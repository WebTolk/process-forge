+                "title": "File root",
+                "content_roots": [str(file_root)],
+                "indexing": {"mode": "fulltext", "sources": [
+                    {"path": ".", "include": ["*.md"], "exclude": []},
+                ]},
+            },
+            {
+                "id": "resource.distinct",
