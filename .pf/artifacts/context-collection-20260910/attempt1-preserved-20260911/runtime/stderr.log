   863: def _is_session_end_fallback_duplicate(envelope: dict[str, Any], item: dict[str, Any], project_root: Path, core: Any) -> bool:
   864:     if str(envelope.get("provider") or "") != "codex" or str(envelope.get("adapter") or "") != "codex-hooks":
   865:         return False
   866:     if str(envelope.get("native_event_type") or "") != "SessionEnd" or str(item.get("message_role") or "") != "assistant":
   867:         return False
   868:     content = item.get("content")
   869:     turn_id = str(item.get("turn_id") or "")
   870:     session_id = str(envelope.get("source_session_id") or "")
   871:     if not isinstance(content, str) or not content.strip() or not session_id:
   872:         return False
   873:     for existing in core.load_chat_messages(project_root, session_id):
   874:         body = existing.get("message") if isinstance(existing.get("message"), dict) else {}
   875:         participant = existing.get("participant") if isinstance(existing.get("participant"), dict) else {}
   876:         existing_primary = str(participant.get("id") or "") == "codex" or str(participant.get("type") or "") == "subagent"
   877:         if (
   878:             (not turn_id or str(existing.get("turn_id") or "") == turn_id)
   879:             and existing_primary
   880:             and body.get("role") == "assistant"
   881:             and body.get("content") == content
   882:         ):
   883:             return True
   884:     return False
   885: 
