   660: 
   661: def _pending_conversation_key(project_root: Path, session_id: str, core: Any) -> tuple[str, str]:
   662:     return (core.project_id(project_root), session_id)
   663: 
   664: 
   665: def _pending_conversation_state_key(project_root: Path, session_id: str, core: Any) -> str:
   666:     project_id = core.project_id(project_root)
   667:     digest = hashlib.sha256(json.dumps({"project_id": project_id, "session_id": session_id}, sort_keys=True).encode("utf-8")).hexdigest()
   668:     return "pending_" + digest[:32]
   669: 
   670: 
   671: def _defer_conversation_capture(envelope: dict[str, Any], receipt: Any, project_root: Path, workplace_root: Path, core: Any) -> None:
   672:     session_id = str(envelope.get("source_session_id") or "")
   673:     raw_id = str(receipt.raw_event_id or "")
   674:     if not session_id or not raw_id:
   675:         return
   676:     with state_lock():
   677:         pending = PENDING_CONVERSATION_CAPTURES.setdefault(_pending_conversation_key(project_root, session_id, core), {})
   678:         pending[raw_id] = (dict(envelope), receipt)
   679:         state = load_state(workplace_root)
   680:         durable = state.setdefault("pending_conversation_captures", {})
   681:         session_key = _pending_conversation_state_key(project_root, session_id, core)
   682:         session_pending = durable.setdefault(
   683:             session_key,
   684:             {
   685:                 "project_id": core.project_id(project_root),
   686:                 "session_id": session_id,
   687:                 "items": {},
   688:             },
   689:         )
   690:         items = session_pending.setdefault("items", {})
   691:         items[raw_id] = {"raw_event_id": raw_id, "envelope": dict(envelope)}
   692:         save_state(workplace_root, state, core)
   693: 
   694: 
   695: def _flush_deferred_conversation(
   696:     project_root: Path, workplace_root: Path, session_id: str, core: Any
   697: ) -> tuple[list[str], dict[str, Any]]:
   698:     if not session_id:
   699:         return [], {}
   700:     with state_lock():
   701:         memory_key = _pending_conversation_key(project_root, session_id, core)
   702:         queued = dict(PENDING_CONVERSATION_CAPTURES.get(memory_key, {}))
   703:         state = load_state(workplace_root)
   704:         durable = state.setdefault("pending_conversation_captures", {})
   705:         session_key = _pending_conversation_state_key(project_root, session_id, core)
   706:         stored = durable.get(session_key, {})
   707:     stored_items = stored.get("items") if isinstance(stored, dict) and isinstance(stored.get("items"), dict) else {}
   708:     for raw_id, item in stored_items.items():
   709:         if raw_id in queued or not isinstance(item, dict) or not isinstance(item.get("envelope"), dict):
   710:             continue
   711:         queued[str(raw_id)] = (dict(item["envelope"]), argparse.Namespace(raw_event_id=str(item.get("raw_event_id") or raw_id)))
   712:     if not queued:
   713:         return [], {}
   714:     identifiers: list[str] = []
   715:     failures: list[dict[str, Any]] = []
   716:     succeeded: list[str] = []
   717:     for raw_id, (envelope, receipt) in queued.items():
   718:         chat_ids, diagnostics = _conversation_messages(envelope, receipt, project_root, workplace_root, core)
   719:         identifiers.extend(chat_ids)
   720:         reason = _conversation_reason(diagnostics)
   721:         if reason:
   722:             failures.append({"raw_event_id": raw_id, "reason": reason})
   723:         else:
   724:             succeeded.append(raw_id)
   725:     if succeeded:
   726:         with state_lock():
   727:             memory_pending = PENDING_CONVERSATION_CAPTURES.get(_pending_conversation_key(project_root, session_id, core), {})
   728:             for raw_id in succeeded:
   729:                 memory_pending.pop(raw_id, None)
   730:             if not memory_pending:
   731:                 PENDING_CONVERSATION_CAPTURES.pop(_pending_conversation_key(project_root, session_id, core), None)
   732:             state = load_state(workplace_root)
   733:             durable = state.setdefault("pending_conversation_captures", {})
   734:             session_key = _pending_conversation_state_key(project_root, session_id, core)
   735:             stored = durable.get(session_key, {})
   736:             stored_items = stored.get("items") if isinstance(stored, dict) and isinstance(stored.get("items"), dict) else {}
   737:             for raw_id in succeeded:
   738:                 stored_items.pop(raw_id, None)
   739:             if isinstance(stored, dict) and stored_items:
   740:                 stored["items"] = stored_items
   741:                 durable[session_key] = stored
   742:             else:
   743:                 durable.pop(session_key, None)
   744:             save_state(workplace_root, state, core)
   745:     diagnostics: dict[str, Any] = {"deferred_conversation": {"flushed": len(queued), "chat_message_ids": identifiers}}
   746:     if failures:
   747:         diagnostics["deferred_conversation"]["failures"] = failures
   748:     return identifiers, diagnostics
   749: 
