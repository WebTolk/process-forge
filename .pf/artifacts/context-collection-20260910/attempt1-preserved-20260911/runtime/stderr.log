   613: def _runtime_native_envelope(raw: dict[str, Any], project_ref: str | None) -> dict[str, Any]:
   614:     """Wrap legacy normalized Runtime input without changing its derived ID."""
   615: 
   616:     source = raw.get("source") if isinstance(raw.get("source"), dict) else {}
   617:     return {
   618:         "provider": "processforge",
   619:         "adapter": str(source.get("adapter") or raw.get("adapter") or "runtime-legacy"),
   620:         "native_event_type": str(raw.get("event_type") or raw.get("type") or "runtime.event"),
   621:         "raw_payload": dict(raw),
   622:         "native_event_id": raw.get("event_id"),
   623:         "native_id_scope": "adapter",
   624:         "native_event_id_stable": bool(raw.get("event_id")),
   625:         "source_session_id": str(source.get("session_id") or raw.get("session_id") or "") or None,
   626:         "source_project_ref": str(project_ref or raw.get("project_root") or raw.get("cwd") or "") or None,
   627:         "derived_event": dict(raw),
   628:     }
   629: 
