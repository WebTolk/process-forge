   964: def ingest_event(raw: dict[str, Any], workplace_root: Path | None, core: Any, *, project_ref: str | None = None) -> dict[str, Any]:
   965:     """Persist a private raw event before attempting its derived project effect.
   966: 
   967:     Adapters provide native envelopes and may attach an already-normalized
   968:     ``derived_event``.  The Host remains provider-neutral: it only validates
   969:     project scope and executes the existing normalized-event behavior.
   970:     """
   971: 
   972:     envelope = dict(raw) if _is_native_envelope(raw) else _runtime_native_envelope(raw, project_ref)
   973:     source_project_ref = str(envelope.get("source_project_ref") or project_ref or "")
   974:     if not source_project_ref:
   975:         raise SystemExit("FAIL: runtime event requires --project-root or project_root/cwd in input")
   976:     project_root = resolve_project(source_project_ref, core)
   977:     workplace_root = workplace_root or core.resolve_workplace_root(None, project_root=project_root)
   978:     native = NativeAgentEvent(
   979:         provider=str(envelope["provider"]),
   980:         adapter=str(envelope["adapter"]),
   981:         native_event_type=str(envelope["native_event_type"]),
   982:         raw_payload=dict(envelope["raw_payload"]),
   983:         payload_version=str(envelope.get("payload_version") or "1"),
   984:         native_event_id=str(envelope.get("native_event_id") or "") or None,
   985:         native_id_scope=str(envelope.get("native_id_scope") or "provider"),
   986:         native_event_id_stable=bool(envelope.get("native_event_id_stable", True)),
   987:         source_session_id=str(envelope.get("source_session_id") or "") or None,
   988:         source_project_ref=source_project_ref,
   989:     )
   990:     receipt = RawIngressKernel(workplace_root).ingest(native)
   991:     response = _raw_receipt_payload(receipt)
   992:     if not receipt.accepted:
   993:         return response
   994: 
   995:     derived = envelope.get("derived_event")
   996:     derived_event_type = _derived_event_type(derived) if isinstance(derived, dict) else ""
   997:     derived_session_id = _derived_session_id(derived) if isinstance(derived, dict) else ""
   998:     ended_session_presence: dict[str, Any] | None = None
   999:     if (
  1000:         isinstance(derived, dict)
  1001:         and derived_event_type in {"agent.session.ended", "agent.session.stopped"}
  1002:         and isinstance(envelope.get("derived_conversation_messages"), list)
  1003:         and derived_session_id
  1004:     ):
  1005:         ended_session_presence = ledger_session(derived_session_id, workplace_root, core)
  1006: 
  1007:     if isinstance(derived, dict):
  1008:         derived_ref = str(derived.get("project_root") or derived.get("cwd") or "")
  1009:         if derived_ref and resolve_project(derived_ref, core) != project_root:
  1010:             raise PermissionError("derived event project_root does not match native envelope")
  1011:         # Preserve the established CLI/Runtime 403 behavior for project/session
  1012:         # denial.  The raw receipt already exists at this point for later audit.
  1013:         routed = _ingest_derived_event(derived, workplace_root, core, project_ref=str(project_root))
  1014:         response = {
  1015:             **routed,
  1016:             **response,
  1017:             "routing_status": "routed",
  1018:             "normalized_event_ids": [str(routed["event_id"])],
  1019:         }
  1020:         if derived_event_type in {"agent.session.started", "agent.session.resumed"}:
  1021:             flushed_ids, flushed_diagnostics = _flush_deferred_conversation(project_root, workplace_root, derived_session_id, core)
  1022:             response["chat_message_ids"] = [*response["chat_message_ids"], *flushed_ids]
  1023:             response["diagnostics"] = {**response["diagnostics"], **flushed_diagnostics}
  1024: 
  1025:     chat_message_ids, conversation_diagnostics = _conversation_messages(
  1026:         envelope,
  1027:         receipt,
  1028:         project_root,
  1029:         workplace_root,
  1030:         core,
  1031:         ended_session_presence=ended_session_presence,
  1032:     )
  1033:     if (
  1034:         _conversation_reason(conversation_diagnostics) == "session_not_authorized"
  1035:         and not _is_worker_conversation(envelope)
  1036:         and derived_event_type not in {"agent.session.ended", "agent.session.stopped"}
  1037:         and str(envelope.get("source_session_id") or "")
  1038:         and not ledger_session(str(envelope.get("source_session_id") or ""), workplace_root, core)
  1039:     ):
  1040:         _defer_conversation_capture(envelope, receipt, project_root, workplace_root, core)
  1041:         chat_message_ids, conversation_diagnostics = _conversation_deferred(
  1042:             "session_not_authorized",
  1043:             session_id=str(envelope.get("source_session_id") or ""),
  1044:         )
  1045:     response["chat_message_ids"] = [*response["chat_message_ids"], *chat_message_ids]
  1046:     response["diagnostics"] = {**response["diagnostics"], **conversation_diagnostics}
  1047:     return response
  1048: 
