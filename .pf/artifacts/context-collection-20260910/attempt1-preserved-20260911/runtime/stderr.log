+                    {"path": "keep.md", "include": ["*.md"], "exclude": []},
+                    {"path": "wrong.txt", "include": ["*.md"], "exclude": []},
+                    {"path": "excluded.md", "include": ["*.md"], "exclude": ["excluded.md"]},
+                ]},
+            },
