   760: def _is_safe_automatic_content(content: str) -> bool:
   761:     # Marker names may appear in a safe worker report that explains which
   762:     # private values were withheld. Reject their values (via secret/path
   763:     # checks below), not the vocabulary used to describe that policy.
   764:     return not bool(__import__("re").search(r"(?:[a-zA-Z]:[\\/]|/(?:users|home|tmp|var)/)", content))
   765: 
   766: 
   767: def worker_input_summary(run_id: str, task_id: str, attempt: str, payload_hash: str, expected_report: str) -> str:
   768:     return (
   769:         f"ProcessForge launched worker run `{run_id}`, task `{task_id}`, attempt `{attempt}`; "
   770:         f"stdin_payload_hash=`{payload_hash}`; expected_report=`{expected_report}`."
   771:     )
   772: 
   773: 
   774: def _worker_input_contract(envelope: dict[str, Any], project_root: Path, core: Any) -> dict[str, Any] | None:
   775:     raw = envelope.get("raw_payload") if isinstance(envelope.get("raw_payload"), dict) else {}
   776:     run_id, task_id, attempt = (str(raw.get(key) or "") for key in ("run_id", "task_id", "attempt"))
   777:     payload = raw.get("stdin_payload")
   778:     payload_hash = str(raw.get("stdin_payload_hash") or "")
   779:     expected_report = str(raw.get("expected_report") or "")
   780:     if not run_id or not task_id or not attempt or not isinstance(payload, str) or not payload_hash or not expected_report:
   781:         return None
   782:     if payload_hash != "sha256:" + hashlib.sha256(payload.encode("utf-8")).hexdigest():
   783:         return None
   784:     contract_path = project_root / ".pf" / "runtime" / "agent-runs" / core.safe_id(run_id, "run") / core.safe_id(task_id, "task") / "worker-input-contract.json"
   785:     try:
   786:         contract = json.loads(contract_path.read_text(encoding="utf-8"))
   787:     except (OSError, json.JSONDecodeError):
   788:         return None
   789:     required = {"run_id": run_id, "task_id": task_id, "attempt": attempt, "stdin_payload_hash": payload_hash, "expected_report": expected_report}
   790:     if any(str(contract.get(key) or "") != value for key, value in required.items()):
   791:         return None
   792:     summary = worker_input_summary(run_id, task_id, attempt, payload_hash, expected_report)
   793:     if str(contract.get("summary") or "") != summary:
   794:         return None
   795:     return {**required, "summary": summary}
   796: 
   797: 
   798: def _allowed_conversation_message(envelope: dict[str, Any], item: dict[str, Any]) -> bool:
   799:     provider, adapter, event_type = (str(envelope.get(key) or "") for key in ("provider", "adapter", "native_event_type"))
   800:     role = str(item.get("message_role") or "")
   801:     source = item.get("content_source") if isinstance(item.get("content_source"), dict) else {}
   802:     kind, provenance = str(source.get("kind") or ""), str(source.get("content_provenance") or "")
   803:     raw = envelope.get("raw_payload") if isinstance(envelope.get("raw_payload"), dict) else {}
   804:     session = str(envelope.get("source_session_id") or "")
   805:     if (provider, adapter, event_type, role, kind, provenance) == ("codex", "codex-hooks", "UserPromptSubmit", "user", "codex_hook", "provider_payload"):
   806:         return isinstance(raw.get("prompt"), str) and item.get("content") == raw.get("prompt")
   807:     if (provider, adapter, event_type, role, kind, provenance) in {
   808:         ("codex", "codex-hooks", "Stop", "assistant", "codex_hook", "provider_payload"),
   809:         ("codex", "codex-hooks", "SubagentStop", "assistant", "codex_hook", "provider_payload"),
   810:         ("codex", "codex-hooks", "SessionEnd", "assistant", "codex_hook", "provider_payload"),
   811:     }:
   812:         return isinstance(raw.get("last_assistant_message"), str) and item.get("content") == raw.get("last_assistant_message") and str(item.get("session_id") or session) == session
   813:     if provider != "processforge" or adapter != "pf-codex-exec-worker":
   814:         return False
   815:     run_id, task_id, attempt = (str(raw.get(key) or "") for key in ("run_id", "task_id", "attempt"))
   816:     if session != f"pf-worker:{run_id}:{task_id}:attempt:{attempt}":
   817:         return False
   818:     if event_type == "WorkerPromptPayloadSubmitted":
   819:         return (
   820:             (role, kind, provenance) == ("system", "pf_codex_exec_input", "pf_owned_safe_summary")
   821:             and str(envelope.get("native_event_id") or "") == f"worker-input:{run_id}:{task_id}:attempt:{attempt}"
   822:             and item.get("content") == worker_input_summary(run_id, task_id, attempt, str(raw.get("stdin_payload_hash") or ""), str(raw.get("expected_report") or ""))
   823:         )
   824:     if event_type == "WorkerExpectedReportCaptured":
   825:         report_content = raw.get("report_content")
   826:         report_hash = "sha256:" + hashlib.sha256(report_content.encode("utf-8")).hexdigest() if isinstance(report_content, str) else ""
   827:         return (
   828:             (role, kind, provenance) == ("assistant", "pf_codex_exec_output", "pf_owned_output_file")
   829:             and str(envelope.get("native_event_id") or "") == f"worker-output:{run_id}:{task_id}:attempt:{attempt}:{report_hash}"
   830:             and item.get("content") == report_content
   831:         )
   832:     return False
   833: 
   834: 
   835: def _worker_session_authorized(envelope: dict[str, Any], project_root: Path, core: Any) -> bool:
   836:     raw = envelope.get("raw_payload") if isinstance(envelope.get("raw_payload"), dict) else {}
   837:     run_id, task_id = str(raw.get("run_id") or ""), str(raw.get("task_id") or "")
   838:     if not run_id or not task_id:
   839:         return False
   840:     try:
   841:         task = core.load_task(project_root, task_id)
   842:     except (OSError, SystemExit):
   843:         return False
   844:     if str(task.get("run_id") or "") != run_id:
   845:         return False
   846:     state = core.load_agent_run_state(project_root, run_id, task_id)
   847:     attempt = str(raw.get("attempt") or "")
   848:     if not state or attempt != str(state.get("attempt") or ""):
   849:         return False
   850:     expected = task.get("expected_report") if isinstance(task.get("expected_report"), dict) else {}
   851:     expected_report = str(expected.get("artifact") or "")
   852:     if str(raw.get("expected_report") or "") != expected_report:
   853:         return False
   854:     if str(envelope.get("native_event_type") or "") == "WorkerPromptPayloadSubmitted" and _worker_input_contract(envelope, project_root, core) is None:
   855:         return False
   856:     if str(envelope.get("native_event_type") or "") == "WorkerExpectedReportCaptured":
   857:         report = project_root / expected_report
   858:         if not report.is_file() or report.read_text(encoding="utf-8", errors="replace") != raw.get("report_content"):
   859:             return False
   860:     return True
   861: 
