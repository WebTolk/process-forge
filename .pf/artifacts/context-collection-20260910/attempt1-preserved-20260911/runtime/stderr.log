   631: def _raw_receipt_payload(receipt: Any) -> dict[str, Any]:
   632:     return {
   633:         "raw_event_id": receipt.raw_event_id,
   634:         "accepted": receipt.accepted,
   635:         "deduplicated": receipt.deduplicated,
   636:         "raw_location": receipt.raw_location,
   637:         "routing_status": receipt.routing_status,
   638:         "normalized_event_ids": list(receipt.normalized_event_ids),
   639:         "chat_message_ids": list(receipt.chat_message_ids),
   640:         "diagnostics": dict(receipt.diagnostics),
   641:     }
   642: 
