   644: def _conversation_denial(reason: str, **details: Any) -> tuple[list[str], dict[str, Any]]:
   645:     return [], {"conversation": {"status": "denied", "reason": reason, **details}}
   646: 
   647: 
   648: def _conversation_deferred(reason: str, **details: Any) -> tuple[list[str], dict[str, Any]]:
   649:     return [], {"conversation": {"status": "deferred", "reason": reason, **details}}
