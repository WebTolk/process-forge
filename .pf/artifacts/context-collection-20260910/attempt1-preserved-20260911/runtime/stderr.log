   651: 
   652: def _conversation_reason(diagnostics: dict[str, Any]) -> str:
   653:     conversation = diagnostics.get("conversation") if isinstance(diagnostics.get("conversation"), dict) else {}
   654:     return str(conversation.get("reason") or "")
