  270: def authorized_resource_ids(snapshot: dict[str, Any]) -> list[str]:
  271:     seen: set[str] = set()
  272:     result: list[str] = []
  273:     for row in _resource_records(snapshot):
  274:         resource_id = str(row.get("id") or row.get("resource_id") or "").strip()
  275:         if resource_id and resource_id not in seen:
  276:             seen.add(resource_id)
  277:             result.append(resource_id)
  278:     return result
  279: 
