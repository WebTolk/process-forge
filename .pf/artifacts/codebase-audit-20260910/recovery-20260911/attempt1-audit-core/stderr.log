   85: ) -> list[ProcessDefinitionRef]:
   86:     active_ids = set(context.active_official_pack_ids)
   87:     entries: list[ProcessDefinitionRef] = []
   88:     for manifest_path, manifest in _official_pack_manifest_records(context):
   89:         pack_id = str(manifest.get("id") or "")
   90:         active = pack_id in active_ids
   91:         if not active and not include_available:
   92:             continue
   93:         process_root = manifest_path.parent / "processes"
   94:         provided = manifest.get("provides") if isinstance(manifest.get("provides"), dict) else {}
   95:         declared = {str(item) for item in _as_list(provided.get("processes")) if str(item)}
   96:         for path in sorted(process_root.glob("*.yaml")):
   97:             data = load_yaml_document(path)
   98:             if yaml_error(data) or not isinstance(data, dict):
   99:                 continue
  100:             process_id = str(data.get("id") or path.stem)
  101:             if declared and process_id not in declared:
  102:                 continue
  103:             entries.append(
  104:                 ProcessDefinitionRef(
  105:                     process_id=process_id,
  106:                     path=path,
  107:                     process=data,
  108:                     origin="official",
  109:                     root=manifest_path.parent,
  110:                     catalog_role=process_catalog_role(data),
  111:                     warnings=[],
  112:                     pack_id=pack_id,
  113:                     active=active,
  114:                     available=True,
  115:                     production_ready=bool(manifest.get("production_ready")),
  116:                 )
  117:             )
  118:     return entries
  119: 
  120: 
  121: def official_process_definition_refs(
  122:     context: ProcessCatalogContext,
  123:     *,
  124:     include_available: bool = False,
  125: ) -> list[ProcessDefinitionRef]:
  126:     return _official_process_definition_refs(
  127:         context,
  128:         include_available=include_available,
  129:     )
  130: 
  131: 
  132: def _process_root_candidates(context: ProcessCatalogContext) -> list[tuple[Path, str, bool]]:
  133:     candidates = [
  134:         (context.flow_root / "processes" / "user", "user", False),
  135:         (context.flow_root / "processes" / "custom", "custom", False),
  136:         (context.project_root / "processes" / "user", "user", False),
  137:         (context.project_root / "processes" / "custom", "custom", False),
  138:         (context.distribution_root / "processes" / "user", "user", False),
  139:         (context.distribution_root / "processes" / "custom", "custom", False),
  140:         (context.project_root / "processes" / "core", "core", False),
  141:         (context.distribution_root / "processes" / "core", "core", False),
  142:         (context.flow_root / "processes", "legacy_flat", True),
  143:         (context.project_root / "processes", "legacy_flat", True),
  144:         (context.distribution_root / "processes", "legacy_flat", True),
  145:     ]
  146:     seen: set[Path] = set()
  147:     unique: list[tuple[Path, str, bool]] = []
  148:     for path, origin, legacy in candidates:
  149:         resolved = path.resolve()
  150:         if resolved in seen:
  151:             continue
  152:         seen.add(resolved)
  153:         unique.append((path, origin, legacy))
  154:     return unique
  155: 
  156: 
  157: def process_root_candidates(
  158:     context: ProcessCatalogContext,
  159: ) -> list[tuple[Path, str, bool]]:
  160:     return _process_root_candidates(context)
  161: 
  162: 
  163: def _process_root_yaml_files(root: Path, *, legacy_flat: bool) -> list[Path]:
  164:     if not root.is_dir():
  165:         return []
  166:     if legacy_flat:
  167:         return sorted([*root.glob("*.yaml"), *root.glob("*.yml")])
  168:     return sorted([path for path in root.rglob("*") if path.is_file() and path.suffix.lower() in {".yaml", ".yml"}])
  169: 
  170: 
  171: def process_root_yaml_files(root: Path, *, legacy_flat: bool) -> list[Path]:
  172:     return _process_root_yaml_files(root, legacy_flat=legacy_flat)
  173: 
  174: 
  175: def process_catalog_entries(
  176:     context: ProcessCatalogContext,
  177:     *,
  178:     strict: bool = False,
  179:     include_available_official: bool = False,
  180: ) -> list[ProcessDefinitionRef]:
  181:     selected: dict[str, ProcessDefinitionRef] = {}
  182:     order: list[str] = []
  183:     duplicate_messages: dict[str, list[str]] = {}
  184: 
  185:     def register(entry: ProcessDefinitionRef) -> None:
  186:         process_id = entry.process_id
  187:         if process_id not in selected:
  188:             selected[process_id] = entry
  189:             order.append(process_id)
  190:             return
  191:         current = selected[process_id]
  192:         message = (
  193:             f"duplicate process_id {process_id}: {rel(current.path, context.project_root)} "
  194:             f"wins over {rel(entry.path, context.project_root)}"
  195:         )
  196:         if (
  197:             current.origin in {"user", "custom"}
  198:             and entry.origin in {"core", "official"}
  199:             and not _process_override_declared(current.process, process_id)
  200:         ):
  201:             message += f"; user/custom override of {entry.origin} process requires process_override.reason"
  202:         duplicate_messages.setdefault(process_id, []).append(message)
  203:         if strict:
  204:             current.warnings.append("STRICT: " + message)
  205: 
  206:     official_added = False
  207:     for root, origin, legacy_flat in _process_root_candidates(context):
  208:         if origin == "core" and not official_added:
  209:             for official_entry in _official_process_definition_refs(
  210:                 context,
  211:                 include_available=include_available_official,
  212:             ):
  213:                 register(official_entry)
  214:             official_added = True
  215:         for path in _process_root_yaml_files(root, legacy_flat=legacy_flat):
  216:             data = load_yaml_document(path)
  217:             if yaml_error(data) or not isinstance(data, dict):
  218:                 continue
  219:             process_id = str(data.get("id") or path.stem)
  220:             warnings: list[str] = []
  221:             if legacy_flat:
  222:                 warnings.append(
  223:                     f"Legacy flat process path detected: {rel(path, context.project_root)}. Move built-ins to processes/core/ and user processes to processes/user/."
  224:                 )
  225:             entry = ProcessDefinitionRef(
  226:                 process_id=process_id,
  227:                 path=path,
  228:                 process=data,
  229:                 origin=origin,
  230:                 root=root,
  231:                 catalog_role=process_catalog_role(data),
  232:                 warnings=warnings,
  233:             )
  234:             register(entry)
  235:     for process_id, messages in duplicate_messages.items():
  236:         selected[process_id].warnings.extend(messages)
  237:     return [selected[process_id] for process_id in order]
  238: 
  239: 
  240: def resolve_process_definition(
  241:     context: ProcessCatalogContext,
  242:     process_or_path: str,
  243:     *,
  244:     include_available_official: bool = False,
  245: ) -> ProcessDefinitionRef:
  246:     candidate = Path(process_or_path)
  247:     if candidate.suffix in {".yaml", ".yml"}:
  248:         path = candidate if candidate.is_absolute() else context.project_root / candidate
  249:         if path.is_file():
  250:             for official_entry in _official_process_definition_refs(context, include_available=True):
  251:                 if official_entry.path.resolve() == path.resolve():
  252:                     return official_entry
  253:             data = read_yaml_file(path)
  254:             process_id = str(data.get("id") or path.stem) if isinstance(data, dict) else path.stem
  255:             origin = "legacy_flat"
  256:             root = path.parent
  257:             parts = path.parts
  258:             if "processes" in parts:
  259:                 try:
  260:                     index = parts.index("processes")
  261:                     if len(parts) > index + 1 and parts[index + 1] in {"core", "user", "custom"}:
  262:                         origin = parts[index + 1]
  263:                         root = Path(*parts[: index + 2])
  264:                 except ValueError:
  265:                     pass
  266:             return ProcessDefinitionRef(
  267:                 process_id,
  268:                 path,
  269:                 data,
  270:                 origin,
  271:                 root,
  272:                 process_catalog_role(data) if isinstance(data, dict) else "canonical",
  273:                 [],
  274:             )
  275:     process_id = safe_id(process_or_path, "process")
  276:     for entry in process_catalog_entries(
  277:         context,
  278:         include_available_official=include_available_official,
  279:     ):
  280:         if entry.process_id == process_id:
  281:             return entry
  282:     for entry in _official_process_definition_refs(context, include_available=True):
  283:         if entry.process_id == process_id and not entry.active:
  284:             raise SystemExit(
  285:                 f"FAIL: process {process_id} is available in official pack {entry.pack_id} "
  286:                 "but is not active in this workplace.\n"
  287:                 "Fix: run "
  288:                 f"python bin/pf.py pack-activate --id {entry.pack_id} --workplace <path> --apply"
  289:             )
  290:     raise SystemExit(f"FAIL: process not found: {process_id}")
  291: 
  292: 
  293: def require_official_process_active(context: ProcessCatalogContext, process_id: str) -> None:
  294:     normalized = safe_id(process_id, "process")
  295:     effective = next(
  296:         (
  297:             entry
  298:             for entry in process_catalog_entries(
  299:                 context,
  300:                 include_available_official=True,
  301:             )
  302:             if entry.process_id == normalized
  303:         ),
  304:         None,
  305:     )
  306:     if effective is not None and effective.origin == "official" and not effective.active:
  307:         raise SystemExit(
  308:             f"FAIL: process {normalized} is available in official pack {effective.pack_id} "
  309:             "but is not active in this workplace.\n"
  310:             "Fix: run "
  311:             f"python bin/pf.py pack-activate --id {effective.pack_id} --workplace <path> --apply"
  312:         )
  313: 
  314: 
  315: def process_definition_exists(context: ProcessCatalogContext, process_id: str) -> bool:
  316:     try:
  317:         resolve_process_definition(context, process_id)
  318:         return True
  319:     except SystemExit:
  320:         return False

