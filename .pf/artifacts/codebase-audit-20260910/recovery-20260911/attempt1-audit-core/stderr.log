25505: def platform_authoring_values(args: argparse.Namespace) -> dict[str, Any]:
25506:     platform_id = validate_resource_id(
25507:         str(args.id).removeprefix("platform."),
25508:         "platform",
25509:     )
25510:     contract_id = platform_contract_id(platform_id)
25511:     required_packages = [
25512:         item for item in getattr(args, "requires_package", []) if item
25513:     ]
25514:     recommended_packages = [
25515:         item for item in getattr(args, "recommends_package", []) if item
25516:     ]
25517:     optional_packages = [
25518:         item for item in getattr(args, "optional_package", []) if item
25519:     ]
25520:     required_templates = [
25521:         item for item in getattr(args, "requires_template", []) if item
25522:     ]
25523:     recommended_templates = [
25524:         item for item in getattr(args, "recommends_template", []) if item
25525:     ]
25526:     optional_templates = [
25527:         item for item in getattr(args, "optional_template", []) if item
25528:     ]
25529:     required_tools = [item for item in getattr(args, "requires_tool", []) if item]
25530:     recommended_tools = [
25531:         item for item in getattr(args, "recommends_tool", []) if item
25532:     ]
25533:     optional_tools = [item for item in getattr(args, "optional_tool", []) if item]
25534:     required_mcp = [item for item in getattr(args, "requires_mcp", []) if item]
25535:     recommended_mcp = [
25536:         item for item in getattr(args, "recommends_mcp", []) if item
25537:     ]
25538:     optional_mcp = [item for item in getattr(args, "optional_mcp", []) if item]
25539:     project_types = [item for item in getattr(args, "project_type", []) if item] or [
25540:         platform_id
25541:     ]
25542:     return {
25543:         "platform_id": platform_id,
25544:         "contract_id": contract_id,
25545:         "title": str(getattr(args, "title", "") or title_from_id(platform_id)),
25546:         "version": str(getattr(args, "version", "") or "1.0.0"),
25547:         "required_packages": required_packages,
25548:         "recommended_packages": recommended_packages,
25549:         "optional_packages": optional_packages,
25550:         "required_templates": required_templates,
25551:         "recommended_templates": recommended_templates,
25552:         "optional_templates": optional_templates,
25553:         "required_tools": required_tools,
25554:         "recommended_tools": recommended_tools,
25555:         "optional_tools": optional_tools,
25556:         "required_mcp": required_mcp,
25557:         "recommended_mcp": recommended_mcp,
25558:         "optional_mcp": optional_mcp,
25559:         "project_types": project_types,
25560:         "processes": [item for item in getattr(args, "process", []) if item],
25561:     }
