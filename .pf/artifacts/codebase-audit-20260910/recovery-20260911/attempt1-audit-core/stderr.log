24916: def resolve_template_root(workplace_root: Path, template_root_id: str | None = None, *, mode: str = "read") -> tuple[str, Path]:
24917:     registry_path = workplace_root / "registries" / "templates.yaml"
24918:     data = load_yaml_document(registry_path)
24919:     roots = data.get("template_roots") if isinstance(data, dict) else None
24920:     entries = [entry for entry in roots if isinstance(entry, dict)] if isinstance(roots, list) else []
24921:     if not entries:
24922:         entries = [{"id": "global", "label": "Global reusable templates", "path": "${PF_TEMPLATES}", "scope": "workplace", "status": "available"}]
24923:         if mode == "write":
24924:             upsert_registry_entry(registry_path, "template_roots", entries[0])
24925:     selected = None
24926:     if template_root_id:
24927:         for entry in entries:
24928:             if str(entry.get("id")) == template_root_id:
24929:                 selected = entry
24930:                 break
24931:         if selected is None:
24932:             raise SystemExit(f"FAIL: template root '{template_root_id}' not found in registries/templates.yaml")
24933:     else:
24934:         available = [entry for entry in entries if str(entry.get("status", "available")) == "available"]
24935:         selected = available[0] if available else entries[0]
24936:     root_id = str(selected.get("id", "global"))
24937:     root_path = path_resolution_to_path(workplace_path_resolution(workplace_root, str(selected.get("path") or "${PF_TEMPLATES}")))
24938:     if mode == "write":
24939:         root_path.mkdir(parents=True, exist_ok=True)
24940:     return root_id, root_path
24941: 
24942: 
24943: def resolve_platform_root(workplace_root: Path, platform_root_id: str | None = None, *, mode: str = "read") -> tuple[str, Path]:
24944:     registry_path = workplace_root / "registries" / "platform-contract-roots.yaml"
24945:     data = load_yaml_document(registry_path)
24946:     roots = data.get("platform_contract_roots") if isinstance(data, dict) else None
24947:     entries = [entry for entry in roots if isinstance(entry, dict)] if isinstance(roots, list) else []
24948:     if not entries:
24949:         entries = [{"id": "global", "label": "Global platform contracts", "path": "${PF_PLATFORM_CONTRACTS}", "scope": "workplace", "status": "available"}]
24950:         if mode == "write":
24951:             upsert_registry_entry(registry_path, "platform_contract_roots", entries[0])
24952:     selected = None
24953:     if platform_root_id:
24954:         for entry in entries:
24955:             if str(entry.get("id")) == platform_root_id:
24956:                 selected = entry
24957:                 break
24958:         if selected is None:
24959:             raise SystemExit(f"FAIL: platform root '{platform_root_id}' not found in registries/platform-contract-roots.yaml")
24960:     else:
24961:         available = [entry for entry in entries if str(entry.get("status", "available")) == "available"]
24962:         selected = available[0] if available else entries[0]
24963:     root_id = str(selected.get("id", "global"))
24964:     root_path = path_resolution_to_path(workplace_path_resolution(workplace_root, str(selected.get("path") or "${PF_PLATFORM_CONTRACTS}")))
24965:     if mode == "write":
24966:         root_path.mkdir(parents=True, exist_ok=True)
24967:     return root_id, root_path
