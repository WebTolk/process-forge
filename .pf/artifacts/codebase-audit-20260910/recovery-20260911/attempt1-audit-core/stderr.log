24811: def command_docs_import_plan(args: argparse.Namespace) -> int:
24812:     workplace_root = Path(args.workplace).expanduser().resolve()
24813:     source = safe_id(args.source, "source")
24814:     topics = [safe_id(item.strip(), "topic") for item in str(args.topics).split(",") if item.strip()]
24815:     plan_id = safe_id(args.id or f"{source}-{'-'.join(topics)}", "documentation-import")
24816:     resources = [
24817:         {
24818:             "id": f"{source}-{topic}-docs",
24819:             "kind": "documentation",
24820:             "title": f"{source.upper()} {topic.upper()} documentation mirror",
24821:             "path_ref": {"registry": "external_resources", "id": f"{source}-{topic}-docs"},
24822:             "load_policy": "on_demand",
24823:             "index_policy": "full_text",
24824:             "source": {"type": "documentation_source", "id": source, "topic": topic},
24825:             "license": {"name": args.license or "source-specific"},
24826:             "update_policy": {"mode": "manual_plan_first"},
24827:         }
24828:         for topic in topics
24829:     ]
24830:     plan = {
24831:         "schema_version": 1,
24832:         "id": plan_id,
24833:         "source": source,
24834:         "topics": topics,
24835:         "created_at": now_utc(),
24836:         "mode": "plan_only",
24837:         "download": {"enabled": False, "reason": "MVP does not crawl or download large documentation sets"},
24838:         "resources": resources,
24839:         "index_policy": "write_resource_index_without_loading_full_content",
24840:     }
24841:     target = resource_management_root(workplace_root) / "documentation-import-plans" / f"{plan_id}.yaml"
24842:     target.parent.mkdir(parents=True, exist_ok=True)
24843:     target.write_text(ensure_trailing_newline(dump_yaml(plan)), encoding="utf-8")
24844:     append_workplace_resource_event(
24845:         workplace_root,
24846:         resource_management_event(
24847:             scope="workplace",
24848:             command="docs-import-plan",
24849:             event_type="knowledge.resource.add.requested",
24850:             target={"package_id": args.package or "documentation", "resource_id": plan_id},
24851:             status="planned",
24852:             message="documentation import plan created without downloading content",
24853:         ),
24854:     )
24855:     print(f"PLAN: {rel(target, workplace_root)}")
24856:     return 0
24857: 
