   65: def canonical_fingerprint(value: Any) -> str:
   66:     encoded = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
   67:     return "sha256:" + hashlib.sha256(encoded.encode("utf-8")).hexdigest()
