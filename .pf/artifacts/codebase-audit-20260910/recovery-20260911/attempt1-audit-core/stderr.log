 4815: def active_registry_capability_providers(
 4816:     workplace_manifest: Path | None,
 4817:     activated: dict[str, set[str]],
 4818: ) -> tuple[set[str], dict[str, list[dict[str, Any]]]]:
 4819:     capabilities: set[str] = set()
 4820:     providers: dict[str, list[dict[str, Any]]] = {}
 4821:     registry_specs = [
 4822:         ("tools", "tools", "tool", "tools"),
 4823:         ("mcp", "mcp_servers", "mcp", "mcp"),
 4824:         ("templates", "templates", "template", "templates"),
 4825:         ("templates", "template_roots", "template", "templates"),
 4826:     ]
 4827:     for registry_key, collection_key, provider_key, resource_key in registry_specs:
 4828:         registry = load_workplace_registry(workplace_manifest, registry_key, f"{registry_key}.yaml")
 4829:         entries = registry.get(collection_key) if isinstance(registry, dict) else None
 4830:         if not isinstance(entries, list):
 4831:             continue
 4832:         active_ids = activated.get(resource_key, set())
 4833:         for entry in entries:
 4834:             if not isinstance(entry, dict):
 4835:                 continue
 4836:             resource_id = str(entry.get("id") or "")
 4837:             if not resource_id or resource_id not in active_ids:
 4838:                 continue
 4839:             if str(entry.get("status") or "available") in {"disabled", "missing"}:
 4840:                 continue
 4841:             provided = values_from_registry_entry(entry)
 4842:             capabilities.update(provided)
 4843:             for capability in provided:
 4844:                 providers.setdefault(capability, []).append({"provider": "registry", provider_key: resource_id})
 4845:     pack_capabilities, pack_providers = official_pack_capability_providers(workplace_manifest)
 4846:     capabilities.update(pack_capabilities)
 4847:     for capability, items in pack_providers.items():
 4848:         providers.setdefault(capability, []).extend(items)
 4849:     return capabilities, providers
