 4234: def contract_required_capabilities(contract: dict[str, Any]) -> list[str]:
 4235:     requires = contract.get("requires", {}) if isinstance(contract.get("requires"), dict) else {}
 4236:     return sorted(set(list_value(contract.get("capabilities"))).union(list_value(requires.get("capabilities"))))
