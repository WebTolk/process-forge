 2516:         if isinstance(item, dict):
 2517:             knowledge_roots[str(item.get("id") or "local-docs")] = str(item.get("path_ref") or item.get("path") or "${PF_WORKPLACE}/knowledge")
 2518:     processforge_root = str(machine.get("processforge_root") or "${PROCESSFORGE_ROOT}")
 2519:     discovery_enabled = str(discovery.get("enabled") or "ask").lower() in {"true", "yes", "enabled", "on"}
