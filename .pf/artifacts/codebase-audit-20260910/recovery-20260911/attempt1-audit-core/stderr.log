   81: def _initialization_request(request: dict[str, Any], core: Any) -> dict[str, Any]:
   82:     raw_root, raw_workplace = request.get("project_root"), request.get("workplace")
   83:     if not raw_root or not raw_workplace:
   84:         raise ProjectInitializationError("project_root_and_workplace_required")
   85:     project_root = Path(str(raw_root)).expanduser().resolve()
   86:     workplace = Path(str(raw_workplace)).expanduser().resolve()
   87:     if workplace.is_dir():
   88:         workplace = workplace / "workplace.yaml"
   89:     answers_path = request.get("answers_path")
