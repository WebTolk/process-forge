 2655: def command_workplace_setup_start(args: argparse.Namespace) -> int:
 2656:     workplace = Path(args.workplace).expanduser().resolve()
 2657:     session_id = safe_id(args.session_id or "default", "setup-session")
 2658:     session_dir = workplace_setup_session_dir(workplace, session_id)
 2659:     answers = load_guided_workplace_answers(session_dir, Path(args.answers).expanduser().resolve() if args.answers else None, workplace=workplace, session_id=session_id)
 2660:     planned = [session_dir / "answers.yaml", session_dir / "proposal.yaml", session_dir / "proposal.md", session_dir / "next-steps.md"]
 2661:     if not args.apply or args.dry_run:
 2662:         print_plan("workplace-setup start dry run", planned, workplace)
 2663:         return 0
 2664:     session_dir.mkdir(parents=True, exist_ok=True)
 2665:     write_yaml_file(session_dir / "answers.yaml", answers)
 2666:     proposal, proposal_md = render_workplace_setup_proposal(session_id, answers)
 2667:     write_yaml_file(session_dir / "proposal.yaml", proposal)
 2668:     (session_dir / "proposal.md").write_text(ensure_trailing_newline(proposal_md), encoding="utf-8")
 2669:     (session_dir / "next-steps.md").write_text(
 2670:         "# Next Steps\n\nReview `proposal.md`, adjust `answers.yaml`, then run `workplace-setup apply` with `--apply`.\n",
 2671:         encoding="utf-8",
 2672:     )
 2673:     append_workplace_event(workplace, "workplace.setup.started", payload={"session_id": session_id})
 2674:     print(f"WROTE: {rel(session_dir / 'answers.yaml', workplace)}")
 2675:     print(f"WROTE: {rel(session_dir / 'proposal.md', workplace)}")
 2676:     return 0
 2677: 
