 4295: def resolve_platform_contracts(
 4296:     workplace_manifest: Path | None,
 4297:     platform_ids: list[str],
 4298:     project_root: Path | None = None,
 4299:     contract_overrides: dict[str, dict[str, Any]] | None = None,
 4300: ) -> dict[str, Any]:
 4301:     contracts_by_id: dict[str, dict[str, Any]] = {}
 4302:     platform_stack: list[dict[str, Any]] = []
 4303:     required_capabilities: set[str] = set()
 4304:     required_knowledge_packages: dict[str, str] = {}
 4305:     recommended_knowledge_packages: dict[str, str] = {}
 4306:     required_tools: dict[str, str] = {}
 4307:     recommended_tools: dict[str, str] = {}
 4308:     required_mcp: dict[str, str] = {}
 4309:     recommended_mcp: dict[str, str] = {}
 4310:     required_templates: dict[str, str] = {}
 4311:     recommended_templates: dict[str, str] = {}
 4312:     missing_required_contracts: list[str] = []
 4313:     circular_platforms: list[str] = []
 4314:     dependency_conflicts: list[dict[str, Any]] = []
 4315:     resource_conflicts: list[dict[str, Any]] = []
 4316:     resolved: set[str] = set()
 4317:     resolving: list[str] = []
 4318: 
 4319:     def resolve_one(raw_platform_id: str, *, relation: str = "selected", inherited_by: str | None = None, include_resources: bool = True, required: bool = True) -> None:
 4320:         contract_id = platform_contract_id(raw_platform_id)
 4321:         if contract_id in resolving:
 4322:             cycle = " -> ".join([*resolving[resolving.index(contract_id):], contract_id])
 4323:             circular_platforms.append(cycle)
 4324:             return
 4325:         if contract_id in resolved:
 4326:             return
 4327:         resolving.append(contract_id)
 4328:         if contract_overrides and contract_id in contract_overrides:
 4329:             contract = contract_overrides[contract_id]
 4330:             entry = {"id": contract_id, "status": "available", "source": "staged"}
 4331:             status = "available"
 4332:             source = "staged"
 4333:         else:
 4334:             contract, entry, status, source = load_platform_contract(workplace_manifest, contract_id, project_root)
 4335:         extends_refs = contract_extends(contract)
 4336:         required_platform_refs = contract_required_platforms(contract)
 4337:         for ref in extends_refs:
 4338:             if ref["id"] in resolving:
 4339:                 cycle = " -> ".join([*resolving[resolving.index(ref["id"]):], ref["id"]])
 4340:                 circular_platforms.append(cycle)
 4341:                 continue
 4342:             resolve_one(ref["id"], relation="extends", inherited_by=contract_id, include_resources=True, required=bool(ref.get("required", True)))
 4343:         for ref in required_platform_refs:
 4344:             if ref["id"] in resolving:
 4345:                 cycle = " -> ".join([*resolving[resolving.index(ref["id"]):], ref["id"]])
 4346:                 circular_platforms.append(cycle)
 4347:                 continue
 4348:             resolve_one(ref["id"], relation="requires.platforms", inherited_by=contract_id, include_resources=False, required=bool(ref.get("required", True)))
 4349:         if status != "available" and required:
 4350:             missing_required_contracts.append(contract_id)
 4351:         platform_record = {
 4352:             "id": contract_id,
 4353:             "platform": contract_id.removeprefix("platform."),
 4354:             "source": source,
 4355:             "status": "available" if status == "available" else "missing",
 4356:             "relation": relation,
 4357:             "required": required,
 4358:             "inherited_by": inherited_by,
 4359:             "extends": [ref["id"] for ref in extends_refs],
 4360:             "requires_platforms": [ref["id"] for ref in required_platform_refs],
 4361:         }
 4362:         platform_stack.append(platform_record)
 4363:         if include_resources:
 4364:             required_capabilities.update(contract_required_capabilities(contract))
 4365:             owner = contract_id
 4366:             merge_id_list(required_knowledge_packages, contract_required_items(contract, "knowledge_packages"), owner, resource_conflicts)
 4367:             merge_id_list(recommended_knowledge_packages, contract_recommended_items(contract, "knowledge_packages"), owner, resource_conflicts)
 4368:             merge_id_list(required_tools, contract_required_items(contract, "tools"), owner, resource_conflicts)
 4369:             merge_id_list(recommended_tools, contract_recommended_items(contract, "tools"), owner, resource_conflicts)
 4370:             merge_id_list(required_mcp, contract_required_items(contract, "mcp"), owner, resource_conflicts)
 4371:             merge_id_list(recommended_mcp, contract_recommended_items(contract, "mcp"), owner, resource_conflicts)
 4372:             merge_id_list(required_templates, contract_required_items(contract, "templates"), owner, resource_conflicts)
 4373:             merge_id_list(recommended_templates, contract_recommended_items(contract, "templates"), owner, resource_conflicts)
 4374:         contracts_by_id[contract_id] = {
 4375:             "id": contract_id,
 4376:             "platform": contract_id.removeprefix("platform."),
 4377:             "source": source,
 4378:             "status": "available" if status == "available" else "missing",
 4379:             "registry_entry": str(entry.get("id")) if isinstance(entry, dict) and entry.get("id") else None,
 4380:             "required_contract": required,
 4381:             "relation": relation,
 4382:             "inherited_by": inherited_by,
 4383:             "extends": [ref["id"] for ref in extends_refs],
 4384:             "requires_platforms": [ref["id"] for ref in required_platform_refs],
 4385:             "required_capabilities": sorted(contract_required_capabilities(contract)),
 4386:             "required": {
 4387:                 "knowledge_packages": sorted(contract_required_items(contract, "knowledge_packages")),
 4388:                 "tools": sorted(contract_required_items(contract, "tools")),
 4389:                 "mcp": sorted(contract_required_items(contract, "mcp")),
 4390:                 "templates": sorted(contract_required_items(contract, "templates")),
 4391:             },
 4392:             "recommended": {
 4393:                 "knowledge_packages": sorted(contract_recommended_items(contract, "knowledge_packages")),
 4394:                 "tools": sorted(contract_recommended_items(contract, "tools")),
 4395:                 "mcp": sorted(contract_recommended_items(contract, "mcp")),
 4396:                 "templates": sorted(contract_recommended_items(contract, "templates")),
 4397:             },
 4398:             "optional": {
 4399:                 "knowledge_packages": sorted(contract_optional_items(contract, "knowledge_packages")),
 4400:                 "tools": sorted(contract_optional_items(contract, "tools")),
 4401:                 "mcp": sorted(contract_optional_items(contract, "mcp")),
 4402:                 "templates": sorted(contract_optional_items(contract, "templates")),
 4403:             },
 4404:             "parameters": parameter_payload(contract),
 4405:         }
 4406:         resolving.pop()
 4407:         resolved.add(contract_id)
 4408: 
 4409:     for platform_id in platform_ids:
 4410:         resolve_one(platform_id)
 4411: 
 4412:     package_index_root = project_root or (workplace_manifest.parent if workplace_manifest and workplace_manifest.is_file() else ROOT)
 4413:     package_index = package_manifest_index(package_index_root, ROOT, workplace_manifest)
 4414:     dependency_queue = list(required_knowledge_packages)
 4415:     while dependency_queue:
 4416:         package_id = dependency_queue.pop(0)
 4417:         manifest = package_index.get(package_id)
 4418:         if not isinstance(manifest, dict):
 4419:             continue
 4420:         for dependency_id in package_dependency_ids(manifest):
 4421:             if dependency_id not in required_knowledge_packages:
 4422:                 required_knowledge_packages[dependency_id] = f"package:{package_id}"
 4423:                 dependency_queue.append(dependency_id)
 4424: 
 4425:     required_knowledge_ids = set(required_knowledge_packages)
 4426:     recommended_knowledge_ids = set(recommended_knowledge_packages) - required_knowledge_ids
 4427:     required_tool_ids = set(required_tools)
 4428:     recommended_tool_ids = set(recommended_tools) - required_tool_ids
 4429:     required_mcp_ids = set(required_mcp)
 4430:     recommended_mcp_ids = set(recommended_mcp) - required_mcp_ids
 4431:     required_template_ids = set(required_templates)
 4432:     recommended_template_ids = set(recommended_templates) - required_template_ids
 4433:     return {
 4434:         "contracts": [contracts_by_id[item["id"]] for item in platform_stack if item["id"] in contracts_by_id],
 4435:         "platform_stack": platform_stack,
 4436:         "missing_required_contracts": sorted(set(missing_required_contracts)),
 4437:         "circular_platforms": sorted(set(circular_platforms)),
 4438:         "dependency_conflicts": dependency_conflicts,
 4439:         "resource_conflicts": resource_conflicts,
 4440:         "required_capabilities": sorted(required_capabilities),
 4441:         "required_knowledge_packages": sorted(required_knowledge_ids),
 4442:         "recommended_knowledge_packages": sorted(recommended_knowledge_ids),
 4443:         "knowledge_packages": sorted(required_knowledge_ids.union(recommended_knowledge_ids)),
 4444:         "required_tools": sorted(required_tool_ids),
 4445:         "recommended_tools": sorted(recommended_tool_ids),
 4446:         "tools": sorted(required_tool_ids.union(recommended_tool_ids)),
 4447:         "required_mcp": sorted(required_mcp_ids),
 4448:         "recommended_mcp": sorted(recommended_mcp_ids),
 4449:         "mcp": sorted(required_mcp_ids.union(recommended_mcp_ids)),
 4450:         "required_templates": sorted(required_template_ids),
 4451:         "recommended_templates": sorted(recommended_template_ids),
 4452:         "templates": sorted(required_template_ids.union(recommended_template_ids)),
 4453:     }
 4454: 
