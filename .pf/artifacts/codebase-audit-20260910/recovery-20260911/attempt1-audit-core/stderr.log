  756: def maintenance_tick(project_root: Path, snapshot: dict[str, Any], *, workplace_root: Path | None = None, verify_files: bool = True) -> dict[str, Any]:
  757:     before = index_status(project_root, snapshot, workplace_root=workplace_root, verify_files=verify_files)
  758:     action = "none"
  759:     result: dict[str, Any] | None = None
  760:     error = str(before.get("error") or "")
  761:     try:
  762:         if before.get("status") in {"missing", "stale"}:
  763:             result = build_index(project_root, snapshot, workplace_root=workplace_root)
  764:             action = "refresh"
  765:         elif before.get("status") == "degraded" and error != "fts5_unavailable":
  766:             result = rebuild_index(project_root, snapshot, workplace_root=workplace_root)
  767:             action = "rebuild"
  768:     except (OSError, sqlite3.Error, LocalSearchError) as exc:
  769:         action = "failed_" + ("rebuild" if before.get("status") == "degraded" else "refresh")
  770:         after_failure = index_status(project_root, snapshot, workplace_root=workplace_root, verify_files=False)
  771:         after_failure["status"] = "degraded"
  772:         after_failure["error"] = _error_code(exc)
  773:         return {"schema_version": 1, "kind": "pf.search_index.maintenance_tick", "action": action, "before": before, "after": after_failure, "result": result}
  774:     after = index_status(project_root, snapshot, workplace_root=workplace_root, verify_files=False)
  775:     return {"schema_version": 1, "kind": "pf.search_index.maintenance_tick", "action": action, "before": before, "after": after, "result": result}
  776: 
