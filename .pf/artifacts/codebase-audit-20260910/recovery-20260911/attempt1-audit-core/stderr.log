 4574: def specialization_path_candidates(workplace_root: Path | None, specialization_id: str, project_root: Path | None = None) -> list[Path]:
 4575:     normalized_id = validate_resource_id(
 4576:         specialization_resource_id(specialization_id),
 4577:         "specialization",
 4578:     )
 4579:     candidates: list[Path] = []
 4580:     if workplace_root:
 4581:         registry = load_yaml_document(specialization_registry_path(workplace_root))
 4582:         entries = registry.get("specializations") if isinstance(registry, dict) else []
 4583:         if isinstance(entries, list):
 4584:             for entry in entries:
 4585:                 if not isinstance(entry, dict) or str(entry.get("status", "available")) in {"missing", "disabled"}:
 4586:                     continue
 4587:                 entry_id = specialization_resource_id(str(entry.get("id") or ""))
 4588:                 if entry_id == normalized_id:
 4589:                     path = specialization_path_from_registry_entry(workplace_root, entry, workplace_root / "workplace.yaml")
 4590:                     if path:
 4591:                         candidates.append(path)
 4592:         for root in [workplace_root / "specializations", workplace_root / "specializations" / "user", workplace_root / "specializations" / "custom"]:
 4593:             candidates.extend(
 4594:                 [
 4595:                     contained_resource_path(root, root / f"{normalized_id}.yaml", "specialization"),
 4596:                     contained_resource_path(
 4597:                         root,
 4598:                         root / f"{normalized_id.removeprefix('specialization.')}.yaml",
 4599:                         "specialization",
 4600:                     ),
 4601:                 ]
 4602:             )
 4603:     if project_root:
 4604:         flow_root = locate_flow_root(project_root)
 4605:         for root in [flow_root / "specializations", flow_root / "specializations" / "user", flow_root / "specializations" / "custom"]:
 4606:             candidates.extend(
 4607:                 [
 4608:                     contained_resource_path(root, root / f"{normalized_id}.yaml", "specialization"),
 4609:                     contained_resource_path(
 4610:                         root,
 4611:                         root / f"{normalized_id.removeprefix('specialization.')}.yaml",
 4612:                         "specialization",
 4613:                     ),
 4614:                 ]
 4615:             )
 4616:     unique: list[Path] = []
 4617:     seen: set[Path] = set()
 4618:     for path in candidates:
 4619:         resolved = path.resolve()
 4620:         if resolved not in seen:
 4621:             seen.add(resolved)
 4622:             unique.append(resolved)
 4623:     return unique
