  550:     def can_complete(self, *, run_id: str = "", assignment_id: str = "", session_id: str = "") -> dict[str, Any]:
  551:         selected = self._select_work(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  552:         if not selected:
  553:             return {"can_complete": False, "blockers": [{"code": "active_work_not_found"}]}
  554:         run, assignment = selected
  555:         process, pin_status = self._effective_process(run)
  556:         stage_id = str(assignment.get("stage") or "")
  557:         outcomes = normalized_outcomes(process, stage_id)
  558:         final = any(not str(item.get("next_stage") or "") for item in outcomes)
  559:         state = self.state(run_id=str(run.get("id") or ""), assignment_id=str(assignment.get("id") or ""), session_id=session_id)
  560:         blockers = [*list(state.get("blockers") or []), *list(state.get("incomplete") or [])]
  561:         if pin_status != "pinned":
  562:             blockers.append({"code": "process_not_pinned"})
  563:         if not final:
  564:             blockers.append({"code": "not_final_stage", "stage_id": stage_id})
  565:         blockers.extend(self._run_completion_blockers(process, run, assignment))
  566:         return {"can_complete": not blockers, "blockers": blockers, "run": state.get("run"), "assignment": state.get("assignment"), "stage": state.get("stage")}
  567: 
  568:     def complete(self, *, outcome: str = "completed", evidence: Any = None, notes: str = "", run_id: str = "", assignment_id: str = "", session_id: str = "") -> dict[str, Any]:
  569:         selected = self._select_work(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  570:         if selected:
  571:             run, assignment = selected
  572:             pending, _error = self._load_completion_intent(run, assignment)
  573:             if pending is not None:
  574:                 # A committed intent is authoritative.  Do not make a retry
  575:                 # depend on mutable evidence or on the caller repeating the
  576:                 # original outcome/notes.
  577:                 return self.transition(
  578:                     outcome=outcome,
  579:                     evidence=evidence,
  580:                     notes=notes,
  581:                     run_id=run_id,
  582:                     assignment_id=assignment_id,
  583:                     session_id=session_id,
  584:                 )
  585:         readiness = self.can_complete(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  586:         if readiness["blockers"] and not evidence:
  587:             return {"schema_version": 1, "kind": "pf.work.complete", "action": "blocked", **readiness}
  588:         return self.transition(outcome=outcome, evidence=evidence, notes=notes, run_id=run_id, assignment_id=assignment_id, session_id=session_id)
