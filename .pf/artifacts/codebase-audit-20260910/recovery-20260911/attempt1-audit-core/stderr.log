    1: """Shared application service for deterministic PF project initialization.
    2: 
    3: The Core owns request normalization, state classification and the explicit
    4: write acknowledgement. The distribution CLI supplies existing writer and
    5: doctor adapters, so CLI and controlled MCP follow one workflow.
    6: """
    7: 
    8: from __future__ import annotations
    9: 
   10: from dataclasses import dataclass
   11: from pathlib import Path
   12: from typing import Any, Callable
   13: 
   14: 
   15: @dataclass(frozen=True)
   16: class ProjectInitializationError(Exception):
   17:     code: str
   18: 
   19: 
   20: _DETERMINISTIC_ARTIFACTS = (
   21:     "START_AGENT_HERE.md",
   22:     "process-forge.yaml",
   23:     "assignments/first-assignment.yaml",
   24:     "artifacts/project-onboarding-report.md",
   25: )
   26: 
   27: 
   28: def _resource_state(items: Any) -> dict[str, int]:
   29:     count = len(items) if isinstance(items, list) else 0
   30:     return {"required": 0, "recommended": 0, "activated": count, "missing": 0}
   31: 
   32: 
   33: def status(project_root: Path, core: Any, *, workplace: str | None = None) -> dict[str, Any]:
   34:     """Return a non-mutating, public-safe initialization read model."""
   35:     project_root = Path(project_root).expanduser().resolve()
   36:     flow = project_root / ".pf"
   37:     snapshot_path, _snapshot_md = core.project_context_snapshot_paths(project_root)
   38:     context = core.project_context_check_result(project_root, explicit_workplace=workplace) if flow.is_dir() else {"status": "missing"}
   39:     health = context.get("health") if isinstance(context.get("health"), dict) else {}
   40:     snapshot = core.load_yaml_document(snapshot_path) if snapshot_path.is_file() else {}
   41:     resolved = snapshot.get("resolved") if isinstance(snapshot.get("resolved"), dict) else {}
   42:     missing_artifacts = [item for item in _DETERMINISTIC_ARTIFACTS if not (flow / item).is_file()] if flow.is_dir() else list(_DETERMINISTIC_ARTIFACTS)
   43:     codex = dict(core.project_codex_integration_status(project_root)) if hasattr(core, "project_codex_integration_status") else {"status": "unsupported"}
   44:     codex.update({"required": False, "severity": "info", "purpose": "optional_host_telemetry"})
   45:     if not flow.is_dir() or not snapshot_path.is_file():
   46:         state = "incomplete"
   47:     elif str(health.get("status") or "") == "blocked":
   48:         state = "blocked"
   49:     elif str(context.get("status") or "") in {"stale", "broken"} or missing_artifacts:
   50:         state = "repairable"
   51:     else:
   52:         state = "complete"
   53:     workplace_path = Path(workplace).expanduser() if workplace else None
   54:     if workplace_path is None:
   55:         workplace_state = "auto"
   56:     elif not workplace_path.exists():
   57:         workplace_state = "missing"
   58:     elif workplace_path.is_dir() and not (workplace_path / "workplace.yaml").is_file():
   59:         workplace_state = "unreachable"
   60:     else:
   61:         workplace_state = "reachable"
   62:     mcp_rows = resolved.get("activated_mcp") or resolved.get("available_mcp") or []
   63:     repair_plan = []
   64:     if state == "incomplete":
   65:         repair_plan.append("initialize")
   66:     if state == "repairable":
   67:         repair_plan.append("refresh_context")
   68:         if missing_artifacts:
   69:             repair_plan.append("restore_deterministic_artifacts")
   70:     return {"schema_version": 1, "kind": "pf.project_initialization.status", "state": state, "snapshot": {"status": context.get("status"), "health": health.get("status")}, "snapshot_health": health.get("status"), "workplace": workplace_state, "resources": {"knowledge": _resource_state(resolved.get("knowledge_resources")), "tools": _resource_state(resolved.get("tools")), "mcp": _resource_state(mcp_rows), "templates": _resource_state(resolved.get("templates"))}, "mcp": "active_in_snapshot" if mcp_rows else "not_configured", "codex_integration": codex, "missing_deterministic_artifacts": missing_artifacts, "repair_plan": repair_plan or ["none"], "public_safety": "no_private_paths"}
   71: 
   72: 
   73: def apply(action: str, *, apply_requested: Any, execute: Callable[[], dict[str, Any]]) -> dict[str, Any]:
   74:     """Execute a supplied writer only after an exact explicit acknowledgement."""
   75:     if apply_requested is not True:
   76:         raise ProjectInitializationError("apply_required")
   77:     result = execute()
   78:     return {"action": action, "applied": True, "result": result}
   79: 
   80: 
   81: def _initialization_request(request: dict[str, Any], core: Any) -> dict[str, Any]:
   82:     raw_root, raw_workplace = request.get("project_root"), request.get("workplace")
   83:     if not raw_root or not raw_workplace:
   84:         raise ProjectInitializationError("project_root_and_workplace_required")
   85:     project_root = Path(str(raw_root)).expanduser().resolve()
   86:     workplace = Path(str(raw_workplace)).expanduser().resolve()
   87:     if workplace.is_dir():
   88:         workplace = workplace / "workplace.yaml"
   89:     answers_path = request.get("answers_path")
   90:     answers = core.load_answers(Path(str(answers_path)).expanduser().resolve() if answers_path else None)
   91:     supplied_answers = request.get("answers")
   92:     if isinstance(supplied_answers, dict):
   93:         answers.update(supplied_answers)
   94:     project_type = request.get("project_type")
   95:     if project_type:
   96:         project_answers = answers.get("project") if isinstance(answers.get("project"), dict) else {}
   97:         project_answers["type"] = str(project_type)
   98:         answers["project"] = project_answers
   99:     coordination_mode = request.get("coordination_mode")
  100:     if coordination_mode:
  101:         coordination_answers = answers.get("coordination") if isinstance(answers.get("coordination"), dict) else {}
  102:         coordination_answers["mode"] = str(coordination_mode)
  103:         answers["coordination"] = coordination_answers
  104:     platforms = [str(item) for item in request.get("platforms", []) if str(item)] if isinstance(request.get("platforms"), list) else []
  105:     if platforms:
  106:         project_answers = answers.get("project") if isinstance(answers.get("project"), dict) else {}
  107:         project_answers["platforms"] = platforms
  108:         answers["project"] = project_answers
  109:     specializations = [str(item) for item in request.get("specializations", []) if str(item)] if isinstance(request.get("specializations"), list) else []
  110:     if specializations:
  111:         answers["specializations"] = specializations
  112:     process_id = str(request.get("process") or "").strip()
  113:     if process_id:
  114:         answers["process"] = process_id
  115:     return {"project_root": project_root, "workplace": workplace, "answers": answers, "project_type": str(project_type) if project_type else None, "coordination_mode": str(coordination_mode) if coordination_mode else None, "force": bool(request.get("force", False)), "allow_missing_workplace": bool(request.get("allow_missing_workplace", False)), "command": str(request.get("command") or "project-onboard")}
  116: 
