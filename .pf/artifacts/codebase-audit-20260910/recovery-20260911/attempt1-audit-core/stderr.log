20900:     hook_checks = validate_hooks_config(project_root)
20901:     hook_failures = [item for item in hook_checks if item.level == "FAIL"]
20902:     if hook_failures:
20903:         for item in hook_failures:
20904:             print(f"FAIL: {item.message}")
20905:         return 1
20906:     if getattr(args, "send", False):
20907:         raise SystemExit("FAIL: --send is reserved for a future network transport and is disabled in the MVP")
20908:     event = processforge_event(
20909:         project_root,
20910:         args.event_type,
20911:         severity=args.severity,
20912:         session_id=args.session_id,
20913:         assignment_id_value=args.assignment_id,
20914:         payload={"dry_run": bool(args.dry_run), "outbox": bool(args.outbox), "since": args.since, "source": "hooks-dispatch"},
20915:         privacy="sanitized",
20916:     )
20917:     actions = dispatch_hooks(project_root, event, dry_run=args.dry_run, outbox=args.outbox or not args.dry_run)
20918:     if not actions:
20919:         print("HOOKS: none")
20920:     else:
20921:         for action in actions:
20922:             print(f"HOOK: {action['hook']} {action['type']} {action['status']}")
20923:             if "outbox" in action:
20924:                 print(f"OUTBOX: {action['outbox']}")
20925:             if "result" in action:
20926:                 print(f"RESULT: {action['result']}")
20927:     if not args.dry_run:
20928:         append_process_event(project_root, event, dispatch=False)
20929:         if actions:
20930:             emit_process_event(project_root, "hook.dispatched", payload={"event_id": event_id_value(event), "actions": actions}, privacy="sanitized", correlation_id=str(event.get("correlation_id")))
20931:         print(f"EVENT: {event_id_value(event)}")
20932:     return 0
