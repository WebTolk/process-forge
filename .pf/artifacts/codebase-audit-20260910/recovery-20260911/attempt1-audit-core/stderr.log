 4139: def platform_contract_manifest_index(workplace_manifest: Path | None, project_root: Path | None = None) -> dict[str, dict[str, Any]]:
 4140:     index: dict[str, dict[str, Any]] = {}
 4141:     for path in seed_platform_contract_paths(ROOT):
 4142:         record = platform_contract_record(path, "seed")
 4143:         if record:
 4144:             index[record[0]] = record[1]
 4145:     for path in project_platform_contract_paths(project_root):
 4146:         record = platform_contract_record(path, "project")
 4147:         if record:
 4148:             index[record[0]] = record[1]
 4149:     registry = load_workplace_registry(workplace_manifest, "platforms", "platforms.yaml")
 4150:     entries = registry.get("platforms") if isinstance(registry, dict) else None
 4151:     if isinstance(entries, list) and workplace_manifest:
 4152:         for entry in entries:
 4153:             if not isinstance(entry, dict) or str(entry.get("status", "available")) in {"missing", "disabled"}:
 4154:                 continue
 4155:             raw_path = entry.get("path")
 4156:             if not raw_path:
 4157:                 continue
 4158:             path = resolve_registry_relative_path(workplace_manifest.parent, str(raw_path), workplace_manifest)
 4159:             record = platform_contract_record(path, "workplace", entry)
 4160:             if record:
 4161:                 index[record[0]] = record[1]
 4162:     return index
