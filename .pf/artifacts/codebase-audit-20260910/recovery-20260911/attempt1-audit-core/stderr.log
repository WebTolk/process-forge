 1589: def execute_project_codex_integration_repair(project_root: Path) -> dict[str, Any]:
 1590:     result = project_codex_integration_install(project_root)
 1591:     emit_process_event(
 1592:         project_root,
 1593:         "project.codex_hooks.installed",
 1594:         process_id="project-initialization",
 1595:         process_version="1.0.0",
 1596:         payload={
 1597:             "target": result.get("target"),
 1598:             "changed_events": result.get("changed_events", []),
 1599:             "restart_required": result.get("restart_required"),
 1600:         },
 1601:     )
 1602:     return {
 1603:         "status": "complete",
 1604:         "repair_action": "install_codex_hooks",
 1605:         "codex_integration": result,
 1606:         "next_action": "restart_codex_session" if result.get("restart_required") else "continue",
 1607:     }
