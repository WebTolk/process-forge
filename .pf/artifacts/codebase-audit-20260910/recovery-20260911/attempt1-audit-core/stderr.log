 4092: def platform_contract_registry_entry(workplace_manifest: Path | None, contract_id: str) -> dict[str, Any] | None:
 4093:     registry = load_workplace_registry(workplace_manifest, "platforms", "platforms.yaml")
 4094:     entries = registry.get("platforms") if isinstance(registry, dict) else None
 4095:     if not isinstance(entries, list):
 4096:         return None
 4097:     aliases = {contract_id, contract_id.removeprefix("platform.")}
 4098:     for entry in entries:
 4099:         if not isinstance(entry, dict):
 4100:             continue
 4101:         entry_ids = {str(entry.get("id", "")), str(entry.get("package_id", ""))}
 4102:         if aliases.intersection(entry_ids):
 4103:             return entry
 4104:     return None
