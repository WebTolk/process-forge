 3389:                 "refreshed_at": now_utc(),
 3390:                 "source": normalize_path_string(str(snapshot_path)),
 3391:                 "reason": "organized" if effective_mode == "organized" else "open_inbox_or_include_simple",
 3392:             },
 3393:         )
 3394:         refreshed.append(rel(case_path, workplace_root))
 3395:     if args.json:
 3396:         print(json.dumps({"status": "pass", "cases": refreshed}, indent=2, sort_keys=True))
 3397:     else:
