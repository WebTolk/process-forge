 4107: def seed_platform_contract_paths(distribution_root: Path | None = None) -> list[Path]:
 4108:     root = distribution_root or ROOT
 4109:     seed_root = root / "seeds" / "platform-contracts"
 4110:     if not seed_root.is_dir():
 4111:         return []
 4112:     return sorted([*seed_root.glob("*.yaml"), *seed_root.glob("*.yml")])
