 3182:         raise SystemExit(f"FAIL: workplace.yaml missing: {manifest}")
 3183:     data = read_yaml_file(manifest)
 3184:     cfg = workplace_coordination_config(manifest)
 3185:     updater(cfg)
 3186:     data["coordination"] = cfg
 3187:     write_yaml_file(manifest, data)
 3188:     return cfg
