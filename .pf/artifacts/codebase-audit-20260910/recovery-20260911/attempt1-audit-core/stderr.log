 4529: def resource_bucket(data: dict[str, Any] | None, bucket: str, key: str) -> list[str]:
 4530:     if not isinstance(data, dict):
 4531:         return []
 4532:     bucket_data = data.get(bucket) if isinstance(data.get(bucket), dict) else {}
 4533:     return list_value(bucket_data.get(key)) if isinstance(bucket_data, dict) else []
