 1062:     def _build_completion_intent(
 1063:         self,
 1064:         run: dict[str, Any],
 1065:         assignment: dict[str, Any],
 1066:         process: dict[str, Any],
 1067:         *,
 1068:         outcome: str,
 1069:         notes: str,
 1070:         completed_at: str,
 1071:     ) -> dict[str, Any]:
 1072:         """Build every terminal payload before the first terminal write.
 1073: 
 1074:         The journal is deliberately self-contained.  A retry therefore does
 1075:         not re-run evidence selection, call ``now_utc`` again, or infer a new
 1076:         outcome from partially written records.
 1077:         """
 1078:         run_id = str(run["id"])
 1079:         assignment_id = str(assignment["id"])
 1080:         final_assignment = copy.deepcopy(assignment)
 1081:         final_assignment["stage_status"] = "completed"
 1082:         final_assignment["status"] = "done"
 1083:         final_assignment["updated_at"] = completed_at
 1084:         artifacts = [
 1085:             str(item.get("path"))
 1086:             for item in self._accumulated_evidence(final_assignment)
 1087:             if isinstance(item, dict) and item.get("path")
 1088:         ]
 1089:         final_assignment["result"] = {
 1090:             "status": "done",
 1091:             "summary": str(notes or f"Completed declarative process with outcome {outcome}."),
 1092:             "artifacts": sorted(set(artifacts)),
 1093:         }
 1094: 
 1095:         final_run = copy.deepcopy(run)
 1096:         self._set_run_task_status(final_run, assignment_id, "done")
 1097:         final_run["status"] = "completed"
 1098:         final_run["updated_at"] = completed_at
 1099:         summary_path = self._run_path(run_id).parent / "summary.md"
 1100:         handoff_path = self._flow_root() / "handoffs" / "runs" / f"{run_id}-handoff.md"
 1101:         task_index_path = self._run_path(run_id).parent / "task-index.md"
 1102:         projection_path = self._flow_root() / "artifacts" / "projections" / "process-execution-state.json"
 1103:         summary = self._render_summary(final_run, final_assignment)
 1104:         handoff = f"# Run Handoff: {run_id}\n\nStatus: `completed`\n\nSummary: `{self.core.rel(summary_path, self.project_root)}`\n"
 1105:         final_run["final_artifacts"] = [self.core.rel(summary_path, self.project_root), self.core.rel(handoff_path, self.project_root)]
 1106:         emitted = final_run.setdefault("events", {}).setdefault("emitted", []) if isinstance(final_run.setdefault("events", {}), dict) else []
 1107:         for event_type in ["process.stage.completed", "process.stage.transitioned", "task.completed", "assignment.completed", "run.completed", "run.summary.created"]:
 1108:             if isinstance(emitted, list) and event_type not in emitted:
 1109:                 emitted.append(event_type)
 1110:         if hasattr(self.core, "render_task_index"):
 1111:             task_index = self.core.render_task_index(self.project_root, final_run)
 1112:         else:
 1113:             lines = [f"# Task Index: {run_id}", ""]
 1114:             lines.extend(f"- `{item.get('id')}`: `{item.get('status')}`" for item in final_run.get("tasks", []) if isinstance(item, dict))
 1115:             task_index = "\n".join(lines) + "\n"
 1116: 
 1117:         stage_id = str(assignment.get("stage") or "")
 1118:         intent_seed = f"{run_id}:{assignment_id}:{completed_at}:{outcome}"
 1119:         intent_id = "completion-" + hashlib.sha256(intent_seed.encode("utf-8")).hexdigest()[:32]
 1120:         event_specs = []
 1121:         for event_type, event_stage in [
 1122:             ("process.stage.completed", stage_id),
 1123:             ("process.stage.transitioned", stage_id),
 1124:             ("task.completed", stage_id),
 1125:             ("assignment.completed", stage_id),
 1126:             ("run.completed", stage_id),
 1127:             ("run.summary.created", stage_id),
 1128:         ]:
 1129:             event_specs.append(
 1130:                 {
 1131:                     "event_type": event_type,
 1132:                     "event_id": "evt_" + hashlib.sha256(f"{intent_id}:{event_type}".encode("utf-8")).hexdigest()[:32],
 1133:                     "stage_id": event_stage,
 1134:                     "previous_stage_id": stage_id,
 1135:                     "next_stage_id": "",
 1136:                     "outcome": outcome,
 1137:                 }
 1138:             )
 1139:         pin = final_run.get("process_execution") if isinstance(final_run.get("process_execution"), dict) else {}
 1140:         expected_run_path = self.core.rel(self._run_path(run_id), self.project_root)
 1141:         expected_assignment_path = self.core.rel(self._assignment_path(assignment_id), self.project_root)
 1142:         expected_journal_path = self.core.rel(self._completion_intent_path(run_id), self.project_root)
 1143:         intent = {
 1144:             "schema_version": 1,
 1145:             "kind": "pf.process.completion-intent",
 1146:             "intent_id": intent_id,
 1147:             "created_at": completed_at,
 1148:             "completed_at": completed_at,
 1149:             "run_id": run_id,
 1150:             "assignment_id": assignment_id,
 1151:             "journal_path": expected_journal_path,
 1152:             "owner": {
 1153:                 "project_id": self.core.project_id(self.project_root),
 1154:                 "run_path": expected_run_path,
 1155:                 "assignment_path": expected_assignment_path,
 1156:             },
 1157:             "process_execution": copy.deepcopy(pin),
 1158:             "final": {
 1159:                 "run": final_run,
 1160:                 "assignment": final_assignment,
 1161:                 "summary": {"path": self.core.rel(summary_path, self.project_root), "content": summary},
 1162:                 "handoff": {"path": self.core.rel(handoff_path, self.project_root), "content": handoff},
 1163:                 "task_index": {"path": self.core.rel(task_index_path, self.project_root), "content": task_index},
 1164:                 "projection": {"path": self.core.rel(projection_path, self.project_root)},
 1165:                 "events": event_specs,
 1166:             },
 1167:         }
 1168:         intent["fingerprint"] = canonical_fingerprint(intent)
 1169:         return intent
