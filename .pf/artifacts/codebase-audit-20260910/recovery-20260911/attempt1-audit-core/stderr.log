 3461: def list_project_files(project_root: Path) -> list[Path]:
 3462:     if not project_root.exists():
 3463:         return []
 3464:     ignored_dirs = {".git", ".idea", ".serena", "__pycache__", "runtime", "cache"}
 3465:     files: list[Path] = []
 3466:     for path in project_root.rglob("*"):
 3467:         if any(part in ignored_dirs for part in path.relative_to(project_root).parts):
 3468:             continue
 3469:         if path.is_file():
 3470:             files.append(path)
 3471:     return sorted(files, key=lambda item: item.relative_to(project_root).as_posix())
 3472: 
