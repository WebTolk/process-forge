23899: def emit_package_root_resolution_event(workplace_root: Path, command: str, package_id: str, package_root: PackageRootResolution) -> None:
23900:     has_unavailable = any("path does not exist" in warning or "cannot" in warning for warning in package_root.warnings)
23901:     append_workplace_resource_event(
23902:         workplace_root,
23903:         resource_management_event(
23904:             scope="workplace",
23905:             command=command,
23906:             event_type="package.root.unavailable" if has_unavailable else "package.root.resolved",
23907:             target={"package_id": package_id, "package_root": package_root.root_id},
23908:             status="warn" if has_unavailable or package_root.fallback else "resolved",
23909:             message="; ".join(package_root.warnings) if package_root.warnings else "package root resolved",
23910:         ),
23911:     )
