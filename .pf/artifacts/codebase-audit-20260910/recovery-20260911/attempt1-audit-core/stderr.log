 2546: def render_workplace_setup_proposal(session_id: str, answers: dict[str, Any]) -> tuple[dict[str, Any], str]:
 2547:     machine = answers.get("machine_layout") if isinstance(answers.get("machine_layout"), dict) else {}
 2548:     agents = answers.get("agent_environment") if isinstance(answers.get("agent_environment"), dict) else {}
 2549:     discovery = answers.get("device_discovery") if isinstance(answers.get("device_discovery"), dict) else {}
 2550:     resources = answers.get("resources") if isinstance(answers.get("resources"), dict) else {}
 2551:     first_project = answers.get("first_project") if isinstance(answers.get("first_project"), dict) else {}
 2552:     coordination = answers.get("coordination") if isinstance(answers.get("coordination"), dict) else {}
 2553:     proposal = {
 2554:         "schema_version": 1,
 2555:         "session_id": safe_id(session_id, "setup-session"),
 2556:         "status": "ready_for_review",
 2557:         "workplace": {"path_ref": str(machine.get("workplace_path") or "${PF_WORKPLACE}")},
 2558:         "processforge": {"root_ref": str(machine.get("processforge_root") or "${PROCESSFORGE_ROOT}")},
 2559:         "local_docs": {"path_ref": str(machine.get("local_docs_path") or "${PF_WORKPLACE}/knowledge")},
