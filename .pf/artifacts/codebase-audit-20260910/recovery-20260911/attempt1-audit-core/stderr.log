22707: def fetch_update_manifest(source: dict[str, Any], workplace_root: Path) -> tuple[dict[str, Any], list[str]]:
22708:     warnings: list[str] = []
22709:     location = update_location(source, "provider")
22710:     if not location:
22711:         return {}, ["missing manifest_url"]
22712:     parsed = urlparse(location)
22713:     scheme = parsed.scheme.lower()
22714:     if scheme == "file" or not scheme:
22715:         path = file_url_to_path(location, workplace_root)
22716:         data = load_yaml_or_json_document(path)
22717:         if not data:
22718:             return {}, [f"manifest not found or invalid: {path}"]
22719:         return data, warnings
22720:     if scheme in {"http", "https"}:
22721:         try:
22722:             with urlopen(location, timeout=15) as response:
22723:                 text = response.read().decode("utf-8")
22724:         except Exception as exc:
22725:             return {}, [f"manifest fetch failed: {exc}"]
22726:         data = load_yaml_or_json_text(text)
22727:         if not data:
22728:             return {}, [f"manifest response invalid: {location}"]
22729:         return data, warnings
22730:     return {}, [f"manifest_url scheme is unsupported: {scheme}"]
22731: 
22732: 
22733: def semantic_version_key(value: str) -> tuple[int, tuple[int, ...] | str]:
22734:     text = value.strip()
22735:     match = re.fullmatch(r"v?(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:[-+][A-Za-z0-9.-]+)?", text)
22736:     if not match:
22737:         return (1, text)
22738:     parts = tuple(int(part) for part in match.groups(default="0"))
22739:     return (0, parts)
22740: 
22741: 
22742: def version_is_newer(available: str, installed: str | None) -> tuple[bool, str | None]:
22743:     if not installed:
22744:         return True, None
22745:     available_key = semantic_version_key(available)
22746:     installed_key = semantic_version_key(installed)
22747:     warning = None
22748:     if available_key[0] or installed_key[0]:
22749:         warning = "non-semver version compared lexically"
22750:         return str(available) > str(installed), warning
22751:     return available_key[1] > installed_key[1], warning
22752: 
