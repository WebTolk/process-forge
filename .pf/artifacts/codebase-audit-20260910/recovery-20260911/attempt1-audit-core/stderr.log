    1: from __future__ import annotations
    2: 
    3: import re
    4: from pathlib import Path
    5: from typing import Any
    6: 
    7: 
    8: def _parse_scalar(value: str) -> Any:
    9:     value = value.strip()
   10:     if not value:
   11:         return ""
   12:     if value in {"true", "True"}:
   13:         return True
   14:     if value in {"false", "False"}:
   15:         return False
   16:     if value in {"null", "Null", "NULL", "~"}:
   17:         return None
   18:     if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
   19:         return value[1:-1]
   20:     if re.fullmatch(r"-?\d+", value):
   21:         try:
   22:             return int(value)
   23:         except ValueError:
   24:             return value
   25:     return value
   26: 
   27: 
   28: def _parse_simple_yaml(text: str) -> dict[str, Any]:
   29:     root: dict[str, Any] = {}
   30:     stack: list[tuple[int, dict[str, Any]]] = [(-1, root)]
   31:     for raw_line in text.splitlines():
   32:         line = raw_line.split("#", 1)[0].rstrip()
   33:         if not line.strip():
   34:             continue
   35:         indent = len(line) - len(line.lstrip(" "))
   36:         stripped = line.strip()
   37:         if stripped.startswith("- "):
   38:             continue
   39:         if ":" not in stripped:
   40:             continue
   41:         key, value = stripped.split(":", 1)
   42:         key = key.strip()
   43:         while stack and indent <= stack[-1][0]:
   44:             stack.pop()
   45:         parent = stack[-1][1] if stack else root
   46:         if value.strip() == "":
   47:             child: dict[str, Any] = {}
   48:             parent[key] = child
   49:             stack.append((indent, child))
   50:         else:
   51:             parent[key] = _parse_scalar(value)
   52:     return root
   53: 
   54: 
   55: def load_yaml_document(path: Path) -> dict[str, Any]:
   56:     if not path.is_file():
   57:         return {}
   58:     text = path.read_text(encoding="utf-8", errors="replace")
   59:     try:
   60:         import yaml  # type: ignore
   61: 
   62:         data = yaml.safe_load(text)
   63:         return data if isinstance(data, dict) else {}
   64:     except ModuleNotFoundError:
   65:         return _parse_simple_yaml(text)
   66:     except Exception as exc:
   67:         return {"__yaml_error__": f"{exc.__class__.__name__}: {exc}"}
   68: 
   69: 
   70: def yaml_error(data: Any) -> str | None:
   71:     if isinstance(data, dict) and isinstance(data.get("__yaml_error__"), str):
   72:         return str(data["__yaml_error__"])
   73:     return None
   74: 
   75: 
   76: def read_yaml_file(path: Path) -> dict[str, Any]:
   77:     data = load_yaml_document(path)
   78:     error = yaml_error(data)
   79:     if error:
   80:         raise SystemExit(f"FAIL: {path} is invalid YAML: {error}")
   81:     return data

