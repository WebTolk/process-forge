  155: def _stable_json(value: Any) -> str:
  156:     return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
  157: 
  158: 
  159: def _policy_hash(policy: dict[str, Any]) -> str:
  160:     return hashlib.sha256(_stable_json(policy).encode("utf-8")).hexdigest()
  161: 
