   59: @dataclass(frozen=True)
   60: class ResourceSearchIndex:
   61:     """Stateful application service for the workplace local resource index.
   62: 
   63:     A project snapshot may be supplied for backward-compatible scoped
   64:     maintenance and for query authorization.  A workplace maintenance snapshot
   65:     uses ``search_index_scope: workplace`` and owns the one physical index.
   66:     """
   67: 
   68:     project_root: Path
   69:     snapshot: dict[str, Any] | None = None
   70:     workplace_root: Path | None = None
   71: 
   72:     def status(self, *, verify_files: bool = False) -> dict[str, Any]:
   73:         return index_status(self.project_root, self.snapshot, workplace_root=self.workplace_root, verify_files=verify_files)
   74: 
   75:     def refresh(self) -> dict[str, Any]:
   76:         if self.snapshot is None:
   77:             raise LocalSearchError("snapshot_required")
   78:         return build_index(self.project_root, self.snapshot, workplace_root=self.workplace_root)
   79: 
   80:     def rebuild(self) -> dict[str, Any]:
   81:         if self.snapshot is None:
   82:             raise LocalSearchError("snapshot_required")
   83:         return rebuild_index(self.project_root, self.snapshot, workplace_root=self.workplace_root)
   84: 
   85:     def mark_dirty(self, *, reason: str = "dirty") -> dict[str, Any]:
   86:         return mark_index_dirty(self.project_root, self.snapshot, workplace_root=self.workplace_root, reason=reason)
   87: 
   88:     def maintenance_tick(self, *, verify_files: bool = True) -> dict[str, Any]:
   89:         if self.snapshot is None:
   90:             raise LocalSearchError("snapshot_required")
   91:         return maintenance_tick(self.project_root, self.snapshot, workplace_root=self.workplace_root, verify_files=verify_files)
   92: 
   93:     def search(self, *, query: Any, limit: Any = None, limitstart: Any = None, offset: Any = None) -> dict[str, Any]:
   94:         if self.snapshot is None:
   95:             raise LocalSearchError("snapshot_required")
   96:         return search(
   97:             self.project_root,
   98:             self.snapshot,
   99:             query=query,
  100:             limit=limit,
  101:             limitstart=limitstart,
  102:             offset=offset,
  103:             workplace_root=self.workplace_root,
  104:         )
