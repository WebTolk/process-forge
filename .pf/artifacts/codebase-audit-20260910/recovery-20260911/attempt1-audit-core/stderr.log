21759: def load_doctor_yaml(
21760:     path: Path,
21761:     schema_name: str,
21762:     label: str,
21763:     checks: list[Check],
21764: ) -> dict[str, Any] | None:
21765:     """Load and schema-check a governed YAML document without mutating it."""
21766:     data = load_yaml_document(path)
21767:     error = yaml_error(data)
21768:     if error:
21769:         checks.append(check("FAIL", f"{label} YAML parse failed: {error}"))
21770:         return None
21771:     if not isinstance(data, dict) or not data:
21772:         checks.append(check("FAIL", f"{label} must be a non-empty YAML object"))
21773:         return None
21774:     checks.append(check("PASS", f"{label} is valid YAML"))
21775:     append_json_schema_checks(checks, data, schema_name, label)
21776:     return data
