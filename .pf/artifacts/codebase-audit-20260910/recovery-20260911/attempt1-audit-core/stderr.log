 1452: def write_file(path: Path, content: str, *, force: bool = False) -> WriteResult:
 1453:     content = ensure_trailing_newline(content)
 1454:     path.parent.mkdir(parents=True, exist_ok=True)
 1455:     if path.exists():
 1456:         existing = path.read_text(encoding="utf-8", errors="replace")
 1457:         if existing == content:
 1458:             return WriteResult(path, "unchanged", path)
 1459:         if not force:
 1460:             candidate = path.with_name(path.name + ".candidate")
 1461:             candidate.write_text(content, encoding="utf-8")
 1462:             return WriteResult(path, "candidate", candidate)
 1463:     path.write_text(content, encoding="utf-8")
 1464:     return WriteResult(path, "written", path)
 1465: 
 1466: 
 1467: def append_gitignore_entries(path: Path, entries: list[str], *, force: bool = False) -> WriteResult:
 1468:     existing = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
 1469:     lines = existing.splitlines()
 1470:     changed = False
 1471:     for entry in entries:
 1472:         if entry not in lines:
 1473:             lines.append(entry)
 1474:             changed = True
 1475:     if not changed:
 1476:         return WriteResult(path, "unchanged", path)
 1477:     content = "\n".join(lines).rstrip() + "\n"
 1478:     if path.exists() and existing and not force:
 1479:         candidate = path.with_name(path.name + ".candidate")
 1480:         candidate.write_text(content, encoding="utf-8")
 1481:         return WriteResult(path, "candidate", candidate)
 1482:     path.write_text(content, encoding="utf-8")
 1483:     return WriteResult(path, "written", path)
 1484: 
