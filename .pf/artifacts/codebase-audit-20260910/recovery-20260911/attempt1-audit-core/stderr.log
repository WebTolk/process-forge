 4215: def platform_refs_from(value: Any, *, default_required: bool = True) -> list[dict[str, Any]]:
 4216:     values = value if isinstance(value, list) else ([value] if value else [])
 4217:     refs: list[dict[str, Any]] = []
 4218:     for item in values:
 4219:         ref = normalize_platform_ref(item, default_required=default_required)
 4220:         if ref:
 4221:             refs.append(ref)
 4222:     return refs
