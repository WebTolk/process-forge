24859: def command_template_add(args: argparse.Namespace) -> int:
24860:     workplace_root = Path(args.workplace).expanduser().resolve()
24861:     template_id = safe_id(args.id, "template")
24862:     source = Path(args.source).expanduser().resolve()
24863:     target_root = path_resolution_to_path(workplace_path_resolution(workplace_root, f"${{PF_TEMPLATES}}/{args.type}/{template_id}"))
24864:     slug, proposal_path = write_resource_proposal(
24865:         workplace_root,
24866:         "template-add",
24867:         template_id,
24868:         {"template_id": template_id, "source": str(source), "target": rel(target_root, workplace_root)},
24869:     )
24870:     append_workplace_resource_event(
24871:         workplace_root,
24872:         resource_management_event(
24873:             scope="workplace",
24874:             command="template-add",
24875:             event_type="template.add.requested",
24876:             target={"template_id": template_id},
24877:             status="dry_run" if args.dry_run else "requested",
24878:             message="template add proposal created",
24879:         ),
24880:     )
24881:     if args.dry_run or args.apply is not True:
24882:         print(f"PROPOSAL: {rel(proposal_path, workplace_root)}")
24883:         return 0
24884:     if not source.is_dir():
24885:         raise SystemExit(f"FAIL: template source folder not found: {source}")
24886:     target_root.mkdir(parents=True, exist_ok=True)
24887:     for item in source.rglob("*"):
24888:         if item.is_file():
24889:             relative = item.relative_to(source)
24890:             destination = target_root / relative
24891:             destination.parent.mkdir(parents=True, exist_ok=True)
24892:             shutil.copy2(item, destination)
24893:     readme = target_root / "README.md"
24894:     if not readme.is_file():
24895:         readme.write_text(
24896:             ensure_trailing_newline(
24897:                 f"# {template_id}\n\nUse this {args.type} template when the current package or platform contract selects it.\n\n## Placeholders\n\nDocument placeholders before production use.\n\n## Verification\n\nReview generated files before applying them to a project."
24898:             ),
24899:             encoding="utf-8",
24900:         )
24901:     append_workplace_resource_event(
24902:         workplace_root,
24903:         resource_management_event(
24904:             scope="workplace",
24905:             command="template-add",
24906:             event_type="template.added",
24907:             target={"template_id": template_id},
24908:             status="added",
24909:             message="template payload copied",
24910:         ),
24911:     )
24912:     print(f"TEMPLATE: {rel(target_root, workplace_root)}")
24913:     return 0
