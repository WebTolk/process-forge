 1089: def safe_id(value: str, default: str = "project") -> str:
 1090:     cleaned = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
 1091:     return cleaned or default
 1092: 
 1093: 
 1094: def rel(path: Path, root: Path) -> str:
 1095:     try:
 1096:         return path.relative_to(root).as_posix()
 1097:     except ValueError:
 1098:         return path.as_posix()
 1099: 
 1100: 
 1101: def path_is_relative_to(path: Path, root: Path) -> bool:
 1102:     try:
 1103:         path.resolve().relative_to(root.resolve())
 1104:         return True
 1105:     except ValueError:
 1106:         return False
 1107: 
 1108: 
 1109: RESOURCE_ID_PATTERN = re.compile(r"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$")
 1110: WINDOWS_RESERVED_DEVICE_BASENAMES = {
 1111:     "con",
 1112:     "prn",
 1113:     "aux",
 1114:     "nul",
 1115:     *{f"com{index}" for index in range(1, 10)},
 1116:     *{f"lpt{index}" for index in range(1, 10)},
 1117: }
 1118: 
 1119: 
 1120: def validate_resource_id(raw: str, resource_kind: str = "resource") -> str:
 1121:     value = str(raw)
 1122:     invalid_reason = ""
 1123:     if not value:
 1124:         invalid_reason = "must not be empty"
 1125:     elif value != value.strip() or any(ord(char) < 32 or ord(char) == 127 for char in value):
 1126:         invalid_reason = "must not contain whitespace or control characters"
 1127:     elif "%" in value:
 1128:         invalid_reason = "must not contain percent-encoded path characters"
 1129:     elif "/" in value or "\\" in value:
 1130:         invalid_reason = "must not contain path separators"
 1131:     elif ":" in value or re.match(r"^[a-zA-Z]:", value):
 1132:         invalid_reason = "must not contain drive, URI, or alternate-stream syntax"
 1133:     elif value.endswith((".", " ")):
 1134:         invalid_reason = "must not end with a Windows-trimmed dot or space"
 1135:     elif any(segment in {"", ".", ".."} for segment in value.split(".")):
 1136:         invalid_reason = "must not contain empty or relative dot segments"
 1137:     elif value.split(".", 1)[0] in WINDOWS_RESERVED_DEVICE_BASENAMES:
 1138:         invalid_reason = "must not use a Windows reserved device basename"
 1139:     elif not RESOURCE_ID_PATTERN.fullmatch(value):
 1140:         invalid_reason = "must match ^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
 1141:     if invalid_reason:
 1142:         raise SystemExit(f"FAIL: invalid {resource_kind} id {value!r}: {invalid_reason}")
 1143:     return value
