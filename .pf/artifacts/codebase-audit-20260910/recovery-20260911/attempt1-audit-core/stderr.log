  685:     def _next_work_advisory(self, process: dict[str, Any], run: dict[str, Any]) -> dict[str, Any]:
  686:         pin = run.get("process_execution") if isinstance(run.get("process_execution"), dict) else {}
  687:         current = str(run.get("process") or "")
  688:         available = [item for item in _stable_ids(pin.get("allowed_processes")) if item != current]
  689:         declared = process.get("process_transitions") if isinstance(process.get("process_transitions"), list) else []
  690:         routed = [str(item.get("to_process") or item.get("target_process") or "") for item in declared if isinstance(item, dict)]
  691:         route_path = self._flow_root() / "process-routes.yaml"
  692:         routes = self.core.load_yaml_document(route_path).get("routes", []) if route_path.exists() else []
  693:         routed.extend(
  694:             str(item.get("to_process") or item.get("target_process") or "")
  695:             for item in routes
  696:             if isinstance(item, dict) and str(item.get("from_process") or "") == current
  697:         )
  698:         recommended = next((item for item in routed if item in available), "")
  699:         next_work: dict[str, Any] = {"available_processes": available}
  700:         if recommended:
  701:             next_work["recommended_process"] = recommended
  702:         result: dict[str, Any] = {"next": next_work, "session_continuity": {"recommendation": "auto", "reason": "process_boundary"}}
  703:         handoff = next((str(path) for path in _stable_ids(run.get("final_artifacts")) if path.endswith("-handoff.md")), "")
  704:         if handoff:
  705:             result["handoff"] = {"path": handoff}
  706:         return result
  707: 
  708:     def _effective_process(self, run: dict[str, Any]) -> tuple[dict[str, Any], str]:
  709:         pin = run.get("process_execution") if isinstance(run.get("process_execution"), dict) else {}
  710:         definition = pin.get("definition") if isinstance(pin.get("definition"), dict) else None
  711:         if definition is not None and str(pin.get("process_fingerprint") or "") == canonical_fingerprint(definition):
  712:             return copy.deepcopy(definition), "pinned"
  713:         if pin:
  714:             return copy.deepcopy(definition) if isinstance(definition, dict) else {"id": str(run.get("process") or ""), "stages": []}, "corrupt"
  715:         try:
  716:             resolved = self.core.resolve_process_definition(self.project_root, str(run.get("process") or ""))
  717:             return copy.deepcopy(resolved.process), "legacy_unpinned"
  718:         except (OSError, SystemExit, ValueError):
  719:             return {"id": str(run.get("process") or ""), "stages": []}, "missing"
  720: 
  721:     def _stage(self, process: dict[str, Any], stage_id: str) -> dict[str, Any]:
  722:         return next((stage for stage in executable_stages(process) if str(stage.get("id")) == stage_id), {"id": stage_id})
  723: 
  724:     def _select_work(self, *, run_id: str = "", assignment_id: str = "", session_id: str = "") -> tuple[dict[str, Any], dict[str, Any]] | None:
  725:         records = self._work_records(include_historical=True)
  726:         if assignment_id:
  727:             record = next((item for item in records if item["assignment_id"] == assignment_id), None)
  728:         elif run_id:
  729:             candidates = [item for item in records if item["run_id"] == run_id]
  730:             record = self._preferred_record(candidates, session_id)
  731:         else:
  732:             active = [item for item in records if item["active"]]
  733:             record = self._preferred_record(active, session_id)
  734:         if not record:
  735:             return None
  736:         return self._load_run(record["run_id"]), self._load_assignment(record["assignment_id"])
  737: 
  738:     def _preferred_record(self, records: list[dict[str, Any]], session_id: str) -> dict[str, Any] | None:
  739:         if session_id:
  740:             bound = [item for item in records if item.get("session_id") == session_id]
  741:             if bound:
  742:                 records = bound
  743:         return max(records, key=lambda item: (item.get("updated_at", ""), item.get("created_at", ""), item.get("assignment_id", ""))) if records else None
  744: 
  745:     def _work_records(self, *, include_historical: bool) -> list[dict[str, Any]]:
  746:         records: list[dict[str, Any]] = []
  747:         runs_root = self._flow_root() / "runs"
  748:         for path in sorted(runs_root.glob("*/run.yaml")) if runs_root.is_dir() else []:
  749:             run = self.core.load_yaml_document(path)
  750:             run_id = str(run.get("id") or path.parent.name)
  751:             if not SAFE_ID_RE.fullmatch(run_id):
  752:                 continue
  753:             for entry in run.get("tasks", []) if isinstance(run.get("tasks"), list) else []:
  754:                 if not isinstance(entry, dict) or not entry.get("id"):
  755:                     continue
  756:                 entry_id = str(entry["id"])
  757:                 if not SAFE_ID_RE.fullmatch(entry_id):
  758:                     continue
  759:                 task = self.core.load_yaml_document(self._assignment_path(entry_id))
  760:                 if not task:
  761:                     continue
  762:                 task_id = str(task.get("id") or entry_id)
  763:                 if not SAFE_ID_RE.fullmatch(task_id) or str(task.get("run_id") or run_id) != run_id:
  764:                     continue
  765:                 status = str(task.get("status") or entry.get("status") or "")
  766:                 pending_completion, _intent_error = self._load_completion_intent(run, task)
  767:                 has_pending_completion = pending_completion is not None
  768:                 active = has_pending_completion or (status in ACTIVE_ASSIGNMENT_STATUSES and str(run.get("status") or "") in ACTIVE_RUN_STATUSES)
  769:                 if not active and not include_historical:
  770:                     continue
  771:                 session = task.get("session") if isinstance(task.get("session"), dict) else {}
  772:                 records.append(
  773:                     {
  774:                         "run_id": run_id,
  775:                         "assignment_id": task_id,
  776:                         "objective": str(task.get("objective") or run.get("objective") or ""),
  777:                         "status": status,
  778:                         "run_status": str(run.get("status") or ""),
  779:                         "stage": str(task.get("stage") or ""),
  780:                         "active": active,
  781:                         "session_id": str(session.get("id") or ""),
  782:                         "created_at": str(task.get("created_at") or run.get("created_at") or ""),
  783:                         "updated_at": str(task.get("updated_at") or run.get("updated_at") or ""),
  784:                         "pending_completion": has_pending_completion,
  785:                     }
  786:                 )
  787:         return records
  788: 
  789:     def _find_by_objective(self, objective: str) -> dict[str, Any]:
  790:         normalized = " ".join(objective.casefold().split())
  791:         matches = [item for item in self._work_records(include_historical=True) if " ".join(item["objective"].casefold().split()) == normalized]
  792:         active = self._preferred_record([item for item in matches if item["active"]], "")
  793:         historical = [item for item in matches if not item["active"]]
  794:         return {"active": active, "historical": historical}
  795: 
  796:     def _current_evidence(self, assignment: dict[str, Any]) -> list[dict[str, Any]]:
  797:         execution = assignment.get("stage_execution") if isinstance(assignment.get("stage_execution"), dict) else {}
  798:         return [copy.deepcopy(item) for item in execution.get("evidence", []) if isinstance(item, dict)] if isinstance(execution.get("evidence"), list) else []
  799: 
  800:     def _accumulated_evidence(self, assignment: dict[str, Any]) -> list[dict[str, Any]]:
  801:         evidence: list[dict[str, Any]] = []
  802:         history = assignment.get("stage_history") if isinstance(assignment.get("stage_history"), list) else []
  803:         for record in history:
  804:             if isinstance(record, dict) and isinstance(record.get("evidence"), list):
  805:                 evidence.extend(copy.deepcopy(item) for item in record["evidence"] if isinstance(item, dict))
  806:         evidence.extend(self._current_evidence(assignment))
  807:         return evidence
  808: 
  809:     def _required_artifact_ids(self, process: dict[str, Any], stage: dict[str, Any]) -> list[str]:
  810:         declared = self._string_list(stage.get("required_artifacts"))
  811:         if declared:
  812:             return declared
  813:         definitions = process.get("artifact_definitions") if isinstance(process.get("artifact_definitions"), list) else []
  814:         optional = {str(item.get("id")) for item in definitions if isinstance(item, dict) and item.get("required") is False}
  815:         consumed_inputs = {
  816:             artifact_id
  817:             for candidate in executable_stages(process)
  818:             for artifact_id in self._string_list(candidate.get("required_inputs"))
  819:         }
  820:         return [item for item in self._string_list(stage.get("produced_artifacts")) if item not in optional or item in consumed_inputs]
  821: 
  822:     def _requirement_state(self, kind: str, identifier: str, evidence: list[dict[str, Any]]) -> dict[str, Any]:
  823:         aliases = {"artifact": ("artifact_id", "id"), "input": ("input_id", "artifact_id", "id"), "evidence": ("evidence_id", "id")}
  824:         accepted_kinds = {"artifact": {"artifact"}, "input": {"input", "artifact"}, "evidence": {"evidence", "attestation"}}
  825:         statuses = {"ready", "present", "passed", "approved", "not_applicable"}
  826:         match = next(
  827:             (
  828:                 item
  829:                 for item in reversed(evidence)
  830:                 if str(item.get("kind") or "") in accepted_kinds[kind]
  831:                 and any(str(item.get(key) or "") == identifier for key in aliases[kind])
  832:             ),
  833:             None,
  834:         )
  835:         if match is None:
  836:             return {"id": identifier, "kind": kind, "satisfied": False, "evidence": {}}
  837:         diagnostic = self._evidence_file_diagnostic(match)
  838:         status = str(match.get("status") or "")
  839:         if diagnostic is None and status not in statuses:
  840:             diagnostic = {"code": "evidence_status_not_acceptable", "status": status or "missing", "id": identifier}
  841:         result = {"id": identifier, "kind": kind, "satisfied": diagnostic is None, "evidence": copy.deepcopy(match)}
  842:         if diagnostic is not None:
  843:             result["diagnostic"] = diagnostic
  844:         return result
  845: 
  846:     def _gate_state(self, process: dict[str, Any], gate_id: str, evidence: list[dict[str, Any]], *, phase: str) -> dict[str, Any]:
  847:         definitions = process.get("gates") if isinstance(process.get("gates"), list) else []
  848:         definition = next((item for item in definitions if isinstance(item, dict) and str(item.get("id") or "") == gate_id), {})
  849:         match = next(
  850:             (
  851:                 item
  852:                 for item in reversed(evidence)
  853:                 if str(item.get("kind") or "") == "gate"
  854:                 and str(item.get("gate_id") or item.get("id") or "") == gate_id
  855:             ),
  856:             None,
  857:         )
  858:         diagnostic = self._evidence_file_diagnostic(match) if match is not None else None
  859:         if diagnostic is None and match is not None and str(match.get("status") or "") not in {"passed", "approved", "not_applicable"}:
  860:             diagnostic = {"code": "evidence_status_not_acceptable", "status": str(match.get("status") or "missing"), "id": gate_id}
  861:         result = {
  862:             "id": gate_id,
  863:             "phase": phase,
  864:             "type": str(definition.get("type") or "checklist"),
  865:             "blocking": bool(definition.get("blocking", True)),
  866:             "required": bool(definition.get("required", True)),
  867:             "satisfied": match is not None and diagnostic is None,
  868:             "evidence": copy.deepcopy(match) if match is not None else {},
  869:         }
  870:         if diagnostic is not None:
  871:             result["diagnostic"] = diagnostic
  872:         return result
  873: 
  874:     def _automation_states(self, process: dict[str, Any], stage: dict[str, Any], assignment: dict[str, Any]) -> list[dict[str, Any]]:
  875:         bindings = stage.get("automation_bindings") if isinstance(stage.get("automation_bindings"), list) else []
  876:         if not bindings and isinstance(stage.get("technical_obligations"), list):
  877:             bindings = stage["technical_obligations"]
  878:         states: list[dict[str, Any]] = []
  879:         for binding in bindings:
  880:             if not isinstance(binding, dict):
  881:                 continue
  882:             projector = str(binding.get("projector") or "")
  883:             status = "unsupported"
  884:             details: dict[str, Any] = {}
  885:             if projector == "required-output-readiness" and hasattr(self.core, "required_output_checks"):
  886:                 failures = [item.message for item in self.core.required_output_checks(self.project_root, assignment) if str(getattr(item, "level", "")) == "FAIL"]
  887:                 status = "ready" if not failures else "blocked"
  888:                 details["failures"] = failures
  889:             elif projector == "verification-state":
  890:                 verification = binding.get("verification") if isinstance(binding.get("verification"), dict) else {}
  891:                 passed_event = str(verification.get("passed_event") or "")
  892:                 failed_event = str(verification.get("failed_event") or "")
  893:                 event = self._latest_assignment_event(str(assignment.get("id") or ""), {passed_event, failed_event})
  894:                 event_type = str(event.get("event_type") or "") if event else ""
  895:                 status = "ready" if event_type == passed_event else ("blocked" if event_type == failed_event else "missing")
  896:                 if status == "ready" and hasattr(self.core, "task_verification_fingerprint"):
  897:                     event_data = event.get("data") if isinstance(event.get("data"), dict) else {}
  898:                     if str(event_data.get("verification_fingerprint") or "") != self.core.task_verification_fingerprint(self.project_root, assignment):
  899:                         status = "stale"
  900:                 details["event_type"] = event_type
  901:             states.append({"id": str(binding.get("id") or projector or "obligation"), "projector": projector, "gate": str(binding.get("gate") or ""), "status": status, **details})
  902:         return states
  903: 
  904:     def _stage_requirements(self, inputs: list[dict[str, Any]], artifacts: list[dict[str, Any]], required_evidence: list[dict[str, Any]], gates: list[dict[str, Any]], obligations: list[dict[str, Any]]) -> list[dict[str, Any]]:
  905:         requirements: list[dict[str, Any]] = []
  906:         requirements.extend(self._requirement_blocker("required_input_missing", "input_id", item) for item in inputs if not item["satisfied"])
  907:         requirements.extend(self._requirement_blocker("artifact_evidence_missing", "artifact_id", item) for item in artifacts if not item["satisfied"])
  908:         requirements.extend(self._requirement_blocker("required_evidence_missing", "evidence_id", item) for item in required_evidence if not item["satisfied"])
  909:         requirements.extend(self._requirement_blocker("gate_evidence_missing", "gate_id", item) for item in gates if item["required"] and item["blocking"] and not item["satisfied"])
  910:         requirements.extend({"code": "automation_not_ready", "obligation_id": item["id"], "status": item["status"]} for item in obligations if item["status"] != "ready")
  911:         return requirements
  912: 
  913:     def _requirement_blocker(self, code: str, identifier_key: str, requirement: dict[str, Any]) -> dict[str, Any]:
  914:         blocker = {"code": code, identifier_key: requirement["id"]}
  915:         diagnostic = requirement.get("diagnostic")
  916:         if isinstance(diagnostic, dict):
  917:             blocker["diagnostic"] = copy.deepcopy(diagnostic)
  918:         return blocker
  919: 
  920:     def _normalize_evidence(self, evidence: Any) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
  921:         values = evidence if isinstance(evidence, list) else ([] if evidence is None or evidence == "" else [evidence])
  922:         normalized: list[dict[str, Any]] = []
  923:         blockers: list[dict[str, Any]] = []
  924:         now = self.core.now_utc()
  925:         for index, value in enumerate(values):
  926:             if isinstance(value, str):
  927:                 item = {"kind": "attestation", "id": f"attestation-{index + 1}", "status": "ready", "summary": value}
  928:             elif isinstance(value, dict):
  929:                 item = copy.deepcopy(value)
  930:             else:
  931:                 blockers.append({"code": "invalid_evidence", "index": index})
  932:                 continue
  933:             item.setdefault("kind", "attestation")
  934:             item.setdefault("status", "ready")
  935:             item["recorded_at"] = now
  936:             if str(item.get("status") or "") == "not_applicable":
  937:                 reason = str(item.get("reason") or "").strip()
  938:                 supporting = item.get("evidence")
  939:                 if not reason or not isinstance(supporting, list) or not supporting:
  940:                     blockers.append({"code": "not_applicable_evidence_incomplete", "index": index})
  941:                     continue
  942:             path_value = str(item.get("path") or "").strip()
  943:             if path_value:
  944:                 safe_path = self._safe_evidence_path(path_value)
  945:                 try:
  946:                     valid_file = safe_path is not None and safe_path.is_file()
  947:                 except OSError:
  948:                     valid_file = False
  949:                 if not valid_file:
  950:                     blockers.append({"code": "artifact_path_missing", "index": index, "path": path_value})
  951:                     continue
  952:                 else:
  953:                     try:
  954:                         item["path"] = self.core.rel(safe_path, self.project_root)
  955:                         item["sha256"] = "sha256:" + self._sha256_file(safe_path)
  956:                     except OSError:
  957:                         blockers.append({"code": "artifact_path_unreadable", "index": index, "path": path_value})
  958:                         continue
  959:             normalized.append(item)
  960:         return normalized, blockers
  961: 
  962:     def _safe_evidence_path(self, value: str) -> Path | None:
  963:         try:
  964:             path = Path(value)
  965:             if path.is_absolute():
  966:                 return None
  967:             resolved = (self.project_root / path).resolve()
  968:         except (OSError, RuntimeError, ValueError):
  969:             return None
  970:         try:
  971:             resolved.relative_to(self.project_root.resolve())
  972:         except (OSError, RuntimeError, ValueError):
  973:             return None
  974:         return resolved
  975: 
  976:     def _merge_evidence(self, existing: Any, incoming: list[dict[str, Any]]) -> list[dict[str, Any]]:
  977:         values = [copy.deepcopy(item) for item in existing if isinstance(item, dict)] if isinstance(existing, list) else []
  978:         for item in incoming:
  979:             marker = self._evidence_merge_identity(item)
  980:             values = [current for current in values if self._evidence_merge_identity(current) != marker]
  981:             values.append(item)
  982:         return values
  983: 
  984:     def _evidence_merge_identity(self, item: dict[str, Any]) -> tuple[str, str]:
  985:         kind = str(item.get("kind") or "")
  986:         if kind == "gate":
  987:             return ("gate", str(item.get("gate_id") or item.get("id") or ""))
  988:         if kind in {"input", "artifact"}:
  989:             # Inputs deliberately accept artifact-shaped evidence. Treat both
  990:             # forms as one identity so a later alias cannot resurrect an older
  991:             # positive record.
  992:             return ("input_or_artifact", str(item.get("input_id") or item.get("artifact_id") or item.get("id") or ""))
  993:         if kind in {"evidence", "attestation"}:
  994:             return ("evidence", str(item.get("evidence_id") or item.get("id") or ""))
  995:         return (kind, str(item.get("id") or ""))
  996: 
  997:     def _evidence_file_diagnostic(self, evidence: dict[str, Any] | None) -> dict[str, Any] | None:
  998:         if not isinstance(evidence, dict):
  999:             return None
 1000:         path_value = str(evidence.get("path") or "").strip()
 1001:         if not path_value:
 1002:             return None
 1003:         safe_path = self._safe_evidence_path(path_value)
 1004:         if safe_path is None:
 1005:             return {"code": "evidence_file_unsafe", "path": path_value}
 1006:         try:
 1007:             if not safe_path.exists():
 1008:                 return {"code": "evidence_file_missing", "path": path_value}
 1009:             if not safe_path.is_file():
 1010:                 return {"code": "evidence_file_not_regular", "path": path_value}
 1011:         except OSError as exc:
 1012:             return {"code": "evidence_file_unreadable", "path": path_value, "error": str(exc)}
 1013:         stored = str(evidence.get("sha256") or "").strip()
 1014:         if not stored:
 1015:             return {"code": "evidence_digest_missing", "path": path_value}
 1016:         try:
 1017:             actual = "sha256:" + self._sha256_file(safe_path)
 1018:         except OSError as exc:
 1019:             return {"code": "evidence_file_unreadable", "path": path_value, "error": str(exc)}
 1020:         if stored.casefold() != actual.casefold():
 1021:             return {"code": "evidence_file_changed", "path": path_value, "stored_sha256": stored, "actual_sha256": actual}
 1022:         return None
 1023: 
 1024:     def _latest_assignment_event(self, assignment_id: str, event_types: set[str]) -> dict[str, Any] | None:
 1025:         if not event_types or not hasattr(self.core, "event_runtime_paths"):
 1026:             return None
 1027:         events_path, _outbox = self.core.event_runtime_paths(self.project_root)
 1028:         if not events_path.is_file():
 1029:             return None
 1030:         for line in reversed(events_path.read_text(encoding="utf-8", errors="replace").splitlines()):
 1031:             try:
 1032:                 event = json.loads(line)
 1033:             except json.JSONDecodeError:
 1034:                 continue
 1035:             assignment = event.get("assignment") if isinstance(event.get("assignment"), dict) else {}
 1036:             if str(event.get("event_type") or "") in event_types and (str(assignment.get("id") or "") == assignment_id or str(event.get("subject") or "") == assignment_id):
 1037:                 return event
 1038:         return None
 1039: 
 1040:     def _run_completion_blockers(self, process: dict[str, Any], run: dict[str, Any], assignment: dict[str, Any]) -> list[dict[str, Any]]:
 1041:         completion = process.get("run_completion") if isinstance(process.get("run_completion"), dict) else {}
 1042:         evidence = self._accumulated_evidence(assignment)
 1043:         blockers: list[dict[str, Any]] = []
 1044:         for gate_id in self._string_list(completion.get("gates")):
 1045:             gate = self._gate_state(process, gate_id, evidence, phase="run_completion")
 1046:             if gate["required"] and gate["blocking"] and not gate["satisfied"]:
 1047:                 blocker = {"code": "run_completion_gate_missing", "gate_id": gate_id}
 1048:                 if isinstance(gate.get("diagnostic"), dict):
 1049:                     blocker["diagnostic"] = copy.deepcopy(gate["diagnostic"])
 1050:                 blockers.append(blocker)
 1051:         assignment_id = str(assignment.get("id") or "")
 1052:         for task in run.get("tasks", []) if isinstance(run.get("tasks"), list) else []:
 1053:             if not isinstance(task, dict) or str(task.get("id") or "") == assignment_id or task.get("blocking", True) is False:
 1054:                 continue
 1055:             if str(task.get("status") or "") not in {"done", "completed", "cancelled"}:
 1056:                 blockers.append({"code": "blocking_assignment_incomplete", "assignment_id": str(task.get("id") or ""), "status": str(task.get("status") or "")})
 1057:         return blockers
 1058: 
 1059:     def _completion_intent_path(self, run_id: str) -> Path:
 1060:         return self._run_path(run_id).parent / "completion-intent.yaml"
 1061: 
 1062:     def _build_completion_intent(
 1063:         self,
 1064:         run: dict[str, Any],
 1065:         assignment: dict[str, Any],
 1066:         process: dict[str, Any],
 1067:         *,
 1068:         outcome: str,
 1069:         notes: str,
 1070:         completed_at: str,
 1071:     ) -> dict[str, Any]:
 1072:         """Build every terminal payload before the first terminal write.
 1073: 
 1074:         The journal is deliberately self-contained.  A retry therefore does
 1075:         not re-run evidence selection, call ``now_utc`` again, or infer a new
 1076:         outcome from partially written records.
 1077:         """
 1078:         run_id = str(run["id"])
 1079:         assignment_id = str(assignment["id"])
 1080:         final_assignment = copy.deepcopy(assignment)
 1081:         final_assignment["stage_status"] = "completed"
 1082:         final_assignment["status"] = "done"
 1083:         final_assignment["updated_at"] = completed_at
 1084:         artifacts = [
 1085:             str(item.get("path"))
 1086:             for item in self._accumulated_evidence(final_assignment)
 1087:             if isinstance(item, dict) and item.get("path")
 1088:         ]
 1089:         final_assignment["result"] = {
 1090:             "status": "done",
 1091:             "summary": str(notes or f"Completed declarative process with outcome {outcome}."),
 1092:             "artifacts": sorted(set(artifacts)),
 1093:         }
 1094: 
 1095:         final_run = copy.deepcopy(run)
 1096:         self._set_run_task_status(final_run, assignment_id, "done")
 1097:         final_run["status"] = "completed"
 1098:         final_run["updated_at"] = completed_at
 1099:         summary_path = self._run_path(run_id).parent / "summary.md"
 1100:         handoff_path = self._flow_root() / "handoffs" / "runs" / f"{run_id}-handoff.md"
 1101:         task_index_path = self._run_path(run_id).parent / "task-index.md"
 1102:         projection_path = self._flow_root() / "artifacts" / "projections" / "process-execution-state.json"
 1103:         summary = self._render_summary(final_run, final_assignment)
 1104:         handoff = f"# Run Handoff: {run_id}\n\nStatus: `completed`\n\nSummary: `{self.core.rel(summary_path, self.project_root)}`\n"
 1105:         final_run["final_artifacts"] = [self.core.rel(summary_path, self.project_root), self.core.rel(handoff_path, self.project_root)]
 1106:         emitted = final_run.setdefault("events", {}).setdefault("emitted", []) if isinstance(final_run.setdefault("events", {}), dict) else []
 1107:         for event_type in ["process.stage.completed", "process.stage.transitioned", "task.completed", "assignment.completed", "run.completed", "run.summary.created"]:
 1108:             if isinstance(emitted, list) and event_type not in emitted:
 1109:                 emitted.append(event_type)
 1110:         if hasattr(self.core, "render_task_index"):
 1111:             task_index = self.core.render_task_index(self.project_root, final_run)
 1112:         else:
 1113:             lines = [f"# Task Index: {run_id}", ""]
 1114:             lines.extend(f"- `{item.get('id')}`: `{item.get('status')}`" for item in final_run.get("tasks", []) if isinstance(item, dict))
 1115:             task_index = "\n".join(lines) + "\n"
 1116: 
 1117:         stage_id = str(assignment.get("stage") or "")
 1118:         intent_seed = f"{run_id}:{assignment_id}:{completed_at}:{outcome}"
 1119:         intent_id = "completion-" + hashlib.sha256(intent_seed.encode("utf-8")).hexdigest()[:32]
 1120:         event_specs = []
 1121:         for event_type, event_stage in [
 1122:             ("process.stage.completed", stage_id),
 1123:             ("process.stage.transitioned", stage_id),
 1124:             ("task.completed", stage_id),
 1125:             ("assignment.completed", stage_id),
 1126:             ("run.completed", stage_id),
 1127:             ("run.summary.created", stage_id),
 1128:         ]:
 1129:             event_specs.append(
 1130:                 {
 1131:                     "event_type": event_type,
 1132:                     "event_id": "evt_" + hashlib.sha256(f"{intent_id}:{event_type}".encode("utf-8")).hexdigest()[:32],
 1133:                     "stage_id": event_stage,
 1134:                     "previous_stage_id": stage_id,
 1135:                     "next_stage_id": "",
 1136:                     "outcome": outcome,
 1137:                 }
 1138:             )
 1139:         pin = final_run.get("process_execution") if isinstance(final_run.get("process_execution"), dict) else {}
 1140:         expected_run_path = self.core.rel(self._run_path(run_id), self.project_root)
 1141:         expected_assignment_path = self.core.rel(self._assignment_path(assignment_id), self.project_root)
 1142:         expected_journal_path = self.core.rel(self._completion_intent_path(run_id), self.project_root)
 1143:         intent = {
 1144:             "schema_version": 1,
 1145:             "kind": "pf.process.completion-intent",
 1146:             "intent_id": intent_id,
 1147:             "created_at": completed_at,
 1148:             "completed_at": completed_at,
 1149:             "run_id": run_id,
 1150:             "assignment_id": assignment_id,
 1151:             "journal_path": expected_journal_path,
 1152:             "owner": {
 1153:                 "project_id": self.core.project_id(self.project_root),
 1154:                 "run_path": expected_run_path,
 1155:                 "assignment_path": expected_assignment_path,
 1156:             },
 1157:             "process_execution": copy.deepcopy(pin),
 1158:             "final": {
 1159:                 "run": final_run,
 1160:                 "assignment": final_assignment,
 1161:                 "summary": {"path": self.core.rel(summary_path, self.project_root), "content": summary},
 1162:                 "handoff": {"path": self.core.rel(handoff_path, self.project_root), "content": handoff},
 1163:                 "task_index": {"path": self.core.rel(task_index_path, self.project_root), "content": task_index},
 1164:                 "projection": {"path": self.core.rel(projection_path, self.project_root)},
 1165:                 "events": event_specs,
 1166:             },
 1167:         }
 1168:         intent["fingerprint"] = canonical_fingerprint(intent)
 1169:         return intent
 1170: 
 1171:     def _load_completion_intent(self, run: dict[str, Any], assignment: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
 1172:         run_id = str(run.get("id") or "")
 1173:         assignment_id = str(assignment.get("id") or "")
 1174:         if not SAFE_ID_RE.fullmatch(run_id) or not SAFE_ID_RE.fullmatch(assignment_id):
 1175:             return None, None
 1176:         path = self._completion_intent_path(run_id)
 1177:         if not path.is_file():
 1178:             return None, None
 1179:         try:
 1180:             intent = self.core.load_yaml_document(path)
 1181:         except (OSError, ValueError, TypeError) as exc:
 1182:             return None, f"journal unreadable: {exc}"
 1183:         error = self._validate_completion_intent(intent, run, assignment, path)
 1184:         return (intent, None) if error is None else (None, error)
 1185: 
 1186:     def _validate_completion_intent(
 1187:         self,
 1188:         intent: Any,
 1189:         run: dict[str, Any],
 1190:         assignment: dict[str, Any],
 1191:         journal_path: Path,
 1192:     ) -> str | None:
 1193:         if not isinstance(intent, dict) or intent.get("kind") != "pf.process.completion-intent":
 1194:             return "journal kind is invalid"
 1195:         content = {key: value for key, value in intent.items() if key != "fingerprint"}
 1196:         try:
 1197:             if intent.get("fingerprint") != canonical_fingerprint(content):
 1198:                 return "journal content fingerprint mismatch"
 1199:         except (TypeError, ValueError, RecursionError):
 1200:             return "journal content is invalid"
 1201:         run_id = str(run.get("id") or "")
 1202:         assignment_id = str(assignment.get("id") or "")
 1203:         if intent.get("run_id") != run_id or intent.get("assignment_id") != assignment_id:
 1204:             return "journal identity does not match selected work"
 1205:         final = intent.get("final") if isinstance(intent.get("final"), dict) else {}
 1206:         final_run = final.get("run") if isinstance(final.get("run"), dict) else {}
 1207:         final_assignment = final.get("assignment") if isinstance(final.get("assignment"), dict) else {}
 1208:         if final_run.get("id") != run_id or final_assignment.get("id") != assignment_id or final_assignment.get("run_id") != run_id:
 1209:             return "journal final payload identity is invalid"
 1210:         if final_run.get("status") != "completed" or final_assignment.get("status") not in TERMINAL_ASSIGNMENT_STATUSES:
 1211:             return "journal final payload is not terminal"
 1212:         if final_assignment.get("status") != "done":
 1213:             return "journal final assignment is not done"
 1214:         tasks = final_run.get("tasks") if isinstance(final_run.get("tasks"), list) else []
 1215:         task = next((item for item in tasks if isinstance(item, dict) and str(item.get("id") or "") == assignment_id), None)
 1216:         if not isinstance(task, dict) or task.get("status") not in {"done", "completed"}:
 1217:             return "journal final task status is invalid"
 1218:         if self._effective_process(final_run)[1] != "pinned":
 1219:             return "journal final process pin is invalid"
 1220:         pin = intent.get("process_execution") if isinstance(intent.get("process_execution"), dict) else {}
 1221:         current_pin = run.get("process_execution") if isinstance(run.get("process_execution"), dict) else {}
 1222:         for key in ["process_id", "process_version", "process_fingerprint", "snapshot_id", "snapshot_checksum"]:
 1223:             if str(pin.get(key) or "") != str(current_pin.get(key) or "") or str(pin.get(key) or "") != str((final_run.get("process_execution") or {}).get(key) or ""):
 1224:                 return f"journal process pin mismatch: {key}"
 1225:         expected = {
 1226:             "journal_path": self.core.rel(journal_path, self.project_root),
 1227:             "run_path": self.core.rel(self._run_path(run_id), self.project_root),
 1228:             "assignment_path": self.core.rel(self._assignment_path(assignment_id), self.project_root),
 1229:         }
 1230:         if str(intent.get("journal_path") or "") != expected["journal_path"]:
 1231:             return "journal path is not owned by the selected run"
 1232:         owner = intent.get("owner") if isinstance(intent.get("owner"), dict) else {}
 1233:         if owner.get("run_path") != expected["run_path"] or owner.get("assignment_path") != expected["assignment_path"]:
 1234:             return "journal owner paths are invalid"
 1235:         if hasattr(self.core, "project_id") and str(owner.get("project_id") or "") != str(self.core.project_id(self.project_root)):
 1236:             return "journal project owner is invalid"
 1237:         final_paths = {
 1238:             "summary": self.core.rel(self._run_path(run_id).parent / "summary.md", self.project_root),
 1239:             "handoff": self.core.rel(self._flow_root() / "handoffs" / "runs" / f"{run_id}-handoff.md", self.project_root),
 1240:             "task_index": self.core.rel(self._run_path(run_id).parent / "task-index.md", self.project_root),
 1241:             "projection": self.core.rel(self._flow_root() / "artifacts" / "projections" / "process-execution-state.json", self.project_root),
 1242:         }
 1243:         for key, expected_path in final_paths.items():
 1244:             item = final.get(key) if isinstance(final.get(key), dict) else {}
 1245:             if str(item.get("path") or "") != expected_path:
 1246:                 return f"journal {key} path is invalid"
 1247:         events = final.get("events")
 1248:         if not isinstance(events, list) or not events or any(not isinstance(item, dict) or not item.get("event_type") or not item.get("event_id") for item in events):
 1249:             return "journal event metadata is invalid"
 1250:         return None
 1251: 
 1252:     def _replay_completion_intent(self, intent: dict[str, Any], *, session_id: str = "", remove_intent: bool = True) -> dict[str, Any]:
 1253:         run_id = str(intent["run_id"])
 1254:         assignment_id = str(intent["assignment_id"])
 1255:         final = intent["final"]
 1256:         final_assignment = copy.deepcopy(final["assignment"])
 1257:         final_run = copy.deepcopy(final["run"])
 1258:         self._atomic_yaml(self._assignment_path(assignment_id), final_assignment)
 1259:         self._atomic_yaml(self._run_path(run_id), final_run)
 1260:         self._atomic_text(self._run_path(run_id).parent / "summary.md", str(final["summary"].get("content") or ""))
 1261:         self._atomic_text(self._flow_root() / "handoffs" / "runs" / f"{run_id}-handoff.md", str(final["handoff"].get("content") or ""))
 1262:         self._atomic_text(self._run_path(run_id).parent / "task-index.md", str(final["task_index"].get("content") or ""))
 1263:         result_state = self.state(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
 1264:         self._write_projection(result_state)
 1265:         stage_id = str(final_assignment.get("stage") or "")
 1266:         for event in final["events"]:
 1267:             self._emit(
 1268:                 str(event["event_type"]),
 1269:                 final_run,
 1270:                 final_assignment,
 1271:                 str(event.get("stage_id") or stage_id),
 1272:                 outcome=str(event.get("outcome") or "completed"),
 1273:                 previous_stage_id=str(event.get("previous_stage_id") or stage_id),
 1274:                 next_stage_id=str(event.get("next_stage_id") or ""),
 1275:                 event_id=str(event["event_id"]),
 1276:             )
 1277:         if remove_intent:
 1278:             self._completion_intent_path(run_id).unlink(missing_ok=True)
 1279:         return {**result_state, "action": "run_completed", "previous_stage_id": stage_id, "next_stage_id": "", "recovered": True}
 1280: 
 1281:     def _complete_locked(self, run: dict[str, Any], assignment: dict[str, Any], process: dict[str, Any], *, outcome: str, notes: str, completed_at: str) -> None:
 1282:         run_id = str(run["id"])
 1283:         assignment_id = str(assignment["id"])
 1284:         assignment["stage_status"] = "completed"
 1285:         assignment["status"] = "done"
 1286:         assignment["updated_at"] = completed_at
 1287:         artifacts = [str(item.get("path")) for item in self._accumulated_evidence(assignment) if isinstance(item, dict) and item.get("path")]
 1288:         assignment["result"] = {"status": "done", "summary": str(notes or f"Completed declarative process with outcome {outcome}."), "artifacts": sorted(set(artifacts))}
 1289:         self._set_run_task_status(run, assignment_id, "done")
 1290:         run["status"] = "completed"
 1291:         run["updated_at"] = completed_at
 1292:         summary_path = self._run_path(run_id).parent / "summary.md"
 1293:         handoff_path = self._flow_root() / "handoffs" / "runs" / f"{run_id}-handoff.md"
 1294:         summary = self._render_summary(run, assignment)
 1295:         handoff = f"# Run Handoff: {run_id}\n\nStatus: `completed`\n\nSummary: `{self.core.rel(summary_path, self.project_root)}`\n"
 1296:         run["final_artifacts"] = [self.core.rel(summary_path, self.project_root), self.core.rel(handoff_path, self.project_root)]
 1297:         emitted = run.setdefault("events", {}).setdefault("emitted", []) if isinstance(run.setdefault("events", {}), dict) else []
 1298:         for event_type in ["process.stage.completed", "process.stage.transitioned", "task.completed", "assignment.completed", "run.completed", "run.summary.created"]:
 1299:             if isinstance(emitted, list) and event_type not in emitted:
 1300:                 emitted.append(event_type)
 1301:         self._atomic_yaml(self._assignment_path(assignment_id), assignment)
 1302:         self._atomic_yaml(self._run_path(run_id), run)
 1303:         self._atomic_text(summary_path, summary)
 1304:         self._atomic_text(handoff_path, handoff)
 1305:         self._write_task_index(run)
 1306: 
 1307:     def _render_summary(self, run: dict[str, Any], assignment: dict[str, Any]) -> str:
 1308:         history = assignment.get("stage_history") if isinstance(assignment.get("stage_history"), list) else []
 1309:         lines = [f"# Run Summary: {run.get('title', run.get('id'))}", "", f"- run_id: `{run.get('id')}`", "- status: `completed`", f"- process: `{run.get('process')}`", "", "## Stage History", ""]
 1310:         lines.extend(f"- `{item.get('stage_id')}`: `{item.get('status')}` (`{item.get('outcome')}`)" for item in history if isinstance(item, dict))
 1311:         if not history:
 1312:             lines.append("- No stage history recorded.")
 1313:         return "\n".join(lines) + "\n"
 1314: 
 1315:     def _write_capsule(self, run: dict[str, Any], assignment: dict[str, Any], pin: dict[str, Any]) -> tuple[str, str]:
 1316:         path = self._flow_root() / "contexts" / "assignment-capsules" / f"{assignment['id']}.capsule.yaml"
