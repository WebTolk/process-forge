23202: def command_update_stage(args: argparse.Namespace) -> int:
23203:     workplace_root = update_workplace_root(args.workplace)
23204:     candidate = find_update_candidate(workplace_root, args.candidate)
23205:     if not candidate:
23206:         print(f"FAIL: candidate not found: {args.candidate}")
23207:         return 1
23208:     if candidate.get("status") != "available" or not candidate.get("installable"):
23209:         print(f"FAIL: candidate is not installable: {candidate.get('status')}")
23210:         return 1
23211:     stage_dir = update_runtime_root(workplace_root) / "staged" / str(candidate["id"])
23212:     if args.dry_run:
23213:         print(f"DRY_RUN: would stage {candidate['id']} into {rel(stage_dir, workplace_root)}")
23214:         return 0
23215:     if stage_dir.exists():
23216:         shutil.rmtree(stage_dir)
23217:     stage_dir.mkdir(parents=True, exist_ok=True)
23218:     artifact_path = copy_or_download_update_artifact(candidate, stage_dir, workplace_root)
23219:     actual_sha = sha256_file(artifact_path)
23220:     expected_sha = str(candidate.get("sha256") or candidate.get("artifact_sha256") or "")
23221:     verified = not expected_sha or actual_sha.lower() == expected_sha.lower()
23222:     record = {
23223:         "schema_version": 1,
23224:         "candidate_id": candidate["id"],
23225:         "staged_at": now_utc(),
23226:         "status": "verified" if verified else "failed",
23227:         "workplace": rel(workplace_root, workplace_root.parent),
23228:         "candidate": candidate,
23229:         "artifact": {"path": rel(artifact_path, workplace_root), "sha256": actual_sha, "expected_sha256": expected_sha or None},
23230:         "verification": {"sha256": "pass" if verified else "fail"},
23231:     }
23232:     staged_update_record_path(workplace_root, str(candidate["id"])).write_text(dump_yaml(record), encoding="utf-8")
23233:     print(f"STAGED: {rel(artifact_path, workplace_root)}")
23234:     print(f"SHA256: {'pass' if verified else 'fail'}")
23235:     return 0 if verified else 1
