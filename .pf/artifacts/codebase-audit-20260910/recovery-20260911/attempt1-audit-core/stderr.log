   28: def process_catalog_metadata(process: dict[str, Any]) -> dict[str, Any]:
   29:     catalog = process.get("catalog") if isinstance(process.get("catalog"), dict) else {}
   30:     status = str(process.get("status") or "draft")
   31:     classification = str(catalog.get("classification") or "").upper()
   32:     if classification not in PROCESS_CATALOG_CLASSIFICATIONS:
   33:         if status == "active":
   34:             classification = "PUBLIC_STABLE"
   35:         elif status == "experimental":
   36:             classification = "PUBLIC_EXPERIMENTAL"
   37:         elif status == "internal":
   38:             classification = "INTERNAL_MAINTENANCE"
   39:         elif status == "deprecated":
   40:             classification = "DEPRECATED"
   41:         else:
   42:             classification = "PUBLIC_EXPERIMENTAL"
   43:     public_surface = catalog.get("public_surface", process.get("public_surface", classification != "INTERNAL_MAINTENANCE"))
   44:     return {"classification": classification, "public_surface": bool(public_surface), "status": status}
   45: 
   46: 
   47: def process_catalog_role(process: dict[str, Any]) -> str:
   48:     catalog = process.get("catalog") if isinstance(process.get("catalog"), dict) else {}
   49:     role = str(catalog.get("role") or "").strip()
   50:     if role:
   51:         return safe_id(role, "canonical")
   52:     meta = process_catalog_metadata(process)
   53:     if meta["classification"] == "INTERNAL_MAINTENANCE":
   54:         return "internal"
   55:     if meta["classification"] == "DEPRECATED":
   56:         return "legacy_alias"
   57:     return "canonical"
