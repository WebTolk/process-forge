 1429:     def _unique_id(self, root: Path, seed: str) -> str:
 1430:         base = "-".join(str(seed or "work").lower().split())[:72].strip("-") or "work"
 1431:         candidate = base
 1432:         index = 2
 1433:         while (root / candidate).exists() or (root / f"{candidate}.yaml").exists():
 1434:             suffix = f"-{index}"
 1435:             candidate = base[: 72 - len(suffix)] + suffix
 1436:             index += 1
 1437:         return candidate
 1438: 
 1439:     def _sha256_file(self, path: Path) -> str:
 1440:         return hashlib.sha256(path.read_bytes()).hexdigest()
 1441: 
 1442:     def _string_list(self, value: Any) -> list[str]:
 1443:         return [str(item) for item in value if str(item)] if isinstance(value, list) else []
