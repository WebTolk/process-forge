22519: def latest_update_version(update_index: dict[str, Any], channel: str) -> dict[str, Any] | None:
22520:     channels = update_index.get("channels", {}) if isinstance(update_index.get("channels"), dict) else {}
22521:     latest = None
22522:     channel_data = channels.get(channel)
22523:     if isinstance(channel_data, dict):
22524:         latest = channel_data.get("latest")
22525:     elif isinstance(channel_data, str):
22526:         latest = channel_data
22527:     versions = update_index.get("versions") if isinstance(update_index.get("versions"), list) else []
22528:     for item in versions:
22529:         if isinstance(item, dict) and str(item.get("version")) == str(latest):
22530:             return item
22531:     return None
