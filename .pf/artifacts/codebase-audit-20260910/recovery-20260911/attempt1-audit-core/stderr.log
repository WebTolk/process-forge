 4198: def normalize_platform_ref(value: Any, *, default_required: bool = True) -> dict[str, Any] | None:
 4199:     if isinstance(value, str):
 4200:         ref_id = value.strip()
 4201:         if not ref_id:
 4202:             return None
 4203:         return {"id": platform_contract_id(ref_id), "required": default_required}
 4204:     if isinstance(value, dict):
 4205:         raw_id = value.get("id") or value.get("platform") or value.get("package_id")
 4206:         if not raw_id:
 4207:             return None
 4208:         record: dict[str, Any] = {"id": platform_contract_id(str(raw_id)), "required": bool(value.get("required", default_required))}
 4209:         if value.get("version"):
 4210:             record["version"] = str(value["version"])
 4211:         return record
 4212:     return None
