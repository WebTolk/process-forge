  281: def indexable_resource_ids(resources: list[AuthorizedResource]) -> list[str]:
  282:     seen: set[str] = set()
  283:     result: list[str] = []
  284:     for resource in resources:
  285:         if resource.resource_id not in seen:
  286:             seen.add(resource.resource_id)
  287:             result.append(resource.resource_id)
  288:     return result
  289: 
  290: 
  291: def authorized_roots(project_root: Path, snapshot: dict[str, Any]) -> list[AuthorizedResource]:
  292:     result: list[AuthorizedResource] = []
  293:     seen: set[tuple[str, str]] = set()
  294:     for row in _resource_records(snapshot):
  295:         resource_id = str(row.get("id") or row.get("resource_id") or "").strip()
  296:         if not resource_id:
  297:             continue
  298:         policy = normalize_indexing_policy(row)
  299:         if policy.get("mode") == "none":
  300:             continue
  301:         raw_paths: list[Any] = []
  302:         for key in ("content_roots", "search_roots", "paths"):
  303:             if isinstance(row.get(key), list):
  304:                 raw_paths.extend(row[key])
  305:         raw_paths.extend(row.get(key) for key in ("resolved_path", "local_path", "path") if row.get(key))
  306:         for raw_path in raw_paths:
  307:             value = str(raw_path or "").strip()
  308:             if not value or value.startswith("<") or "://" in value:
  309:                 continue
  310:             candidate = Path(value)
  311:             if not candidate.is_absolute():
  312:                 candidate = project_root / candidate
  313:             try:
  314:                 root = candidate.resolve(strict=True)
  315:             except OSError:
  316:                 continue
  317:             identity = (resource_id, str(root))
  318:             if identity in seen:
  319:                 continue
  320:             seen.add(identity)
  321:             sources = tuple(_normalize_source(item, str(policy.get("mode") or "metadata")) for item in policy.get("sources", []) if isinstance(item, dict))
  322:             result.append(
  323:                 AuthorizedResource(
  324:                     resource_id=resource_id,
  325:                     package_id=str(row.get("package_id") or row.get("package") or ""),
  326:                     kind=str(row.get("kind") or "knowledge"),
  327:                     title=str(row.get("title") or resource_id),
  328:                     description=str(row.get("description") or ""),
  329:                     version=str(row.get("version") or row.get("generation") or ""),
  330:                     fingerprint=_fingerprint_value(row),
  331:                     root=root,
  332:                     root_ref=_stable_json(row.get("path_ref")) if isinstance(row.get("path_ref"), dict) else str(root),
  333:                     indexing=policy,
  334:                     sources=sources,
  335:                 )
  336:             )
  337:     return result
  338: 
  339: 
  340: def _matches_any(path: str, patterns: tuple[str, ...]) -> bool:
  341:     normalized_path = path.lstrip("/")
  342:     for pattern in patterns:
  343:         normalized_pattern = pattern.lstrip("/")
  344:         candidates = [normalized_pattern]
  345:         if normalized_pattern.startswith("**/"):
  346:             candidates.append(normalized_pattern[3:])
  347:         if any(fnmatch.fnmatch(normalized_path, candidate) for candidate in candidates):
  348:             return True
  349:     return False
  350: 
  351: 
  352: def _iter_source_files(root: Path, source: IndexSource) -> Iterable[tuple[Path, str]]:
  353:     base = (root / source.path).resolve() if source.path not in {"", "."} else root
  354:     try:
  355:         base.relative_to(root if root.is_dir() else root.parent)
  356:     except ValueError:
  357:         return
  358:     if base.is_file():
  359:         rel_path = base.relative_to(root.parent if not root.is_dir() else root).as_posix() if root != base else base.name
  360:         if base.suffix.lower() in TEXT_SUFFIXES and base.stat().st_size <= MAX_FILE_BYTES:
  361:             # Treat an explicit file source exactly like a file discovered
  362:             # beneath a directory source.  In particular, an explicit path
  363:             # must still satisfy include/exclude authorization patterns.
  364:             source_rel = base.name
  365:             if _matches_any(source_rel, source.include) and not (
  366:                 source.exclude
  367:                 and (_matches_any(source_rel, source.exclude) or _matches_any(rel_path, source.exclude))
  368:             ):
  369:                 yield base, rel_path
  370:         return
  371:     if not base.is_dir():
  372:         return
  373:     for path in base.rglob("*"):
  374:         try:
  375:             if not (path.is_file() and path.suffix.lower() in TEXT_SUFFIXES and path.stat().st_size <= MAX_FILE_BYTES):
  376:                 continue
  377:             rel_path = path.relative_to(root).as_posix() if root.is_dir() else path.name
  378:             source_rel = path.relative_to(base).as_posix()
  379:             if not _matches_any(source_rel, source.include):
  380:                 continue
  381:             if source.exclude and (_matches_any(source_rel, source.exclude) or _matches_any(rel_path, source.exclude)):
  382:                 continue
  383:             yield path, rel_path
  384:         except OSError:
  385:             continue
  386: 
  387: 
  388: def _metadata_content(resource: AuthorizedResource, source: IndexSource | None = None) -> str:
  389:     parts = [
  390:         resource.title,
  391:         resource.description,
  392:         resource.resource_id,
  393:         resource.package_id,
  394:         resource.kind,
  395:         resource.version,
  396:         resource.root_ref,
  397:     ]
  398:     if source is not None:
  399:         parts.extend([source.path, source.role])
  400:     return "\n".join(item for item in parts if item)
  401: 
  402: 
  403: def _documents(resources: list[AuthorizedResource]) -> list[dict[str, Any]]:
  404:     documents: list[dict[str, Any]] = []
  405:     positions: dict[tuple[str, str], int] = {}
  406: 
  407:     def append(document: dict[str, Any]) -> None:
  408:         # Multiple sources may intentionally overlap (for example, a source
  409:         # tree and an explicit file).  A logical document is identified by
  410:         # its resource and canonical relative path, not by the source that
  411:         # happened to discover it first.
  412:         identity = (str(document["resource_id"]), str(document["relative_path"]))
  413:         if identity not in positions:
  414:             positions[identity] = len(documents)
  415:             documents.append(document)
  416:         elif document["metadata"]["mode"] == "fulltext" and documents[positions[identity]]["metadata"]["mode"] != "fulltext":
  417:             # An explicit fulltext source must not be hidden by a metadata
  418:             # source for the same path merely because of source ordering.
  419:             documents[positions[identity]] = document
  420: 
  421:     for resource in resources:
  422:         policy_hash = _policy_hash(resource.indexing)
  423:         if all(source.mode != "fulltext" for source in resource.sources):
  424:             content = _metadata_content(resource, resource.sources[0] if resource.sources else None)
  425:             content_hash = hashlib.sha256(content.encode("utf-8")).hexdigest()
  426:             append(
  427:                 {
  428:                     "resource_id": resource.resource_id,
  429:                     "package_id": resource.package_id,
  430:                     "kind": resource.kind,
  431:                     "relative_path": ".",
  432:                     "title": resource.title,
  433:                     "content": content,
  434:                     "content_hash": content_hash,
  435:                     "fingerprint": f"{resource.fingerprint}:{policy_hash}:{content_hash}",
  436:                     "metadata": {"mode": "metadata", "root_ref": resource.root_ref, "version": resource.version},
  437:                 }
  438:             )
  439:             continue
  440:         for source in resource.sources:
  441:             if source.mode == "none":
  442:                 continue
  443:             if source.mode == "metadata":
  444:                 content = _metadata_content(resource, source)
  445:                 content_hash = hashlib.sha256(content.encode("utf-8")).hexdigest()
  446:                 append(
  447:                     {
  448:                         "resource_id": resource.resource_id,
  449:                         "package_id": resource.package_id,
  450:                         "kind": resource.kind,
  451:                         "relative_path": source.path or ".",
  452:                         "title": resource.title,
  453:                         "content": content,
  454:                         "content_hash": content_hash,
  455:                         "fingerprint": f"{resource.fingerprint}:{policy_hash}:{content_hash}",
  456:                         "metadata": {"mode": "metadata", "role": source.role, "root_ref": resource.root_ref, "version": resource.version},
  457:                     }
  458:                 )
  459:                 continue
  460:             for path, relative_path in _iter_source_files(resource.root, source):
  461:                 try:
  462:                     text = path.read_text(encoding="utf-8", errors="replace")
  463:                 except OSError:
  464:                     continue
  465:                 content = _metadata_content(resource, source) + "\n" + text
  466:                 content_hash = hashlib.sha256(text.encode("utf-8")).hexdigest()
  467:                 append(
  468:                     {
  469:                         "resource_id": resource.resource_id,
  470:                         "package_id": resource.package_id,
  471:                         "kind": resource.kind,
  472:                         "relative_path": relative_path,
  473:                         "title": relative_path,
  474:                         "content": content,
  475:                         "content_hash": content_hash,
  476:                         "fingerprint": f"{resource.fingerprint}:{policy_hash}:{relative_path}:{content_hash}",
  477:                         "metadata": {"mode": "fulltext", "root_ref": resource.root_ref, "version": resource.version},
  478:                     }
  479:                 )
  480:     return documents
  481: 
  482: 
  483: def index_path(project_root: Path, workplace_root: Path | None = None) -> Path:
  484:     """Return the private derived search DB path."""
  485: 
  486:     if workplace_root is not None:
  487:         return workplace_root / "runtime" / "search" / "local-resource-search.sqlite"
  488:     return project_root / ".pf" / "runtime" / "local-resource-search" / "search.sqlite"
  489: 
  490: 
  491: def sqlite_fts5_capability() -> dict[str, Any]:
  492:     version = sqlite3.sqlite_version
  493:     try:
  494:         db = sqlite3.connect(":memory:")
  495:     except sqlite3.Error as exc:
  496:         return {"sqlite_version": version, "fts5_available": False, "error": _error_code(exc) or "sqlite_unavailable"}
  497:     try:
  498:         try:
  499:             db.execute("CREATE VIRTUAL TABLE fts5_probe USING fts5(content)")
  500:             fts5_available = True
  501:         except sqlite3.Error:
  502:             fts5_available = False
  503:     finally:
  504:         db.close()
  505:     return {"sqlite_version": version, "fts5_available": fts5_available}
  506: 
  507: 
  508: def _ensure_schema(db: sqlite3.Connection) -> None:
  509:     db.execute("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)")
  510:     current = db.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
  511:     if current and str(current[0]) != str(SCHEMA_VERSION):
  512:         raise LocalSearchError("index_schema_mismatch")
  513:     db.execute("INSERT OR REPLACE INTO meta VALUES (?, ?)", ("schema_version", str(SCHEMA_VERSION)))
  514:     db.execute("INSERT OR REPLACE INTO meta VALUES (?, ?)", ("sqlite_version", sqlite3.sqlite_version))
  515:     db.execute(
  516:         "CREATE TABLE IF NOT EXISTS resources ("
  517:         "resource_id TEXT PRIMARY KEY, "
  518:         "resource_type TEXT, "
  519:         "version TEXT, "
  520:         "fingerprint TEXT, "
  521:         "indexing_policy_hash TEXT, "
  522:         "root_ref TEXT, "
  523:         "indexed_at TEXT, "
  524:         "status TEXT NOT NULL, "
  525:         "last_error TEXT)"
  526:     )
  527:     db.execute(
  528:         "CREATE TABLE IF NOT EXISTS documents ("
  529:         "id INTEGER PRIMARY KEY, "
  530:         "resource_id TEXT NOT NULL, "
  531:         "package_id TEXT, "
  532:         "kind TEXT, "
  533:         "relative_path TEXT NOT NULL, "
  534:         "title TEXT, "
  535:         "content_hash TEXT, "
  536:         "metadata TEXT, "
  537:         "fingerprint TEXT, "
  538:         "UNIQUE(resource_id, relative_path))"
  539:     )
  540:     db.execute("CREATE INDEX IF NOT EXISTS documents_resource_idx ON documents(resource_id)")
  541:     db.execute("CREATE VIRTUAL TABLE IF NOT EXISTS documents_fts USING fts5(title, content, document_id UNINDEXED, resource_id UNINDEXED)")
  542:     db.execute(
  543:         "CREATE TABLE IF NOT EXISTS index_state ("
  544:         "scope_key TEXT PRIMARY KEY, "
  545:         "snapshot_checksum TEXT NOT NULL, "
  546:         "allowed_resource_ids TEXT NOT NULL, "
  547:         "status TEXT NOT NULL, "
  548:         "generation TEXT NOT NULL, "
  549:         "resource_count INTEGER NOT NULL, "
  550:         "document_count INTEGER NOT NULL, "
  551:         "failed_file_count INTEGER NOT NULL DEFAULT 0, "
  552:         "last_successful_refresh TEXT, "
  553:         "last_full_reconciliation TEXT, "
  554:         "last_error TEXT)"
  555:     )
  556: 
  557: 
  558: def _check_schema(db: sqlite3.Connection) -> None:
  559:     required = {"meta", "resources", "index_state", "documents", "documents_fts"}
  560:     rows = db.execute("SELECT name FROM sqlite_master WHERE name IN ('meta', 'resources', 'index_state', 'documents', 'documents_fts')").fetchall()
  561:     existing = {str(row[0]) for row in rows}
  562:     if required - existing:
  563:         raise LocalSearchError("index_schema_missing")
  564:     current = db.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
  565:     if not current or str(current[0]) != str(SCHEMA_VERSION):
  566:         raise LocalSearchError("index_schema_mismatch")
  567: 
  568: 
  569: def _delete_resource(db: sqlite3.Connection, resource_id: str) -> None:
  570:     db.execute("DELETE FROM documents_fts WHERE resource_id=?", (resource_id,))
  571:     db.execute("DELETE FROM documents WHERE resource_id=?", (resource_id,))
  572:     db.execute("DELETE FROM resources WHERE resource_id=?", (resource_id,))
  573: 
  574: 
  575: def _error_code(exc: BaseException) -> str:
  576:     if isinstance(exc, LocalSearchError):
  577:         return exc.code
  578:     return str(exc) or type(exc).__name__
  579: 
  580: 
  581: def _document_fingerprint_map(resources: list[AuthorizedResource]) -> dict[str, str]:
  582:     return {f"{item['resource_id']}:{item['relative_path']}": str(item["fingerprint"]) for item in _documents(resources)}
  583: 
  584: 
  585: def _stored_fingerprint_map(db: sqlite3.Connection, resource_ids: list[str]) -> dict[str, str]:
  586:     if not resource_ids:
  587:         return {}
  588:     placeholders = ",".join("?" for _ in resource_ids)
  589:     rows = db.execute(f"SELECT resource_id, relative_path, fingerprint FROM documents WHERE resource_id IN ({placeholders})", resource_ids).fetchall()
  590:     return {f"{row[0]}:{row[1]}": str(row[2]) for row in rows}
  591: 
  592: 
  593: def _scope_generation(snapshot: dict[str, Any], resource_ids: list[str], fingerprints: dict[str, str]) -> str:
  594:     seed = {"snapshot": _snapshot_checksum(snapshot), "allowed_resource_ids": sorted(resource_ids), "fingerprints": fingerprints}
  595:     return hashlib.sha256(_stable_json(seed).encode("utf-8")).hexdigest()[:16]
  596: 
  597: 
  598: def build_index(project_root: Path, snapshot: dict[str, Any], *, workplace_root: Path | None = None, full_reconciliation: bool = False) -> dict[str, Any]:
  599:     resources = authorized_roots(project_root, snapshot)
  600:     resource_ids = indexable_resource_ids(resources)
  601:     path = index_path(project_root, workplace_root)
  602:     path.parent.mkdir(parents=True, exist_ok=True)
  603:     documents = _documents(resources)
  604:     scope_key = _scope_key(snapshot)
  605:     refreshed_at = _now_utc()
  606:     fingerprints = {f"{item['resource_id']}:{item['relative_path']}": str(item["fingerprint"]) for item in documents}
  607:     generation = _scope_generation(snapshot, resource_ids, fingerprints)
  608:     db = sqlite3.connect(path)
  609:     try:
  610:         _ensure_schema(db)
  611:         # A Workplace refresh is an authoritative reconciliation of its
  612:         # registered catalogue.  Retaining a removed package here would allow
  613:         # an old project snapshot to query an orphaned document from the shared
  614:         # DB, so remove every no-longer-registered resource before upserting.
  615:         if _scope_key(snapshot) == "workplace":
  616:             stored_ids = [str(row[0]) for row in db.execute("SELECT resource_id FROM resources").fetchall()]
  617:             for resource_id in stored_ids:
  618:                 if resource_id not in resource_ids:
  619:                     _delete_resource(db, resource_id)
  620:         for resource in resources:
  621:             _delete_resource(db, resource.resource_id)
  622:             db.execute(
  623:                 "INSERT OR REPLACE INTO resources (resource_id, resource_type, version, fingerprint, indexing_policy_hash, root_ref, indexed_at, status, last_error) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
  624:                 (resource.resource_id, resource.kind, resource.version, resource.fingerprint, _policy_hash(resource.indexing), resource.root_ref, refreshed_at, "fresh", None),
  625:             )
  626:         for item in documents:
  627:             cursor = db.execute(
  628:                 "INSERT OR REPLACE INTO documents (resource_id, package_id, kind, relative_path, title, content_hash, metadata, fingerprint) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
  629:                 (item["resource_id"], item["package_id"], item["kind"], item["relative_path"], item["title"], item["content_hash"], _stable_json(item["metadata"]), item["fingerprint"]),
  630:             )
  631:             document_id = cursor.lastrowid
  632:             if not document_id:
  633:                 row = db.execute("SELECT id FROM documents WHERE resource_id=? AND relative_path=?", (item["resource_id"], item["relative_path"])).fetchone()
  634:                 document_id = int(row[0])
  635:             db.execute("DELETE FROM documents_fts WHERE document_id=?", (document_id,))
  636:             db.execute("INSERT INTO documents_fts (title, content, document_id, resource_id) VALUES (?, ?, ?, ?)", (item["title"], item["content"], document_id, item["resource_id"]))
  637:         db.execute(
  638:             "INSERT OR REPLACE INTO index_state (scope_key, snapshot_checksum, allowed_resource_ids, status, generation, resource_count, document_count, failed_file_count, last_successful_refresh, last_full_reconciliation, last_error) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
  639:             (scope_key, _snapshot_checksum(snapshot), _stable_json(sorted(resource_ids)), "fresh", generation, len(resource_ids), len(documents), 0, refreshed_at, refreshed_at if full_reconciliation else None, None),
  640:         )
  641:         db.commit()
  642:     finally:
  643:         db.close()
  644:     return {"status": "fresh", "indexed": len(documents), "resources": len(resource_ids), "snapshot_checksum": _snapshot_checksum(snapshot), "generation": generation}
  645: 
  646: 
  647: def rebuild_index(project_root: Path, snapshot: dict[str, Any], *, workplace_root: Path | None = None) -> dict[str, Any]:
  648:     path = index_path(project_root, workplace_root)
  649:     path.unlink(missing_ok=True)
  650:     return build_index(project_root, snapshot, workplace_root=workplace_root, full_reconciliation=True)
  651: 
  652: 
  653: def index_status(project_root: Path, snapshot: dict[str, Any] | None = None, *, workplace_root: Path | None = None, verify_files: bool = False) -> dict[str, Any]:
  654:     capability = sqlite_fts5_capability()
  655:     path = index_path(project_root, workplace_root)
  656:     payload: dict[str, Any] = {
  657:         "schema_version": SCHEMA_VERSION,
  658:         "kind": "pf.search_index.status",
  659:         "path": str(path),
  660:         "sqlite": capability,
  661:         "status": "missing",
  662:         "generation": None,
  663:         "resource_count": 0,
  664:         "document_count": 0,
  665:         "stale_resource_count": 0,
  666:         "failed_file_count": 0,
  667:         "last_successful_refresh": None,
  668:         "last_full_reconciliation": None,
  669:     }
  670:     if not capability.get("fts5_available"):
  671:         payload["status"] = "degraded"
  672:         payload["error"] = "fts5_unavailable"
  673:         return payload
  674:     if not path.is_file():
  675:         return payload
  676:     try:
  677:         db = sqlite3.connect(path)
  678:         try:
  679:             _check_schema(db)
  680:             scope_key = _scope_key(snapshot) if snapshot is not None else None
  681:             if scope_key:
  682:                 row = db.execute("SELECT status, generation, resource_count, document_count, failed_file_count, last_successful_refresh, last_full_reconciliation, last_error, allowed_resource_ids, snapshot_checksum FROM index_state WHERE scope_key=?", (scope_key,)).fetchone()
  683:                 current_resources = authorized_roots(project_root, snapshot or {})
  684:                 resource_ids = indexable_resource_ids(current_resources)
  685:                 if not row:
  686:                     payload["status"] = "stale"
  687:                     payload["stale_resource_count"] = len(resource_ids) or 1
  688:                     payload["error"] = "scope_not_indexed"
  689:                     return payload
  690:                 if row[9] != _snapshot_checksum(snapshot or {}):
  691:                     payload["status"] = "stale"
  692:                     payload["stale_resource_count"] = len(resource_ids) or 1
  693:                     payload["error"] = "snapshot_checksum_changed"
  694:                     return payload
  695:                 if json.loads(row[8] or "[]") != sorted(resource_ids):
  696:                     payload["status"] = "stale"
  697:                     payload["stale_resource_count"] = len(resource_ids) or 1
  698:                     payload["error"] = "allowed_resources_changed"
  699:                     return payload
  700:                 missing_resources = [item for item in resource_ids if not db.execute("SELECT 1 FROM resources WHERE resource_id=?", (item,)).fetchone()]
  701:                 if missing_resources:
  702:                     payload["status"] = "stale"
  703:                     payload["stale_resource_count"] = len(missing_resources)
  704:                     payload["error"] = "resource_not_indexed"
  705:                     return payload
  706:                 if verify_files and snapshot is not None:
  707:                     current = _document_fingerprint_map(current_resources)
  708:                     stored = _stored_fingerprint_map(db, resource_ids)
  709:                     if stored != current:
  710:                         payload.update({"status": "stale", "stale_resource_count": 1, "resource_count": row[2], "document_count": row[3], "failed_file_count": row[4], "last_successful_refresh": row[5], "last_full_reconciliation": row[6], "error": "document_fingerprint_changed"})
  711:                         return payload
  712:                 payload.update({"status": row[0], "generation": row[1], "resource_count": row[2], "document_count": row[3], "failed_file_count": row[4], "last_successful_refresh": row[5], "last_full_reconciliation": row[6]})
  713:                 if row[7]:
  714:                     payload["error"] = row[7]
  715:             else:
  716:                 row = db.execute("SELECT count(*), count(*), COALESCE((SELECT count(*) FROM documents), 0), 0, max(indexed_at), max(indexed_at) FROM resources").fetchone()
  717:                 payload.update(
  718:                     {
  719:                         "status": "fresh" if row and row[0] else "missing",
  720:                         "resource_count": int(row[1] or 0) if row else 0,
  721:                         "document_count": int(row[2] or 0) if row else 0,
  722:                         "failed_file_count": int(row[3] or 0) if row else 0,
  723:                         "last_successful_refresh": row[4] if row else None,
  724:                         "last_full_reconciliation": row[5] if row else None,
  725:                     }
  726:                 )
  727:         finally:
  728:             db.close()
  729:     except (OSError, sqlite3.Error, LocalSearchError, json.JSONDecodeError) as exc:
  730:         payload["status"] = "degraded"
  731:         payload["error"] = _error_code(exc) or "index_unreadable"
  732:     return payload
  733: 
  734: 
  735: def mark_index_dirty(project_root: Path, snapshot: dict[str, Any] | None = None, *, workplace_root: Path | None = None, reason: str = "dirty") -> dict[str, Any]:
  736:     path = index_path(project_root, workplace_root)
  737:     payload = {"schema_version": 1, "kind": "pf.search_index.dirty_mark", "path": str(path), "reason": reason, "status": "missing", "marked_scope_count": 0}
  738:     if not path.is_file():
  739:         return payload
  740:     db = sqlite3.connect(path)
  741:     try:
  742:         _check_schema(db)
  743:         scope_key = _scope_key(snapshot) if snapshot is not None else None
  744:         if scope_key:
  745:             cursor = db.execute("UPDATE index_state SET status='stale', last_error=? WHERE scope_key=?", (reason, scope_key))
  746:         else:
  747:             cursor = db.execute("UPDATE index_state SET status='stale', last_error=?", (reason,))
  748:         db.commit()
  749:         payload["status"] = "stale" if cursor.rowcount else "missing"
  750:         payload["marked_scope_count"] = int(cursor.rowcount or 0)
  751:     finally:
  752:         db.close()
  753:     return payload
  754: 
  755: 
  756: def maintenance_tick(project_root: Path, snapshot: dict[str, Any], *, workplace_root: Path | None = None, verify_files: bool = True) -> dict[str, Any]:
  757:     before = index_status(project_root, snapshot, workplace_root=workplace_root, verify_files=verify_files)
  758:     action = "none"
  759:     result: dict[str, Any] | None = None
  760:     error = str(before.get("error") or "")
  761:     try:
  762:         if before.get("status") in {"missing", "stale"}:
  763:             result = build_index(project_root, snapshot, workplace_root=workplace_root)
  764:             action = "refresh"
  765:         elif before.get("status") == "degraded" and error != "fts5_unavailable":
  766:             result = rebuild_index(project_root, snapshot, workplace_root=workplace_root)
  767:             action = "rebuild"
  768:     except (OSError, sqlite3.Error, LocalSearchError) as exc:
  769:         action = "failed_" + ("rebuild" if before.get("status") == "degraded" else "refresh")
  770:         after_failure = index_status(project_root, snapshot, workplace_root=workplace_root, verify_files=False)
  771:         after_failure["status"] = "degraded"
  772:         after_failure["error"] = _error_code(exc)
  773:         return {"schema_version": 1, "kind": "pf.search_index.maintenance_tick", "action": action, "before": before, "after": after_failure, "result": result}
  774:     after = index_status(project_root, snapshot, workplace_root=workplace_root, verify_files=False)
  775:     return {"schema_version": 1, "kind": "pf.search_index.maintenance_tick", "action": action, "before": before, "after": after, "result": result}
  776: 
  777: 
  778: def search(project_root: Path, snapshot: dict[str, Any], *, query: Any, limit: Any = None, limitstart: Any = None, offset: Any = None, workplace_root: Path | None = None) -> dict[str, Any]:
  779:     if not isinstance(query, str) or not query.strip():
  780:         raise LocalSearchError("invalid_query")
  781:     page_limit, start = pagination(limit=limit, limitstart=limitstart, offset=offset)
  782:     path = index_path(project_root, workplace_root)
  783:     scope_key = _scope_key(snapshot)
  784:     resource_ids = indexable_resource_ids(authorized_roots(project_root, snapshot))
  785:     # The physical database is maintained from the Workplace resource
  786:     # catalogue.  A project snapshot is deliberately only an authorization
  787:     # filter for the query and must not make a fresh Workplace index appear
  788:     # stale merely because another project has a different checksum.
  789:     state = index_status(project_root, None if workplace_root is not None else snapshot, workplace_root=workplace_root, verify_files=False)
  790:     if state.get("status") != "fresh":
  791:         return {
  792:             "schema_version": 1,
  793:             "kind": "pf.search",
  794:             "search_status": state.get("status"),
  795:             "index_generation": state.get("generation"),
  796:             "query": query,
  797:             "total": 0,
  798:             "limit": page_limit,
  799:             "offset": start,
  800:             "items": [],
  801:             "results": [],
  802:             "page": {"limit": page_limit, "limitstart": start, "offset": start, "returned": 0, "total": 0, "next_limitstart": None},
  803:             "degraded_reason": state.get("error") or "index_not_fresh",
  804:         }
  805:     if not resource_ids:
  806:         return {
  807:             "schema_version": 1,
  808:             "kind": "pf.search",
  809:             "search_status": "fresh",
  810:             "index_generation": state.get("generation"),
  811:             "query": query,
  812:             "total": 0,
  813:             "limit": page_limit,
  814:             "offset": start,
  815:             "items": [],
  816:             "results": [],
  817:             "page": {"limit": page_limit, "limitstart": start, "offset": start, "returned": 0, "total": 0, "next_limitstart": None},
  818:         }
  819:     try:
  820:         db = sqlite3.connect(path)
  821:     except OSError as exc:
  822:         raise LocalSearchError("search_unavailable") from exc
  823:     fts_query = '"' + query.replace('"', '""') + '"'
  824:     placeholders = ",".join("?" for _ in resource_ids)
  825:     args = [fts_query, *resource_ids]
  826:     try:
  827:         try:
  828:             total = int(db.execute(f"SELECT count(*) FROM documents_fts WHERE documents_fts MATCH ? AND resource_id IN ({placeholders})", args).fetchone()[0])
  829:             rows = db.execute(
  830:                 f"SELECT d.id, d.resource_id, d.package_id, d.kind, d.relative_path, d.metadata, bm25(documents_fts) FROM documents_fts JOIN documents d ON d.id = documents_fts.document_id WHERE documents_fts MATCH ? AND documents_fts.resource_id IN ({placeholders}) ORDER BY bm25(documents_fts), d.resource_id, d.relative_path LIMIT ? OFFSET ?",
  831:                 [*args, page_limit, start],
  832:             ).fetchall()
  833:         except sqlite3.OperationalError as exc:
  834:             raise LocalSearchError("invalid_query" if "syntax" in str(exc).lower() else "search_unavailable") from exc
  835:     finally:
  836:         db.close()
  837:     expected = _snapshot_checksum(snapshot)
  838:     items: list[dict[str, Any]] = []
  839:     for row in rows:
  840:         metadata = json.loads(row[5] or "{}")
  841:         items.append(
  842:             {
  843:                 "document_id": row[0],
  844:                 "resource_id": row[1],
  845:                 "resource_type": row[3],
  846:                 "title": row[4],
  847:                 "provenance": {"package_id": row[2], "kind": row[3], "snapshot_checksum": expected},
  848:                 "canonical_path": row[4],
  849:                 "relative_path": row[4],
  850:                 "path_ref": f"{row[1]}:{row[4]}",
  851:                 "metadata": metadata,
  852:                 "match_reason": "content" if metadata.get("mode") == "fulltext" else "metadata",
  853:                 "match": {"fields": ["title", "content"], "rank": row[6], "reason": "FTS5 title/content match"},
  854:             }
  855:         )
  856:     return {
  857:         "schema_version": 1,
  858:         "kind": "pf.search",
  859:         "search_status": "fresh",
  860:         "index_generation": state.get("generation"),
  861:         "scope_key": scope_key,
  862:         "query": query,
  863:         "total": total,
  864:         "limit": page_limit,
  865:         "offset": start,
  866:         "items": items,
  867:         "results": items,
  868:         "page": {"limit": page_limit, "limitstart": start, "offset": start, "returned": len(rows), "total": total, "next_limitstart": start + len(rows) if start + len(rows) < total else None},
  869:     }

===== src/processforge_core/core_update.py =====
    1: """Manifest-based ProcessForge core update primitives.
    2: 
    3: The service is intentionally file-system scoped.  It does not discover update
    4: servers or workplace registries; callers provide an explicit core root and,
    5: for update operations, an explicit release archive.
    6: """
    7: 
    8: from __future__ import annotations
    9: 
   10: import hashlib
   11: import json
   12: import os
   13: import shutil
   14: import zipfile
   15: from dataclasses import dataclass
   16: from datetime import datetime, timezone
   17: from pathlib import Path
   18: from typing import Any, Iterable
   19: 
   20: 
   21: CORE_MANIFEST_NAME = "processforge-core.manifest.json"
   22: CORE_MANIFEST_SCHEMA_VERSION = 1
   23: WORKPLACE_MIGRATION_KIND = "processforge.workplace_migration"
   24: 
   25: 
   26: @dataclass(frozen=True)
   27: class CoreUpdateError(Exception):
   28:     code: str
   29:     message: str
   30: 
   31: 
   32: def now_utc() -> str:
   33:     return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
   34: 
   35: 
   36: def sha256_bytes(content: bytes) -> str:
   37:     return hashlib.sha256(content).hexdigest()
   38: 
   39: 
   40: def sha256_file(path: Path) -> str:
   41:     digest = hashlib.sha256()
   42:     with path.open("rb") as handle:
   43:         for chunk in iter(lambda: handle.read(1024 * 1024), b""):
   44:             digest.update(chunk)
   45:     return digest.hexdigest()
   46: 
   47: 
   48: def safe_relative_path(raw: Any) -> str:
   49:     if not isinstance(raw, str) or not raw.strip():
   50:         raise CoreUpdateError("invalid_manifest_path", "manifest path is empty")
   51:     value = raw.replace("\\", "/")
   52:     if value != raw:
   53:         raise CoreUpdateError("invalid_manifest_path", f"manifest path contains backslash: {raw}")
   54:     if value.startswith("/") or value.startswith("//") or (len(value) > 1 and value[1] == ":"):
   55:         raise CoreUpdateError("invalid_manifest_path", f"manifest path is absolute: {raw}")
   56:     parts = value.split("/")
   57:     if any(part in {"", ".", ".."} for part in parts):
   58:         raise CoreUpdateError("invalid_manifest_path", f"manifest path escapes or is not normalized: {raw}")
   59:     if value == CORE_MANIFEST_NAME:
   60:         raise CoreUpdateError("invalid_manifest_path", f"{CORE_MANIFEST_NAME} is a control file, not an owned payload file")
   61:     return value
   62: 
   63: 
   64: def ensure_inside(root: Path, relative_path: str) -> Path:
   65:     root_resolved = root.resolve()
   66:     target = (root / relative_path).resolve()
   67:     if root_resolved != target and root_resolved not in target.parents:
   68:         raise CoreUpdateError("path_outside_core_root", f"path escapes core root: {relative_path}")
   69:     return target
   70: 
   71: 
   72: def manifest_path(core_root: Path) -> Path:
   73:     return core_root / CORE_MANIFEST_NAME
   74: 
   75: 
   76: def runtime_root(core_root: Path) -> Path:
   77:     return core_root / "runtime" / "core-update"
   78: 
   79: 
   80: def manifest_file_map(manifest: dict[str, Any]) -> dict[str, dict[str, Any]]:
   81:     if manifest.get("schema_version") != CORE_MANIFEST_SCHEMA_VERSION:
   82:         raise CoreUpdateError("invalid_core_manifest", "core manifest schema_version must be 1")
   83:     files = manifest.get("files")
   84:     if not isinstance(files, list):
   85:         raise CoreUpdateError("invalid_core_manifest", "core manifest files must be a list")
   86:     result: dict[str, dict[str, Any]] = {}
   87:     for item in files:
   88:         if not isinstance(item, dict):
   89:             raise CoreUpdateError("invalid_core_manifest", "core manifest file entry must be an object")
   90:         relative_path = safe_relative_path(item.get("relative_path") or item.get("path"))
   91:         digest = item.get("sha256")
   92:         if not isinstance(digest, str) or len(digest) != 64 or any(char not in "0123456789abcdefABCDEF" for char in digest):
   93:             raise CoreUpdateError("invalid_core_manifest", f"invalid sha256 for {relative_path}")
   94:         result[relative_path] = {**item, "relative_path": relative_path, "sha256": digest.lower()}
   95:     return result
   96: 
   97: 
   98: def make_core_manifest(*, version: str, source: dict[str, Any] | None, files: Iterable[dict[str, Any]], generated_at: str | None = None) -> dict[str, Any]:
   99:     normalized_files = []
  100:     for item in files:
  101:         relative_path = safe_relative_path(item.get("relative_path") or item.get("path"))
  102:         normalized_files.append(
  103:             {
  104:                 "relative_path": relative_path,
  105:                 "size": int(item.get("size") or 0),
  106:                 "sha256": str(item.get("sha256") or "").lower(),
  107:             }
  108:         )
  109:     normalized_files.sort(key=lambda row: row["relative_path"])
  110:     manifest = {
  111:         "schema_version": CORE_MANIFEST_SCHEMA_VERSION,
  112:         "kind": "processforge.core_manifest",
  113:         "version": version,
  114:         "generated_at": generated_at or now_utc(),
  115:         "source": source or {},
  116:         "files": normalized_files,
  117:     }
  118:     manifest_file_map(manifest)
  119:     return manifest
  120: 
  121: 
  122: def make_core_manifest_from_release_files(files: list[tuple[str, Path]], *, version: str, source: dict[str, Any] | None, generated_at: str | None = None) -> dict[str, Any]:
  123:     entries = []
  124:     for archive_path, source_path in files:
  125:         if archive_path == CORE_MANIFEST_NAME:
  126:             continue
  127:         entries.append({"relative_path": archive_path, "size": source_path.stat().st_size, "sha256": sha256_file(source_path)})
  128:     return make_core_manifest(version=version, source=source, files=entries, generated_at=generated_at)
  129: 
  130: 
  131: def manifest_bytes(manifest: dict[str, Any]) -> bytes:
  132:     return (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode("utf-8")
  133: 
  134: 
  135: def read_manifest(path: Path) -> dict[str, Any]:
  136:     try:
  137:         data = json.loads(path.read_text(encoding="utf-8"))
  138:     except FileNotFoundError as exc:
  139:         raise CoreUpdateError("manifest_missing", f"manifest not found: {path}") from exc
  140:     except json.JSONDecodeError as exc:
  141:         raise CoreUpdateError("manifest_invalid_json", f"invalid manifest JSON: {path}: {exc}") from exc
  142:     if not isinstance(data, dict):
  143:         raise CoreUpdateError("invalid_core_manifest", "core manifest must be an object")
  144:     manifest_file_map(data)
  145:     return data
  146: 
  147: 
  148: def read_archive_manifest(archive_path: Path) -> dict[str, Any]:
  149:     try:
  150:         with zipfile.ZipFile(archive_path) as archive:
  151:             try:
  152:                 raw = archive.read(CORE_MANIFEST_NAME)
  153:             except KeyError as exc:
  154:                 raise CoreUpdateError("archive_manifest_missing", f"archive does not contain {CORE_MANIFEST_NAME}") from exc
  155:     except zipfile.BadZipFile as exc:
  156:         raise CoreUpdateError("archive_invalid", f"invalid ZIP archive: {archive_path}") from exc
  157:     try:
  158:         data = json.loads(raw.decode("utf-8"))
  159:     except (UnicodeDecodeError, json.JSONDecodeError) as exc:
  160:         raise CoreUpdateError("archive_manifest_invalid", f"archive manifest is invalid JSON: {exc}") from exc
  161:     if not isinstance(data, dict):
  162:         raise CoreUpdateError("invalid_core_manifest", "archive core manifest must be an object")
  163:     manifest_file_map(data)
  164:     return data
  165: 
  166: 
  167: def validate_archive_payload(archive_path: Path, manifest: dict[str, Any]) -> None:
  168:     new_files = manifest_file_map(manifest)
  169:     try:
  170:         with zipfile.ZipFile(archive_path) as archive:
  171:             names = set(archive.namelist())
  172:             for relative_path, entry in new_files.items():
  173:                 if relative_path not in names:
  174:                     raise CoreUpdateError("archive_file_missing", f"archive file missing: {relative_path}")
  175:                 actual = sha256_bytes(archive.read(relative_path))
  176:                 if actual != entry["sha256"]:
  177:                     raise CoreUpdateError("archive_checksum_mismatch", f"archive file sha256 mismatch: {relative_path}")
  178:             for name in names:
  179:                 if name.endswith("/"):
  180:                     continue
  181:                 if name == CORE_MANIFEST_NAME:
  182:                     continue
  183:                 safe_relative_path(name)
  184:     except zipfile.BadZipFile as exc:
  185:         raise CoreUpdateError("archive_invalid", f"invalid ZIP archive: {archive_path}") from exc
  186: 
  187: 
  188: def load_yaml_bytes(content: bytes, *, source: str) -> dict[str, Any]:
  189:     try:
  190:         import yaml  # type: ignore
  191:     except ModuleNotFoundError as exc:
  192:         raise CoreUpdateError("yaml_support_missing", "PyYAML is required for Workplace migration") from exc
  193:     try:
  194:         data = yaml.safe_load(content.decode("utf-8"))
  195:     except (UnicodeDecodeError, yaml.YAMLError) as exc:  # type: ignore[attr-defined]
  196:         raise CoreUpdateError("workplace_migration_invalid", f"invalid YAML in {source}: {exc}") from exc
  197:     if not isinstance(data, dict):
  198:         raise CoreUpdateError("workplace_migration_invalid", f"migration document must be a mapping: {source}")
  199:     return data
  200: 
  201: 
  202: def dump_yaml_bytes(data: dict[str, Any]) -> bytes:
  203:     try:
  204:         import yaml  # type: ignore
  205:     except ModuleNotFoundError as exc:
  206:         raise CoreUpdateError("yaml_support_missing", "PyYAML is required for Workplace migration") from exc
  207:     return yaml.safe_dump(data, allow_unicode=True, sort_keys=False).encode("utf-8")
  208: 
  209: 
  210: def load_archive_workplace_migration(archive_path: Path, *, installed_version: str | None, target_version: str) -> tuple[str | None, dict[str, Any] | None]:
  211:     """Select the one declared Workplace migration applicable to this Core plan."""
  212:     try:
  213:         with zipfile.ZipFile(archive_path) as archive:
  214:             for name in sorted(archive.namelist()):
  215:                 if not name.startswith("updates/migrations/") or not name.endswith((".yaml", ".yml")):
  216:                     continue
  217:                 migration = load_yaml_bytes(archive.read(name), source=name)
  218:                 if migration.get("kind") != WORKPLACE_MIGRATION_KIND:
  219:                     continue
  220:                 if str(migration.get("to_version") or "") != target_version:
  221:                     continue
  222:                 versions = migration.get("from_versions")
  223:                 allowed = {str(value) for value in versions} if isinstance(versions, list) else set()
  224:                 if installed_version not in allowed and not (installed_version is None and migration.get("allow_unmanaged_installed_core") is True):
  225:                     continue
  226:                 return name, migration
  227:     except zipfile.BadZipFile as exc:
  228:         raise CoreUpdateError("archive_invalid", f"invalid ZIP archive: {archive_path}") from exc
  229:     return None, None
  230: 
  231: 
  232: def workplace_target(workplace_root: Path, relative_path: str) -> Path:
  233:     return ensure_inside(workplace_root, safe_relative_path(relative_path))
  234: 
  235: 
  236: def workplace_migration_plan(core_root: Path, archive_path: Path, *, installed_version: str | None, target_version: str, workplace_root: Path | None) -> dict[str, Any]:
  237:     result: dict[str, Any] = {
  238:         "status": "not_requested",
  239:         "workplace_root": str(workplace_root.resolve()) if workplace_root else None,
  240:         "migration": None,
  241:         "operations": [],
  242:         "preserved": [],
  243:         "blockers": [],
  244:     }
  245:     if workplace_root is None:
  246:         return result
  247:     workplace_root = workplace_root.resolve()
  248:     if not (workplace_root / "workplace.yaml").is_file():
  249:         result.update({"status": "blocked", "blockers": [{"code": "workplace_manifest_missing", "path": str(workplace_root / "workplace.yaml")} ]})
  250:         return result
  251:     source_path, migration = load_archive_workplace_migration(
  252:         archive_path, installed_version=installed_version, target_version=target_version
  253:     )
  254:     if migration is None:
  255:         result["status"] = "not_applicable"
  256:         return result
  257:     migration_id = str(migration.get("id") or "")
  258:     operations = migration.get("operations")
  259:     if not migration_id or not isinstance(operations, list):
  260:         raise CoreUpdateError("workplace_migration_invalid", f"migration {source_path} requires id and operations")
  261:     result.update({"status": "planned", "migration": {"id": migration_id, "source": source_path}})
  262:     for item in operations:
  263:         if not isinstance(item, dict):
  264:             raise CoreUpdateError("workplace_migration_invalid", f"migration {migration_id} contains a non-object operation")
  265:         operation_id = str(item.get("id") or "")
  266:         operation_type = str(item.get("type") or "")
  267:         target_path = str(item.get("target") or "")
  268:         if not operation_id or not target_path:
  269:             raise CoreUpdateError("workplace_migration_invalid", f"migration {migration_id} operation requires id and target")
  270:         target = workplace_target(workplace_root, target_path)
  271:         if operation_type == "copy_if_missing":
  272:             source = safe_relative_path(item.get("source"))
  273:             if target.exists():
  274:                 result["preserved"].append({"id": operation_id, "path": target_path, "reason": "existing_file"})
  275:             else:
  276:                 result["operations"].append({"id": operation_id, "type": operation_type, "source": source, "target": target_path})
  277:             continue
  278:         if operation_type == "append_registry_entry_if_missing":
  279:             list_key = str(item.get("list_key") or "")
  280:             match_key = str(item.get("match_key") or "id")
  281:             entry = item.get("entry")
  282:             if not list_key or not isinstance(entry, dict) or not entry.get(match_key):
  283:                 raise CoreUpdateError("workplace_migration_invalid", f"migration {migration_id} registry operation {operation_id} is invalid")
  284:             data = load_yaml_bytes(target.read_bytes(), source=target_path) if target.is_file() else {"schema_version": 1}
  285:             current = data.get(list_key)
  286:             if current is None:
  287:                 current = []
  288:             if not isinstance(current, list):
  289:                 raise CoreUpdateError("workplace_migration_invalid", f"registry list is invalid: {target_path}:{list_key}")
  290:             if any(isinstance(row, dict) and row.get(match_key) == entry[match_key] for row in current):
  291:                 result["preserved"].append({"id": operation_id, "path": target_path, "reason": "existing_registry_entry", "value": entry[match_key]})
  292:             else:
  293:                 result["operations"].append({"id": operation_id, "type": operation_type, "target": target_path, "list_key": list_key, "entry": entry})
  294:             continue
  295:         raise CoreUpdateError("workplace_migration_invalid", f"unsupported migration operation: {operation_type}")
  296:     return result
  297: 
  298: 
  299: def backup_workplace_target(workplace_root: Path, backup_dir: Path, relative_path: str) -> dict[str, Any]:
  300:     source = workplace_target(workplace_root, relative_path)
  301:     record: dict[str, Any] = {"path": relative_path, "existed": source.is_file()}
  302:     if source.is_file():
  303:         target = backup_dir / "workplace" / "files" / relative_path
  304:         target.parent.mkdir(parents=True, exist_ok=True)
  305:         shutil.copy2(source, target)
  306:         record["backup"] = str(target.relative_to(backup_dir).as_posix())
  307:     return record
  308: 
  309: 
  310: def apply_workplace_migration(archive_path: Path, workplace_root: Path, migration_plan: dict[str, Any], backup_dir: Path) -> dict[str, Any]:
  311:     operations = migration_plan.get("operations") if isinstance(migration_plan.get("operations"), list) else []
  312:     backed_up: list[dict[str, Any]] = []
  313:     with zipfile.ZipFile(archive_path) as archive:
  314:         for operation in operations:
  315:             if not isinstance(operation, dict):
  316:                 continue
  317:             target_path = str(operation["target"])
  318:             backed_up.append(backup_workplace_target(workplace_root, backup_dir, target_path))
  319:             target = workplace_target(workplace_root, target_path)
  320:             if operation["type"] == "copy_if_missing":
  321:                 atomic_write(target, archive.read(str(operation["source"])))
  322:             elif operation["type"] == "append_registry_entry_if_missing":
  323:                 data = load_yaml_bytes(target.read_bytes(), source=target_path) if target.is_file() else {"schema_version": 1}
  324:                 values = data.get(str(operation["list_key"]))
  325:                 if not isinstance(values, list):
  326:                     values = []
  327:                     data[str(operation["list_key"])] = values
  328:                 values.append(operation["entry"])
  329:                 atomic_write(target, dump_yaml_bytes(data))
  330:     record = {
  331:         "schema_version": 1,
  332:         "migration": migration_plan.get("migration"),
  333:         "applied_at": now_utc(),
  334:         "operations": operations,
  335:         "preserved": migration_plan.get("preserved", []),
  336:         "backed_up": backed_up,
  337:     }
  338:     write_json(backup_dir / "workplace-migration.json", record)
  339:     return record
  340: 
  341: 
  342: def installed_manifest(core_root: Path) -> dict[str, Any] | None:
  343:     path = manifest_path(core_root)
  344:     return read_manifest(path) if path.is_file() else None
  345: 
  346: 
  347: def unowned_path_blocker(
  348:     core_root: Path,
  349:     relative_path: str,
  350:     *,
  351:     removable_owned_paths: set[str] | frozenset[str] = frozenset(),
  352: ) -> dict[str, str] | None:
  353:     """Return a blocker when an added payload would replace an unowned path.
  354: 
  355:     ``Path.exists()`` does not report broken symlinks, and resolving a path
  356:     through a non-directory ancestor can defer the failure until apply has
  357:     already created update state.  Inspect the lexical path first so all
  358:     existing objects, including symlinks, are protected before any mutation.
  359:     """
  360:     target = core_root / relative_path
  361:     if os.path.lexists(target):
  362:         return {"code": "unowned_path_collision", "path": relative_path, "conflict_path": relative_path}
  363: 
  364:     ancestor = target.parent
  365:     while ancestor != core_root:
  366:         if os.path.lexists(ancestor) and (ancestor.is_symlink() or not ancestor.is_dir()):
  367:             conflict_path = ancestor.relative_to(core_root).as_posix()
  368:             if (
  369:                 conflict_path in removable_owned_paths
  370:                 and ancestor.is_file()
  371:                 and not ancestor.is_symlink()
  372:             ):
  373:                 ancestor = ancestor.parent
  374:                 continue
  375:             return {"code": "unowned_path_collision", "path": relative_path, "conflict_path": conflict_path}
  376:         ancestor = ancestor.parent
  377:     return None
  378: 
  379: 
  380: def build_plan(core_root: Path, archive_path: Path, *, workplace_root: Path | None = None) -> dict[str, Any]:
  381:     core_root = core_root.resolve()
  382:     archive_path = archive_path.resolve()
  383:     new_manifest = read_archive_manifest(archive_path)
  384:     validate_archive_payload(archive_path, new_manifest)
  385:     old_manifest = installed_manifest(core_root)
  386:     old_files = manifest_file_map(old_manifest) if old_manifest else {}
  387:     new_files = manifest_file_map(new_manifest)
  388:     old_paths = set(old_files)
  389:     new_paths = set(new_files)
  390:     added = sorted(new_paths - old_paths)
  391:     removed = sorted(old_paths - new_paths)
  392:     common = old_paths & new_paths
  393:     changed = sorted(path for path in common if old_files[path]["sha256"] != new_files[path]["sha256"])
  394:     unchanged = sorted(path for path in common if old_files[path]["sha256"] == new_files[path]["sha256"])
  395:     locally_modified = []
  396:     missing_owned = []
  397:     blockers = []
  398:     for relative_path in sorted(old_paths):
  399:         target = core_root / relative_path
  400:         if target.is_symlink() or (os.path.lexists(target) and not target.is_file()):
  401:             blockers.append({"code": "nonregular_owned_path", "path": relative_path})
  402:             continue
  403:         if not target.exists():
  404:             missing_owned.append(relative_path)
  405:             collision = unowned_path_blocker(core_root, relative_path)
  406:             if collision:
  407:                 blockers.append(collision)
  408:             continue
  409:         target = ensure_inside(core_root, relative_path)
  410:         if sha256_file(target) != old_files[relative_path]["sha256"]:
  411:             locally_modified.append(relative_path)
  412:     restored = sorted(set(missing_owned).intersection(unchanged))
  413:     for relative_path in sorted(set(locally_modified).intersection(set(removed).union(changed))):
  414:         blockers.append({"code": "locally_modified", "path": relative_path})
  415:     for relative_path in added:
  416:         collision = unowned_path_blocker(core_root, relative_path, removable_owned_paths=set(removed))
  417:         if collision is not None:
  418:             blockers.append(collision)
  419:     incomplete = (runtime_root(core_root) / "in-progress.json").is_file()
  420:     if incomplete:
  421:         blockers.append({"code": "incomplete_update", "path": str(runtime_root(core_root) / "in-progress.json")})
  422:     migration = workplace_migration_plan(
  423:         core_root,
  424:         archive_path,
  425:         installed_version=old_manifest.get("version") if old_manifest else None,
  426:         target_version=str(new_manifest.get("version") or ""),
  427:         workplace_root=workplace_root,
  428:     )
  429:     blockers.extend(migration.get("blockers", []))
  430:     return {
  431:         "schema_version": 1,
  432:         "kind": "processforge.core_update.plan",
  433:         "status": "blocked" if blockers else "planned",
  434:         "core_root": str(core_root),
  435:         "archive": str(archive_path),
  436:         "installed_manifest": str(manifest_path(core_root)) if old_manifest else None,
  437:         "installed_version": old_manifest.get("version") if old_manifest else None,
  438:         "available_version": new_manifest.get("version"),
  439:         "counts": {"added": len(added), "removed": len(removed), "changed": len(changed), "unchanged": len(unchanged), "locally_modified": len(locally_modified), "missing_owned": len(missing_owned), "restored": len(restored)},
  440:         "added": added,
  441:         "removed": removed,
  442:         "changed": changed,
  443:         "unchanged": unchanged,
  444:         "locally_modified": locally_modified,
  445:         "missing_owned": missing_owned,
  446:         "restored": restored,
  447:         "blockers": blockers,
  448:         "workplace_migration": migration,
  449:         "new_manifest": new_manifest,
  450:     }
  451: 
  452: 
  453: def core_status(core_root: Path) -> dict[str, Any]:
  454:     core_root = core_root.resolve()
  455:     manifest = installed_manifest(core_root)
  456:     incomplete_path = runtime_root(core_root) / "in-progress.json"
  457:     payload = {
  458:         "schema_version": 1,
  459:         "kind": "processforge.core_update.status",
  460:         "core_root": str(core_root),
  461:         "status": "installed" if manifest else "not_installed",
  462:         "manifest": str(manifest_path(core_root)),
  463:         "version": manifest.get("version") if manifest else None,
  464:         "file_count": len(manifest_file_map(manifest)) if manifest else 0,
  465:         "incomplete_update": incomplete_path.is_file(),
  466:     }
  467:     if incomplete_path.is_file():
  468:         try:
  469:             payload["in_progress"] = json.loads(incomplete_path.read_text(encoding="utf-8"))
  470:         except json.JSONDecodeError:
  471:             payload["in_progress"] = {"status": "unreadable"}
  472:     return payload
  473: 
  474: 
  475: def backup_file(core_root: Path, backup_dir: Path, relative_path: str) -> str | None:
  476:     source = ensure_inside(core_root, relative_path)
  477:     if not source.is_file():
  478:         return None
  479:     target = backup_dir / "files" / relative_path
  480:     target.parent.mkdir(parents=True, exist_ok=True)
  481:     shutil.copy2(source, target)
  482:     return str(target.relative_to(backup_dir).as_posix())
  483: 
  484: 
  485: def prune_empty_parents(core_root: Path, relative_path: str) -> None:
  486:     root = core_root.resolve()
  487:     parent = ensure_inside(root, relative_path).parent
  488:     while parent != root and root in parent.parents:
  489:         try:
  490:             parent.rmdir()
  491:         except OSError:
  492:             break
  493:         parent = parent.parent
  494: 
  495: 
  496: def atomic_write(target: Path, content: bytes) -> None:
  497:     target.parent.mkdir(parents=True, exist_ok=True)
  498:     temporary = target.with_name(target.name + ".pf-update-tmp")
  499:     with temporary.open("wb") as handle:
  500:         handle.write(content)
  501:         handle.flush()
  502:         try:
  503:             os.fsync(handle.fileno())
  504:         except OSError:
  505:             pass
  506:     os.replace(temporary, target)
  507: 
  508: 
  509: def write_json(path: Path, payload: dict[str, Any]) -> None:
  510:     path.parent.mkdir(parents=True, exist_ok=True)
  511:     path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
  512: 
  513: 
  514: def apply_update(
  515:     core_root: Path,
  516:     archive_path: Path,
  517:     *,
  518:     confirm: bool = False,
  519:     force_local_modifications: bool = False,
  520:     workplace_root: Path | None = None,
  521: ) -> dict[str, Any]:
  522:     if not confirm:
  523:         raise CoreUpdateError("confirm_required", "core update apply requires explicit confirmation")
  524:     plan = build_plan(core_root, archive_path, workplace_root=workplace_root)
  525:     blockers = [item for item in plan["blockers"] if item.get("code") != "locally_modified" or not force_local_modifications]
  526:     if blockers:
  527:         raise CoreUpdateError("plan_blocked", "core update plan has blockers")
  528:     update_id = "core-update-" + now_utc().replace(":", "").replace("-", "")
  529:     work_root = runtime_root(core_root)
  530:     backup_dir = work_root / "backups" / update_id
  531:     backup_dir.mkdir(parents=True, exist_ok=True)
  532:     in_progress_path = work_root / "in-progress.json"
  533:     in_progress_path.parent.mkdir(parents=True, exist_ok=True)
  534:     backed_up: dict[str, str | None] = {}
  535:     pending_operations: list[dict[str, str]] = []
  536:     missing_unchanged = set(plan["restored"])
  537:     backup_paths = set(plan["removed"]).union(plan["changed"]).union(missing_unchanged)
  538:     for relative_path in sorted(backup_paths):
  539:         pending_operations.append({"op": "backup", "path": relative_path})
  540:     for relative_path in plan["removed"]:
  541:         pending_operations.append({"op": "delete", "path": relative_path})
  542:     write_paths = set(plan["added"]).union(plan["changed"]).union(missing_unchanged)
  543:     for relative_path in sorted(write_paths):
  544:         pending_operations.append({"op": "write", "path": relative_path})
  545:     migration = plan.get("workplace_migration") if isinstance(plan.get("workplace_migration"), dict) else {}
  546:     if migration.get("status") == "planned" and migration.get("operations"):
  547:         pending_operations.append({"op": "workplace_migration", "path": str(migration.get("migration", {}).get("id") or "workplace")})
  548:     pending_operations.append({"op": "write_manifest", "path": CORE_MANIFEST_NAME})
  549:     progress = {
  550:         "schema_version": 1,
  551:         "update_id": update_id,
  552:         "status": "applying",
  553:         "started_at": now_utc(),
  554:         "core_root": str(core_root.resolve()),
  555:         "archive": str(archive_path.resolve()),
  556:         "backup_dir": str(backup_dir),
  557:         "installed_version": plan.get("installed_version"),
  558:         "target_version": plan.get("available_version"),
  559:         "counts": plan.get("counts"),
  560:         "completed_operations": [],
  561:         "pending_operations": pending_operations,
  562:         "backed_up": backed_up,
  563:     }
  564: 
  565:     def complete_operation(op: str, relative_path: str) -> None:
  566:         completed = progress["completed_operations"]
  567:         pending = progress["pending_operations"]
  568:         assert isinstance(completed, list)
  569:         assert isinstance(pending, list)
  570:         completed.append({"op": op, "path": relative_path, "completed_at": now_utc()})
  571:         for index, item in enumerate(list(pending)):
  572:             if isinstance(item, dict) and item.get("op") == op and item.get("path") == relative_path:
  573:                 del pending[index]
  574:                 break
  575:         write_json(in_progress_path, progress)
  576: 
  577:     old_manifest = installed_manifest(core_root)
  578:     if old_manifest:
  579:         write_json(backup_dir / "control" / "old-manifest.json", old_manifest)
  580:     write_json(backup_dir / "control" / "new-manifest.json", plan["new_manifest"])
  581:     write_json(backup_dir / "control" / "plan.json", {key: value for key, value in plan.items() if key != "new_manifest"})
  582:     write_json(in_progress_path, progress)
  583:     try:
  584:         migration_record = None
  585:         if migration.get("status") == "planned" and migration.get("operations"):
  586:             if workplace_root is None:
  587:                 raise CoreUpdateError("workplace_root_missing", "Workplace migration was planned without a Workplace root")
  588:             migration_record = apply_workplace_migration(archive_path, workplace_root.resolve(), migration, backup_dir)
  589:             complete_operation("workplace_migration", str(migration.get("migration", {}).get("id") or "workplace"))
  590:         for relative_path in sorted(backup_paths):
  591:             backed_up[relative_path] = backup_file(core_root, backup_dir, relative_path)
  592:             complete_operation("backup", relative_path)
  593:         for relative_path in plan["removed"]:
  594:             target = ensure_inside(core_root, relative_path)
  595:             if target.exists():
  596:                 target.unlink()
  597:                 prune_empty_parents(core_root, relative_path)
  598:             complete_operation("delete", relative_path)
  599:         with zipfile.ZipFile(archive_path) as archive:
  600:             for relative_path in sorted(write_paths):
  601:                 content = archive.read(relative_path)
  602:                 atomic_write(ensure_inside(core_root, relative_path), content)
  603:                 complete_operation("write", relative_path)
  604:         atomic_write(manifest_path(core_root), manifest_bytes(plan["new_manifest"]))
  605:         complete_operation("write_manifest", CORE_MANIFEST_NAME)
  606:         record = {"schema_version": 1, "update_id": update_id, "status": "applied", "applied_at": now_utc(), "available_version": plan["available_version"], "backup_dir": str(backup_dir), "backed_up": backed_up, "counts": plan["counts"], "workplace_migration": migration_record}
  607:         last_apply = work_root / "last-apply.json"
  608:         write_json(last_apply, record)
  609:         in_progress_path.unlink(missing_ok=True)
  610:         return record
  611:     except CoreUpdateError:
  612:         raise
  613:     except OSError as exc:
  614:         try:
  615:             failure = {
  616:                 **progress,
  617:                 "schema_version": 1,
  618:                 "update_id": update_id,
  619:                 "status": "failed",
  620:                 "failed_at": now_utc(),
  621:                 "backup_dir": str(backup_dir),
  622:                 "error": {"code": "file_operation_failed", "message": str(exc)},
  623:             }
  624:             write_json(in_progress_path, failure)
  625:         except OSError:
  626:             pass
  627:         raise CoreUpdateError("file_operation_failed", str(exc)) from exc
  628: 
  629: 
  630: def recovery_assessment(in_progress: dict[str, Any]) -> str:
  631:     status = str(in_progress.get("status") or "")
  632:     if status not in {"failed", "applying"}:
  633:         return "manual_repair_required"
  634:     completed = in_progress.get("completed_operations")
  635:     if not isinstance(completed, list):
  636:         return "manual_repair_required"
  637:     manifest_written = any(isinstance(item, dict) and item.get("op") == "write_manifest" for item in completed)
  638:     if manifest_written:
  639:         return "manual_repair_required"
  640:     raw_backup_dir = str(in_progress.get("backup_dir") or "")
  641:     backup_dir = Path(raw_backup_dir) if raw_backup_dir else None
  642:     if status == "failed" and backup_dir is not None and backup_dir.is_dir() and (backup_dir / "control" / "old-manifest.json").is_file():
  643:         return "safe_to_rollback"
  644:     return "manual_repair_required"
  645: 
  646: 
  647: def repair_status(core_root: Path) -> dict[str, Any]:
  648:     status = core_status(core_root)
  649:     if not status.get("incomplete_update"):
  650:         return {"schema_version": 1, "kind": "processforge.core_update.repair", "status": "nothing_to_repair", "core_root": str(core_root.resolve())}
  651:     in_progress = status.get("in_progress") if isinstance(status.get("in_progress"), dict) else {}
  652:     assessment = recovery_assessment(in_progress)
  653:     return {
  654:         "schema_version": 1,
  655:         "kind": "processforge.core_update.repair",
  656:         "status": assessment,
  657:         "core_root": str(core_root.resolve()),
  658:         "in_progress": in_progress,
  659:     }

