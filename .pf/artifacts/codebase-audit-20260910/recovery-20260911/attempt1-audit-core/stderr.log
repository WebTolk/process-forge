  107: def _snapshot_checksum(snapshot: dict[str, Any]) -> str:
  108:     value = snapshot.get("snapshot") if isinstance(snapshot.get("snapshot"), dict) else {}
  109:     return str(value.get("checksum") or value.get("sha256") or value.get("id") or "")
  110: 
  111: 
  112: def _scope_key(snapshot: dict[str, Any]) -> str:
  113:     if str(snapshot.get("search_index_scope") or "") == "workplace":
  114:         return "workplace"
  115:     checksum = _snapshot_checksum(snapshot)
  116:     return checksum or "snapshot-unknown"
  117: 
  118: 
  119: def _now_utc() -> str:
  120:     return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
  121: 
  122: 
  123: def _as_int(value: Any, *, default: int, maximum: int) -> int:
  124:     if value is None:
  125:         return default
  126:     if isinstance(value, bool):
  127:         raise LocalSearchError("invalid_limit")
  128:     try:
  129:         result = int(value)
  130:     except (TypeError, ValueError) as exc:
  131:         raise LocalSearchError("invalid_limit") from exc
  132:     if not 1 <= result <= maximum:
  133:         raise LocalSearchError("invalid_limit")
  134:     return result
  135: 
  136: 
  137: def pagination(*, limit: Any = None, limitstart: Any = None, offset: Any = None) -> tuple[int, int]:
  138:     page_limit = _as_int(limit, default=DEFAULT_LIMIT, maximum=MAX_LIMIT)
  139:     if limitstart not in (None, "") and offset not in (None, "") and str(limitstart) != str(offset):
  140:         raise LocalSearchError("ambiguous_offset")
  141:     raw_start = limitstart if limitstart not in (None, "") else offset
  142:     if raw_start in (None, ""):
  143:         return page_limit, 0
  144:     if isinstance(raw_start, bool):
  145:         raise LocalSearchError("invalid_offset")
  146:     try:
  147:         start = int(raw_start)
  148:     except (TypeError, ValueError) as exc:
  149:         raise LocalSearchError("invalid_offset") from exc
  150:     if start < 0:
  151:         raise LocalSearchError("invalid_offset")
  152:     return page_limit, start
