22005: def update_manifest_candidates_under(root: Path, patterns: list[str]) -> list[Path]:
22006:     if not root.is_dir():
22007:         return []
22008:     candidates: list[Path] = []
22009:     for pattern in patterns:
22010:         candidates.extend(sorted(root.glob(pattern)))
22011:     return [path.resolve() for path in candidates if path.is_file()]
