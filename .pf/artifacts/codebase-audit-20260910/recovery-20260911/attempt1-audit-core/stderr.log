   70: def executable_stages(process: dict[str, Any]) -> list[dict[str, Any]]:
   71:     stages = process.get("stages") if isinstance(process.get("stages"), list) else []
   72:     return [copy.deepcopy(item) for item in stages if isinstance(item, dict) and item.get("id") and item.get("executable", True) is not False]
   73: 
   74: 
   75: def initial_stage_id(process: dict[str, Any]) -> str:
   76:     stages = executable_stages(process)
   77:     stage_ids = [str(item["id"]) for item in stages]
   78:     declared = str(process.get("initial_stage") or "").strip()
   79:     if declared:
   80:         if declared not in stage_ids:
   81:             raise ValueError(f"initial stage is not executable: {declared}")
   82:         return declared
   83:     return stage_ids[0] if stage_ids else ""
   84: 
   85: 
   86: def normalized_outcomes(process: dict[str, Any], stage_id: str) -> list[dict[str, Any]]:
   87:     stages = executable_stages(process)
   88:     index = next((offset for offset, stage in enumerate(stages) if str(stage.get("id")) == stage_id), -1)
   89:     if index < 0:
   90:         return []
   91:     default_next = str(stages[index + 1].get("id")) if index + 1 < len(stages) else ""
   92:     raw = stages[index].get("outcomes")
   93:     outcomes: list[dict[str, Any]] = []
   94:     if isinstance(raw, dict):
   95:         for outcome_id, target in raw.items():
   96:             item = dict(target) if isinstance(target, dict) else {"next_stage": target}
   97:             item["id"] = str(item.get("id") or outcome_id)
   98:             outcomes.append(item)
   99:     elif isinstance(raw, list):
  100:         for value in raw:
  101:             if isinstance(value, str):
  102:                 outcomes.append({"id": value})
  103:             elif isinstance(value, dict) and value.get("id"):
  104:                 outcomes.append(copy.deepcopy(value))
  105:     if not outcomes:
  106:         outcomes = [{"id": "completed", "next_stage": default_next}]
  107:     stage_ids = {str(item.get("id")) for item in stages}
  108:     normalized: list[dict[str, Any]] = []
  109:     for item in outcomes:
  110:         outcome_id = str(item.get("id") or "").strip()
  111:         if not outcome_id:
  112:             continue
  113:         next_stage = str(item.get("next_stage") or default_next).strip()
  114:         if next_stage and next_stage not in stage_ids:
  115:             raise ValueError(f"outcome {outcome_id} routes to an unknown stage: {next_stage}")
  116:         normalized.append({"id": outcome_id, "next_stage": next_stage, "title": str(item.get("title") or outcome_id)})
  117:     return normalized
