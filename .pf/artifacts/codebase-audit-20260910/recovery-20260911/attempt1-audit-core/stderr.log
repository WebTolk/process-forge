25039: def command_template_doctor(args: argparse.Namespace) -> int:
25040:     workplace_root = Path(args.workplace).expanduser().resolve()
25041:     template_id = str(args.template)
25042:     checks: list[Check] = []
25043:     manifest_path = template_manifest_path(workplace_root, template_id)
25044:     checks.append(
25045:         check("PASS", "template manifest found")
25046:         if manifest_path
25047:         else check_with_hint(
25048:             "FAIL",
25049:             "template manifest found",
25050:             "The template id cannot be resolved through registries/templates.yaml or the default template root.",
25051:             f"python bin/pf.py template-create --workplace <workplace-root> --id {template_id} --title \"{template_id}\" --apply",
25052:         )
25053:     )
25054:     if manifest_path:
25055:         text = manifest_path.read_text(encoding="utf-8", errors="replace")
25056:         checks.append(check("PASS" if is_public_path_safe(text) else "FAIL", "template manifest has no local absolute paths"))
25057:         data = load_doctor_yaml(
25058:             manifest_path,
25059:             "reusable-template.schema.json",
25060:             f"template {template_id} manifest",
25061:             checks,
25062:         )
25063:         if data is None:
25064:             return print_checks(checks)
25065:         if data.get("schema_version") == 1:
25066:             checks.append(check("WARN", "legacy reusable template schema_version 1 requires explicit migration"))
25067:         checks.append(check("PASS" if data.get("id") == template_id else "FAIL", "template id matches requested id"))
25068:         root = manifest_path.parent
25069:         for dirname in ["files", "prompts", "examples", "artifacts", "reviews", "handoffs"]:
25070:             checks.append(check("PASS" if (root / dirname).exists() else "WARN", f"{dirname}/ exists"))
25071:         for item in data.get("files", []) if isinstance(data.get("files"), list) else []:
25072:             source = item.get("source") if isinstance(item, dict) else None
25073:             if source:
25074:                 checks.append(
25075:                     check("PASS", f"referenced file exists: {source}")
25076:                     if (root / str(source)).is_file()
25077:                     else check_with_hint(
25078:                         "FAIL",
25079:                         f"referenced file exists: {source}",
25080:                         "The template manifest references a payload file that is not present.",
25081:                         f"restore {source} under the template root or remove the file entry from template.yaml",
25082:                     )
25083:                 )
25084:         for item in data.get("prompts", []) if isinstance(data.get("prompts"), list) else []:
25085:             prompt_path = item.get("path") if isinstance(item, dict) else None
25086:             if prompt_path:
25087:                 checks.append(
25088:                     check("PASS", f"referenced prompt exists: {prompt_path}")
25089:                     if (root / str(prompt_path)).is_file()
25090:                     else check_with_hint(
25091:                         "FAIL",
25092:                         f"referenced prompt exists: {prompt_path}",
25093:                         "The template manifest references a prompt file that is not present.",
25094:                         f"restore {prompt_path} under the template root or remove the prompt entry from template.yaml",
25095:                     )
25096:                 )
25097:     return print_checks(checks)
25098: 
