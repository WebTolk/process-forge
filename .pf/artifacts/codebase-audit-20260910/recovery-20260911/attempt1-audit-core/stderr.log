25970: def command_platform_create(args: argparse.Namespace) -> int:
25971:     mode = authoring_mode(args)
25972:     plan, _values, contract_path = build_platform_authoring_plan(args, "platform-create")
25973:     workplace_root = Path(args.workplace).expanduser().resolve()
25974:     if mode == "dry_run":
25975:         render_authoring_dry_run(plan, workplace_root)
25976:         return 0
25977:     execute_authoring_plan(plan)
25978:     print(f"PLATFORM: {rel(contract_path, workplace_root)}")
25979:     print_search_index_maintenance_summary(search_index_maintenance_for_known_projects(workplace_root, reason="platform-create"))
25980:     return 0
