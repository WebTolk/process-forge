  163: def _process_root_yaml_files(root: Path, *, legacy_flat: bool) -> list[Path]:
  164:     if not root.is_dir():
  165:         return []
  166:     if legacy_flat:
  167:         return sorted([*root.glob("*.yaml"), *root.glob("*.yml")])
  168:     return sorted([path for path in root.rglob("*") if path.is_file() and path.suffix.lower() in {".yaml", ".yml"}])
  169: 
  170: 
  171: def process_root_yaml_files(root: Path, *, legacy_flat: bool) -> list[Path]:
  172:     return _process_root_yaml_files(root, legacy_flat=legacy_flat)
