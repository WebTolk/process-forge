 1078: @dataclass
 1079: class PackageRootResolution:
 1080:     root_id: str
 1081:     original_path: str
 1082:     resolved_path: Path
 1083:     status: str
 1084:     warnings: list[str]
 1085:     fallback: bool = False
 1086:     entry: dict[str, Any] | None = None
