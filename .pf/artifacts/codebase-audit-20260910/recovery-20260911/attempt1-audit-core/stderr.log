25983: def install_platform_args(args: argparse.Namespace) -> argparse.Namespace:
25984:     platform_id = validate_resource_id(
25985:         str(args.id).removeprefix("platform."),
25986:         "platform",
25987:     )
25988:     return argparse.Namespace(
25989:         workplace=args.workplace,
25990:         id=platform_id,
25991:         title=title_from_id(platform_id),
25992:         version=args.version,
25993:         platform_root=None,
25994:         project_type=[platform_id],
25995:         requires_package=[item for item in args.required_packages.split(",") if item],
25996:         recommends_package=[
25997:             item for item in args.recommended_packages.split(",") if item
25998:         ],
25999:         optional_package=[],
26000:         requires_template=[
26001:             item for item in args.required_templates.split(",") if item
26002:         ],
26003:         recommends_template=[
26004:             item for item in args.recommended_templates.split(",") if item
26005:         ],
26006:         optional_template=[],
26007:         requires_tool=[item for item in args.required_tools.split(",") if item],
26008:         recommends_tool=[
26009:             item for item in args.recommended_tools.split(",") if item
26010:         ],
26011:         optional_tool=[],
26012:         requires_mcp=[item for item in args.required_mcp.split(",") if item],
26013:         recommends_mcp=[item for item in args.recommended_mcp.split(",") if item],
26014:         optional_mcp=[],
26015:         process=[],
26016:         force=False,
26017:         apply=bool(getattr(args, "apply", False)),
26018:         dry_run=bool(getattr(args, "dry_run", False)),
26019:     )
