   60: def _process_override_declared(process: dict[str, Any], overridden_process_id: str) -> bool:
   61:     override = process.get("process_override") if isinstance(process.get("process_override"), dict) else {}
   62:     return str(override.get("overrides") or "") == overridden_process_id and bool(str(override.get("reason") or "").strip())
