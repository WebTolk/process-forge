 2976: def command_doctor_workplace(args: argparse.Namespace) -> int:
 2977:     root = Path(args.root).expanduser().resolve()
 2978:     checks: list[Check] = []
 2979:     manifest = root / "workplace.yaml"
 2980:     if manifest.is_file():
 2981:         checks.append(check("PASS", "workplace.yaml found"))
 2982:         text = manifest.read_text(encoding="utf-8", errors="replace")
 2983:         if contains_secret_value(text):
 2984:             checks.append(check("FAIL", "workplace.yaml appears to contain a secret value"))
 2985:         else:
 2986:             checks.append(check("PASS", "workplace.yaml contains no obvious secret values"))
 2987:         load_doctor_yaml(manifest, "workplace.schema.json", "workplace manifest", checks)
 2988:         cfg = workplace_coordination_config(manifest)
 2989:         checks.append(check("PASS", f"default_project_mode is {cfg['default_project_mode']}"))
 2990:         checks.append(check("PASS", f"director_enabled is {str(bool(cfg.get('director_enabled'))).lower()}"))
 2991:         if cfg.get("director_office_enabled"):
 2992:             checks.append(check("PASS" if director_office_exists(root, cfg) else "WARN", "Director Office exists"))
 2993:         checks.extend(path_constant_checks(root, manifest))
 2994:         checks.extend(registry_path_resolution_checks(root, manifest))
 2995:         checks.extend(package_root_registry_checks(root))
 2996:     else:
 2997:         checks.append(
 2998:             check_with_hint(
 2999:                 "FAIL",
 3000:                 "workplace.yaml missing",
 3001:                 "The selected path is not an initialized ProcessForge workplace.",
 3002:                 "python bin/pf.py workplace-init --workplace <workplace-root> --apply",
 3003:             )
 3004:         )
 3005: 
 3006:     for rel_path in [
 3007:         "registries/distributions.yaml",
 3008:         "registries/platforms.yaml",
 3009:         "registries/knowledge-roots.yaml",
 3010:         "registries/package-roots.yaml",
 3011:         "registries/templates.yaml",
 3012:         "registries/tools.yaml",
 3013:         "registries/mcp.yaml",
 3014:         "registries/process-packs.yaml",
 3015:     ]:
 3016:         path = root / rel_path
 3017:         checks.append(
 3018:             check("PASS", f"{rel_path} found")
 3019:             if path.is_file()
 3020:             else check_with_hint(
 3021:                 "FAIL",
 3022:                 f"{rel_path} missing",
 3023:                 "A required workplace registry is absent.",
 3024:                 "python bin/pf.py workplace-init --workplace <workplace-root> --apply",
 3025:             )
 3026:         )
 3027:         if path.is_file() and contains_secret_value(path.read_text(encoding="utf-8", errors="replace")):
 3028:             checks.append(check("FAIL", f"{rel_path} appears to contain a secret value"))
 3029:         registry_schema = {
 3030:             "registries/distributions.yaml": "distributions-registry.schema.json",
 3031:             "registries/platforms.yaml": "platform-registry.schema.json",
 3032:             "registries/knowledge-roots.yaml": "knowledge-roots-registry.schema.json",
 3033:             "registries/package-roots.yaml": "package-roots-registry.schema.json",
 3034:             "registries/templates.yaml": "template-registry.schema.json",
 3035:             "registries/tools.yaml": "tool-registry.schema.json",
 3036:             "registries/mcp.yaml": "mcp-registry.schema.json",
 3037:         }.get(rel_path)
 3038:         if path.is_file() and registry_schema:
 3039:             load_doctor_yaml(path, registry_schema, rel_path, checks)
 3040:         elif path.is_file() and rel_path == "registries/process-packs.yaml":
 3041:             process_pack_registry = load_yaml_document(path)
 3042:             error = yaml_error(process_pack_registry)
 3043:             if error:
 3044:                 checks.append(check("FAIL", f"{rel_path} YAML parse failed: {error}"))
 3045:             elif not isinstance(process_pack_registry.get("process_packs"), list):
 3046:                 checks.append(check("FAIL", f"{rel_path} process_packs must be a list"))
 3047:             else:
 3048:                 checks.append(check("PASS", f"{rel_path} has a valid process_packs collection"))
 3049: 
 3050:     for rel_dir in ["cache", "runtime", "logs"]:
 3051:         path = root / rel_dir
 3052:         checks.append(check("PASS" if path.is_dir() else "WARN", f"{rel_dir}/ {'found' if path.is_dir() else 'missing'}"))
 3053: 
 3054:     if manifest.is_file():
 3055:         knowledge_roots = load_workplace_registry(manifest, "knowledge_roots", "knowledge-roots.yaml")
 3056:         knowledge_entries = knowledge_roots.get("knowledge_roots") if isinstance(knowledge_roots, dict) else []
 3057:         local_docs = next((item for item in knowledge_entries if isinstance(item, dict) and str(item.get("id")) == "local-docs"), None) if isinstance(knowledge_entries, list) else None
 3058:         if not local_docs:
 3059:             checks.append(
 3060:                 check_with_hint(
 3061:                     "WARN",
 3062:                     "knowledge_roots.local-docs missing or empty",
 3063:                     "Local heavy documentation and source snapshots must be referenced through knowledge_roots.local-docs instead of private package paths.",
 3064:                     "add local-docs pointing to your documentation root",
 3065:                 )
 3066:             )
 3067:         else:
 3068:             local_docs_path = resolve_registry_relative_path(root, str(local_docs.get("path", "")), manifest)
 3069:             checks.append(
 3070:                 check("PASS", "knowledge_roots.local-docs configured")
 3071:                 if local_docs_path.is_dir()
 3072:                 else check_with_hint(
 3073:                     "WARN",
 3074:                     "knowledge_roots.local-docs configured but path missing",
 3075:                     "The local-docs root is registered but the target directory is not available on this machine.",
 3076:                     "create the directory or update registries/knowledge-roots.yaml to the correct local documentation root",
 3077:                 )
 3078:             )
 3079: 
 3080:         platforms_registry = load_workplace_registry(manifest, "platforms", "platforms.yaml")
 3081:         platform_entries = platforms_registry.get("platforms") if isinstance(platforms_registry, dict) else []
 3082:         platform_ids = [
 3083:             str(item.get("id") or item.get("package_id"))
 3084:             for item in platform_entries
 3085:             if isinstance(item, dict) and (item.get("id") or item.get("package_id")) and str(item.get("status", "available")) not in {"missing", "disabled"}
 3086:         ] if isinstance(platform_entries, list) else []
 3087:         if platform_ids:
 3088:             workplace_resolution = resolve_platform_contracts(manifest, platform_ids)
 3089:             checks.append(check("PASS" if not workplace_resolution["missing_required_contracts"] else "FAIL", "platform inheritance parent platforms resolve"))
 3090:             for missing in workplace_resolution["missing_required_contracts"]:
 3091:                 checks.append(
 3092:                     check_with_hint(
 3093:                         "FAIL",
 3094:                         f"required platform available: {missing}",
 3095:                         "A workplace platform extends or requires a platform that is not registered.",
 3096:                         f"python bin/pf.py platform-create --workplace <workplace-root> --id {missing} --title \"{missing}\" --apply",
 3097:                     )
 3098:                 )
 3099:             for cycle in workplace_resolution["circular_platforms"]:
 3100:                 checks.append(
 3101:                     check_with_hint(
 3102:                         "FAIL",
 3103:                         f"circular platform inheritance detected: {cycle}",
 3104:                         "Workplace platform inheritance must resolve to an acyclic stack.",
 3105:                         "remove one extends edge from the cycle and rerun doctor-workplace",
 3106:                     )
 3107:                 )
 3108:         public_manifest_paths: list[Path] = []
 3109:         if platform_ids:
 3110:             public_manifest_paths.extend(path for pid in platform_ids for path in [platform_contract_path(root, pid)] if path)
 3111:         public_manifest_paths.extend(package_manifest_candidates(root, None, manifest))
 3112:         for public_path in sorted(set(public_manifest_paths), key=lambda item: item.as_posix()):
 3113:             text = public_path.read_text(encoding="utf-8", errors="replace")
 3114:             checks.append(check("PASS" if is_public_path_safe(text) else "FAIL", f"{rel(public_path, root)} contains no private absolute paths"))
 3115: 
 3116:     mcp_registry = root / "registries" / "mcp.yaml"
 3117:     if mcp_registry.is_file():
 3118:         mcp_text = mcp_registry.read_text(encoding="utf-8", errors="replace")
 3119:         has_mcp_entry = re.search(r"(?m)^\s*-\s*$", mcp_text) or re.search(r"(?m)^\s*-\s+id:", mcp_text)
 3120:         if "mcp_servers:" in mcp_text and not has_mcp_entry:
 3121:             checks.append(check("WARN", "optional MCP providers are not configured"))
