 4171: def load_platform_contract(workplace_manifest: Path | None, contract_id: str, project_root: Path | None = None) -> tuple[dict[str, Any], dict[str, Any] | None, str, str]:
 4172:     normalized_id = platform_contract_id(contract_id)
 4173:     entry = platform_contract_manifest_index(workplace_manifest, project_root).get(normalized_id)
 4174:     if entry:
 4175:         return entry["contract"], entry.get("registry_entry"), str(entry.get("status", "available")), str(entry.get("source", "manifest"))
 4176:     registry_entry = platform_contract_registry_entry(workplace_manifest, normalized_id)
 4177:     if registry_entry and str(registry_entry.get("status", "available")) in {"missing", "disabled"}:
 4178:         return {"id": normalized_id, "requires": {}, "includes": {}}, registry_entry, str(registry_entry.get("status")), "registry"
 4179:     return {"id": normalized_id, "requires": {}, "includes": {}}, registry_entry, "missing", "missing"
