 4182: def list_value(value: Any) -> list[str]:
 4183:     if isinstance(value, str):
 4184:         return [value]
 4185:     if isinstance(value, list):
 4186:         output: list[str] = []
 4187:         for item in value:
 4188:             if isinstance(item, str):
 4189:                 output.append(item)
 4190:             elif isinstance(item, dict):
 4191:                 item_id = item.get("id") or item.get("package") or item.get("template") or item.get("capability")
 4192:                 if item_id:
 4193:                     output.append(str(item_id))
 4194:         return output
 4195:     return []
