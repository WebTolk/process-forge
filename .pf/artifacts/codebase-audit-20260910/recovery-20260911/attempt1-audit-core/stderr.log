 5130: def match_global_resources(workplace_manifest: Path, detected: dict[str, Any], required: list[str], optional: list[str]) -> dict[str, list[str]]:
 5131:     tools_text = registry_text(workplace_manifest, "tools.yaml")
 5132:     mcp_text = registry_text(workplace_manifest, "mcp.yaml")
 5133:     templates_text = registry_text(workplace_manifest, "templates.yaml")
 5134:     package_text = registry_text(workplace_manifest, "package-roots.yaml")
 5135: 
 5136:     available_platform_ids = set(platform_contract_manifest_index(workplace_manifest))
 5137:     available_platform_ids.update(item.removeprefix("platform.") for item in list(available_platform_ids))
 5138:     matched_platforms = [item for item in detected["platforms"] if item and (item in available_platform_ids or platform_contract_id(item) in available_platform_ids)]
 5139:     missing_platforms = [item for item in detected["platforms"] if item and item not in matched_platforms]
 5140:     matched_tools = [cap for cap in required + optional if cap and cap in tools_text]
 5141:     matched_mcp = [cap for cap in required + optional if cap and cap in mcp_text]
 5142:     missing_required = [cap for cap in required if cap not in tools_text and cap not in mcp_text]
 5143:     optional_missing = [cap for cap in optional if cap not in tools_text and cap not in mcp_text]
 5144:     matched_templates = ["template roots configured"] if "template_roots:" in templates_text and "[]" not in templates_text else []
 5145:     matched_packages = ["package roots configured"] if "package_roots:" in package_text and "[]" not in package_text else []
 5146:     return {
 5147:         "matched_platforms": matched_platforms,
 5148:         "missing_platforms": missing_platforms,
 5149:         "matched_packages": matched_packages,
 5150:         "matched_tools": matched_tools,
 5151:         "matched_mcp": matched_mcp,
 5152:         "matched_templates": matched_templates,
 5153:         "missing_required": missing_required,
 5154:         "optional_missing": optional_missing,
 5155:         "conflicts": [],
 5156:     }
