20778: def _command_task_complete_locked(args: argparse.Namespace) -> int:
20779:     project_root = Path(args.project_root).expanduser().resolve()
20780:     task_id = safe_id(args.task, "task")
20781:     task = load_task(project_root, task_id)
20782:     if getattr(args, "dry_run", False):
20783:         print(f"DRY-RUN: would complete task {task_id}")
20784:         return 0
20785:     waivers = parse_required_output_waivers(getattr(args, "waive_required_output", []))
