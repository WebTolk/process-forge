24130: def build_knowledge_resource_add_plan(
24131:     args: argparse.Namespace,
24132:     command_name: str,
24133:     raw_resource: dict[str, Any],
24134: ) -> tuple[AuthoringPlan, dict[str, Any], str, Path, Path, PackageRootResolution]:
24135:     workplace_root = Path(args.workplace).expanduser().resolve()
24136:     if not (workplace_root / "workplace.yaml").is_file():
24137:         raise SystemExit(f"FAIL: workplace is not initialized: {workplace_root}")
24138:     package_id = validate_resource_id(str(args.package), "knowledge package")
24139:     package_root_id = getattr(args, "package_root", None)
24140:     manifest_path, manifest, package_root = load_workplace_package_manifest(
24141:         workplace_root,
24142:         package_id,
24143:         package_root_id,
24144:         mode="read",
24145:     )
24146:     if manifest_path.is_file() and yaml_error(manifest):
24147:         raise SystemExit(
24148:             f"FAIL: package manifest YAML invalid; original preserved: {manifest_path}: {yaml_error(manifest)}"
24149:         )
24150:     resources = manifest.get("resources")
24151:     if resources is None:
24152:         resources = []
24153:         manifest["resources"] = resources
24154:     if not isinstance(resources, list):
24155:         raise SystemExit("FAIL: knowledge package resources must be a list")
24156:     resource = normalize_resource_record(
24157:         raw_resource,
24158:         package_id,
24159:         workplace_root,
24160:         register_private_path=False,
24161:     )
24162:     resource_id = str(resource["id"])
24163:     result = upsert_resource(resources, resource)
24164:     manifest["package_root"] = package_root.root_id
24165:     require_json_schema_document(
24166:         manifest,
24167:         "package-manifest.schema.json",
24168:         f"knowledge package {package_id}",
24169:     )
24170:     index = build_resource_index(
24171:         manifest,
24172:         workplace_root,
24173:         package_root.root_id,
24174:     )
24175:     require_json_schema_document(
24176:         index,
24177:         "knowledge-resource-index.schema.json",
24178:         f"knowledge package {package_id} resource index",
24179:     )
24180:     index_path = resource_index_path_for_package(
24181:         manifest_path,
24182:         workplace_root,
24183:         package_id,
24184:     )
24185:     entity_writes = [
24186:         AuthoringWrite(
24187:             manifest_path,
24188:             ensure_trailing_newline(dump_yaml(manifest)).encode("utf-8"),
24189:             role="entity",
24190:             operation="replace" if manifest_path.is_file() else "create",
24191:             schema_name="package-manifest.schema.json",
24192:             allow_replace=manifest_path.is_file(),
24193:         ),
24194:         AuthoringWrite(
24195:             index_path,
24196:             ensure_trailing_newline(dump_yaml(index)).encode("utf-8"),
24197:             role="entity",
24198:             operation="replace" if index_path.is_file() else "create",
24199:             schema_name="knowledge-resource-index.schema.json",
24200:             allow_replace=index_path.is_file(),
24201:         ),
24202:     ]
24203:     registry_writes: list[AuthoringWrite] = []
24204:     raw_path = str(raw_resource.get("path") or "")
24205:     path_ref = resource.get("path_ref") if isinstance(resource.get("path_ref"), dict) else {}
24206:     if raw_path and path_ref.get("registry") == "private_resource_paths":
24207:         private_registry = workplace_root / "registries" / "private-resource-paths.yaml"
24208:         registry_bytes, _private_result, _private_data = planned_registry_upsert(
24209:             private_registry,
24210:             "private_resource_paths",
24211:             private_resource_registry_entry(resource_id, raw_path),
24212:             "private-resource-paths-registry.schema.json",
24213:         )
24214:         registry_writes.append(
24215:             AuthoringWrite(
24216:                 private_registry,
24217:                 registry_bytes,
24218:                 role="registry",
24219:                 operation="replace" if private_registry.is_file() else "create",
24220:                 schema_name="private-resource-paths-registry.schema.json",
24221:                 allow_replace=private_registry.is_file(),
24222:             )
24223:         )
24224:     transaction_id = f"{safe_id(command_name, 'knowledge')}-{resource_id}-{uuid.uuid4().hex[:12]}"
24225:     plan = AuthoringPlan(
24226:         transaction_id=transaction_id,
24227:         command=command_name,
24228:         runtime_root=workplace_root / "runtime",
24229:         authoritative_writes=entity_writes,
24230:         registry_writes=registry_writes,
24231:         post_commit_effects=[],
24232:         validation_callbacks=[],
24233:     )
24234: 
24235:     plan.post_commit_effects.append(
24236:         AuthoringEffect(
24237:             "knowledge-audit-events",
24238:             "runtime/resource-management/proposals/<transaction>.yaml, reports, and runtime/events/events.ndjson",
24239:             kind="knowledge_audit",
24240:             payload={
24241:                 "workplace_root": str(workplace_root),
24242:                 "command": command_name,
24243:                 "resource_id": resource_id,
