21092: def existing_capsule_status(project_root: Path, task_id: str) -> tuple[str, str]:
21093:     capsule_path = assignment_capsule_path(project_root, task_id)
21094:     if not capsule_path.is_file():
21095:         return "missing", rel(capsule_path, project_root)
21096:     capsule = load_yaml_document(capsule_path)
21097:     capsule_meta = capsule.get("capsule") if isinstance(capsule, dict) else {}
21098:     recorded_checksum = str(capsule_meta.get("assignment_checksum") or "") if isinstance(capsule_meta, dict) else ""
21099:     if not recorded_checksum:
21100:         return "legacy", rel(capsule_path, project_root)
21101:     assignment_path = assignment_yaml_path(project_root, task_id)
21102:     current_checksum = sha256_file(assignment_path) if assignment_path.is_file() else ""
21103:     if recorded_checksum == current_checksum:
21104:         return "fresh", rel(capsule_path, project_root)
21105:     return "stale", rel(capsule_path, project_root)
