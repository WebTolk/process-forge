27873: def main(argv: list[str] | None = None) -> int:
27874:     parser = build_parser()
27875:     args = parser.parse_args(argv)
27876:     strict_authoring_commands = {
27877:         "authoring-transaction-recover",
27878:         "knowledge-add-url",
