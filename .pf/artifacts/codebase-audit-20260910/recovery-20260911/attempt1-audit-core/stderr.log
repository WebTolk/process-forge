 4470: def platform_resource_findings(workplace_manifest: Path | None, resolved: dict[str, Any], package_index_ids: set[str] | None = None) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
 4471:     package_ids = registry_ids(load_workplace_registry(workplace_manifest, "package_roots", "package-roots.yaml"), "package_roots")
 4472:     if workplace_manifest and workplace_manifest.is_file():
 4473:         package_ids = package_ids.union(set(package_manifest_index(workplace_manifest.parent, None, workplace_manifest)) - {"__duplicates__"})
 4474:     if package_index_ids:
 4475:         package_ids = package_ids.union(package_index_ids)
 4476:     tool_ids = registry_ids(load_workplace_registry(workplace_manifest, "tools", "tools.yaml"), "tools")
 4477:     mcp_ids = registry_ids(load_workplace_registry(workplace_manifest, "mcp", "mcp.yaml"), "mcp_servers")
 4478:     templates_registry = load_workplace_registry(workplace_manifest, "templates", "templates.yaml")
 4479:     template_ids = registry_ids(templates_registry, "template_roots").union(registry_ids(templates_registry, "templates"))
 4480:     required_missing: list[dict[str, Any]] = []
 4481:     recommended_missing: list[dict[str, Any]] = []
 4482: 
 4483:     for group, available, collection in [
 4484:         ("knowledge_package", package_ids, resolved.get("required_knowledge_packages", [])),
 4485:         ("tool", tool_ids, resolved.get("required_tools", [])),
 4486:         ("mcp", mcp_ids, resolved.get("required_mcp", [])),
 4487:         ("template", template_ids, resolved.get("required_templates", [])),
 4488:     ]:
 4489:         for item in collection:
 4490:             if item not in available:
 4491:                 required_missing.append({"kind": group, "id": item, "status": "missing", "severity": "fail", "requirement": "required"})
 4492: 
 4493:     for group, available, collection in [
 4494:         ("knowledge_package", package_ids, resolved.get("recommended_knowledge_packages", [])),
 4495:         ("tool", tool_ids, resolved.get("recommended_tools", [])),
 4496:         ("mcp", mcp_ids, resolved.get("recommended_mcp", [])),
 4497:         ("template", template_ids, resolved.get("recommended_templates", [])),
 4498:     ]:
 4499:         for item in collection:
 4500:             if item not in available:
 4501:                 recommended_missing.append({"kind": group, "id": item, "status": "missing", "severity": "warn", "requirement": "recommended"})
 4502:     return required_missing, recommended_missing
 4503: 
 4504: 
 4505: RESOURCE_GROUP_KEYS = ("knowledge_packages", "tools", "mcp", "templates")
 4506: RESOURCE_BUCKET_KEYS = ("requires", "recommends", "optional", "excludes")
 4507: PROJECT_OVERRIDE_KINDS = {
 4508:     "template": "templates",
 4509:     "templates": "templates",
 4510:     "knowledge_package": "knowledge_packages",
 4511:     "knowledge_packages": "knowledge_packages",
