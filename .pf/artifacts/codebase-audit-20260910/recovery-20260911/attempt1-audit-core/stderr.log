25363:     write_authoring_text(target, dump_yaml(document))
25364:     upsert_registry_entry(specialization_registry_path(workplace_root), "specializations", {"id": specialization_id, "path": rel(target, workplace_root), "status": "available", "scope": "workplace"})
25365:     append_workplace_resource_event(workplace_root, resource_management_event(scope="workplace", command="specialization-create", event_type="specialization.created", target={"specialization_id": specialization_id}, status="created", message="specialization created"))
25366:     print(f"SPECIALIZATION: {rel(target, workplace_root)}")
25367:     return print_checks(specialization_doctor_checks(workplace_root, specialization_id))
