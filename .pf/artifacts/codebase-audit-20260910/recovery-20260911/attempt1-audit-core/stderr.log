   14: ACTIVE_RUN_STATUSES = {"draft", "open", "in_progress", "blocked", "review"}
   15: ACTIVE_ASSIGNMENT_STATUSES = {"draft", "ready", "open", "pending", "in_progress", "blocked", "debugging", "review", "ready_for_review"}
   16: TERMINAL_ASSIGNMENT_STATUSES = {"done", "completed", "cancelled", "failed"}
   17: TERMINAL_RUN_STATUSES = {"completed", "cancelled", "failed"}
