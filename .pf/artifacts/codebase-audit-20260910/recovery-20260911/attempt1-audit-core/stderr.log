 1739: def dict_entries_from_answers(container: Any, item_label: str, scope: str) -> list[dict[str, Any]]:
 1740:     if not isinstance(container, dict):
 1741:         return []
 1742:     entries = []
 1743:     for key, value in container.items():
 1744:         if value in (None, "", "<path>"):
 1745:             continue
 1746:         entries.append(
 1747:             {
 1748:                 "id": safe_id(str(key), item_label),
 1749:                 "label": str(key).replace("_", " ").title(),
 1750:                 "path": str(value),
 1751:                 "scope": scope,
 1752:                 "status": "available",
 1753:             }
 1754:         )
 1755:     return entries
