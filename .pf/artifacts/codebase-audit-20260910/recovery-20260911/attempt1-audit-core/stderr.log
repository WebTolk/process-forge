  163: def _resource_records(snapshot: dict[str, Any]) -> Iterable[dict[str, Any]]:
  164:     resolved = snapshot.get("resolved") if isinstance(snapshot.get("resolved"), dict) else {}
  165:     rows = snapshot.get("local_search_resources")
  166:     if isinstance(rows, list):
  167:         yield from (row for row in rows if isinstance(row, dict))
  168:         return
  169:     # Pre-selection snapshots have no local search grant. Keep compatibility
  170:     # with their resolved resources, never with the diagnostic available list.
  171:     for key in ("knowledge_resources", "templates", "template_resources"):
  172:         rows = resolved.get(key) if isinstance(resolved, dict) else []
  173:         if isinstance(rows, list):
  174:             yield from (row for row in rows if isinstance(row, dict))
  175: 
  176: 
  177: def _fingerprint_value(row: dict[str, Any]) -> str:
  178:     raw = row.get("fingerprint")
  179:     if isinstance(raw, dict):
  180:         value = raw.get("value")
  181:         if value:
  182:             return str(value)
  183:     if raw:
  184:         return str(raw)
  185:     version = str(row.get("version") or row.get("generation") or "")
  186:     identity = {
  187:         "id": row.get("id") or row.get("resource_id"),
  188:         "path_ref": row.get("path_ref"),
  189:         "version": version,
  190:         "indexing": row.get("indexing") or row.get("index_policy"),
  191:     }
  192:     return "sha256:" + hashlib.sha256(_stable_json(identity).encode("utf-8")).hexdigest()
  193: 
  194: 
  195: def _string_list(value: Any) -> tuple[str, ...]:
  196:     if isinstance(value, list):
  197:         return tuple(str(item) for item in value if str(item))
  198:     return ()
  199: 
  200: 
  201: def _normalize_source(raw: dict[str, Any], default_mode: str) -> IndexSource:
  202:     mode = str(raw.get("mode") or default_mode or "metadata")
  203:     if mode not in POLICY_MODES:
  204:         mode = "metadata"
  205:     return IndexSource(
  206:         path=str(raw.get("path") or "."),
  207:         mode=mode,
  208:         include=_string_list(raw.get("include")) or ("**/*",),
  209:         exclude=_string_list(raw.get("exclude")),
  210:         role=str(raw.get("role") or ""),
  211:     )
  212: 
  213: 
  214: def normalize_indexing_policy(row: dict[str, Any]) -> dict[str, Any]:
  215:     """Normalize the public indexing contract for one resource."""
  216: 
  217:     raw = row.get("indexing") if isinstance(row.get("indexing"), dict) else None
  218:     if raw is None:
  219:         legacy = str(row.get("index_policy") or "").strip()
  220:         if legacy in {"none", "never", "disabled"}:
  221:             raw = {"enabled": False, "mode": "none"}
  222:         elif legacy in {"metadata", "metadata_first", "index_only", "source_tree", "symbols"}:
  223:             raw = {"enabled": True, "mode": "metadata", "fields": ["title", "description", "tags", "path"]}
  224:         elif legacy in {"fulltext", "always_index", "snapshot_authorized"}:
  225:             raw = {
  226:                 "enabled": True,
  227:                 "mode": "fulltext",
  228:                 "fields": ["title", "description", "path"],
  229:                 "sources": [{"path": ".", "mode": "fulltext", "include": ["**/*.md", "**/*.txt", "**/*.rst"]}],
  230:             }
  231:         else:
  232:             # Compatibility for old direct callers. Snapshot producers should
  233:             # write explicit `indexing` and not rely on this fallback.
  234:             raw = {
  235:                 "enabled": True,
  236:                 "mode": "fulltext",
  237:                 "fields": ["title", "description", "path"],
  238:                 "sources": [{"path": ".", "mode": "fulltext", "include": ["**/*"]}],
  239:                 "legacy_default": True,
  240:             }
  241:     enabled = bool(raw.get("enabled", True))
  242:     mode = str(raw.get("mode") or ("metadata" if enabled else "none"))
  243:     if mode not in POLICY_MODES:
  244:         mode = "metadata"
  245:     if not enabled:
  246:         mode = "none"
  247:     fields = _string_list(raw.get("fields")) or ("title", "description", "path")
  248:     source_rows = raw.get("sources") if isinstance(raw.get("sources"), list) else []
  249:     sources = tuple(_normalize_source(item, mode) for item in source_rows if isinstance(item, dict))
  250:     if not sources and mode != "none":
  251:         sources = (_normalize_source({"path": ".", "mode": mode, "include": ["**/*"]}, mode),)
  252:     return {
  253:         "enabled": enabled,
  254:         "mode": mode,
  255:         "fields": list(fields),
  256:         "sources": [
  257:             {
  258:                 "path": item.path,
  259:                 "mode": item.mode,
  260:                 "include": list(item.include),
  261:                 "exclude": list(item.exclude),
  262:                 **({"role": item.role} if item.role else {}),
  263:             }
  264:             for item in sources
  265:         ],
  266:         **({"legacy_default": True} if raw.get("legacy_default") else {}),
  267:     }
  268: 
