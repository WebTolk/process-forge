 1402:     def _atomic_text(self, path: Path, content: str) -> None:
 1403:         path.parent.mkdir(parents=True, exist_ok=True)
 1404:         temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
 1405:         temporary.write_text(content, encoding="utf-8")
 1406:         temporary.replace(path)
