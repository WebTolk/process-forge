  275:             "assignment_id": assignment_id,
  276:             "stage": stage_id,
  277:             "valid_stages": [str(item.get("id")) for item in stages],
  278:             "stage_selection": "preferred" if stage_override else "process_initial_stage",
  279:             "session": {"status": "bound", "id": session_id} if session_id else {"status": "absent"},
