 1280: def workplace_path_resolution(workplace_root: Path, raw_path: str | None) -> dict[str, Any]:
 1281:     manifest = workplace_root / "workplace.yaml"
 1282:     return resolve_path_with_constants(raw_path, workplace_root, load_workplace_path_constants(manifest, workplace_root))
