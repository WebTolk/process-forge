22872:     try:
22873:         data = json.loads(path.read_text(encoding="utf-8"))
22874:     except json.JSONDecodeError:
22875:         return {"schema_version": 1, "generated_at": now_utc(), "channel": "stable", "candidates": [], "conflicts": []}
22876:     return data if isinstance(data, dict) else {"schema_version": 1, "generated_at": now_utc(), "channel": "stable", "candidates": [], "conflicts": []}
