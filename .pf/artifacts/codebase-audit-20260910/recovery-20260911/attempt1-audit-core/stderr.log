  430: @dataclass
  431: class Check:
  432:     level: str
  433:     message: str
  434: 
  435: 
  436: @dataclass
  437: class WriteResult:
  438:     path: Path
  439:     status: str
  440:     target: Path
  441: 
  442: 
  443: @dataclass
  444: class AuthoringWrite:
  445:     destination: Path
  446:     content: bytes | None
  447:     role: str = "entity"
  448:     operation: str = "create"
  449:     schema_name: str | None = None
  450:     allow_replace: bool = False
  451: 
  452: 
  453: @dataclass
  454: class AuthoringEffect:
  455:     label: str
  456:     destination: str
  457:     role: str = "audit"
  458:     operation: str = "append"
  459:     condition: str = "after_commit"
  460:     kind: str = "callback"
  461:     payload: dict[str, Any] = field(default_factory=dict)
  462:     executable: bool = True
  463:     callback: Any = None
  464: 
  465: 
  466: @dataclass
  467: class AuthoringPlan:
  468:     transaction_id: str
  469:     command: str
  470:     runtime_root: Path
  471:     authoritative_writes: list[AuthoringWrite]
  472:     registry_writes: list[AuthoringWrite]
  473:     post_commit_effects: list[AuthoringEffect]
  474:     validation_callbacks: list[Any]
  475: 
  476: 
  477: AUTHORING_FAILURE_INJECTOR: Any = None
  478: 
  479: 
  480: def authoring_failure_point(phase: str, plan: AuthoringPlan, write: AuthoringWrite | None = None) -> None:
  481:     callback = AUTHORING_FAILURE_INJECTOR
  482:     if callback is not None:
  483:         callback(phase, plan, write)
  484: 
  485: 
  486: def authoring_mode(args: argparse.Namespace) -> str:
  487:     apply = bool(getattr(args, "apply", False))
  488:     dry_run = bool(getattr(args, "dry_run", False))
  489:     if apply == dry_run:
  490:         raise SystemExit("FAIL: choose exactly one of --dry-run or --apply")
  491:     if apply:
  492:         return "apply"
  493:     return "dry_run"
  494: 
  495: 
  496: def authoring_transaction_root(plan: AuthoringPlan) -> Path:
  497:     return plan.runtime_root / "authoring-transactions" / plan.transaction_id
  498: 
  499: 
  500: def authoring_journal_path(plan: AuthoringPlan) -> Path:
  501:     return authoring_transaction_root(plan) / "journal.yaml"
  502: 
  503: 
  504: def authoring_hash_bytes(content: bytes) -> str:
  505:     return hashlib.sha256(content).hexdigest()
  506: 
  507: 
  508: def authoring_file_hash(path: Path) -> str | None:
  509:     return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None
  510: 
  511: 
  512: def write_authoring_journal_data(path: Path, journal: dict[str, Any]) -> None:
  513:     path.parent.mkdir(parents=True, exist_ok=True)
  514:     temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
  515:     try:
  516:         temporary.write_text(ensure_trailing_newline(dump_yaml(journal)), encoding="utf-8")
  517:         os.replace(temporary, path)
  518:     finally:
  519:         if temporary.exists():
  520:             temporary.unlink()
  521: 
  522: 
  523: def write_authoring_journal(plan: AuthoringPlan, journal: dict[str, Any]) -> None:
  524:     write_authoring_journal_data(authoring_journal_path(plan), journal)
  525: 
  526: 
  527: def incomplete_authoring_journals(runtime_root: Path) -> list[Path]:
  528:     root = runtime_root / "authoring-transactions"
  529:     if not root.is_dir():
  530:         return []
  531:     incomplete: list[Path] = []
  532:     terminal = {"rolled_back", "committed_audit_complete"}
  533:     for path in sorted(root.glob("*/journal.yaml")):
  534:         data = load_yaml_document(path)
  535:         if str(data.get("state") or "") not in terminal:
  536:             incomplete.append(path)
  537:     return incomplete
  538: 
  539: 
  540: def validate_authoring_parent_types(destination: Path) -> None:
  541:     if destination.exists() and destination.is_dir():
  542:         raise SystemExit(f"FAIL: authoring destination is a directory: {destination}")
  543:     parent = destination.parent
  544:     missing: list[Path] = []
  545:     while not parent.exists():
  546:         missing.append(parent)
  547:         if parent == parent.parent:
  548:             break
  549:         parent = parent.parent
  550:     if parent.exists() and not parent.is_dir():
  551:         raise SystemExit(f"FAIL: authoring destination parent is not a directory: {parent}")
  552: 
  553: 
  554: def preflight_authoring_plan(plan: AuthoringPlan) -> None:
  555:     incomplete = incomplete_authoring_journals(plan.runtime_root)
  556:     if incomplete:
  557:         raise SystemExit(
  558:             "FAIL: incomplete authoring transaction blocks mutation: "
  559:             + ", ".join(str(path) for path in incomplete)
  560:         )
  561:     writes = [*plan.authoritative_writes, *plan.registry_writes]
  562:     destinations = [write.destination.resolve() for write in writes]
  563:     if len(destinations) != len(set(destinations)):
  564:         raise SystemExit("FAIL: authoring plan contains duplicate destinations")
  565:     for write in writes:
  566:         validate_authoring_parent_types(write.destination)
  567:         if write.operation == "delete":
  568:             if not write.destination.is_file():
  569:                 raise SystemExit(f"FAIL: authoring delete source missing: {write.destination}")
  570:             continue
  571:         if write.content is None:
  572:             raise SystemExit(f"FAIL: authoring write has no content: {write.destination}")
  573:         if write.destination.exists() and not write.allow_replace:
  574:             raise SystemExit(f"FAIL: authoring destination already exists: {write.destination}")
  575:     for callback in plan.validation_callbacks:
  576:         callback(plan, None)
  577: 
  578: 
  579: def render_authoring_plan(plan: AuthoringPlan, root: Path) -> None:
  580:     print(f"PLAN: {plan.command}")
  581:     print("TRANSACTION: <generated-on-apply>")
  582:     rows: list[tuple[str, str, str, str]] = []
  583:     for write in [*plan.authoritative_writes, *plan.registry_writes]:
  584:         rows.append(
  585:             (
  586:                 rel(write.destination, root),
  587:                 write.role,
  588:                 write.operation,
  589:                 f"schema={write.schema_name}" if write.schema_name else "",
  590:             )
  591:         )
  592:     for effect in plan.post_commit_effects:
  593:         rows.append((effect.destination, effect.role, effect.operation, effect.condition))
  594:     for destination, role, operation, condition in sorted(rows):
  595:         suffix = f" [{condition}]" if condition else ""
  596:         print(f"- {role}:{operation}: {destination}{suffix}")
  597: 
  598: 
  599: def render_authoring_dry_run(plan: AuthoringPlan, root: Path) -> None:
  600:     preflight_authoring_plan(plan)
  601:     render_authoring_plan(plan, root)
  602: 
  603: 
  604: def stage_authoring_plan(plan: AuthoringPlan) -> tuple[dict[str, Any], dict[Path, Path]]:
  605:     transaction_root = authoring_transaction_root(plan)
  606:     staged_root = transaction_root / "staged"
  607:     backup_root = transaction_root / "backups"
  608:     journal: dict[str, Any] = {
  609:         "schema_version": 1,
  610:         "transaction_id": plan.transaction_id,
  611:         "command": plan.command,
  612:         "state": "preparing",
  613:         "created_at": now_utc(),
  614:         "writes": [],
  615:         "created_directories": [],
  616:         "completed": [],
  617:         "post_commit_effects": [],
  618:     }
  619:     for index, effect in enumerate(plan.post_commit_effects):
  620:         effect_id = f"{plan.transaction_id}:{index + 1:04d}:{safe_id(effect.kind, 'effect')}"
  621:         journal["post_commit_effects"].append(
  622:             {
  623:                 "effect_id": effect_id,
  624:                 "label": effect.label,
  625:                 "kind": effect.kind,
  626:                 "payload": effect.payload,
  627:                 "destination": effect.destination,
  628:                 "role": effect.role,
  629:                 "operation": effect.operation,
  630:                 "condition": effect.condition,
  631:                 "executable": bool(effect.executable),
  632:                 "state": "pending" if effect.executable else "not_executable",
  633:                 "attempts": 0,
  634:                 "last_error": None,
  635:             }
  636:         )
  637:     write_authoring_journal(plan, journal)
  638:     authoring_failure_point("after_journal_prepare", plan)
  639:     staged: dict[Path, Path] = {}
  640:     for index, write in enumerate([*plan.authoritative_writes, *plan.registry_writes]):
  641:         staged_path = staged_root / f"{index:04d}.content"
  642:         backup_path = backup_root / f"{index:04d}.preimage"
  643:         staged_path.parent.mkdir(parents=True, exist_ok=True)
  644:         if write.operation != "delete":
  645:             assert write.content is not None
  646:             staged_path.write_bytes(write.content)
  647:             staged[write.destination] = staged_path
  648:         journal["writes"].append(
  649:             {
  650:                 "destination": str(write.destination),
  651:                 "role": write.role,
  652:                 "operation": write.operation,
  653:                 "pre_exists": write.destination.is_file(),
  654:                 "pre_sha256": authoring_file_hash(write.destination),
  655:                 "staged_sha256": authoring_hash_bytes(write.content) if write.content is not None else None,
  656:                 "staged_path": str(staged_path) if write.operation != "delete" else None,
  657:                 "backup_path": str(backup_path),
  658:                 "published": False,
  659:             }
  660:         )
  661:         write_authoring_journal(plan, journal)
  662:         authoring_failure_point(f"after_staged_item:{index + 1}", plan, write)
  663:     return journal, staged
  664: 
  665: 
  666: def validate_staged_authoring_plan(
  667:     plan: AuthoringPlan,
  668:     journal: dict[str, Any],
  669:     staged: dict[Path, Path],
  670: ) -> None:
  671:     for write in [*plan.authoritative_writes, *plan.registry_writes]:
  672:         if write.operation == "delete":
  673:             continue
  674:         staged_path = staged[write.destination]
  675:         if authoring_file_hash(staged_path) != authoring_hash_bytes(write.content or b""):
  676:             raise RuntimeError(f"staged authoring hash mismatch: {write.destination}")
  677:     for callback in plan.validation_callbacks:
  678:         callback(plan, staged)
  679:     journal["state"] = "prepared"
  680:     write_authoring_journal(plan, journal)
  681: 
  682: 
  683: def authoring_parent_chain(path: Path) -> list[Path]:
  684:     chain: list[Path] = []
  685:     parent = path.parent
  686:     while not parent.exists():
  687:         chain.append(parent)
  688:         if parent == parent.parent:
  689:             break
  690:         parent = parent.parent
  691:     return list(reversed(chain))
  692: 
  693: 
  694: def publish_authoring_write(
  695:     plan: AuthoringPlan,
  696:     write: AuthoringWrite,
  697:     record: dict[str, Any],
  698:     staged: dict[Path, Path],
  699:     journal: dict[str, Any],
  700: ) -> None:
  701:     backup = Path(str(record["backup_path"]))
  702:     if write.destination.is_file():
  703:         backup.parent.mkdir(parents=True, exist_ok=True)
  704:         shutil.copy2(write.destination, backup)
  705:     for directory in authoring_parent_chain(write.destination):
  706:         directory.mkdir()
  707:         journal["created_directories"].append(str(directory))
  708:     if write.operation == "delete":
  709:         write.destination.unlink()
  710:     else:
  711:         staged_path = staged[write.destination]
  712:         temporary = write.destination.with_name(f".{write.destination.name}.{plan.transaction_id}.tmp")
  713:         shutil.copy2(staged_path, temporary)
  714:         os.replace(temporary, write.destination)
  715:     record["published"] = True
  716:     journal["completed"].append(str(write.destination))
  717:     write_authoring_journal(plan, journal)
  718: 
  719: 
  720: def authoring_restore_record(record: dict[str, Any], transaction_id: str) -> list[str]:
  721:     errors: list[str] = []
  722:     destination = Path(str(record.get("destination") or ""))
  723:     backup = Path(str(record.get("backup_path") or ""))
  724:     try:
  725:         if record.get("pre_exists"):
  726:             expected = record.get("pre_sha256")
  727:             if not backup.is_file():
  728:                 return [f"missing backup for {destination}"]
  729:             if expected and authoring_file_hash(backup) != expected:
  730:                 return [f"backup hash mismatch for {destination}"]
  731:             destination.parent.mkdir(parents=True, exist_ok=True)
  732:             temporary = destination.with_name(f".{destination.name}.{transaction_id}.restore")
  733:             shutil.copy2(backup, temporary)
  734:             os.replace(temporary, destination)
  735:         elif destination.exists():
  736:             if destination.is_file():
  737:                 destination.unlink()
  738:             else:
  739:                 shutil.rmtree(destination)
  740:     except OSError as exc:
  741:         errors.append(f"restore failed for {destination}: {exc}")
  742:     return errors
  743: 
  744: 
  745: def verify_authoring_rollback(journal: dict[str, Any]) -> list[str]:
  746:     errors: list[str] = []
  747:     for record in journal.get("writes", []) if isinstance(journal.get("writes"), list) else []:
  748:         if not isinstance(record, dict) or not record.get("published"):
  749:             continue
  750:         destination = Path(str(record.get("destination") or ""))
  751:         if record.get("pre_exists"):
  752:             expected = record.get("pre_sha256")
  753:             if not destination.is_file():
  754:                 errors.append(f"pre-existing destination missing after rollback: {destination}")
  755:             elif expected and authoring_file_hash(destination) != expected:
  756:                 errors.append(f"pre-existing destination hash mismatch after rollback: {destination}")
  757:         elif destination.exists():
  758:             errors.append(f"pre-missing destination still exists after rollback: {destination}")
  759:     for raw in journal.get("created_directories", []) if isinstance(journal.get("created_directories"), list) else []:
  760:         directory = Path(str(raw))
  761:         if directory.exists():
  762:             errors.append(f"created directory still exists after rollback: {directory}")
  763:     return errors
  764: 
  765: 
  766: def remove_authoring_created_directories(journal: dict[str, Any]) -> list[str]:
  767:     errors: list[str] = []
  768:     for raw in reversed(journal.get("created_directories", []) if isinstance(journal.get("created_directories"), list) else []):
  769:         directory = Path(str(raw))
  770:         try:
  771:             if directory.is_dir() and not any(directory.iterdir()):
  772:                 directory.rmdir()
  773:         except OSError as exc:
  774:             errors.append(f"created directory cleanup failed for {directory}: {exc}")
  775:     return errors
  776: 
  777: 
  778: def rollback_authoring_plan(plan: AuthoringPlan, journal: dict[str, Any]) -> None:
  779:     journal["state"] = "rolling_back"
  780:     write_authoring_journal(plan, journal)
  781:     errors: list[str] = []
  782:     for record in reversed(journal.get("writes", [])):
  783:         if not record.get("published"):
  784:             continue
  785:         errors.extend(authoring_restore_record(record, plan.transaction_id))
  786:     errors.extend(remove_authoring_created_directories(journal))
  787:     errors.extend(verify_authoring_rollback(journal))
  788:     ok = not errors
  789:     journal["state"] = "rolled_back" if ok else "recovery_required"
  790:     journal["rollback_verified"] = ok
  791:     journal["recovery_errors"] = errors
  792:     write_authoring_journal(plan, journal)
  793:     if not ok:
  794:         raise RuntimeError(
  795:             f"authoring rollback could not be verified; recovery required: {authoring_journal_path(plan)}"
  796:         )
  797: 
  798: 
  799: def commit_authoring_plan(
  800:     plan: AuthoringPlan,
  801:     journal: dict[str, Any],
  802:     staged: dict[Path, Path],
  803: ) -> None:
  804:     entity_writes = plan.authoritative_writes
  805:     registry_writes = plan.registry_writes
  806:     records = journal["writes"]
  807:     try:
  808:         authoring_failure_point("before_first_entity_publish", plan)
  809:         for index, write in enumerate(entity_writes):
  810:             journal["next_operation"] = str(write.destination)
  811:             write_authoring_journal(plan, journal)
  812:             publish_authoring_write(plan, write, records[index], staged, journal)
  813:             authoring_failure_point(f"after_entity_publish:{index + 1}", plan, write)
  814:         authoring_failure_point("before_first_registry_publish", plan)
  815:         offset = len(entity_writes)
  816:         for index, write in enumerate(registry_writes):
  817:             journal["next_operation"] = str(write.destination)
  818:             write_authoring_journal(plan, journal)
  819:             publish_authoring_write(plan, write, records[offset + index], staged, journal)
  820:             authoring_failure_point(f"after_registry_publish:{index + 1}", plan, write)
  821:         authoring_failure_point("before_commit_verification", plan)
  822:         for write in [*entity_writes, *registry_writes]:
  823:             if write.operation == "delete":
  824:                 if write.destination.exists():
  825:                     raise RuntimeError(f"deleted authoring path still exists: {write.destination}")
  826:             elif authoring_file_hash(write.destination) != authoring_hash_bytes(write.content or b""):
  827:                 raise RuntimeError(f"committed authoring hash mismatch: {write.destination}")
  828:         journal["state"] = "committed"
  829:         journal["committed_at"] = now_utc()
  830:         journal.pop("next_operation", None)
  831:         write_authoring_journal(plan, journal)
  832:     except BaseException:
  833:         rollback_authoring_plan(plan, journal)
  834:         raise
  835: 
  836: 
  837: def execute_authoring_effect(record: dict[str, Any], plan: AuthoringPlan | None = None) -> None:
  838:     kind = str(record.get("kind") or "")
  839:     payload = record.get("payload") if isinstance(record.get("payload"), dict) else {}
  840:     effect_id = str(record.get("effect_id") or "")
  841:     if kind == "callback" and plan is not None:
  842:         for effect in plan.post_commit_effects:
  843:             if effect.label == record.get("label") and effect.callback is not None:
  844:                 effect.callback()
  845:                 return
  846:         return
  847:     if kind == "process_event":
  848:         project_root = Path(str(payload["project_root"])).expanduser().resolve()
  849:         emit_process_event(
  850:             project_root,
  851:             str(payload["event_type"]),
  852:             process_id=str(payload["process_id"]),
  853:             subject=str(payload["process_id"]),
  854:             payload=payload.get("payload") if isinstance(payload.get("payload"), dict) else {},
  855:             correlation_id=str(payload["correlation_id"]),
  856:             event_id=f"evt_{safe_id(effect_id, 'effect')}",
  857:         )
  858:         return
  859:     if kind == "knowledge_audit":
  860:         workplace_root = Path(str(payload["workplace_root"])).expanduser().resolve()
  861:         slug = safe_id(effect_id, "effect")
  862:         _slug, proposal_path = write_resource_proposal(
  863:             workplace_root,
  864:             str(payload["command"]),
  865:             str(payload["resource_id"]),
  866:             payload.get("proposal_payload") if isinstance(payload.get("proposal_payload"), dict) else {},
  867:             slug=slug,
  868:         )
  869:         for event in payload.get("events", []) if isinstance(payload.get("events"), list) else []:
  870:             if not isinstance(event, dict):
  871:                 continue
  872:             append_workplace_resource_event(
  873:                 workplace_root,
  874:                 resource_management_event(
  875:                     scope="workplace",
  876:                     command=str(payload["command"]),
  877:                     event_type=str(event["event_type"]),
  878:                     target=event.get("target") if isinstance(event.get("target"), dict) else {},
  879:                     status=str(event["status"]),
  880:                     message=str(event["message"]),
  881:                     event_id=f"evt_{safe_id(effect_id + '-' + str(event['event_type']), 'event')}",
  882:                 ),
  883:             )
  884:         report = write_resource_management_report(
  885:             workplace_root,
  886:             slug,
  887:             str(payload.get("report_title") or "Knowledge Resource Add Report"),
  888:             [str(item) for item in payload.get("report_lines", []) if isinstance(item, str)],
  889:         )
  890:         print(f"PROPOSAL: {rel(proposal_path, workplace_root)}")
  891:         print(f"REPORT: {rel(report, workplace_root)}")
  892:         return
  893:     if kind == "platform_audit":
  894:         workplace_root = Path(str(payload["workplace_root"])).expanduser().resolve()
  895:         slug = safe_id(effect_id, "effect")
  896:         _slug, proposal_path = write_resource_proposal(
  897:             workplace_root,
  898:             str(payload["command"]),
  899:             str(payload["contract_id"]),
  900:             payload.get("proposal_payload") if isinstance(payload.get("proposal_payload"), dict) else {},
  901:             slug=slug,
  902:         )
  903:         for event in payload.get("events", []) if isinstance(payload.get("events"), list) else []:
  904:             if not isinstance(event, dict):
  905:                 continue
  906:             append_workplace_resource_event(
  907:                 workplace_root,
  908:                 resource_management_event(
  909:                     scope="workplace",
  910:                     command=str(payload["command"]),
  911:                     event_type=str(event["event_type"]),
  912:                     target=event.get("target") if isinstance(event.get("target"), dict) else {},
  913:                     status=str(event["status"]),
  914:                     message=str(event["message"]),
  915:                     event_id=f"evt_{safe_id(effect_id + '-' + str(event['event_type']), 'event')}",
  916:                 ),
  917:             )
  918:         print(f"PROPOSAL: {rel(proposal_path, workplace_root)}")
  919:         return
  920:     raise RuntimeError(f"unknown authoring effect kind: {kind}")
  921: 
  922: 
  923: def run_post_commit_effect_records(
  924:     journal: dict[str, Any],
  925:     journal_path: Path,
  926:     plan: AuthoringPlan | None = None,
  927: ) -> None:
  928:     for record in journal.get("post_commit_effects", []) if isinstance(journal.get("post_commit_effects"), list) else []:
  929:         if not isinstance(record, dict) or not record.get("executable"):
  930:             continue
  931:         if record.get("state") == "succeeded":
  932:             continue
  933:         record["state"] = "running"
  934:         record["attempts"] = int(record.get("attempts") or 0) + 1
  935:         record["last_error"] = None
  936:         journal["state"] = "committed_audit_pending"
  937:         write_authoring_journal_data(journal_path, journal)
  938:         try:
  939:             execute_authoring_effect(record, plan)
  940:         except BaseException as exc:
  941:             record["state"] = "failed"
  942:             record["last_error"] = str(exc)
  943:             journal["state"] = "committed_audit_pending"
  944:             write_authoring_journal_data(journal_path, journal)
  945:             raise
  946:         record["state"] = "succeeded"
  947:         write_authoring_journal_data(journal_path, journal)
  948:     journal["state"] = "committed_audit_complete"
  949:     journal["post_commit_completed"] = [
  950:         str(record.get("label") or record.get("effect_id"))
  951:         for record in journal.get("post_commit_effects", [])
  952:         if isinstance(record, dict) and record.get("executable") and record.get("state") == "succeeded"
  953:     ]
  954:     write_authoring_journal_data(journal_path, journal)
  955: 
  956: 
  957: def run_post_commit_effects(plan: AuthoringPlan, journal: dict[str, Any]) -> None:
  958:     authoring_failure_point("after_commit_before_audit", plan)
  959:     run_post_commit_effect_records(journal, authoring_journal_path(plan), plan)
  960: 
  961: 
  962: def execute_authoring_plan(plan: AuthoringPlan) -> dict[str, Any]:
  963:     preflight_authoring_plan(plan)
  964:     journal, staged = stage_authoring_plan(plan)
  965:     try:
  966:         validate_staged_authoring_plan(plan, journal, staged)
  967:         commit_authoring_plan(plan, journal, staged)
  968:     except BaseException:
  969:         if journal.get("state") not in {"rolled_back", "recovery_required"}:
  970:             rollback_authoring_plan(plan, journal)
  971:         raise
  972:     run_post_commit_effects(plan, journal)
  973:     return journal
  974: 
  975: 
  976: def validate_authoring_recovery_journal(journal_path: Path, data: dict[str, Any]) -> list[str]:
  977:     errors: list[str] = []
  978:     transaction_root = journal_path.parent.resolve()
  979:     if not isinstance(data.get("transaction_id"), str) or not data.get("transaction_id"):
  980:         errors.append("journal transaction_id missing")
  981:     writes = data.get("writes")
  982:     if not isinstance(writes, list):
  983:         return [*errors, "journal writes missing"]
  984:     for index, record in enumerate(writes):
  985:         if not isinstance(record, dict):
  986:             errors.append(f"write {index} is not an object")
  987:             continue
  988:         destination = Path(str(record.get("destination") or ""))
  989:         backup = Path(str(record.get("backup_path") or ""))
  990:         if not destination.is_absolute():
  991:             errors.append(f"write {index} destination is not absolute")
  992:         try:
  993:             backup.resolve().relative_to(transaction_root)
  994:         except ValueError:
  995:             errors.append(f"write {index} backup path escapes transaction root")
  996:     return errors
  997: 
  998: 
  999: def recover_authoring_transaction(journal_path: Path, *, apply: bool = True) -> str:
 1000:     data = load_yaml_document(journal_path)
 1001:     if not isinstance(data, dict):
 1002:         raise SystemExit(f"FAIL: authoring journal is invalid: {journal_path}")
 1003:     state = str(data.get("state") or "")
 1004:     if state in {"rolled_back", "committed_audit_complete"}:
 1005:         return state
 1006:     if not apply:
 1007:         return state or "unknown"
 1008:     validation_errors = validate_authoring_recovery_journal(journal_path, data)
 1009:     if validation_errors:
 1010:         data["state"] = "recovery_required"
 1011:         data["rollback_verified"] = False
 1012:         data["recovery_errors"] = validation_errors
 1013:         write_authoring_journal_data(journal_path, data)
 1014:         return "recovery_required"
 1015:     if state in {"committed", "committed_audit_pending"}:
 1016:         run_post_commit_effect_records(data, journal_path, None)
 1017:         return str(data["state"])
 1018:     errors: list[str] = []
 1019:     transaction_id = str(data.get("transaction_id") or journal_path.parent.name)
 1020:     for record in reversed(data.get("writes", []) if isinstance(data.get("writes"), list) else []):
 1021:         if not isinstance(record, dict) or not record.get("published"):
 1022:             continue
 1023:         errors.extend(authoring_restore_record(record, transaction_id))
 1024:     errors.extend(remove_authoring_created_directories(data))
 1025:     errors.extend(verify_authoring_rollback(data))
 1026:     ok = not errors
 1027:     data["state"] = "rolled_back" if ok else "recovery_required"
 1028:     data["rollback_verified"] = ok
 1029:     data["recovery_errors"] = errors
 1030:     write_authoring_journal_data(journal_path, data)
 1031:     return str(data["state"])
 1032: 
 1033: 
 1034: def command_authoring_transaction_recover(args: argparse.Namespace) -> int:
 1035:     runtime_root = Path(args.runtime_root).expanduser().resolve()
 1036:     transaction_id = validate_resource_id(str(args.transaction), "authoring transaction")
 1037:     journal_path = runtime_root / "authoring-transactions" / transaction_id / "journal.yaml"
 1038:     if not journal_path.is_file():
 1039:         raise SystemExit(f"FAIL: authoring transaction journal not found: {journal_path}")
 1040:     mode = authoring_mode(args)
 1041:     state = recover_authoring_transaction(journal_path, apply=mode == "apply")
 1042:     print(f"TRANSACTION: {transaction_id}")
 1043:     print(f"STATE: {state}")
 1044:     return 1 if state == "recovery_required" else 0
 1045: 
