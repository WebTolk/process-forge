25375:         raise SystemExit(f"FAIL: specialization not found: {specialization_id}")
25376:     data = load_yaml_document(path)
25377:     if not isinstance(data, dict) or yaml_error(data):
25378:         raise SystemExit(f"FAIL: specialization YAML invalid: {rel(path, workplace_root)}")
25379:     binding = {
25380:         "platforms": [platform_contract_id(str(args.platform))],
25381:         "platform_stack_includes": [platform_contract_id(item) for item in getattr(args, "platform_stack_includes", [])],
25382:         "applies_to_project_types": [str(item) for item in getattr(args, "project_type", [])],
25383:         "tags": [],
25384:         "resources": default_resource_buckets(),
25385:         "provides_capabilities": [str(item) for item in getattr(args, "provides_capability", [])],
25386:     }
25387:     legacy_process_filters = [str(item) for item in getattr(args, "process", [])]
25388:     if legacy_process_filters:
25389:         binding["applies_to_processes"] = legacy_process_filters
25390:     for value in getattr(args, "requires_knowledge", []):
25391:         binding["resources"]["requires"]["knowledge_packages"].append(str(value))
25392:     for value in getattr(args, "requires_tool", []):
25393:         binding["resources"]["requires"]["tools"].append(str(value))
25394:     for value in getattr(args, "requires_mcp", []):
25395:         binding["resources"]["requires"]["mcp"].append(str(value))
25396:     for value in getattr(args, "requires_template", []):
25397:         binding["resources"]["requires"]["templates"].append(str(value))
25398:     if not getattr(args, "apply", False):
25399:         print(dump_yaml(binding), end="")
25400:         return 0
25401:     bindings = data.setdefault("platform_bindings", [])
25402:     if not isinstance(bindings, list):
25403:         bindings = []
25404:         data["platform_bindings"] = bindings
25405:     bindings.append(binding)
25406:     write_authoring_text(path, dump_yaml(data))
25407:     append_workplace_resource_event(workplace_root, resource_management_event(scope="workplace", command="specialization-bind-platform", event_type="specialization.platform_bound", target={"specialization_id": specialization_id, "platform": platform_contract_id(str(args.platform))}, status="updated", message="specialization platform binding added"))
25408:     print(f"UPDATED: {rel(path, workplace_root)}")
25409:     return 0
