 2679: def command_workplace_setup_review(args: argparse.Namespace) -> int:
 2680:     workplace = Path(args.workplace).expanduser().resolve()
 2681:     session_id = safe_id(args.session_id or "default", "setup-session")
 2682:     session_dir = workplace_setup_session_dir(workplace, session_id)
