23736:     print(f"FAILED_FILES: {payload.get('failed_file_count')}")
23737:     print(f"LAST_SUCCESSFUL_REFRESH: {payload.get('last_successful_refresh') or 'none'}")
23738:     print(f"LAST_FULL_RECONCILIATION: {payload.get('last_full_reconciliation') or 'none'}")
23739:     if payload.get("error"):
23740:         print(f"ERROR: {payload.get('error')}")
23741:     if payload.get("path"):
23742:         print(f"INDEX: {payload.get('path')}")
