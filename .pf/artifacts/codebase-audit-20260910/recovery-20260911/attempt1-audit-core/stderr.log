   65: def _official_pack_manifest_records(context: ProcessCatalogContext) -> list[tuple[Path, dict[str, Any]]]:
   66:     distribution_root = context.distribution_root.resolve()
   67:     records: list[tuple[Path, dict[str, Any]]] = []
   68:     for path in sorted((distribution_root / "packs" / "official").glob("*/package.yaml")):
   69:         data = load_yaml_document(path)
   70:         if (
   71:             isinstance(data, dict)
   72:             and not yaml_error(data)
   73:             and data.get("kind") == "processforge.pack"
   74:             and data.get("origin") == "official"
   75:             and data.get("id")
   76:         ):
   77:             records.append((path, data))
