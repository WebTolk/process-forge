23327: def project_roots_under_workplace(workplace_root: Path) -> list[Path]:
23328:     candidates = []
23329:     if (workplace_root / ".pf" / "process-forge.yaml").is_file():
23330:         candidates.append(workplace_root)
23331:     projects_root = workplace_root / "projects"
23332:     if projects_root.is_dir():
23333:         for path in sorted(projects_root.iterdir()):
23334:             if path.is_dir() and (path / ".pf" / "process-forge.yaml").is_file():
23335:                 candidates.append(path)
23336:     return candidates
