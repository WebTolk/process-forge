23841: def command_core_update_apply(args: argparse.Namespace) -> int:
23842:     from processforge_core.core_update import CoreUpdateError, apply_update
23843: 
23844:     try:
23845:         payload = apply_update(
23846:             Path(args.core_root).expanduser().resolve(),
23847:             Path(args.archive).expanduser().resolve(),
23848:             confirm=bool(args.confirm),
23849:             force_local_modifications=bool(args.force_local_modifications),
23850:             workplace_root=Path(args.workplace_root).expanduser().resolve() if args.workplace_root else None,
23851:         )
23852:     except CoreUpdateError as exc:
23853:         print(json.dumps({"error": {"code": exc.code, "message": exc.message}}, indent=2, sort_keys=True))
23854:         return 1
23855:     if args.workplace_root:
23856:         core_root = Path(args.core_root).expanduser().resolve()
23857:         command = [sys.executable, str(core_root / "bin" / "pf.py"), "doctor-workplace", "--root", str(Path(args.workplace_root).expanduser().resolve())]
23858:         try:
23859:             completed = subprocess.run(command, text=True, encoding="utf-8", errors="replace", capture_output=True, timeout=90)
23860:             doctor = {"status": "pass" if completed.returncode == 0 else "fail", "command": command, "output": completed.stdout + completed.stderr}
23861:         except (OSError, subprocess.TimeoutExpired) as exc:
23862:             doctor = {"status": "fail", "command": command, "output": str(exc)}
23863:         payload["post_update_doctor"] = doctor
23864:         last_apply_path = core_root / "runtime" / "core-update" / "last-apply.json"
23865:         if last_apply_path.is_file():
23866:             last_apply = json.loads(last_apply_path.read_text(encoding="utf-8"))
23867:             last_apply["post_update_doctor"] = doctor
23868:             last_apply_path.write_text(json.dumps(last_apply, indent=2, sort_keys=True) + "\n", encoding="utf-8")
23869:     print(json.dumps(payload, indent=2, sort_keys=True))
23870:     return 0 if not args.workplace_root or payload["post_update_doctor"]["status"] == "pass" else 2
