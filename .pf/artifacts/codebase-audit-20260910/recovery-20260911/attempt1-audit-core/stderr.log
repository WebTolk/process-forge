 2566:             "outputs": [
 2567:                 str(item)
 2568:                 for item in as_list(
 2569:                     discovery.get("outputs")
 2570:                     or ["device-discovery-report.md", "resource-candidates.yaml", "auto-setup-proposal.md"]
 2571:                 )
 2572:             ],
 2573:         },
 2574:         "registries": {
 2575:             "knowledge_roots": resources.get("knowledge_roots", []),
 2576:             "package_roots": resources.get("package_roots", []),
 2577:             "tools": resources.get("tools", []),
 2578:             "mcp_servers": resources.get("mcp_servers", []),
 2579:             "templates": resources.get("templates", []),
 2580:         },
 2581:         "privacy": answers.get("privacy_safety", {}),
 2582:         "platform_policy": answers.get("platform_contracts", {}),
 2583:         "coordination": {
 2584:             "director_capability": bool(coordination.get("director_capability", False)),
 2585:             "default_project_mode": normalize_workplace_default_project_mode(coordination.get("default_project_mode", "simple")),
 2586:             "initialize_director_office": bool(coordination.get("initialize_director_office", False)),
 2587:         },
 2588:         "first_project": first_project,
 2589:         "apply_steps": [
 2590:             "review optional device-discovery findings and resource candidates",
 2591:             "run workplace-init internals",
 2592:             "write workplace registries",
 2593:             "write agent instruction snippet",
 2594:             "run doctor-workplace",
 2595:             "write project-onboard next steps",
 2596:         ],
 2597:     }
 2598:     md = f"""# Guided Workplace Setup Proposal
 2599: 
 2600: ## Session
 2601: 
 2602: - id: `{safe_id(session_id, "setup-session")}`
 2603: - status: `ready_for_review`
 2604: 
 2605: ## Layout
 2606: 
 2607: - ProcessForge root: `{proposal["processforge"]["root_ref"]}`
 2608: - Workplace: `{proposal["workplace"]["path_ref"]}`
 2609: - Local docs: `{proposal["local_docs"]["path_ref"]}`
 2610: - Project roots: {", ".join(proposal["project_roots"]) if proposal["project_roots"] else "not set"}
 2611: - Director capability: {str(proposal["coordination"]["director_capability"]).lower()}
 2612: - Default project mode: {proposal["coordination"]["default_project_mode"]}
 2613: - Initialize Director Office: {str(proposal["coordination"]["initialize_director_office"]).lower()}
 2614: 
 2615: ## Agent Environments
 2616: 
 2617: - Tools: {", ".join(proposal["agent_environments"])}
 2618: - Instruction targets: {", ".join(proposal["instruction_targets"])}
 2619: 
 2620: ## Device Discovery
 2621: 
 2622: - Enabled: {proposal["device_discovery"]["enabled"]}
 2623: - Read only: {str(proposal["device_discovery"]["read_only"]).lower()}
 2624: - Outputs: {", ".join(proposal["device_discovery"]["outputs"])}
 2625: 
 2626: ## Apply Plan
 2627: 
 2628: 1. Review optional device-discovery findings and resource candidates.
 2629: 2. Create or update the workplace layer through `workplace-init`.
 2630: 3. Preserve private machine paths inside workplace-local files.
 2631: 4. Generate a bounded ProcessForge agent instruction snippet.
 2632: 5. Run `doctor-workplace`.
 2633: 6. Write project onboarding next steps.
 2634: """
 2635:     return proposal, md
