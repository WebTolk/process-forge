   21: def _stable_ids(value: Any) -> list[str]:
   22:     values = value if isinstance(value, list) else ([] if value is None or value == "" else [value])
   23:     result: list[str] = []
   24:     for item in values:
   25:         candidate = str(item.get("id") if isinstance(item, dict) else item or "").strip()
   26:         if candidate and candidate not in result:
   27:             result.append(candidate)
   28:     return result
   29: 
