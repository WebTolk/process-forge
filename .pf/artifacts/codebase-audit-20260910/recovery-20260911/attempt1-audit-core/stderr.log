25466: def command_project_override_doctor(args: argparse.Namespace) -> int:
25467:     project_root = Path(args.project_root).expanduser().resolve()
25468:     path = project_overrides_path(project_root)
25469:     checks: list[Check] = []
25470:     checks.append(check("PASS", "project overrides file optional") if not path.is_file() else check("PASS", "project overrides file found"))
25471:     data = load_project_overrides(project_root)
25472:     checks.append(check("PASS" if data.get("kind") in {None, "processforge.project_overrides"} else "FAIL", "project overrides kind valid"))
25473:     for entry in project_override_entries(project_root):
25474:         mode = str(entry.get("mode") or "")
25475:         checks.append(check("PASS" if mode in PROJECT_OVERRIDE_MODES else "FAIL", f"{entry.get('kind')} {entry.get('target')} mode valid"))
25476:         override_path = project_override_path(project_root, entry)
25477:         if override_path:
25478:             checks.append(check("PASS" if path_is_relative_to(override_path, locate_flow_root(project_root)) else "FAIL", f"{entry.get('target')} override path is project-local"))
25479:             checks.append(check("PASS" if override_path.is_file() else "WARN", f"{entry.get('target')} override file exists"))
25480:     return print_checks(checks)
