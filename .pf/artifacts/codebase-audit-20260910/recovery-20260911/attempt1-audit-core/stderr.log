 2507:     resources = answers.get("resources") if isinstance(answers.get("resources"), dict) else {}
 2508:     privacy = answers.get("privacy_safety") if isinstance(answers.get("privacy_safety"), dict) else {}
 2509:     coordination = answers.get("coordination") if isinstance(answers.get("coordination"), dict) else {}
 2510:     package_roots = {}
 2511:     for item in resources.get("package_roots", []) if isinstance(resources.get("package_roots"), list) else []:
 2512:         if isinstance(item, dict):
