 4536: def merge_resource_buckets(target: dict[str, dict[str, list[str]]], resources: dict[str, Any] | None) -> None:
 4537:     for bucket in RESOURCE_BUCKET_KEYS:
 4538:         for key in RESOURCE_GROUP_KEYS:
 4539:             values = resource_bucket(resources, bucket, key)
 4540:             if values:
 4541:                 target[bucket][key].extend(values)
