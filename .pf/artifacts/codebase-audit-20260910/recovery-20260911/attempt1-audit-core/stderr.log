 4115: def project_platform_contract_paths(project_root: Path | None) -> list[Path]:
 4116:     if not project_root:
 4117:         return []
 4118:     candidates: list[Path] = []
 4119:     for root in [project_root / PROJECT_FLOW_ROOT / "platform-contracts", project_root / "platform-contracts"]:
 4120:         if root.is_dir():
 4121:             candidates.extend(sorted(root.glob("*.yaml")))
 4122:             candidates.extend(sorted(root.glob("*.yml")))
 4123:             candidates.extend(sorted(root.glob("*/platform-contract.yaml")))
 4124:             candidates.extend(sorted(root.glob("*/platform-contract.yml")))
 4125:     return candidates
