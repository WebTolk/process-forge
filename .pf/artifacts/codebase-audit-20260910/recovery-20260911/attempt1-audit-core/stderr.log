26022: def command_platform_contract_install(args: argparse.Namespace) -> int:
26023:     normalized = install_platform_args(args)
26024:     mode = authoring_mode(normalized)
26025:     plan, _values, contract_path = build_platform_authoring_plan(
26026:         normalized,
26027:         "platform-contract-install",
26028:     )
26029:     workplace_root = Path(args.workplace).expanduser().resolve()
26030:     if mode == "dry_run":
26031:         render_authoring_dry_run(plan, workplace_root)
26032:         return 0
26033:     execute_authoring_plan(plan)
26034:     print(f"CONTRACT: {rel(contract_path, workplace_root)}")
26035:     print_search_index_maintenance_summary(search_index_maintenance_for_known_projects(workplace_root, reason="platform-contract-install"))
26036:     return 0
