 2527:             "approved_before_apply": False,
 2528:         },
 2529:         "workplace": {"id": safe_id(workplace.name or "workplace", "workplace"), "name": workplace.name or "ProcessForge Workplace"},
 2530:         "paths": {
 2531:             "root": str(machine.get("workplace_path") or workplace),
 2532:             "knowledge_roots": knowledge_roots,
 2533:             "package_roots": package_roots,
 2534:             "template_roots": {"global": "${PF_WORKPLACE}/reusable-templates"},
 2535:             "distributions": {"processforge": processforge_root},
 2536:         },
 2537:         "policies": {"shell_is_fallback": True, "local_paths_private_only": bool(privacy.get("local_paths_private_only", True))},
 2538:         "coordination": {
 2539:             "director_enabled": bool(coordination.get("director_capability", False)),
 2540:             "director_office_enabled": bool(coordination.get("initialize_director_office", False)),
 2541:             "default_project_mode": normalize_workplace_default_project_mode(coordination.get("default_project_mode", "simple")),
 2542:         },
 2543:     }
