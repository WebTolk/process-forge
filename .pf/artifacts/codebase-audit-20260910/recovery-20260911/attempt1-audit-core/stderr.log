25582:             "templates": values["required_templates"],
25583:         },
25584:         "recommends": {
25585:             "knowledge_packages": values["recommended_packages"],
25586:             "templates": values["recommended_templates"],
25587:             "tools": values["recommended_tools"],
25588:             "mcp": values["recommended_mcp"],
25589:         },
25590:         "optional": {
25591:             "knowledge_packages": values["optional_packages"],
25592:             "templates": values["optional_templates"],
25593:             "tools": values["optional_tools"],
25594:             "mcp": values["optional_mcp"],
25595:         },
25596:         "includes": {
25597:             "knowledge_packages": values["optional_packages"],
25598:             "templates": values["optional_templates"],
25599:             "tools": values["optional_tools"],
25600:             "mcp": values["optional_mcp"],
25601:             "processes": values["processes"],
25602:         },
25603:         "policies": {
25604:             "missing_required_capability": "block",
25605:             "missing_optional_resource": "warn",
25606:         },
25607:     }
