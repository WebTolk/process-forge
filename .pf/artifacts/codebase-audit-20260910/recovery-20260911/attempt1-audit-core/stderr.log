 4251: def contract_includes(contract: dict[str, Any], key: str) -> list[str]:
 4252:     includes = contract.get("includes", {}) if isinstance(contract.get("includes"), dict) else {}
 4253:     output: list[str] = []
 4254:     value = includes.get(key)
 4255:     if isinstance(value, str):
 4256:         return [value]
 4257:     if isinstance(value, list):
 4258:         for item in value:
 4259:             if isinstance(item, str):
 4260:                 output.append(item)
 4261:             elif isinstance(item, dict) and item.get("required") is not True:
 4262:                 item_id = item.get("id") or item.get("package") or item.get("template") or item.get("capability")
 4263:                 if item_id:
 4264:                     output.append(str(item_id))
 4265:     return sorted(set(output))
 4266: 
 4267: 
 4268: def contract_recommended_items(contract: dict[str, Any], key: str) -> list[str]:
 4269:     recommends = contract.get("recommends") if isinstance(contract.get("recommends"), dict) else {}
 4270:     values = list_value(recommends.get(key))
 4271:     values.extend(contract_includes(contract, key))
 4272:     return sorted(set(values))
 4273: 
 4274: 
 4275: def contract_optional_items(contract: dict[str, Any], key: str) -> list[str]:
 4276:     optional = contract.get("optional") if isinstance(contract.get("optional"), dict) else {}
 4277:     return sorted(set(list_value(optional.get(key))))
