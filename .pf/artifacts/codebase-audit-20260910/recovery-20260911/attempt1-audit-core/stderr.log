20868: def command_iteration_complete(args: argparse.Namespace) -> int:
20869:     project_root = Path(args.project_root).expanduser().resolve()
20870:     task_id = safe_id(args.task, "task")
20871:     task = load_task(project_root, task_id)
20872:     status = args.status
20873:     if status not in ITERATION_STATUSES:
20874:         raise SystemExit(f"FAIL: invalid iteration status: {status}")
20875:     iterations = task.get("iterations") if isinstance(task.get("iterations"), list) else []
20876:     found = False
20877:     for item in iterations:
20878:         if isinstance(item, dict) and item.get("id") == args.iteration:
20879:             item["status"] = status
20880:             item["completed_at"] = now_utc()
20881:             if args.summary:
20882:                 item["summary"] = args.summary
20883:             found = True
20884:             break
20885:     if not found:
20886:         raise SystemExit(f"FAIL: iteration not found: {args.iteration}")
20887:     if getattr(args, "dry_run", False):
20888:         print(f"DRY-RUN: would complete iteration {args.iteration}")
20889:         return 0
20890:     task["iterations"] = iterations
20891:     save_task(project_root, task)
20892:     emit_process_event(project_root, "iteration.completed" if status in {"completed", "passed"} else "iteration.failed", process_id=task_process_id(task), subject=args.iteration, assignment_id_value=task_id, assignment_path=rel(assignment_yaml_path(project_root, task_id), project_root), payload={"run_id": task.get("run_id"), "task_id": task_id, "iteration_id": args.iteration, "status": status}, correlation_id=f"run-{task.get('run_id')}")
20893:     print(f"UPDATED: {args.iteration}")
20894:     return 0
