22434: def validate_normalized_update_manifest_data(data: dict[str, Any], path: Path) -> list[Check]:
22435:     checks: list[Check] = []
22436:     append_json_schema_checks(checks, data, "normalized-update-manifest.schema.json", str(path))
22437:     if data.get("schema_version") != 1:
22438:         checks.append(check("FAIL", f"{path} schema_version must be 1"))
22439:     product = data.get("product") if isinstance(data.get("product"), dict) else {}
22440:     if not product.get("id"):
22441:         checks.append(check("FAIL", f"{path} product.id missing"))
22442:     subjects = data.get("subjects")
22443:     if not isinstance(subjects, list):
22444:         checks.append(check("FAIL", f"{path} subjects must be a list"))
22445:         return checks
22446:     for subject_index, subject in enumerate(subjects):
22447:         if not isinstance(subject, dict):
22448:             checks.append(check("FAIL", f"subjects[{subject_index}] must be an object"))
22449:             continue
22450:         for key in ("type", "id"):
22451:             if not isinstance(subject.get(key), str) or not str(subject.get(key)).strip():
22452:                 checks.append(check("FAIL", f"subjects[{subject_index}].{key} missing"))
22453:         versions = subject.get("versions")
22454:         if not isinstance(versions, list):
22455:             checks.append(check("FAIL", f"subjects[{subject_index}].versions must be a list"))
22456:             continue
22457:         for version_index, version in enumerate(versions):
22458:             if not isinstance(version, dict):
22459:                 checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}] must be an object"))
22460:                 continue
22461:             artifacts = version.get("artifacts")
22462:             if not isinstance(artifacts, list):
22463:                 checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}].artifacts must be a list"))
22464:                 continue
22465:             for artifact_index, artifact in enumerate(artifacts):
22466:                 if not isinstance(artifact, dict):
22467:                     checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}].artifacts[{artifact_index}] must be an object"))
22468:                     continue
22469:                 artifact_url = artifact.get("url")
22470:                 if not artifact_url:
22471:                     checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}].artifacts[{artifact_index}].url missing"))
22472:                 elif not isinstance(artifact_url, str):
22473:                     checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}].artifacts[{artifact_index}].url must be a string"))
22474:                 else:
22475:                     valid, reason = valid_artifact_url_shape(artifact_url, artifact)
22476:                     if not valid:
22477:                         checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}].artifacts[{artifact_index}].url {reason}"))
22478:                 artifact_sha256 = artifact.get("sha256")
22479:                 if not artifact_sha256:
22480:                     checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}].artifacts[{artifact_index}].sha256 missing"))
22481:                 elif not isinstance(artifact_sha256, str) or not SHA256_HEX_RE.fullmatch(artifact_sha256):
22482:                     checks.append(check("FAIL", f"subjects[{subject_index}].versions[{version_index}].artifacts[{artifact_index}].sha256 must be 64 hex characters"))
22483:     if not checks:
22484:         checks.append(check("PASS", f"{path} valid normalized update manifest"))
22485:     return checks
