 1146: def contained_resource_path(root: Path, target: Path, resource_kind: str = "resource") -> Path:
 1147:     try:
 1148:         resolved_root = root.expanduser().resolve()
 1149:         resolved_target = target.expanduser().resolve()
 1150:         resolved_target.relative_to(resolved_root)
 1151:     except (OSError, RuntimeError, ValueError) as exc:
 1152:         raise SystemExit(
 1153:             f"FAIL: invalid {resource_kind} target cannot be contained under declared root: {target.as_posix()}"
 1154:         ) from exc
 1155:     return resolved_target
