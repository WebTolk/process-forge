 1420:     def _validated_id(self, value: str, kind: str) -> str:
 1421:         identifier = str(value or "")
 1422:         if not SAFE_ID_RE.fullmatch(identifier):
 1423:             raise ValueError(f"unsafe {kind} id: {identifier!r}")
 1424:         return identifier
 1425: 
 1426:     def _flow_root(self) -> Path:
 1427:         return self.core.locate_flow_root(self.project_root)
