  120: @dataclass(frozen=True)
  121: class ProcessExecutionService:
  122:     project_root: Path
  123:     workplace_root: Path | None
  124:     core: Any
  125: 
  126:     def start(self, *, objective: str, process_id: str = "", session_id: str = "", stage_override: str = "") -> dict[str, Any]:
  127:         with self._start_lock():
  128:             return self._start_locked(objective=objective, process_id=process_id, session_id=session_id, stage_override=stage_override)
  129: 
  130:     def _start_locked(self, *, objective: str, process_id: str = "", session_id: str = "", stage_override: str = "") -> dict[str, Any]:
  131:         objective = str(objective or "").strip()
  132:         if not objective:
  133:             return self._blocked("objective_required")
  134:         check = self._context_check()
  135:         if str(check.get("status") or "") not in {"fresh", "fresh_with_updates"}:
  136:             return self._blocked(
  137:                 "snapshot_not_fresh",
  138:                 context={"status": check.get("status"), "recommended_action": check.get("recommended_action")},
  139:             )
  140:         duplicate = self._find_by_objective(objective)
  141:         if duplicate.get("active"):
  142:             state = self.state(
  143:                 run_id=str(duplicate["active"].get("run_id") or ""),
  144:                 assignment_id=str(duplicate["active"].get("assignment_id") or ""),
  145:                 session_id=session_id,
  146:             )
  147:             return {
  148:                 "schema_version": 1,
  149:                 "kind": "pf.work.start",
  150:                 "action": "continue_existing",
  151:                 "project": state.get("project", {}),
  152:                 "run_id": state.get("run", {}).get("id"),
  153:                 "assignment_id": state.get("assignment", {}).get("id"),
  154:                 "stage": state.get("stage", {}).get("id"),
  155:                 "session": {"status": "bound", "id": session_id} if session_id else {"status": "absent"},
  156:                 "work_state": state,
  157:             }
  158:         if duplicate.get("historical"):
  159:             return self._blocked(
  160:                 "completed_historical_work_matches_objective",
  161:                 action="operator_choice_required",
  162:                 historical=duplicate["historical"][:5],
  163:             )
  164: 
  165:         selection = self._project_process_selection()
  166:         requested_process = str(process_id or "").strip()
  167:         selected_process, selection_result = self._select_process(selection, requested_process)
  168:         if not selected_process:
  169:             return selection_result
  170:         try:
  171:             definition = self.core.resolve_process_definition(self.project_root, selected_process)
  172:         except (OSError, SystemExit, ValueError):
  173:             return self._blocked("process_definition_unavailable", process_id=selected_process)
  174:         process = copy.deepcopy(definition.process)
  175:         stages = executable_stages(process)
  176:         if not stages:
  177:             return self._blocked("process_has_no_executable_stages", process_id=selected_process)
  178:         try:
  179:             stage_id = initial_stage_id(process)
  180:             if stage_override:
  181:                 valid = {str(item.get("id")) for item in stages}
  182:                 if stage_override not in valid:
  183:                     return self._blocked(
  184:                         "invalid_preferred_stage",
  185:                         action="operator_choice_required",
  186:                         valid_stages=sorted(valid),
  187:                     )
  188:                 stage_id = stage_override
  189:             for stage in stages:
  190:                 normalized_outcomes(process, str(stage.get("id")))
  191:         except ValueError as exc:
  192:             return self._blocked("invalid_process_definition", message=str(exc), process_id=selected_process)
  193: 
  194:         now = self.core.now_utc()
  195:         flow_root = self._flow_root()
  196:         run_id = self._unique_id(flow_root / "runs", "garage-" + self.core.safe_id(objective, "work"))
  197:         assignment_id = self._unique_id(flow_root / "assignments", self.core.safe_id(objective, "task"))
  198:         specialization_selection = project_specialization_selection(self._manifest(), process)
  199:         active_specializations = specialization_selection["active"]
  200:         selected_resource_ids = self._selected_resource_ids()
  201:         pin = self._process_pin(process, definition.path, active_specializations=active_specializations, selected_resource_ids=selected_resource_ids, allowed_processes=selection["allowed"])
  202:         run = {
  203:             "schema_version": 1,
  204:             "id": run_id,
  205:             "title": objective[:80],
  206:             "process": selected_process,
  207:             "status": "in_progress",
  208:             "created_at": now,
  209:             "updated_at": now,
  210:             "objective": objective,
  211:             "platform": "",
  212:             "selected_specializations": active_specializations,
  213:             "scope": {"type": "project", "project_root": "."},
  214:             "tasks": [{"id": assignment_id, "assignment": f".pf/assignments/{assignment_id}.yaml", "status": "in_progress", "order": 1, "blocking": True}],
  215:             "final_artifacts": [],
  216:             "events": {"emitted": ["run.created", "process.stage.started"]},
  217:             "privacy": {"public_safe": True},
  218:             "process_execution": pin,
  219:         }
  220:         assignment = {
  221:             "schema_version": 1,
  222:             "id": assignment_id,
  223:             "title": objective[:80],
  224:             "run_id": run_id,
  225:             "process": selected_process,
  226:             "status": "in_progress",
  227:             "created_at": now,
  228:             "updated_at": now,
  229:             "objective": objective,
  230:             "platform": "",
  231:             "selected_specializations": active_specializations,
  232:             "order": 1,
  233:             "dependencies": {"blocked_by": [], "blocks": []},
  234:             "iterations": [],
  235:             "result": {"status": "pending", "summary": "", "artifacts": []},
  236:             "execution_mode": {"kind": "implementation", "code_changes_allowed": True, "artifact_changes_allowed": True, "requires_review": True},
  237:             "stage": stage_id,
  238:             "stage_status": "in_progress",
  239:             "stage_execution": {"started_at": now, "evidence": [], "notes": ""},
  240:             "stage_history": [],
  241:             "process_execution": {
  242:                 "process_id": pin["process_id"],
  243:                 "process_version": pin["process_version"],
  244:                 "process_fingerprint": pin["process_fingerprint"],
  245:                 "snapshot_id": pin["snapshot_id"],
  246:                 "snapshot_checksum": pin["snapshot_checksum"],
  247:             },
  248:         }
  249:         if session_id:
  250:             assignment["session"] = {"status": "bound", "id": session_id}
  251:         capsule_path, capsule_checksum = self._write_capsule(run, assignment, pin)
  252:         run["process_execution"]["assignment_capsule"] = capsule_path
  253:         run["process_execution"]["assignment_capsule_checksum"] = capsule_checksum
  254:         assignment["process_execution"]["assignment_capsule"] = capsule_path
  255:         assignment["process_execution"]["assignment_capsule_checksum"] = capsule_checksum
  256: 
  257:         run_path = self._run_path(run_id)
  258:         assignment_path = self._assignment_path(assignment_id)
  259:         self._atomic_yaml(run_path, run)
  260:         self._atomic_yaml(assignment_path, assignment)
  261:         self._atomic_text(run_path.parent / "plan.md", f"# Run Plan: {objective[:80]}\n\nObjective: {objective}\n")
  262:         self._write_task_index(run)
  263:         self._emit("run.created", run, assignment, stage_id, outcome="started")
  264:         self._emit("task.created", run, assignment, stage_id, outcome="started")
  265:         self._emit("assignment.created", run, assignment, stage_id, outcome="started")
  266:         self._emit("process.stage.started", run, assignment, stage_id, outcome="started", previous_stage_id="", next_stage_id=stage_id)
  267:         state = self.state(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  268:         self._write_projection(state)
  269:         return {
  270:             "schema_version": 1,
