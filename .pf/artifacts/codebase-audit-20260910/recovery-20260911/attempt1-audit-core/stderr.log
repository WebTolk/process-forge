22850: def update_site_policy(source: dict[str, Any], installed_subject: dict[str, Any] | None = None) -> dict[str, Any]:
22851:     policy: dict[str, Any] = {}
22852:     if isinstance(source.get("policy"), dict):
22853:         policy.update(source["policy"])
22854:     if installed_subject and isinstance(installed_subject.get("update_policy"), dict):
22855:         policy.update(installed_subject["update_policy"])
22856:     return policy
