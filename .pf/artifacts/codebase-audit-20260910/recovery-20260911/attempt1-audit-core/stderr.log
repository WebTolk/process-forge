22668: def file_url_to_path(value: str, base: Path | None = None) -> Path:
22669:     text = value.strip()
22670:     if text.startswith("file://"):
22671:         parsed = urlparse(text)
22672:         raw = url2pathname(parsed.path or "")
22673:         if os.name == "nt" and re.match(r"^/[A-Za-z]:/", raw):
22674:             raw = raw[1:]
22675:         return Path(raw).expanduser().resolve()
22676:     path = Path(text).expanduser()
22677:     if not path.is_absolute() and base is not None:
22678:         path = base / path
22679:     return path.resolve()
22680: 
