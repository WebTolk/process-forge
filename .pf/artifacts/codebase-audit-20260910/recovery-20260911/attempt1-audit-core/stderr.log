 4456: def registry_ids(data: dict[str, Any], collection_key: str) -> set[str]:
 4457:     entries = data.get(collection_key) if isinstance(data, dict) else None
 4458:     ids: set[str] = set()
 4459:     if not isinstance(entries, list):
 4460:         return ids
 4461:     for entry in entries:
 4462:         if isinstance(entry, dict):
 4463:             for key in ["id", "package_id", "capability"]:
 4464:                 value = entry.get(key)
 4465:                 if value:
 4466:                     ids.add(str(value))
 4467:     return ids
