  182: def repair(*, apply_requested: Any, execute: Callable[[], dict[str, Any]]) -> dict[str, Any]:
  183:     return apply("repair", apply_requested=apply_requested, execute=execute)

===== src/processforge_core/bootstrap.py =====
    1: """Bootstrap direct-script runtime adapters onto the packaged ProcessForge core."""
    2: 
    3: from __future__ import annotations
    4: 
    5: import importlib
    6: import importlib.util
    7: import sys
    8: from dataclasses import dataclass
    9: from pathlib import Path
   10: from types import ModuleType
   11: 
   12: LEGACY_CORE_MODULE_NAME = "processforge_core._legacy_processforge"
   13: LEGACY_PUBLIC_MODULE_NAME = "processforge"
   14: 
   15: 
   16: @dataclass(frozen=True)
   17: class RuntimeBootstrap:
   18:     repo_root: Path
   19:     core: ModuleType
   20:     host: ModuleType
   21:     service: ModuleType
   22: 
   23: 
   24: def _repo_root_from(caller_file: str | Path) -> Path:
   25:     caller_path = Path(caller_file).resolve()
   26:     for candidate in (caller_path.parent, *caller_path.parents):
   27:         if (candidate / "tools" / "processforge.py").is_file():
   28:             return candidate
   29:     raise RuntimeError(f"could not resolve repository root from {caller_path}")
   30: 
   31: 
   32: def _ensure_sys_path(path: Path) -> None:
   33:     value = str(path)
   34:     if value not in sys.path:
   35:         sys.path.insert(0, value)
   36: 
   37: 
   38: def _cached_legacy_core(script_path: Path) -> ModuleType | None:
   39:     for name in (LEGACY_CORE_MODULE_NAME, LEGACY_PUBLIC_MODULE_NAME):
   40:         module = sys.modules.get(name)
   41:         if isinstance(module, ModuleType) and Path(getattr(module, "__file__", "")).resolve() == script_path:
   42:             sys.modules[LEGACY_CORE_MODULE_NAME] = module
   43:             sys.modules[LEGACY_PUBLIC_MODULE_NAME] = module
   44:             return module
   45:     return None
   46: 
   47: 
   48: def _load_legacy_core(repo_root: Path) -> ModuleType:
   49:     script_path = (repo_root / "tools" / "processforge.py").resolve()
   50:     cached = _cached_legacy_core(script_path)
   51:     if cached is not None:
   52:         return cached
   53:     spec = importlib.util.spec_from_file_location(LEGACY_CORE_MODULE_NAME, script_path)
   54:     if spec is None or spec.loader is None:
   55:         raise ImportError(f"could not load legacy core module: {script_path}")
   56:     module = importlib.util.module_from_spec(spec)
   57:     sys.modules[LEGACY_CORE_MODULE_NAME] = module
   58:     sys.modules[LEGACY_PUBLIC_MODULE_NAME] = module
   59:     try:
   60:         spec.loader.exec_module(module)
   61:     except Exception:
   62:         if sys.modules.get(LEGACY_CORE_MODULE_NAME) is module:
   63:             sys.modules.pop(LEGACY_CORE_MODULE_NAME, None)
   64:         if sys.modules.get(LEGACY_PUBLIC_MODULE_NAME) is module:
   65:             sys.modules.pop(LEGACY_PUBLIC_MODULE_NAME, None)
   66:         raise
   67:     return module
   68: 
   69: 
   70: def bootstrap_runtime(caller_file: str | Path) -> RuntimeBootstrap:
   71:     repo_root = _repo_root_from(caller_file)
   72:     _ensure_sys_path(repo_root / "src")
   73:     _ensure_sys_path(repo_root / "tools")
   74:     core = _load_legacy_core(repo_root)
   75:     host = importlib.import_module("pf_runtime.host")
   76:     service = importlib.import_module("pf_runtime.service")
   77:     return RuntimeBootstrap(
   78:         repo_root=repo_root,
   79:         core=core,
   80:         host=host,
   81:         service=service,
   82:     )

