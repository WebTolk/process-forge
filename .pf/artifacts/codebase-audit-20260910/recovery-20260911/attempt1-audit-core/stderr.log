23730:     print(f"GENERATION: {payload.get('generation') or 'none'}")
23731:     print(f"SQLITE_VERSION: {sqlite_info.get('sqlite_version') or 'unknown'}")
23732:     print(f"FTS5: {'available' if sqlite_info.get('fts5_available') else 'unavailable'}")
23733:     print(f"RESOURCES: {payload.get('resource_count')}")
23734:     print(f"DOCUMENTS: {payload.get('document_count')}")
