 2816: def run_command_capture(func: Any, args: argparse.Namespace) -> tuple[int, str]:
 2817:     buffer = io.StringIO()
 2818:     status = 0
 2819:     with contextlib.redirect_stdout(buffer):
 2820:         try:
 2821:             status = int(func(args) or 0)
 2822:         except SystemExit as exc:
 2823:             status = int(exc.code) if isinstance(exc.code, int) else 1
 2824:             if exc.code and not isinstance(exc.code, int):
 2825:                 print(str(exc.code))
 2826:     return status, buffer.getvalue()
 2827: 
