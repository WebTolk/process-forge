20601: def _command_task_create_locked(args: argparse.Namespace) -> int:
20602:     project_root = Path(args.project_root).expanduser().resolve()
20603:     run = load_run(project_root, args.run)
20604:     run_id = str(run.get("id", safe_id(args.run, "run")))
20605:     task_id = safe_id(args.id, "task")
20606:     process_id = safe_id(args.process, "task")
20607:     require_official_process_active(project_root, process_id)
20608:     stage_id = safe_id(str(getattr(args, "stage", "") or ""), "stage") if getattr(args, "stage", None) else ""
20609:     if stage_id:
20610:         definition = resolve_process_definition(project_root, process_id)
20611:         declared_stages = {str(item.get("id") or "") for item in as_list(definition.process.get("stages")) if isinstance(item, dict)}
20612:         if stage_id not in declared_stages:
20613:             raise SystemExit(f"FAIL: stage {stage_id} is not declared by process {process_id}")
20614:     path = assignment_yaml_path(project_root, task_id)
20615:     if path.exists():
20616:         raise SystemExit(f"FAIL: task already exists: {rel(path, project_root)}")
20617:     tasks = run.get("tasks") if isinstance(run.get("tasks"), list) else []
20618:     if any(isinstance(item, dict) and item.get("id") == task_id for item in tasks):
20619:         raise SystemExit(f"FAIL: run already contains task id: {task_id}")
20620:     order = args.order or (len(tasks) + 1)
20621:     task = {
20622:         "schema_version": 1,
20623:         "id": task_id,
20624:         "title": args.title,
20625:         "run_id": run_id,
20626:         "process": process_id,
20627:         "status": "open",
20628:         "created_at": now_utc(),
20629:         "updated_at": now_utc(),
20630:         "objective": args.objective or "",
20631:         "platform": getattr(args, "platform", None) or "",
20632:         "selected_specializations": [specialization_resource_id(str(item)) for item in as_list(getattr(args, "specialization", []))],
20633:         "order": order,
20634:         "dependencies": {"blocked_by": [], "blocks": []},
20635:         "iterations": [],
20636:         "result": {"status": "pending", "summary": "", "artifacts": []},
20637:     }
20638:     if stage_id:
20639:         task["stage"] = stage_id
20640:     allowed_files = assignment_scope_items([*as_list(getattr(args, "allowed_file", [])), *as_list(getattr(args, "allowed_glob", []))])
20641:     allowed_read_files = assignment_scope_items([*as_list(getattr(args, "read_file", [])), *as_list(getattr(args, "allowed_read_file", []))])
20642:     context_artifacts = normalize_context_artifacts(getattr(args, "context_artifact", []))
20643:     required_sources = assignment_scope_items(getattr(args, "required_source", []))
20644:     forbidden_files = assignment_scope_items([*as_list(getattr(args, "forbidden_file", [])), *as_list(getattr(args, "forbidden_glob", []))])
20645:     required_outputs = normalize_required_outputs(getattr(args, "required_output", []))
20646:     if getattr(args, "execution_mode", None):
20647:         task["execution_mode"] = normalize_execution_mode(args.execution_mode)
20648:         if task["execution_mode"]["kind"] == "implementation":
20649:             task["execution_mode"]["code_changes_allowed"] = True
20650:     if context_artifacts:
20651:         task["context_artifacts"] = context_artifacts
20652:     if required_sources:
20653:         task["required_sources"] = required_sources
20654:     workspace_access = normalize_workspace_access(
20655:         {
20656:             "knowledge_resources": getattr(args, "workspace_knowledge_resource", []),
20657:             "templates": getattr(args, "workspace_template", []),
20658:             "tools": getattr(args, "workspace_tool", []),
20659:             "mcp": getattr(args, "workspace_mcp", []),
20660:         }
20661:     )
20662:     if any(workspace_access[key] for key in WORKSPACE_ACCESS_KEYS):
20663:         task["workspace_access"] = workspace_access
20664:     if allowed_files:
20665:         task["allowed_files"] = allowed_files
20666:     if allowed_read_files:
20667:         task["allowed_read_files"] = allowed_read_files
20668:     if forbidden_files:
20669:         task["forbidden_files"] = forbidden_files
20670:     writer = str(getattr(args, "writer", "true")).lower() == "true"
20671:     if allowed_files or getattr(args, "owner", None) or getattr(args, "role", None) or not writer:
20672:         task["ownership"] = {
20673:             "owner_id": safe_id(getattr(args, "owner", None) or task_id, "assignment"),
20674:             "owner_label": f"worker-{safe_id(getattr(args, 'owner', None) or task_id, 'assignment')}",
20675:             "role": getattr(args, "role", None) or "",
20676:             "writer": writer,
20677:             "owned_files": allowed_files if writer else [],
20678:             "owned_globs": [],
20679:         }
20680:     if allowed_files or forbidden_files:
20681:         task["non_overlap"] = {
20682:             "policy": "block_on_write_overlap",
20683:             "active_parallel_tasks": [],
20684:             "current_write_scope": assignment_write_scope(task),
20685:             "rule": "Do not edit files owned by active parallel tasks.",
20686:         }
20687:     if required_outputs:
20688:         task["required_outputs"] = required_outputs
20689:     agent_model = normalize_agent_model(getattr(args, "agent_model", None) or getattr(args, "model", None) or "")
20690:     if agent_model:
20691:         task["agent_model"] = agent_model
20692:     agent_reasoning_effort = normalize_agent_reasoning_effort(getattr(args, "reasoning_effort", None) or getattr(args, "agent_reasoning_effort", None) or "")
20693:     if agent_reasoning_effort:
20694:         task["agent_reasoning_effort"] = agent_reasoning_effort
20695:     expected_report: dict[str, Any] = {}
20696:     if getattr(args, "expected_report_language", None):
20697:         expected_report["language"] = args.expected_report_language
20698:     if getattr(args, "expected_report_artifact", None):
20699:         expected_report["artifact"] = normalize_assignment_path(args.expected_report_artifact)
20700:         if len(required_outputs) == 1:
20701:             required_outputs[0].setdefault("path", expected_report["artifact"])
20702:     missing_output_paths = [str(item.get("id") or "output") for item in required_outputs if not str(item.get("path") or "").strip()]
20703:     if missing_output_paths:
20704:         raise SystemExit(
20705:             "FAIL: every required output needs a path; use "
20706:             "--required-output id=<id>,path=<repository-relative-path>. Missing: "
20707:             + ", ".join(missing_output_paths)
20708:         )
20709:     if expected_report:
20710:         expected_report.setdefault("format", "concise_markdown")
20711:         expected_report.setdefault("include", [item["id"] for item in required_outputs])
20712:         task["expected_report"] = expected_report
20713:     overlap_check = validate_assignment_scope_overlaps(project_root, task, assignment_path=path)
20714:     if overlap_check["status"] == "fail" and not getattr(args, "force_with_handoff", False):
20715:         raise SystemExit("FAIL: task write scope overlaps active assignments: " + dump_yaml(overlap_check))
20716:     if overlap_check["status"] == "fail":
20717:         task.setdefault("non_overlap", {})["overlap_check"] = overlap_check
20718:     planned = [path, task_artifacts_root(project_root, run_id, task_id), run_root(project_root, run_id) / "task-index.md"]
20719:     if getattr(args, "dry_run", False):
20720:         print_plan("task-create dry run", planned, project_root)
20721:         if allowed_files or forbidden_files:
20722:             print("WRITE_SCOPE:")
20723:             for item in assignment_write_scope(task):
20724:                 print(f"- {item}")
20725:             print("OVERLAP_CHECK: " + overlap_check["status"])
20726:         return 0
20727:     task_artifacts_root(project_root, run_id, task_id).mkdir(parents=True, exist_ok=True)
20728:     write_yaml_file(path, task)
20729:     tasks.append({"id": task_id, "assignment": rel(path, project_root), "status": "open", "order": order, "blocking": True})
20730:     run["tasks"] = tasks
20731:     save_run_locked(project_root, run)
20732:     for event_type in ["task.created", "assignment.created"]:
20733:         emit_process_event(project_root, event_type, process_id=task["process"], subject=task_id, assignment_id_value=task_id, assignment_path=rel(path, project_root), payload={"run_id": run_id, "task_id": task_id, "path": rel(path, project_root)}, correlation_id=f"run-{run_id}")
20734:     print(f"WROTE: {rel(path, project_root)}")
20735:     return 0
