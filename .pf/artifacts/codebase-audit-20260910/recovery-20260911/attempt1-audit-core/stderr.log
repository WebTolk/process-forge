21779: def valid_remote_url_shape(url: str, *, require_https: bool) -> tuple[bool, str]:
21780:     if CONTROL_CHAR_RE.search(url) or any(char.isspace() for char in url):
21781:         return False, "must not contain whitespace or control characters"
21782:     parsed = urlparse(url)
21783:     if parsed.scheme.lower() not in {"http", "https"} or not parsed.netloc:
21784:         return False, "must be a valid remote URL with scheme and host"
21785:     if require_https and parsed.scheme.lower() != "https":
21786:         return False, "must use https unless local trust policy disables require_https"
21787:     return True, ""
21788: 
21789: 
21790: def valid_artifact_url_shape(url: str, artifact: dict[str, Any]) -> tuple[bool, str]:
21791:     if CONTROL_CHAR_RE.search(url) or any(char.isspace() for char in url):
21792:         return False, "must not contain whitespace or control characters"
21793:     parsed = urlparse(url)
21794:     if parsed.scheme.lower() == "file":
21795:         if parsed.path or parsed.netloc:
21796:             return True, ""
21797:         return False, "file URL must include a path"
21798:     if parsed.scheme.lower() in {"http", "https"}:
21799:         if not parsed.netloc:
21800:             return False, "remote URL must include a host"
21801:         if source_requires_https(artifact) and parsed.scheme.lower() != "https":
21802:             return False, "remote URL must use https unless local trust policy disables require_https"
21803:         return True, ""
21804:     return False, "must be an https or file URL"
21805: 
