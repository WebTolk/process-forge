25370: def command_specialization_bind_platform(args: argparse.Namespace) -> int:
25371:     workplace_root = Path(args.workplace).expanduser().resolve()
25372:     specialization_id = specialization_resource_id(str(args.specialization))
25373:     path = specialization_manifest_path(workplace_root, specialization_id)
