  118: def initialize_project(request: dict[str, Any], core: Any) -> dict[str, Any]:
  119:     """Plan or perform one deterministic initialization workflow for CLI and MCP."""
  120:     normalized = _initialization_request(request, core)
  121:     project_root, workplace = normalized["project_root"], normalized["workplace"]
  122:     apply_requested = request.get("apply")
  123:     if apply_requested is True and not workplace.is_file() and not normalized["allow_missing_workplace"]:
  124:         raise ProjectInitializationError("workplace_manifest_required")
  125:     if apply_requested is not True and not project_root.is_dir():
  126:         raise ProjectInitializationError("project_root_missing")
  127:     if apply_requested is True:
  128:         def execute() -> dict[str, Any]:
  129:             # Greenfield creation is an acknowledged deterministic write. It
  130:             # must precede inspection because the legacy detector reads root.
  131:             project_root.mkdir(parents=True, exist_ok=True)
  132:             files = core.build_project_files(project_root, workplace, normalized["answers"])
  133:             return core.execute_project_initialization(normalized, files)
  134: 
  135:         return apply("initialize", apply_requested=True, execute=execute)
  136:     files = core.build_project_files(project_root, workplace, normalized["answers"])
  137:     planned = [core.rel(path, project_root) for path in files]
  138:     planned.extend(f"{core.PROJECT_FLOW_ROOT}/{item}" for item in core.PROJECT_FLOW_DIRS)
  139:     planned.append(".gitignore")
  140:     if apply_requested is not True:
  141:         return {"action": "initialize", "applied": False, "status": "planned", "mode": core.project_mode(project_root, normalized["answers"]), "planned_artifacts": sorted(set(planned)), "next_action": "rerun with apply: true"}
  142:     raise ProjectInitializationError("apply_required")
  143: 
  144: 
  145: def repair_project(request: dict[str, Any], core: Any) -> dict[str, Any]:
  146:     """Repair deterministic project state only; it never performs onboarding."""
  147:     raw_root = request.get("project_root")
  148:     if not raw_root:
  149:         raise ProjectInitializationError("project_root_required")
  150:     project_root = Path(str(raw_root)).expanduser().resolve()
  151:     if not project_root.is_dir() or not (project_root / ".pf").is_dir():
  152:         raise ProjectInitializationError("project_not_initialized")
  153:     action = str(request.get("repair_action") or "refresh_context")
  154:     if action not in {"refresh_context", "restore_deterministic_artifacts", "install_codex_hooks"}:
  155:         raise ProjectInitializationError("unsupported_repair_action")
  156:     workplace = request.get("workplace")
  157:     before = status(project_root, core, workplace=str(workplace) if workplace else None)
  158:     if request.get("apply") is not True:
  159:         return {"action": "repair", "applied": False, "status": "planned", "repair_action": action, "before": {"state": before["state"], "snapshot": before["snapshot"]}, "next_action": "rerun with apply: true"}
  160:     if action == "restore_deterministic_artifacts":
  161:         def restore() -> dict[str, Any]:
  162:             manifest = core.load_yaml_document(project_root / ".pf" / "process-forge.yaml")
  163:             answers = {key: manifest[key] for key in ("project", "coordination", "context_requirements", "context_policy", "parameters", "specializations", "process") if isinstance(manifest, dict) and key in manifest}
  164:             platforms = manifest.get("platform_contracts") if isinstance(manifest, dict) and isinstance(manifest.get("platform_contracts"), list) else []
  165:             project_answers = answers.get("project") if isinstance(answers.get("project"), dict) else {}
  166:             project_answers["platforms"] = [str(item.get("id") or item.get("platform") or "") for item in platforms if isinstance(item, dict) and str(item.get("id") or item.get("platform") or "")]
  167:             answers["project"] = project_answers
  168:             files = core.build_project_files(project_root, Path(str(workplace)).expanduser().resolve() / "workplace.yaml" if workplace and Path(str(workplace)).is_dir() else Path(str(workplace)).expanduser().resolve() if workplace else core.resolve_workplace_manifest(project_root / ".pf" / "process-forge.local.yaml"), answers)
  169:             return core.execute_project_initialization({"project_root": project_root, "project_type": project_answers.get("type"), "force": False, "command": "project-init-repair"}, files)
  170:         return apply("repair", apply_requested=True, execute=restore)
  171:     if action == "install_codex_hooks":
  172:         if not hasattr(core, "execute_project_codex_integration_repair"):
  173:             raise ProjectInitializationError("codex_integration_unsupported")
  174:         return apply("repair", apply_requested=True, execute=lambda: core.execute_project_codex_integration_repair(project_root))
  175:     return apply("repair", apply_requested=True, execute=lambda: core.execute_project_repair(project_root, workplace=str(workplace) if workplace else None, reason=str(request.get("reason") or "manual")))
  176: 
  177: 
  178: def initialize(*, apply_requested: Any, execute: Callable[[], dict[str, Any]]) -> dict[str, Any]:
  179:     return apply("initialize", apply_requested=apply_requested, execute=execute)
  180: 
