 1330: def parse_scalar(value: str) -> Any:
 1331:     value = value.strip()
 1332:     if not value:
 1333:         return ""
 1334:     if value in {"true", "True"}:
 1335:         return True
 1336:     if value in {"false", "False"}:
 1337:         return False
 1338:     if value in {"null", "Null", "NULL", "~"}:
 1339:         return None
 1340:     if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
 1341:         return value[1:-1]
 1342:     if re.fullmatch(r"-?\d+", value):
 1343:         try:
 1344:             return int(value)
 1345:         except ValueError:
 1346:             return value
 1347:     return value
 1348: 
 1349: 
 1350: def parse_simple_yaml(text: str) -> dict[str, Any]:
 1351:     """Parse the small mapping-only YAML subset used by init answers."""
 1352:     root: dict[str, Any] = {}
 1353:     stack: list[tuple[int, dict[str, Any]]] = [(-1, root)]
 1354:     for raw_line in text.splitlines():
 1355:         line = raw_line.split("#", 1)[0].rstrip()
 1356:         if not line.strip():
 1357:             continue
 1358:         indent = len(line) - len(line.lstrip(" "))
 1359:         stripped = line.strip()
 1360:         if stripped.startswith("- "):
 1361:             continue
 1362:         if ":" not in stripped:
 1363:             continue
 1364:         key, value = stripped.split(":", 1)
 1365:         key = key.strip()
 1366:         while stack and indent <= stack[-1][0]:
 1367:             stack.pop()
 1368:         parent = stack[-1][1] if stack else root
 1369:         if value.strip() == "":
 1370:             child: dict[str, Any] = {}
 1371:             parent[key] = child
 1372:             stack.append((indent, child))
 1373:         else:
 1374:             parent[key] = parse_scalar(value)
 1375:     return root
 1376: 
 1377: 
 1378: def load_answers(path: Path | None) -> dict[str, Any]:
 1379:     if path is None:
 1380:         return {}
 1381:     if not path.is_file():
 1382:         raise SystemExit(f"FAIL: answers file not found: {path}")
 1383:     text = path.read_text(encoding="utf-8")
 1384:     if contains_secret_value(text):
 1385:         raise SystemExit("FAIL: answers file appears to contain a secret value")
 1386:     try:
 1387:         import yaml  # type: ignore
 1388: 
 1389:         data = yaml.safe_load(text)
 1390:         return data if isinstance(data, dict) else {}
 1391:     except ModuleNotFoundError:
 1392:         return parse_simple_yaml(text)
 1393: 
 1394: 
 1395: def format_scalar(value: Any) -> str:
 1396:     if value is True:
 1397:         return "true"
 1398:     if value is False:
 1399:         return "false"
 1400:     if value is None:
 1401:         return "null"
 1402:     if isinstance(value, (int, float)):
 1403:         return str(value)
 1404:     text = str(value)
 1405:     if text == "":
 1406:         return '""'
 1407:     yaml_literals = {"*", "null", "true", "false", "yes", "no", "on", "off", "~"}
 1408:     special_start = ("-", "?", "&", "*", "!", "%", "@", "`", ">", "|")
 1409:     if (
 1410:         text.lower() in yaml_literals
 1411:         or text.startswith(special_start)
 1412:         or any(char in text for char in [":", "#", "{", "}", "[", "]", "\\"])
 1413:         or text.strip() != text
 1414:     ):
 1415:         return "'" + text.replace("'", "''") + "'"
 1416:     return text
 1417: 
 1418: 
 1419: def dump_yaml(data: Any, indent: int = 0) -> str:
 1420:     lines: list[str] = []
 1421:     prefix = " " * indent
 1422:     if isinstance(data, dict):
 1423:         if not data:
 1424:             lines.append(f"{prefix}{{}}")
 1425:         for key, value in data.items():
 1426:             if isinstance(value, (dict, list)):
 1427:                 lines.append(f"{prefix}{key}:")
 1428:                 lines.append(dump_yaml(value, indent + 2))
 1429:             else:
 1430:                 lines.append(f"{prefix}{key}: {format_scalar(value)}")
 1431:     elif isinstance(data, list):
 1432:         if not data:
 1433:             lines.append(f"{prefix}[]")
 1434:         for item in data:
 1435:             if isinstance(item, dict):
 1436:                 lines.append(f"{prefix}-")
 1437:                 lines.append(dump_yaml(item, indent + 2))
 1438:             elif isinstance(item, list):
 1439:                 lines.append(f"{prefix}-")
 1440:                 lines.append(dump_yaml(item, indent + 2))
 1441:             else:
 1442:                 lines.append(f"{prefix}- {format_scalar(item)}")
 1443:     else:
 1444:         lines.append(f"{prefix}{format_scalar(data)}")
 1445:     return "\n".join(lines)
 1446: 
 1447: 
 1448: def ensure_trailing_newline(text: str) -> str:
 1449:     return text if text.endswith("\n") else text + "\n"
 1450: 
