 1171:     def _load_completion_intent(self, run: dict[str, Any], assignment: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
 1172:         run_id = str(run.get("id") or "")
 1173:         assignment_id = str(assignment.get("id") or "")
 1174:         if not SAFE_ID_RE.fullmatch(run_id) or not SAFE_ID_RE.fullmatch(assignment_id):
 1175:             return None, None
 1176:         path = self._completion_intent_path(run_id)
 1177:         if not path.is_file():
 1178:             return None, None
 1179:         try:
 1180:             intent = self.core.load_yaml_document(path)
 1181:         except (OSError, ValueError, TypeError) as exc:
 1182:             return None, f"journal unreadable: {exc}"
 1183:         error = self._validate_completion_intent(intent, run, assignment, path)
 1184:         return (intent, None) if error is None else (None, error)
 1185: 
 1186:     def _validate_completion_intent(
 1187:         self,
 1188:         intent: Any,
 1189:         run: dict[str, Any],
 1190:         assignment: dict[str, Any],
 1191:         journal_path: Path,
 1192:     ) -> str | None:
 1193:         if not isinstance(intent, dict) or intent.get("kind") != "pf.process.completion-intent":
 1194:             return "journal kind is invalid"
 1195:         content = {key: value for key, value in intent.items() if key != "fingerprint"}
 1196:         try:
 1197:             if intent.get("fingerprint") != canonical_fingerprint(content):
 1198:                 return "journal content fingerprint mismatch"
 1199:         except (TypeError, ValueError, RecursionError):
 1200:             return "journal content is invalid"
 1201:         run_id = str(run.get("id") or "")
 1202:         assignment_id = str(assignment.get("id") or "")
 1203:         if intent.get("run_id") != run_id or intent.get("assignment_id") != assignment_id:
 1204:             return "journal identity does not match selected work"
 1205:         final = intent.get("final") if isinstance(intent.get("final"), dict) else {}
 1206:         final_run = final.get("run") if isinstance(final.get("run"), dict) else {}
 1207:         final_assignment = final.get("assignment") if isinstance(final.get("assignment"), dict) else {}
 1208:         if final_run.get("id") != run_id or final_assignment.get("id") != assignment_id or final_assignment.get("run_id") != run_id:
 1209:             return "journal final payload identity is invalid"
 1210:         if final_run.get("status") != "completed" or final_assignment.get("status") not in TERMINAL_ASSIGNMENT_STATUSES:
 1211:             return "journal final payload is not terminal"
 1212:         if final_assignment.get("status") != "done":
 1213:             return "journal final assignment is not done"
 1214:         tasks = final_run.get("tasks") if isinstance(final_run.get("tasks"), list) else []
 1215:         task = next((item for item in tasks if isinstance(item, dict) and str(item.get("id") or "") == assignment_id), None)
 1216:         if not isinstance(task, dict) or task.get("status") not in {"done", "completed"}:
 1217:             return "journal final task status is invalid"
 1218:         if self._effective_process(final_run)[1] != "pinned":
 1219:             return "journal final process pin is invalid"
 1220:         pin = intent.get("process_execution") if isinstance(intent.get("process_execution"), dict) else {}
 1221:         current_pin = run.get("process_execution") if isinstance(run.get("process_execution"), dict) else {}
 1222:         for key in ["process_id", "process_version", "process_fingerprint", "snapshot_id", "snapshot_checksum"]:
 1223:             if str(pin.get(key) or "") != str(current_pin.get(key) or "") or str(pin.get(key) or "") != str((final_run.get("process_execution") or {}).get(key) or ""):
 1224:                 return f"journal process pin mismatch: {key}"
 1225:         expected = {
 1226:             "journal_path": self.core.rel(journal_path, self.project_root),
 1227:             "run_path": self.core.rel(self._run_path(run_id), self.project_root),
 1228:             "assignment_path": self.core.rel(self._assignment_path(assignment_id), self.project_root),
 1229:         }
 1230:         if str(intent.get("journal_path") or "") != expected["journal_path"]:
 1231:             return "journal path is not owned by the selected run"
 1232:         owner = intent.get("owner") if isinstance(intent.get("owner"), dict) else {}
 1233:         if owner.get("run_path") != expected["run_path"] or owner.get("assignment_path") != expected["assignment_path"]:
 1234:             return "journal owner paths are invalid"
 1235:         if hasattr(self.core, "project_id") and str(owner.get("project_id") or "") != str(self.core.project_id(self.project_root)):
 1236:             return "journal project owner is invalid"
 1237:         final_paths = {
 1238:             "summary": self.core.rel(self._run_path(run_id).parent / "summary.md", self.project_root),
 1239:             "handoff": self.core.rel(self._flow_root() / "handoffs" / "runs" / f"{run_id}-handoff.md", self.project_root),
 1240:             "task_index": self.core.rel(self._run_path(run_id).parent / "task-index.md", self.project_root),
 1241:             "projection": self.core.rel(self._flow_root() / "artifacts" / "projections" / "process-execution-state.json", self.project_root),
 1242:         }
 1243:         for key, expected_path in final_paths.items():
 1244:             item = final.get(key) if isinstance(final.get(key), dict) else {}
 1245:             if str(item.get("path") or "") != expected_path:
 1246:                 return f"journal {key} path is invalid"
 1247:         events = final.get("events")
 1248:         if not isinstance(events, list) or not events or any(not isinstance(item, dict) or not item.get("event_type") or not item.get("event_id") for item in events):
 1249:             return "journal event metadata is invalid"
 1250:         return None
