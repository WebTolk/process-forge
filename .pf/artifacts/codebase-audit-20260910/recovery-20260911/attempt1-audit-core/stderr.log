 4778: def resolved_override_record(project_root: Path, entry: dict[str, Any], base_path: Path | None = None) -> dict[str, Any]:
 4779:     override_path = project_override_path(project_root, entry)
 4780:     mode = str(entry.get("mode") or "extension")
 4781:     target = str(entry.get("target") or "")
 4782:     record = {
 4783:         "kind": str(entry.get("kind") or ""),
 4784:         "target": target,
 4785:         "mode": mode,
 4786:         "reason": str(entry.get("reason") or ""),
 4787:         "path": rel(override_path, project_root) if override_path else "",
 4788:         "sha256": sha256_optional_file(override_path),
 4789:         "base_sha256": sha256_optional_file(base_path),
 4790:         "effective_fingerprint": effective_fingerprint_for(target, base_path, override_path, mode),
 4791:     }
 4792:     if isinstance(entry.get("params"), dict):
 4793:         record["params"] = entry["params"]
 4794:     if entry.get("project_package"):
 4795:         record["project_package"] = str(entry["project_package"])
 4796:     return record
