23702: def print_search_index_maintenance_summary(payload: dict[str, Any]) -> None:
23703:     print(f"SEARCH_INDEX_SCOPE: {payload.get('scope') or 'workplace'}")
23704:     if payload.get("report"):
23705:         print(f"SEARCH_INDEX_REPORT: {payload.get('report')}")
23706:     results = payload.get("results") if isinstance(payload.get("results"), list) else []
23707:     for row in results:
23708:         if not isinstance(row, dict):
23709:             continue
23710:         project = row.get("project") or row.get("scope")
23711:         if row.get("status") in {"ok", "degraded"}:
23712:             print(
23713:                 "SEARCH_INDEX: "
23714:                 f"{project} action={row.get('action')} status={row.get('search_status')} "
23715:                 f"generation={row.get('generation') or 'none'} documents={row.get('document_count')}"
23716:             )
23717:         elif row.get("status") == "skipped":
23718:             print(
23719:                 "SEARCH_INDEX_SKIPPED: "
23720:                 f"{project} reason={row.get('reason')} context={row.get('context_status') or 'unknown'} "
23721:                 f"next={row.get('recommended_action') or 'none'}"
23722:             )
23723:         elif row.get("status") == "error":
23724:             print(f"SEARCH_INDEX_ERROR: {project} error={row.get('error')}")
23725: 
