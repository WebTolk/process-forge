 3405: def command_error_route(args: argparse.Namespace) -> int:
 3406:     project_root = Path(args.project_root).expanduser().resolve()
 3407:     require_flow_root(project_root)
 3408:     mode = str(args.mode or "none")
 3409:     if mode not in ERROR_WORKFLOW_MODES:
 3410:         raise SystemExit("FAIL: error workflow mode must be none, director_inbox, route_to_process, or needs_operator")
 3411:     fallback = str(args.fallback_if_no_director or "fail_validation")
 3412:     if fallback not in ERROR_WORKFLOW_FALLBACKS:
 3413:         raise SystemExit("FAIL: fallback_if_no_director must be needs_operator or fail_validation")
 3414:     coordination = effective_project_coordination(project_root, getattr(args, "workplace", None))
 3415:     result: dict[str, Any] = {
 3416:         "schema_version": 1,
 3417:         "created_at": now_utc(),
 3418:         "project_id": project_id(project_root),
 3419:         "effective_mode": coordination["effective_mode"],
 3420:         "requested_mode": mode,
 3421:         "result_mode": mode,
 3422:         "status": "recorded",
 3423:         "summary": args.summary or "",
 3424:     }
 3425:     if mode == "director_inbox" and coordination["effective_mode"] == "organized":
 3426:         code = command_director_inbox_submit(
 3427:             argparse.Namespace(
 3428:                 project_root=str(project_root),
 3429:                 workplace=getattr(args, "workplace", None),
 3430:                 message_type="error_report",
 3431:                 content=args.summary or "",
 3432:                 allow_simple_submit=False,
 3433:                 json=False,
 3434:             )
 3435:         )
 3436:         if code:
 3437:             return code
 3438:         result["result_mode"] = "director_inbox"
 3439:     elif mode == "director_inbox":
 3440:         if fallback == "fail_validation":
 3441:             raise SystemExit("FAIL: director_inbox error workflow requires effective organized project mode")
 3442:         result["result_mode"] = "needs_operator"
 3443:         result["status"] = "needs_operator"
 3444:     elif mode == "route_to_process":
 3445:         routes = locate_flow_root(project_root) / "process-routes.yaml"
 3446:         if not routes.is_file():
 3447:             raise SystemExit("FAIL: route_to_process requires .pf/process-routes.yaml")
 3448:         result["route"] = rel(routes, project_root)
 3449:     elif mode == "needs_operator":
 3450:         result["status"] = "needs_operator"
 3451:     output = locate_flow_root(project_root) / "artifacts" / "error-workflow" / f"error-{uuid.uuid4().hex[:12]}.yaml"
 3452:     write_yaml_file(output, result)
 3453:     if args.json:
 3454:         print(json.dumps({"status": "pass", "path": rel(output, project_root), "result": result}, indent=2, sort_keys=True))
 3455:     else:
 3456:         print(f"WROTE: {rel(output, project_root)}")
 3457:         print(f"RESULT_MODE: {result['result_mode']}")
 3458:     return 0
