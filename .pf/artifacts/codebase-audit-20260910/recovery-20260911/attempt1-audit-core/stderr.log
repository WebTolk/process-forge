22844: def update_candidate_id(subject_type: str, subject_id: str, available_version: str, source_id: str) -> str:
22845:     raw = f"{subject_type}:{subject_id}:{available_version}:{source_id}"
22846:     digest = hashlib.sha256(raw.encode("utf-8")).hexdigest()[:12]
22847:     return f"candidate-{safe_id(subject_type)}-{safe_id(subject_id)}-{safe_id(available_version)}-{digest}"
22848: 
