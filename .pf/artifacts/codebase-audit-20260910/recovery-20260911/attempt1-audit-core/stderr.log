   22: MAX_LIMIT = 100
   23: TEXT_SUFFIXES = {".md", ".txt", ".rst", ".py", ".json", ".yaml", ".yml", ".toml", ".ini", ".csv"}
   24: # Version 4 also invalidates derived rows produced before source deduplication
   25: # and explicit-file filtering, even though the SQL table layout is unchanged.
