  285:     def state(self, *, run_id: str = "", assignment_id: str = "", session_id: str = "") -> dict[str, Any]:
  286:         selected = self._select_work(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  287:         if not selected:
  288:             return {
  289:                 "schema_version": 1,
  290:                 "kind": "pf.work.state",
  291:                 "action": "start_recommended",
  292:                 "project": {"id": self.core.project_id(self.project_root)},
  293:             }
  294:         run, assignment = selected
  295:         process, pin_status = self._effective_process(run)
  296:         stage_id = str(assignment.get("stage") or "")
  297:         stage = self._stage(process, stage_id)
  298:         current_evidence = self._current_evidence(assignment)
  299:         accumulated_evidence = self._accumulated_evidence(assignment)
  300:         required_inputs = [
  301:             self._requirement_state("input", str(item), accumulated_evidence)
  302:             for item in self._string_list(stage.get("required_inputs"))
  303:         ]
  304:         required_artifact_ids = self._required_artifact_ids(process, stage)
  305:         artifacts = [self._requirement_state("artifact", item, current_evidence) for item in required_artifact_ids]
  306:         required_evidence = [
  307:             self._requirement_state("evidence", item, current_evidence)
  308:             for item in self._string_list(stage.get("required_evidence"))
  309:         ]
  310:         entry_gates = [
  311:             self._gate_state(process, str(gate_id), accumulated_evidence, phase="entry")
  312:             for gate_id in self._string_list(stage.get("entry_gates"))
  313:         ]
  314:         exit_gates = [
  315:             self._gate_state(process, str(gate_id), current_evidence, phase="exit")
  316:             for gate_id in self._string_list(stage.get("exit_gates"))
  317:         ]
  318:         obligations = self._automation_states(process, stage, assignment)
  319:         incomplete = self._stage_requirements(required_inputs, artifacts, required_evidence, entry_gates + exit_gates, obligations)
  320:         completion = stage.get("stage_completion") if isinstance(stage.get("stage_completion"), dict) else process.get("stage_completion") if isinstance(process.get("stage_completion"), dict) else {}
  321:         if completion.get("evidence_required") is True and not current_evidence:
  322:             incomplete.append({"code": "stage_evidence_required", "stage_id": stage_id})
  323:         stage_execution = assignment.get("stage_execution") if isinstance(assignment.get("stage_execution"), dict) else {}
  324:         if completion.get("handoff_note_required") is True and not str(stage_execution.get("notes") or "").strip():
  325:             incomplete.append({"code": "handoff_note_required", "stage_id": stage_id})
  326:         try:
  327:             outcomes = normalized_outcomes(process, stage_id)
  328:         except ValueError as exc:
  329:             outcomes = []
  330:             incomplete.append({"code": "invalid_process_definition", "message": str(exc), "stage_id": stage_id})
  331:         stored_blockers = stage_execution.get("blockers") if isinstance(stage_execution.get("blockers"), list) else []
  332:         blockers = [copy.deepcopy(item) for item in stored_blockers if isinstance(item, dict)]
  333:         if str(assignment.get("stage_status") or "") == "blocked" and not blockers:
  334:             blockers.append({"code": "stage_marked_blocked", "stage_id": stage_id})
  335:         if str(run.get("status") or "") == "completed":
  336:             action = "run_completed"
  337:         elif blockers:
  338:             action = "work_blocked"
  339:         elif incomplete:
  340:             action = "work_incomplete"
  341:         else:
  342:             action = "work_ready"
  343:         return {
  344:             "schema_version": 1,
  345:             "kind": "pf.work.state",
  346:             "action": action,
  347:             "project": {"id": self.core.project_id(self.project_root)},
  348:             "process": {
  349:                 "id": str(process.get("id") or run.get("process") or ""),
  350:                 "version": str(process.get("version") or ""),
  351:                 "fingerprint": str((run.get("process_execution") or {}).get("process_fingerprint") or canonical_fingerprint(process)),
  352:                 "pin_status": pin_status,
  353:             },
  354:             "work": {
  355:                 "active_specializations": _stable_ids(assignment.get("selected_specializations") or run.get("selected_specializations")),
  356:                 "selected_resource_ids": _stable_ids((run.get("process_execution") or {}).get("selected_resource_ids")),
  357:             },
  358:             "run": {"id": str(run.get("id") or ""), "status": str(run.get("status") or "")},
  359:             "assignment": {"id": str(assignment.get("id") or ""), "status": str(assignment.get("status") or "")},
  360:             "stage": {"id": stage_id, "title": str(stage.get("title") or stage_id), "status": str(assignment.get("stage_status") or "in_progress")},
  361:             "required_inputs": required_inputs,
  362:             "required_evidence": required_evidence,
  363:             "obligations": obligations,
  364:             "artifacts": artifacts,
  365:             "gates": {"entry": entry_gates, "exit": exit_gates},
  366:             "allowed_outcomes": outcomes,
  367:             "blockers": blockers,
  368:             "incomplete": incomplete,
  369:             "completion": {"status": "complete" if not incomplete else "incomplete", "requirements": incomplete},
  370:             "evidence": current_evidence,
  371:         }
  372: 
  373:     def allowed_transitions(self, *, run_id: str = "", assignment_id: str = "", session_id: str = "") -> dict[str, Any]:
  374:         state = self.state(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  375:         return {
  376:             "schema_version": 1,
  377:             "kind": "pf.work.allowed_transitions",
  378:             "run": state.get("run", {}),
  379:             "assignment": state.get("assignment", {}),
  380:             "stage": state.get("stage", {}),
  381:             "allowed_outcomes": state.get("allowed_outcomes", []),
  382:             "blockers": state.get("blockers", []),
  383:         }
  384: 
  385:     def transition(
  386:         self,
  387:         *,
  388:         outcome: str,
  389:         evidence: Any = None,
  390:         notes: str = "",
  391:         run_id: str = "",
  392:         assignment_id: str = "",
  393:         session_id: str = "",
  394:     ) -> dict[str, Any]:
  395:         selected = self._select_work(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  396:         if not selected:
  397:             return self._blocked("active_work_not_found")
  398:         run, assignment = selected
  399:         if not isinstance(run.get("process_execution"), dict) or not isinstance(run["process_execution"].get("definition"), dict):
  400:             return self._blocked("process_not_pinned", run_id=run.get("id"), assignment_id=assignment.get("id"))
  401:         with self._run_lock(str(run.get("id") or "")):
  402:             run = self._load_run(str(run.get("id") or ""))
  403:             assignment = self._load_assignment(str(assignment.get("id") or ""))
  404:             pending_intent, intent_error = self._load_completion_intent(run, assignment)
  405:             if pending_intent is not None:
  406:                 return self._replay_completion_intent(pending_intent, session_id=session_id)
  407:             if intent_error:
  408:                 return self._blocked(
  409:                     "completion_intent_invalid",
  410:                     run_id=run.get("id"),
  411:                     assignment_id=assignment.get("id"),
  412:                     detail=intent_error,
  413:                 )
  414:             if str(run.get("status") or "") in TERMINAL_RUN_STATUSES or str(assignment.get("status") or "") in TERMINAL_ASSIGNMENT_STATUSES:
  415:                 return self._blocked("work_is_terminal", run_id=run.get("id"), assignment_id=assignment.get("id"), run_status=run.get("status"), assignment_status=assignment.get("status"))
  416:             process, pin_status = self._effective_process(run)
  417:             if pin_status != "pinned":
  418:                 return self._blocked("process_pin_invalid", run_id=run.get("id"), assignment_id=assignment.get("id"), pin_status=pin_status)
  419:             stage_id = str(assignment.get("stage") or "")
  420:             normalized_evidence, evidence_blockers = self._normalize_evidence(evidence)
  421:             if evidence_blockers:
  422:                 return self._transition_rejected(
  423:                     run=run,
  424:                     assignment=assignment,
  425:                     session_id=session_id,
  426:                     reason="invalid_evidence",
  427:                     blockers=evidence_blockers,
  428:                 )
  429:             try:
  430:                 allowed_outcomes = {str(item.get("id")): item for item in normalized_outcomes(process, stage_id) if isinstance(item, dict)}
  431:             except ValueError as exc:
  432:                 return self._transition_rejected(
  433:                     run=run,
  434:                     assignment=assignment,
  435:                     session_id=session_id,
  436:                     reason="invalid_process_definition",
  437:                     blockers=[{"code": "invalid_process_definition", "message": str(exc), "stage_id": stage_id}],
  438:                 )
  439:             if outcome not in allowed_outcomes:
  440:                 return self._transition_rejected(
  441:                     run=run,
  442:                     assignment=assignment,
  443:                     session_id=session_id,
  444:                     reason="outcome_not_allowed",
  445:                     blockers=[{"code": "outcome_not_allowed", "outcome": outcome, "allowed": sorted(allowed_outcomes)}],
  446:                 )
  447:             stage_execution = assignment.get("stage_execution") if isinstance(assignment.get("stage_execution"), dict) else {}
  448:             stored_blockers = stage_execution.get("blockers") if isinstance(stage_execution.get("blockers"), list) else []
  449:             if stored_blockers:
  450:                 if not all(self._is_recoverable_transition_rejection(item) for item in stored_blockers if isinstance(item, dict)):
  451:                     return self.state(run_id=str(run.get("id") or ""), assignment_id=str(assignment.get("id") or ""), session_id=session_id)
  452:                 # Older releases persisted request-validation failures as a
  453:                 # stage block. A valid retry is the recovery operation; do not
  454:                 # require users to repair assignment YAML by hand.
  455:                 stage_execution.pop("blockers", None)
  456:                 stage_execution.pop("blocked_at", None)
  457:                 if str(assignment.get("stage_status") or "") == "blocked":
  458:                     assignment["stage_status"] = "in_progress"
  459:             stage_execution = {**stage_execution, "evidence": self._merge_evidence(stage_execution.get("evidence"), normalized_evidence), "notes": str(notes or stage_execution.get("notes") or "")}
  460:             assignment["stage_execution"] = stage_execution
  461:             assignment["updated_at"] = self.core.now_utc()
  462:             self._atomic_yaml(self._assignment_path(str(assignment["id"])), assignment)
  463:             preview = self.state(run_id=str(run.get("id") or ""), assignment_id=str(assignment.get("id") or ""), session_id=session_id)
  464:             preview_blockers = list(preview.get("blockers") or [])
  465:             preview_incomplete = list(preview.get("incomplete") or [])
  466:             outcomes = {str(item.get("id")): item for item in preview.get("allowed_outcomes", []) if isinstance(item, dict)}
  467:             next_stage_id = str(outcomes.get(outcome, {}).get("next_stage") or "")
  468:             if next_stage_id:
  469:                 next_stage = self._stage(process, next_stage_id)
  470:                 accumulated = self._accumulated_evidence(assignment)
  471:                 for gate_id in self._string_list(next_stage.get("entry_gates")):
  472:                     gate = self._gate_state(process, gate_id, accumulated, phase="entry")
  473:                     if not gate["satisfied"] and gate.get("blocking", True):
  474:                         preview_incomplete.append({"code": "entry_gate_evidence_missing", "gate_id": gate_id, "stage_id": next_stage_id})
  475:             if preview_blockers:
  476:                 return self._transition_rejected(
  477:                     run=run,
  478:                     assignment=assignment,
  479:                     session_id=session_id,
  480:                     reason="stage_transition_rejected",
  481:                     blockers=preview_blockers,
  482:                 )
  483: 
  484:             if preview_incomplete:
  485:                 incomplete_state = self.state(run_id=str(run["id"]), assignment_id=str(assignment["id"]), session_id=session_id)
  486:                 self._write_projection(incomplete_state)
  487:                 return {**incomplete_state, "action": "incomplete", "reason": "stage_requirements_incomplete", "incomplete": preview_incomplete}
  488: 
  489:             if not next_stage_id:
  490:                 completion_blockers = self._run_completion_blockers(process, run, assignment)
  491:                 if completion_blockers:
  492:                     incomplete_state = self.state(run_id=str(run["id"]), assignment_id=str(assignment["id"]), session_id=session_id)
  493:                     self._write_projection(incomplete_state)
  494:                     return {**incomplete_state, "action": "incomplete", "reason": "run_completion_incomplete", "incomplete": completion_blockers}
  495: 
  496:             now = self.core.now_utc()
  497:             history = assignment.get("stage_history") if isinstance(assignment.get("stage_history"), list) else []
  498:             history.append(
  499:                 {
  500:                     "stage_id": stage_id,
  501:                     "status": "completed",
  502:                     "started_at": str(assignment["stage_execution"].get("started_at") or assignment.get("created_at") or ""),
  503:                     "completed_at": now,
  504:                     "outcome": outcome,
  505:                     "next_stage_id": next_stage_id,
  506:                     "evidence": list(assignment["stage_execution"].get("evidence") or []),
  507:                     "notes": str(notes or ""),
  508:                 }
  509:             )
  510:             assignment["stage_history"] = history
  511:             previous_stage_id = stage_id
  512:             if next_stage_id:
  513:                 assignment["stage"] = next_stage_id
  514:                 assignment["stage_status"] = "in_progress"
  515:                 assignment["stage_execution"] = {"started_at": now, "evidence": [], "notes": ""}
  516:                 assignment["updated_at"] = now
  517:                 run["updated_at"] = now
  518:                 self._set_run_task_status(run, str(assignment["id"]), "in_progress")
  519:                 self._atomic_yaml(self._assignment_path(str(assignment["id"])), assignment)
  520:                 self._atomic_yaml(self._run_path(str(run["id"])), run)
  521:                 self._write_task_index(run)
  522:                 action = "stage_transitioned"
  523:             else:
  524:                 intent = self._build_completion_intent(
  525:                     run,
  526:                     assignment,
  527:                     process,
  528:                     outcome=outcome,
  529:                     notes=notes,
  530:                     completed_at=now,
  531:                 )
  532:                 # JSON is valid YAML and preserves multiline payloads exactly;
  533:                 # the generic YAML formatter folds quoted multiline strings.
  534:                 self._atomic_text(self._completion_intent_path(str(run["id"])), json.dumps(intent, ensure_ascii=False, sort_keys=True, indent=2) + "\n")
  535:                 self._replay_completion_intent(intent, session_id=session_id)
  536:                 action = "run_completed"
  537: 
  538:             result_state = self.state(run_id=str(run["id"]), assignment_id=str(assignment["id"]), session_id=session_id)
  539:             if action != "run_completed":
  540:                 self._write_projection(result_state)
  541:                 self._emit("process.stage.completed", run, assignment, previous_stage_id, outcome=outcome, previous_stage_id=previous_stage_id, next_stage_id=next_stage_id)
  542:                 self._emit("process.stage.transitioned", run, assignment, next_stage_id or previous_stage_id, outcome=outcome, previous_stage_id=previous_stage_id, next_stage_id=next_stage_id)
  543:                 if next_stage_id:
  544:                     self._emit("process.stage.started", run, assignment, next_stage_id, outcome="started", previous_stage_id=previous_stage_id, next_stage_id=next_stage_id)
  545:             result = {**result_state, "action": action, "previous_stage_id": previous_stage_id, "next_stage_id": next_stage_id}
  546:             if action == "run_completed":
  547:                 result.update(self._next_work_advisory(process, run))
  548:             return result
  549: 
  550:     def can_complete(self, *, run_id: str = "", assignment_id: str = "", session_id: str = "") -> dict[str, Any]:
  551:         selected = self._select_work(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  552:         if not selected:
  553:             return {"can_complete": False, "blockers": [{"code": "active_work_not_found"}]}
  554:         run, assignment = selected
  555:         process, pin_status = self._effective_process(run)
  556:         stage_id = str(assignment.get("stage") or "")
  557:         outcomes = normalized_outcomes(process, stage_id)
  558:         final = any(not str(item.get("next_stage") or "") for item in outcomes)
  559:         state = self.state(run_id=str(run.get("id") or ""), assignment_id=str(assignment.get("id") or ""), session_id=session_id)
  560:         blockers = [*list(state.get("blockers") or []), *list(state.get("incomplete") or [])]
  561:         if pin_status != "pinned":
  562:             blockers.append({"code": "process_not_pinned"})
  563:         if not final:
  564:             blockers.append({"code": "not_final_stage", "stage_id": stage_id})
  565:         blockers.extend(self._run_completion_blockers(process, run, assignment))
  566:         return {"can_complete": not blockers, "blockers": blockers, "run": state.get("run"), "assignment": state.get("assignment"), "stage": state.get("stage")}
  567: 
  568:     def complete(self, *, outcome: str = "completed", evidence: Any = None, notes: str = "", run_id: str = "", assignment_id: str = "", session_id: str = "") -> dict[str, Any]:
  569:         selected = self._select_work(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  570:         if selected:
  571:             run, assignment = selected
  572:             pending, _error = self._load_completion_intent(run, assignment)
  573:             if pending is not None:
  574:                 # A committed intent is authoritative.  Do not make a retry
  575:                 # depend on mutable evidence or on the caller repeating the
  576:                 # original outcome/notes.
  577:                 return self.transition(
  578:                     outcome=outcome,
  579:                     evidence=evidence,
  580:                     notes=notes,
  581:                     run_id=run_id,
  582:                     assignment_id=assignment_id,
  583:                     session_id=session_id,
  584:                 )
  585:         readiness = self.can_complete(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  586:         if readiness["blockers"] and not evidence:
  587:             return {"schema_version": 1, "kind": "pf.work.complete", "action": "blocked", **readiness}
  588:         return self.transition(outcome=outcome, evidence=evidence, notes=notes, run_id=run_id, assignment_id=assignment_id, session_id=session_id)
  589: 
  590:     def _context_check(self) -> dict[str, Any]:
  591:         explicit = ""
  592:         if self.workplace_root and (self.workplace_root / "workplace.yaml").is_file():
  593:             explicit = str(self.workplace_root)
  594:         return self.core.project_context_check_result(self.project_root, explicit_workplace=explicit or None)
  595: 
  596:     def _manifest(self) -> dict[str, Any]:
  597:         return self.core.load_yaml_document(self._flow_root() / "process-forge.yaml")
  598: 
  599:     def _project_process_selection(self) -> dict[str, Any]:
  600:         return project_process_selection(self._manifest())
  601: 
  602:     def _select_process(self, selection: dict[str, Any], requested: str) -> tuple[str, dict[str, Any]]:
  603:         allowed = _stable_ids(selection.get("allowed"))
  604:         if requested:
  605:             if requested not in allowed:
  606:                 try:
  607:                     self.core.resolve_process_definition(self.project_root, requested)
  608:                 except (OSError, SystemExit, ValueError):
  609:                     return "", self._blocked("process_not_found", process_id=requested)
  610:                 return "", self._blocked("process_not_allowed", process_id=requested, allowed_processes=allowed)
  611:             return requested, {}
  612:         if len(allowed) == 1:
  613:             return allowed[0], {}
  614:         default = str(selection.get("default") or "").strip()
  615:         return "", self._blocked(
  616:             "process_choice_required",
  617:             action="process_choice_required",
  618:             default_process=default if default in allowed else "",
  619:             candidates=self._process_candidates(allowed, default=default),
  620:         )
  621: 
  622:     def _process_candidates(self, process_ids: list[str], *, default: str = "") -> list[dict[str, Any]]:
  623:         candidates: list[dict[str, Any]] = []
  624:         for process_id in process_ids:
  625:             try:
  626:                 process = self.core.resolve_process_definition(self.project_root, process_id).process
  627:             except (OSError, SystemExit, ValueError):
  628:                 candidates.append({"id": process_id, "title": process_id, "purpose": "Process definition unavailable.", "expected_result": "", "default": process_id == default})
  629:                 continue
  630:             candidates.append(
  631:                 {
  632:                     "id": str(process.get("id") or process_id),
  633:                     "title": str(process.get("name") or process_id),
  634:                     "purpose": str(process.get("purpose") or process.get("description") or ""),
  635:                     "expected_result": str(process.get("expected_result") or ""),
  636:                     "default": str(process.get("id") or process_id) == default,
  637:                 }
  638:             )
  639:         return candidates
  640: 
  641:     @staticmethod
  642:     def _is_recoverable_transition_rejection(blocker: Any) -> bool:
  643:         if not isinstance(blocker, dict):
  644:             return False
  645:         return str(blocker.get("code") or "") in {
  646:             "invalid_evidence",
  647:             "not_applicable_evidence_incomplete",
  648:             "artifact_path_missing",
  649:             "outcome_not_allowed",
  650:             "invalid_process_definition",
  651:         }
  652: 
  653:     def _transition_rejected(self, *, run: dict[str, Any], assignment: dict[str, Any], session_id: str, reason: str, blockers: list[dict[str, Any]]) -> dict[str, Any]:
  654:         state = self.state(run_id=str(run.get("id") or ""), assignment_id=str(assignment.get("id") or ""), session_id=session_id)
  655:         return {**state, "action": "transition_rejected", "reason": reason, "blockers": blockers}
  656: 
  657:     def _process_pin(self, process: dict[str, Any], source_path: Path, *, active_specializations: list[str], selected_resource_ids: list[str], allowed_processes: list[str]) -> dict[str, Any]:
  658:         snapshot_path = self._flow_root() / "contexts" / "project-context.snapshot.yaml"
  659:         snapshot = self.core.load_yaml_document(snapshot_path)
  660:         meta = snapshot.get("snapshot") if isinstance(snapshot.get("snapshot"), dict) else {}
  661:         snapshot_checksum = "sha256:" + self._sha256_file(snapshot_path) if snapshot_path.is_file() else ""
  662:         normalized = json.loads(json.dumps(process, ensure_ascii=False))
  663:         try:
  664:             process_source = source_path.resolve().relative_to(self.project_root.resolve()).as_posix()
  665:         except ValueError:
  666:             process_source = f"catalog:{normalized.get('id') or source_path.stem}"
  667:         return {
  668:             "process_id": str(normalized.get("id") or ""),
  669:             "process_version": str(normalized.get("version") or ""),
  670:             "process_fingerprint": canonical_fingerprint(normalized),
  671:             "process_source": process_source,
  672:             "snapshot_id": str(meta.get("id") or ""),
  673:             "snapshot_checksum": snapshot_checksum,
  674:             "definition": normalized,
  675:             "active_specializations": active_specializations,
  676:             "selected_resource_ids": selected_resource_ids,
  677:             "allowed_processes": allowed_processes,
  678:         }
  679: 
  680:     def _selected_resource_ids(self) -> list[str]:
  681:         snapshot = self.core.load_yaml_document(self._flow_root() / "contexts" / "project-context.snapshot.yaml")
  682:         resolved = snapshot.get("resolved") if isinstance(snapshot.get("resolved"), dict) else {}
  683:         return _stable_ids(resolved.get("knowledge_resources"))
