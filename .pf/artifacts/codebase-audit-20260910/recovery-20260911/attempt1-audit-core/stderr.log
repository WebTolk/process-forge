 1946: def build_workplace_files(root: Path, answers: dict[str, Any]) -> dict[Path, str]:
 1947:     defaults = workplace_defaults(root, answers)
 1948:     profile = str(answers.get("profile") or "generic").strip() or "generic"
 1949:     paths_answers = answers.get("paths", {}) if isinstance(answers.get("paths"), dict) else {}
 1950:     policies_answers = answers.get("policies", {}) if isinstance(answers.get("policies"), dict) else {}
 1951:     coordination_answers = answers.get("coordination", {}) if isinstance(answers.get("coordination"), dict) else {}
 1952:     director_answers = coordination_answers.get("director", {}) if isinstance(coordination_answers.get("director"), dict) else {}
 1953:     workplace_parameters = answers.get("parameters") if isinstance(answers.get("parameters"), dict) else {}
 1954:     workplace_coordination = default_workplace_coordination()
 1955:     workplace_coordination["director_enabled"] = bool(coordination_answers.get("director_enabled", False))
 1956:     workplace_coordination["director_office_enabled"] = bool(coordination_answers.get("director_office_enabled", False))
 1957:     workplace_coordination["default_project_mode"] = normalize_workplace_default_project_mode(coordination_answers.get("default_project_mode", "simple"))
 1958:     workplace_coordination["director"].update({key: value for key, value in director_answers.items() if value not in (None, "")})
 1959:     path_constants = dict(DEFAULT_PATH_CONSTANTS)
 1960:     answer_constants = paths_answers.get("path_constants")
 1961:     if isinstance(answer_constants, dict):
 1962:         for key, value in answer_constants.items():
 1963:             if isinstance(key, str) and value not in (None, ""):
 1964:                 path_constants[key] = str(value)
 1965: 
 1966:     workplace = {
 1967:         "schema_version": 1,
 1968:         "workplace": {
 1969:             "id": defaults["id"],
 1970:             "name": defaults["name"],
 1971:             "type": defaults["type"],
 1972:             "os": defaults["os"],
 1973:             "owner": None,
 1974:         },
 1975:         "process_forge": {
 1976:             "version_constraint": "^1.0",
 1977:             "install_mode": "linked",
 1978:             "supported_modes": ["file_only", "local_supervisor_ready"],
 1979:         },
 1980:         "paths": {
 1981:             "root": defaults["root"],
 1982:             "terms": "terms.yaml",
 1983:             "registries": "registries",
 1984:             "cache": "cache",
 1985:             "runtime": "runtime",
 1986:             "logs": "logs",
 1987:         },
