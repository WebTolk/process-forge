 1252:     def _replay_completion_intent(self, intent: dict[str, Any], *, session_id: str = "", remove_intent: bool = True) -> dict[str, Any]:
 1253:         run_id = str(intent["run_id"])
 1254:         assignment_id = str(intent["assignment_id"])
 1255:         final = intent["final"]
 1256:         final_assignment = copy.deepcopy(final["assignment"])
 1257:         final_run = copy.deepcopy(final["run"])
 1258:         self._atomic_yaml(self._assignment_path(assignment_id), final_assignment)
 1259:         self._atomic_yaml(self._run_path(run_id), final_run)
 1260:         self._atomic_text(self._run_path(run_id).parent / "summary.md", str(final["summary"].get("content") or ""))
 1261:         self._atomic_text(self._flow_root() / "handoffs" / "runs" / f"{run_id}-handoff.md", str(final["handoff"].get("content") or ""))
 1262:         self._atomic_text(self._run_path(run_id).parent / "task-index.md", str(final["task_index"].get("content") or ""))
 1263:         result_state = self.state(run_id=run_id, assignment_id=assignment_id, session_id=session_id)
 1264:         self._write_projection(result_state)
 1265:         stage_id = str(final_assignment.get("stage") or "")
 1266:         for event in final["events"]:
 1267:             self._emit(
 1268:                 str(event["event_type"]),
 1269:                 final_run,
 1270:                 final_assignment,
 1271:                 str(event.get("stage_id") or stage_id),
 1272:                 outcome=str(event.get("outcome") or "completed"),
 1273:                 previous_stage_id=str(event.get("previous_stage_id") or stage_id),
 1274:                 next_stage_id=str(event.get("next_stage_id") or ""),
 1275:                 event_id=str(event["event_id"]),
 1276:             )
 1277:         if remove_intent:
 1278:             self._completion_intent_path(run_id).unlink(missing_ok=True)
 1279:         return {**result_state, "action": "run_completed", "previous_stage_id": stage_id, "next_stage_id": "", "recovered": True}
