 3474: def project_classifier_registry_documents(
 3475:     workplace_manifest: Path | None,
 3476:     project_root: Path,
 3477: ) -> list[tuple[dict[str, Any], Path]]:
 3478:     documents: list[tuple[dict[str, Any], Path]] = []
 3479:     if workplace_manifest and workplace_manifest.is_file():
 3480:         registry = load_workplace_registry(workplace_manifest, "project_classifiers", "project-classifiers.yaml")
 3481:         documents.append((registry, workplace_manifest.parent))
 3482:     flow_registry = locate_flow_root(project_root) / "registries" / "project-classifiers.yaml"
 3483:     if flow_registry.is_file():
 3484:         data = load_yaml_document(flow_registry)
 3485:         if isinstance(data, dict) and not yaml_error(data):
 3486:             documents.append((data, flow_registry.parent.parent))
 3487:     for manifest_path, manifest in active_official_pack_records(workplace_manifest):
 3488:         provided = manifest.get("provides") if isinstance(manifest.get("provides"), dict) else {}
 3489:         declared_ids = {str(item) for item in as_list(provided.get("project_classifiers")) if str(item)}
 3490:         registry_path = manifest_path.parent / "project-classifiers" / "registry-entry.yaml"
 3491:         registry = load_yaml_document(registry_path)
 3492:         if not isinstance(registry, dict) or yaml_error(registry):
 3493:             continue
 3494:         entries = [
 3495:             entry
 3496:             for entry in as_list(registry.get("project_classifiers"))
 3497:             if isinstance(entry, dict)
 3498:             and (not declared_ids or str(entry.get("id") or "") in declared_ids)
 3499:         ]
 3500:         documents.append(
 3501:             (
 3502:                 {"schema_version": 1, "project_classifiers": entries},
 3503:                 manifest_path.parent,
 3504:             )
 3505:         )
 3506:     return documents
 3507: 
 3508: 
 3509: def project_classifier_paths(
 3510:     workplace_manifest: Path | None,
 3511:     project_root: Path,
 3512:     explicit_paths: list[Path] | None = None,
 3513: ) -> list[Path]:
 3514:     candidates = [path.expanduser().resolve() for path in explicit_paths or []]
 3515:     for registry, base in project_classifier_registry_documents(workplace_manifest, project_root):
 3516:         entries = registry.get("project_classifiers")
 3517:         if not isinstance(entries, list):
 3518:             continue
 3519:         for entry in entries:
 3520:             if not isinstance(entry, dict) or str(entry.get("status", "active")) not in {"active", "enabled", "configured"}:
 3521:                 continue
 3522:             raw_path = entry.get("path")
 3523:             if raw_path:
 3524:                 candidates.append(resolve_registry_relative_path(base, str(raw_path), workplace_manifest))
 3525:     unique: list[Path] = []
 3526:     seen: set[Path] = set()
 3527:     for path in candidates:
 3528:         resolved = path.resolve()
 3529:         if resolved not in seen and resolved.is_file():
 3530:             seen.add(resolved)
 3531:             unique.append(resolved)
 3532:     return unique
 3533: 
 3534: 
 3535: def project_available_paths(project_root: Path, files: list[Path] | None = None) -> set[str]:
 3536:     source_files = files if files is not None else list_project_files(project_root)
 3537:     available_paths = {rel(path, project_root) for path in source_files}
 3538:     for path in source_files:
 3539:         parent = path.relative_to(project_root).parent
 3540:         while parent != Path("."):
 3541:             available_paths.add(parent.as_posix())
 3542:             parent = parent.parent
 3543:     available_paths.update(
 3544:         path.name
 3545:         for path in project_root.iterdir()
 3546:         if path.is_dir() and path.name not in {".git", ".idea", ".serena"}
 3547:     )
 3548:     return available_paths
 3549: 
 3550: 
 3551: def inactive_official_classifier_hints(workplace_manifest: Path | None, project_root: Path, files: list[Path] | None = None) -> list[str]:
 3552:     active_ids = active_process_pack_ids(workplace_manifest)
 3553:     available_paths = project_available_paths(project_root, files)
 3554:     hints: list[str] = []
 3555:     seen: set[str] = set()
 3556:     for manifest_path, manifest in official_pack_manifest_records():
 3557:         pack_id = str(manifest.get("id") or "")
 3558:         if not pack_id or pack_id in active_ids:
 3559:             continue
 3560:         provided = manifest.get("provides") if isinstance(manifest.get("provides"), dict) else {}
 3561:         declared_ids = {str(item) for item in as_list(provided.get("project_classifiers")) if str(item)}
 3562:         if not declared_ids:
 3563:             continue
 3564:         registry_path = manifest_path.parent / "project-classifiers" / "registry-entry.yaml"
 3565:         registry = load_yaml_document(registry_path)
 3566:         if not isinstance(registry, dict) or yaml_error(registry):
 3567:             continue
 3568:         for entry in as_list(registry.get("project_classifiers")):
 3569:             if not isinstance(entry, dict) or str(entry.get("status", "active")) not in {"active", "enabled", "configured"}:
 3570:                 continue
 3571:             classifier_id = str(entry.get("id") or "")
 3572:             if classifier_id and classifier_id not in declared_ids:
 3573:                 continue
 3574:             raw_path = entry.get("path")
 3575:             if not raw_path:
 3576:                 continue
 3577:             classifier_path = resolve_registry_relative_path(manifest_path.parent, str(raw_path), workplace_manifest)
 3578:             classifier = load_yaml_document(classifier_path)
 3579:             if (
 3580:                 not isinstance(classifier, dict)
 3581:                 or yaml_error(classifier)
 3582:                 or classifier.get("kind") != "processforge.project_classifier"
 3583:                 or str(classifier.get("status", "active")) != "active"
 3584:             ):
 3585:                 continue
 3586:             for rule in classifier.get("rules", []) if isinstance(classifier.get("rules"), list) else []:
 3587:                 if not isinstance(rule, dict) or not project_classifier_rule_matches(rule, available_paths):
 3588:                     continue
 3589:                 key = f"{pack_id}:{classifier_id or classifier.get('id')}"
 3590:                 if key in seen:
 3591:                     continue
 3592:                 seen.add(key)
 3593:                 hints.append(
 3594:                     f"{pack_id} could classify this project via {classifier.get('id') or classifier_id}; "
 3595:                     f"activate with `python bin/pf.py pack-activate --id {pack_id} --workplace <workplace-root> --apply`, "
 3596:                     "then rerun project-context-refresh."
 3597:                 )
 3598:     return hints
 3599: 
 3600: 
 3601: def project_classifier_condition_matches(condition: dict[str, Any], available_paths: set[str]) -> bool:
 3602:     exists = condition.get("exists")
 3603:     if not isinstance(exists, str) or not exists.strip():
 3604:         return False
 3605:     pattern = exists.strip().replace("\\", "/")
 3606:     return any(path_matches_pattern(path, pattern) for path in available_paths)
 3607: 
 3608: 
 3609: def project_classifier_rule_matches(rule: dict[str, Any], available_paths: set[str]) -> bool:
 3610:     when = rule.get("when")
 3611:     if not isinstance(when, dict):
 3612:         return False
 3613:     all_conditions = when.get("all")
 3614:     any_conditions = when.get("any")
 3615:     if isinstance(all_conditions, list):
 3616:         return bool(all_conditions) and all(
 3617:             isinstance(item, dict) and project_classifier_condition_matches(item, available_paths)
 3618:             for item in all_conditions
 3619:         )
 3620:     if isinstance(any_conditions, list):
 3621:         return any(
 3622:             isinstance(item, dict) and project_classifier_condition_matches(item, available_paths)
 3623:             for item in any_conditions
 3624:         )
 3625:     return False
 3626: 
 3627: 
 3628: def classify_project(
 3629:     project_root: Path,
 3630:     workplace_manifest: Path | None = None,
 3631:     explicit_classifier_paths: list[Path] | None = None,
 3632: ) -> dict[str, Any]:
 3633:     files = list_project_files(project_root)
 3634:     available_paths = project_available_paths(project_root, files)
 3635:     project_types: set[str] = set()
 3636:     platforms: set[str] = set()
 3637:     tags: set[str] = set()
 3638:     matched_rules: list[dict[str, Any]] = []
 3639:     confidence_rank = {"low": 1, "medium": 2, "high": 3}
 3640:     confidence = "low"
 3641:     loaded: list[str] = []
 3642:     for path in project_classifier_paths(workplace_manifest, project_root, explicit_classifier_paths):
 3643:         classifier = load_yaml_document(path)
 3644:         if (
 3645:             not isinstance(classifier, dict)
 3646:             or yaml_error(classifier)
 3647:             or classifier.get("kind") != "processforge.project_classifier"
 3648:             or str(classifier.get("status", "active")) != "active"
 3649:         ):
 3650:             continue
 3651:         classifier_id = str(classifier.get("id") or path.stem)
 3652:         loaded.append(classifier_id)
 3653:         rules = classifier.get("rules")
 3654:         if not isinstance(rules, list):
 3655:             continue
 3656:         for rule in rules:
 3657:             if not isinstance(rule, dict) or not project_classifier_rule_matches(rule, available_paths):
 3658:                 continue
 3659:             classify_as = rule.get("classify_as")
 3660:             if not isinstance(classify_as, dict):
 3661:                 continue
 3662:             project_types.update(str(item) for item in classify_as.get("project_types", []) if str(item))
 3663:             platforms.update(str(item) for item in classify_as.get("platforms", []) if str(item))
 3664:             tags.update(str(item) for item in classify_as.get("tags", []) if str(item))
 3665:             rule_confidence = str(rule.get("confidence", "medium"))
 3666:             if confidence_rank.get(rule_confidence, 0) > confidence_rank.get(confidence, 0):
 3667:                 confidence = rule_confidence
 3668:             matched_rules.append(
 3669:                 {
 3670:                     "classifier": classifier_id,
 3671:                     "rule": str(rule.get("id") or "rule"),
 3672:                     "confidence": rule_confidence,
 3673:                     "source": rel(path, project_root) if path.is_relative_to(project_root) else path.name,
 3674:                 }
 3675:             )
 3676:     inactive_hints = inactive_official_classifier_hints(workplace_manifest, project_root, files) if not matched_rules else []
 3677:     return {
 3678:         "status": "classified" if matched_rules else "unclassified",
 3679:         "project_types": sorted(project_types),
 3680:         "platforms": sorted(platforms),
 3681:         "tags": sorted(tags),
 3682:         "confidence": confidence,
 3683:         "loaded_classifiers": sorted(set(loaded)),
 3684:         "matched_rules": matched_rules,
 3685:         "inactive_classifier_hints": inactive_hints,
 3686:     }
 3687: 
 3688: 
 3689: def detect_project(
 3690:     project_root: Path,
 3691:     workplace_manifest: Path | None = None,
 3692:     explicit_classifier_paths: list[Path] | None = None,
 3693: ) -> dict[str, Any]:
 3694:     files = list_project_files(project_root)
 3695:     top_dirs = sorted(
 3696:         {
 3697:             item.parts[0]
 3698:             for path in files
 3699:             for item in [path.relative_to(project_root)]
 3700:             if item.parts
 3701:         }.union({path.name for path in project_root.iterdir() if path.is_dir() and path.name not in {".git", ".idea", ".serena"}})
 3702:     )
 3703:     classification = classify_project(project_root, workplace_manifest, explicit_classifier_paths)
 3704:     project_types = classification["project_types"] or ["unknown"]
 3705:     evidence = [
 3706:         f"{item['classifier']}/{item['rule']}"
 3707:         for item in classification["matched_rules"]
 3708:     ]
 3709:     return {
 3710:         "status": classification["status"],
 3711:         "languages": [],
 3712:         "platforms": classification["platforms"],
 3713:         "frameworks": [],
 3714:         "project_kind": project_types,
 3715:         "tags": classification["tags"],
 3716:         "confidence": classification["confidence"],
 3717:         "loaded_classifiers": classification["loaded_classifiers"],
 3718:         "matched_rules": classification["matched_rules"],
 3719:         "inactive_classifier_hints": classification["inactive_classifier_hints"],
 3720:         "evidence": evidence or ["No loaded project classifier matched."],
 3721:         "files": [rel(path, project_root) for path in files[:300]],
 3722:         "top_dirs": top_dirs,
 3723:     }
 3724: 
 3725: 
 3726: def answer_strings(value: Any) -> list[str]:
 3727:     strings: list[str] = []
 3728:     if isinstance(value, str):
 3729:         strings.append(value)
 3730:     elif isinstance(value, list):
 3731:         for item in value:
 3732:             strings.extend(answer_strings(item))
 3733:     elif isinstance(value, dict):
 3734:         for item in value.values():
 3735:             strings.extend(answer_strings(item))
 3736:     return strings
 3737: 
 3738: 
 3739: def normalize_hint(value: str) -> str:
 3740:     return re.sub(r"[^a-z0-9]+", " ", value.lower()).strip()
 3741: 
 3742: 
 3743: def selected_project_platforms(detected: dict[str, Any], answers: dict[str, Any], project_type: str, workplace_manifest: Path | None, project_root: Path) -> list[str]:
 3744:     project_answers = answers.get("project", {}) if isinstance(answers.get("project"), dict) else {}
 3745:     selected = set(str(item) for item in detected.get("platforms", []) if item)
 3746:     for key in ["platform", "platforms", "platform_contract", "platform_contracts"]:
 3747:         value = project_answers.get(key)
 3748:         if value:
 3749:             selected.update(platform_contract_id(item).removeprefix("platform.") for item in answer_strings(value))
 3750:     selected.update(platform_ids_from_detection_rules(workplace_manifest, project_root))
 3751:     selected.update(workplace_platform_ids_for_project_type(workplace_manifest, project_type, project_root))
 3752:     return sorted(selected)
 3753: 
 3754: 
 3755: def platform_contract_project_type_hints(contract: dict[str, Any]) -> list[str]:
 3756:     hints = list_value(contract.get("project_type_hints"))
 3757:     applies_to = contract.get("applies_to") if isinstance(contract.get("applies_to"), dict) else {}
 3758:     detection = contract.get("detection") if isinstance(contract.get("detection"), dict) else {}
 3759:     hints.extend(list_value(applies_to.get("project_type_hints")))
 3760:     hints.extend(list_value(applies_to.get("project_types")))
 3761:     hints.extend(list_value(detection.get("project_type_hints")))
 3762:     return sorted(set(str(item) for item in hints if item))
 3763: 
 3764: 
 3765: def hint_matches(candidate: str, hints: list[str]) -> bool:
 3766:     candidate_variants = {candidate, normalize_hint(candidate), normalize_hint(candidate).replace(" ", "-")}
 3767:     for hint in hints:
 3768:         hint_variants = {hint, normalize_hint(hint), normalize_hint(hint).replace(" ", "-")}
 3769:         if candidate_variants.intersection(hint_variants):
 3770:             return True
 3771:     return False
 3772: 
 3773: 
 3774: def platform_contract_parent_type_hints(
 3775:     contract: dict[str, Any],
 3776:     contracts: dict[str, dict[str, Any]],
 3777:     visited: set[str] | None = None,
 3778: ) -> list[str]:
 3779:     """Return project type hints declared by a contract's parent graph."""
 3780:     seen = set() if visited is None else set(visited)
 3781:     hints: set[str] = set()
 3782:     parent_refs = [*contract_extends(contract), *contract_required_platforms(contract)]
 3783:     for ref in parent_refs:
 3784:         parent_id = ref["id"]
 3785:         if parent_id in seen:
 3786:             continue
 3787:         seen.add(parent_id)
 3788:         parent_entry = contracts.get(parent_id)
 3789:         if not isinstance(parent_entry, dict):
 3790:             continue
 3791:         parent_contract = parent_entry.get("contract")
 3792:         if not isinstance(parent_contract, dict):
 3793:             continue
 3794:         hints.update(platform_contract_project_type_hints(parent_contract))
 3795:         hints.update(platform_contract_parent_type_hints(parent_contract, contracts, seen))
 3796:     return sorted(hints)
 3797: 
 3798: 
 3799: def workplace_platform_ids_for_project_type(workplace_manifest: Path | None, project_type: str, project_root: Path | None = None) -> list[str]:
 3800:     """Return contracts selected by project type without promoting descendants.
 3801: 
 3802:     A derived contract may declare a specific project type, which is valid
 3803:     selection evidence. A type hint inherited from its parent, however, makes
 3804:     it only a candidate: select it through explicit input, project-classifier
 3805:     evidence, or its own concrete detection rules.
 3806:     """
 3807:     matched: list[str] = []
 3808:     contracts = platform_contract_manifest_index(workplace_manifest, project_root)
 3809:     for contract_id, entry in contracts.items():
 3810:         contract = entry["contract"]
 3811:         parent_hints = platform_contract_parent_type_hints(contract, contracts)
 3812:         if parent_hints and hint_matches(project_type, parent_hints):
 3813:             continue
 3814:         if hint_matches(project_type, platform_contract_project_type_hints(contract)):
 3815:             matched.append(contract_id.removeprefix("platform."))
 3816:     return sorted(set(item for item in matched if item))
 3817: 
 3818: 
 3819: def path_matches_pattern(path: str, pattern: str) -> bool:
 3820:     normalized = path.replace("\\", "/")
 3821:     name = Path(normalized).name
 3822:     return fnmatch.fnmatch(normalized, pattern) or fnmatch.fnmatch(name, pattern)
 3823: 
 3824: 
 3825: def detection_group_matches(values: Any, available: set[str], *, all_required: bool) -> bool:
 3826:     patterns = list_value(values)
 3827:     if not patterns:
 3828:         return False
 3829:     checks = [any(path_matches_pattern(item, pattern) for item in available) for pattern in patterns]
 3830:     return all(checks) if all_required else any(checks)
 3831: 
 3832: 
 3833: def platform_detection_matches(contract: dict[str, Any], project_root: Path) -> bool:
 3834:     detection = contract.get("detection") if isinstance(contract.get("detection"), dict) else {}
 3835:     if not detection:
 3836:         return False
 3837:     files = list_project_files(project_root)
 3838:     rel_files = {rel(path, project_root) for path in files}
 3839:     directories = {
 3840:         item.as_posix()
 3841:         for path in files
 3842:         for item in [path.relative_to(project_root).parent]
 3843:         if item.as_posix() != "."
 3844:     }
 3845:     directories.update(path.name for path in project_root.iterdir() if path.is_dir() and path.name not in {".git", ".idea", ".serena"})
 3846:     dir_rules = detection.get("directories") if isinstance(detection.get("directories"), dict) else {}
 3847:     file_rules = detection.get("files") if isinstance(detection.get("files"), dict) else {}
 3848:     matched = False
 3849:     if detection_group_matches(dir_rules.get("any"), directories, all_required=False):
 3850:         matched = True
 3851:     if detection_group_matches(dir_rules.get("all"), directories, all_required=True):
 3852:         matched = True
 3853:     if detection_group_matches(file_rules.get("any"), rel_files, all_required=False):
 3854:         matched = True
 3855:     if detection_group_matches(file_rules.get("all"), rel_files, all_required=True):
 3856:         matched = True
 3857:     contains_rules = detection.get("file_contains") if isinstance(detection.get("file_contains"), list) else []
 3858:     for rule in contains_rules:
 3859:         if not isinstance(rule, dict) or not rule.get("pattern"):
 3860:             continue
 3861:         candidate_patterns = list_value(rule.get("files")) or ["*"]
 3862:         candidate_files = [path for path in files if any(path_matches_pattern(rel(path, project_root), pattern) for pattern in candidate_patterns)]
 3863:         for path in candidate_files[:200]:
 3864:             text = path.read_text(encoding="utf-8", errors="ignore")[:200000]
 3865:             try:
 3866:                 if re.search(str(rule["pattern"]), text):
 3867:                     matched = True
 3868:                     break
 3869:             except re.error:
 3870:                 if str(rule["pattern"]) in text:
 3871:                     matched = True
 3872:                     break
 3873:         if matched:
 3874:             break
 3875:     return matched
 3876: 
 3877: 
 3878: def platform_ids_from_detection_rules(workplace_manifest: Path | None, project_root: Path) -> list[str]:
 3879:     matched: list[str] = []
 3880:     for contract_id, entry in platform_contract_manifest_index(workplace_manifest, project_root).items():
 3881:         if platform_detection_matches(entry["contract"], project_root):
 3882:             matched.append(contract_id.removeprefix("platform."))
 3883:     return sorted(set(matched))
 3884: 
 3885: 
 3886: def project_mode(project_root: Path, answers: dict[str, Any]) -> str:
 3887:     project_answers = answers.get("project", {}) if isinstance(answers.get("project"), dict) else {}
 3888:     requested = str(project_answers.get("mode") or "auto")
 3889:     if requested in {"greenfield", "brownfield"}:
 3890:         return requested
 3891:     if not project_root.exists():
 3892:         return "greenfield"
 3893:     visible = [path for path in project_root.iterdir() if path.name not in {".git", ".idea", ".serena"}]
 3894:     return "greenfield" if not visible else "brownfield"
 3895: 
 3896: 
 3897: def project_defaults(project_root: Path, answers: dict[str, Any], detected: dict[str, Any]) -> dict[str, Any]:
 3898:     project_answers = answers.get("project", {}) if isinstance(answers.get("project"), dict) else {}
 3899:     project_id = safe_id(str(project_answers.get("id") or project_root.name), "project")
 3900:     project_name = str(project_answers.get("name") or project_root.name or "ProcessForge Project")
 3901:     detected_kind = detected["project_kind"][0] if detected["project_kind"] else "unknown"
 3902:     project_type = str(project_answers.get("type") or project_answers.get("type_hint") or detected_kind)
 3903:     if project_type == "auto":
 3904:         project_type = detected_kind
 3905:     return {"id": project_id, "name": project_name, "type": project_type}
 3906: 
 3907: 
 3908: def project_runtime_launcher_files(flow_root: Path) -> dict[Path, str]:
 3909:     launcher_py = r'''#!/usr/bin/env python3
 3910: """Project-local ProcessForge launcher.
 3911: 
 3912: This file lives under .pf/runtime/ and may read private local paths from
 3913: .pf/process-forge.local.yaml. Public project files should use `pf` or this
 3914: launcher without exposing resolved local paths.
 3915: """
 3916: 
 3917: from __future__ import annotations
 3918: 
 3919: import os
 3920: import subprocess
 3921: import sys
 3922: from pathlib import Path
 3923: 
 3924: 
 3925: def project_marker(path: Path) -> bool:
 3926:     return (path / ".pf" / "process-forge.local.yaml").is_file()
 3927: 
 3928: 
 3929: def find_project_root(start: Path) -> Path | None:
 3930:     current = start.resolve()
 3931:     if project_marker(current):
 3932:         return current
 3933:     script_path = Path(__file__).resolve()
 3934:     script_project = script_path.parents[3] if len(script_path.parents) > 3 else None
 3935:     if script_project and project_marker(script_project):
 3936:         return script_project
 3937:     for candidate in [current, *current.parents, *script_path.parents]:
 3938:         if project_marker(candidate):
 3939:             return candidate
 3940:     return None
 3941: 
 3942: 
 3943: def yaml_scalar(text: str, key: str) -> str | None:
 3944:     prefix = key + ":"
 3945:     for line in text.splitlines():
 3946:         stripped = line.strip()
 3947:         if stripped.startswith(prefix):
 3948:             value = stripped[len(prefix) :].strip()
 3949:             if value in {"", "null", "None", "~"}:
 3950:                 return None
 3951:             return value.strip("'\"")
 3952:     return None
 3953: 
 3954: 
 3955: def resolve_path(base: Path, raw: str) -> Path:
 3956:     path = Path(raw)
 3957:     if path.is_absolute():
 3958:         return path
 3959:     return (base / path).resolve()
 3960: 
 3961: 
 3962: def exec_args(args: list[str]) -> list[str]:
 3963:     if os.name != "nt":
 3964:         return args
 3965:     return [subprocess.list2cmdline([arg]) for arg in args]
 3966: 
 3967: 
 3968: def exec_processforge(cli: Path, argv: list[str]) -> int:
 3969:     args = exec_args([sys.executable, str(cli), *argv])
 3970:     if os.name == "nt":
 3971:         return os.spawnv(os.P_WAIT, sys.executable, args)
 3972:     os.execv(sys.executable, args)
 3973:     return 2
 3974: 
 3975: 
 3976: def distribution_from_workplace(workplace_manifest: Path) -> Path | None:
 3977:     registry = workplace_manifest.parent / "registries" / "distributions.yaml"
 3978:     if not registry.is_file():
 3979:         return None
 3980:     lines = registry.read_text(encoding="utf-8", errors="replace").splitlines()
 3981:     in_processforge = False
 3982:     for line in lines:
 3983:         stripped = line.strip()
 3984:         if stripped.startswith("id:"):
 3985:             in_processforge = stripped.split(":", 1)[1].strip().strip("'\"") == "processforge"
 3986:         elif in_processforge and stripped.startswith("path:"):
 3987:             raw = stripped.split(":", 1)[1].strip().strip("'\"")
 3988:             raw = raw.replace("${PF_WORKPLACE}", str(workplace_manifest.parent))
 3989:             return resolve_path(workplace_manifest.parent, raw)
 3990:     return None
 3991: 
 3992: 
 3993: def distribution_root(project_root: Path) -> Path | None:
 3994:     env_home = os.environ.get("PROCESSFORGE_HOME")
 3995:     local_manifest = project_root / ".pf" / "process-forge.local.yaml"
 3996:     if local_manifest.is_file():
 3997:         text = local_manifest.read_text(encoding="utf-8", errors="replace")
 3998:         override = yaml_scalar(text, "distribution_override")
 3999:         if override:
 4000:             return resolve_path(local_manifest.parent, override)
 4001:         workplace_raw = yaml_scalar(text, "manifest")
 4002:         if workplace_raw:
 4003:             workplace = resolve_path(local_manifest.parent, workplace_raw)
 4004:             found = distribution_from_workplace(workplace)
 4005:             if found:
 4006:                 return found
 4007:     if env_home:
 4008:         return Path(env_home).expanduser().resolve()
 4009:     return None
 4010: 
 4011: 
 4012: def main(argv: list[str]) -> int:
 4013:     project_root = find_project_root(Path.cwd())
 4014:     if project_root is None:
 4015:         message = """FAIL: ProcessForge project root not found.
 4016: 
 4017: Fix:
 4018:   Run this launcher from a ProcessForge project root, pass --project-root to the command, or rerun project-onboard."""
 4019:         print(message, file=sys.stderr)
 4020:         return 1
 4021:     distribution = distribution_root(project_root)
 4022:     if not distribution:
 4023:         message = """FAIL: ProcessForge distribution not found.
 4024: 
 4025: Fix:
 4026:   Set PROCESSFORGE_HOME to the ProcessForge distribution root, or rerun project-onboard from the distribution."""
 4027:         print(message, file=sys.stderr)
 4028:         return 1
 4029:     cli = distribution / "tools" / "processforge.py"
 4030:     if not cli.is_file():
 4031:         message = f"""FAIL: ProcessForge CLI not found under distribution root: {distribution}
 4032: 
 4033: Fix:
 4034:   Check PROCESSFORGE_HOME or rerun project-onboard so .pf/process-forge.local.yaml points to a valid distribution."""
 4035:         print(message, file=sys.stderr)
 4036:         return 1
 4037:     try:
 4038:         return exec_processforge(cli, argv)
 4039:     except OSError as exc:
 4040:         print("FAIL: could not exec ProcessForge CLI", file=sys.stderr)
 4041:         print(f"Reason: {exc}", file=sys.stderr)
 4042:         return 2
 4043: 
 4044: 
 4045: if __name__ == "__main__":
 4046:     raise SystemExit(main(sys.argv[1:]))
 4047: '''
 4048:     launcher_sh = """#!/usr/bin/env sh
 4049: SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
 4050: if command -v python3 >/dev/null 2>&1; then
 4051:   exec python3 "$SCRIPT_DIR/pf.py" "$@"
 4052: fi
 4053: exec python "$SCRIPT_DIR/pf.py" "$@"
 4054: """
 4055:     launcher_bat = """@echo off
 4056: set SCRIPT_DIR=%~dp0
 4057: py -3 "%SCRIPT_DIR%pf.py" %*
 4058: if errorlevel 9009 python "%SCRIPT_DIR%pf.py" %*
 4059: """
 4060:     return {
 4061:         flow_root / "runtime" / "bin" / "pf.py": launcher_py,
 4062:         flow_root / "runtime" / "bin" / "pf": launcher_sh,
 4063:         flow_root / "runtime" / "bin" / "pf.bat": launcher_bat,
 4064:     }
 4065: 
 4066: 
 4067: def markdown_list(items: list[str], empty: str = "None.") -> str:
 4068:     if not items:
 4069:         return f"- {empty}"
 4070:     return "\n".join(f"- {item}" for item in items)
