21198: def command_doctor_project(args: argparse.Namespace) -> int:
21199:     project_root = Path(args.project_root).expanduser().resolve()
21200:     flow_root = require_flow_root(project_root)
21201:     checks: list[Check] = []
21202:     manifest = flow_root / "process-forge.yaml"
21203:     local_manifest = flow_root / "process-forge.local.yaml"
21204:     gitignore = project_root / ".gitignore"
21205:     auto_workplace_mode = False
21206:     workplace_manifest_path: Path | None = None
21207: 
21208:     if manifest.is_file():
21209:         checks.append(check("PASS", f"{rel(manifest, project_root)} found"))
21210:         text = manifest.read_text(encoding="utf-8", errors="replace")
21211:         checks.append(check("PASS" if is_public_path_safe(text) else "FAIL", "public manifest has no local absolute paths"))
21212:         checks.append(check("PASS" if not contains_secret_value(text) else "FAIL", "public manifest contains no secret values"))
21213:         loaded_manifest = load_doctor_yaml(
21214:             manifest,
21215:             "process-forge-manifest.schema.json",
21216:             "project ProcessForge manifest",
21217:             checks,
21218:         )
21219:         manifest_data = loaded_manifest or {}
21220:     else:
21221:         checks.append(
21222:             check_with_hint(
21223:                 "FAIL",
21224:                 f"{rel(manifest, project_root)} missing",
21225:                 "The project has not been onboarded into ProcessForge or the .pf flow root is incomplete.",
21226:                 "python bin/pf.py project-onboard --project-root <project-root> --workplace <workplace-root> --type generic --apply",
21227:             )
21228:         )
21229:         manifest_data = {}
21230: 
21231:     distribution_root: Path | None = None
21232:     if local_manifest.is_file():
21233:         checks.append(check("PASS", "process-forge.local.yaml found"))
21234:         workplace = resolve_workplace_manifest(local_manifest)
21235:         if workplace and workplace.is_file():
21236:             workplace_manifest_path = workplace
21237:             checks.append(check("PASS", "workplace manifest is reachable"))
21238:             registry = resolve_registry_path(workplace, "distributions", "distributions.yaml")
21239:             checks.append(check("PASS" if registry.is_file() else "FAIL", "workplace distributions registry is reachable"))
21240:             distribution_root = resolve_distribution_path(workplace, "processforge")
21241:         else:
21242:             checks.append(
21243:                 check_with_hint(
21244:                     "FAIL",
21245:                     "workplace manifest is missing or unreachable",
21246:                     "The local project config points to a workplace manifest that cannot be read.",
21247:                     "update .pf/process-forge.local.yaml so manifest points to an existing workplace.yaml",
21248:                 )
21249:             )
21250:     else:
21251:         workplace_data = manifest_data.get("workplace", {}) if isinstance(manifest_data.get("workplace"), dict) else {}
21252:         if workplace_data.get("reference") == "auto":
21253:             auto_workplace_mode = True
21254:             checks.append(check("PASS", "process-forge.local.yaml omitted by explicit workplace.reference auto mode"))
21255:             distribution_root = project_root
21256:         else:
21257:             checks.append(
21258:                 check_with_hint(
21259:                     "FAIL",
21260:                     "process-forge.local.yaml missing",
21261:                     "Linked projects need private local workplace/distribution coordinates.",
21262:                     "python bin/pf.py project-onboard --project-root <project-root> --workplace <workplace-root> --type generic --apply",
21263:                     "set workplace.reference: auto only for self-contained distribution dogfooding projects",
21264:                 )
21265:             )
21266: 
21267:     checks.extend(distribution_checks(distribution_root))
21268:     scan_policy = scan_policy_from_manifest(manifest_data)
21269:     if looks_like_processforge_distribution(project_root) and not project_type_allows_processforge_core(manifest_data):
21270:         checks.append(
21271:             check_with_hint(
21272:                 "FAIL",
21273:                 "project root looks like ProcessForge distribution",
21274:                 "This root contains ProcessForge core files and should not be treated as a generic project source tree.",
21275:                 "set project.type to processforge-development or processforge-core-development, or choose a normal project root",
21276:             )
21277:         )
21278:     path_roles = project_path_roles(project_root, distribution_root, workplace_manifest_path, manifest_data)
21279:     guarded_roles = {"distribution_root", "workplace_root", "knowledge_root"}
21280:     for role in path_roles:
21281:         role_name = str(role.get("role"))
21282:         if role_name not in guarded_roles:
21283:             continue
21284:         role_path_text = str(role.get("path") or "")
21285:         role_path = Path(role_path_text)
21286:         if not role_path.is_absolute():
21287:             role_path = (project_root / role_path).resolve()
21288:         if not path_is_relative_to(role_path, project_root):
21289:             continue
21290:         same_as_project = role_path.resolve() == project_root.resolve()
21291:         if same_as_project and role_name == "distribution_root" and project_type_allows_processforge_core(manifest_data):
21292:             checks.append(check("PASS", "ProcessForge distribution root allowed by explicit project type"))
21293:             continue
21294:         if same_as_project:
21295:             continue
