   31: def project_process_selection(manifest: dict[str, Any]) -> dict[str, Any]:
   32:     """Normalize legacy `process` and additive multi-process selection input."""
   33:     legacy = str(manifest.get("process") or "").strip()
   34:     declared = manifest.get("processes")
   35:     if isinstance(declared, dict):
   36:         allowed = _stable_ids(declared.get("allowed"))
   37:         default = str(declared.get("default") or legacy or "").strip()
   38:         return {"default": default, "allowed": allowed or ([legacy] if legacy else ["task-batch-execution"]), "source": "processes"}
   39:     selected = legacy or "task-batch-execution"
   40:     return {"default": selected, "allowed": [selected], "source": "legacy_process" if legacy else "fallback"}
   41: 
   42: 
   43: def project_specialization_selection(manifest: dict[str, Any], process: dict[str, Any]) -> dict[str, list[str]]:
   44:     """Keep project authorization distinct from the active Work specialization set."""
   45:     declared = manifest.get("specializations")
   46:     if isinstance(declared, dict):
   47:         allowed = _stable_ids(declared.get("allowed"))
   48:         active = _stable_ids(declared.get("active") or declared.get("default"))
   49:         policy = process.get("specialization_policy") if isinstance(process.get("specialization_policy"), dict) else {}
   50:         if not active:
   51:             # A process may constrain an explicitly selected project profile,
   52:             # but it must not invent a profile from ad-hoc legacy fields.
   53:             active = _stable_ids(policy.get("default"))
   54:         policy_allowed = _stable_ids(policy.get("allowed"))
   55:         forbidden = set(_stable_ids(policy.get("forbidden")))
   56:         return {
   57:             "allowed": allowed,
   58:             "active": [item for item in active if item in allowed and item not in forbidden and (not policy_allowed or item in policy_allowed)],
   59:         }
   60:     legacy = _stable_ids(declared)
   61:     # A legacy list was the already-selected profile. Preserve that behaviour.
   62:     return {"allowed": legacy, "active": legacy}
   63: 
