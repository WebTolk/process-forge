 4667: def platform_binding_matches(binding: dict[str, Any], selected_platforms: list[str], platform_stack: list[dict[str, Any]], process_id: str | None = None) -> bool:
 4668:     selected = {platform_contract_id(item) for item in selected_platforms}
 4669:     stack_ids = {str(item.get("id") or platform_contract_id(str(item.get("platform") or ""))) for item in platform_stack if isinstance(item, dict)}
 4670:     binding_platforms = {platform_contract_id(item) for item in list_value(binding.get("platforms"))}
 4671:     stack_includes = {platform_contract_id(item) for item in list_value(binding.get("platform_stack_includes"))}
 4672:     process_filter = set(list_value(binding.get("applies_to_processes")))
 4673:     if process_filter and process_id and process_id not in process_filter:
 4674:         return False
 4675:     return bool(selected.intersection(binding_platforms) or stack_ids.intersection(stack_includes))
