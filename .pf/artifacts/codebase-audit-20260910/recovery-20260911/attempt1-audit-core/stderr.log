23339: def mark_impacted_project_contexts_after_update(workplace_root: Path, candidate: dict[str, Any], *, reason: str) -> list[Path]:
23340:     subject = candidate.get("subject") if isinstance(candidate.get("subject"), dict) else {}
23341:     subject_type = str(subject.get("type") or "")
23342:     subject_id = str(subject.get("id") or "")
23343:     if subject_type not in SNAPSHOT_IMPACTING_UPDATE_SUBJECT_TYPES:
23344:         return []
23345:     marked: list[Path] = []
23346:     for project_root in project_roots_under_workplace(workplace_root):
23347:         snapshot_path, _snapshot_md = project_context_snapshot_paths(project_root)
23348:         if not snapshot_path.is_file():
23349:             continue
23350:         snapshot = load_yaml_document(snapshot_path)
23351:         resolved = snapshot.get("resolved") if isinstance(snapshot.get("resolved"), dict) else {}
23352:         resources = resolved.get("knowledge_resources") if isinstance(resolved.get("knowledge_resources"), list) else []
23353:         impacted = subject_type != "knowledge_resource"
23354:         for resource in resources:
23355:             if not isinstance(resource, dict):
23356:                 continue
23357:             if resource.get("id") == subject_id or resource.get("package_id") == subject_id:
23358:                 impacted = True
23359:         if impacted:
23360:             marked.append(mark_project_context_stale(project_root, subject=subject_id or subject_type, reason=reason, source="update-apply"))
23361:     return marked
