23275: def update_install_path(workplace_root: Path, candidate: dict[str, Any]) -> Path:
23276:     policy = candidate.get("update_policy") if isinstance(candidate.get("update_policy"), dict) else {}
23277:     install_path = policy.get("install_path")
23278:     if isinstance(install_path, str) and install_path.strip():
23279:         return path_resolution_to_path(workplace_path_resolution(workplace_root, install_path))
23280:     installed = installed_subjects_by_key(workplace_root)
23281:     subject = candidate.get("subject") if isinstance(candidate.get("subject"), dict) else {}
23282:     installed_subject = installed.get((str(subject.get("type")), str(subject.get("id"))), {})
23283:     if isinstance(installed_subject.get("install_path"), str) and str(installed_subject["install_path"]).strip():
23284:         return path_resolution_to_path(workplace_path_resolution(workplace_root, str(installed_subject["install_path"])))
23285:     return workplace_root / "packages" / safe_id(str(subject.get("id") or "package"))
