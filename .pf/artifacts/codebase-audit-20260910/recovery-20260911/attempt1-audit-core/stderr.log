 4764: def sha256_optional_file(path: Path | None) -> str:
 4765:     return "sha256:" + sha256_file(path) if path and path.is_file() else "missing"
 4766: 
 4767: 
 4768: def effective_fingerprint_for(base_id: str, base_path: Path | None, override_path: Path | None, mode: str) -> str:
 4769:     stable = {
 4770:         "id": base_id,
 4771:         "base_sha256": sha256_optional_file(base_path),
 4772:         "override_sha256": sha256_optional_file(override_path),
 4773:         "mode": mode,
 4774:     }
 4775:     return "sha256:" + hashlib.sha256(json.dumps(stable, sort_keys=True).encode("utf-8")).hexdigest()
 4776: 
