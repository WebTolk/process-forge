23789:         check("PASS", "workplace resource catalogue resolved without project context"),
23790:         check("PASS" if status.get("status") == "fresh" else "WARN", f"search index status: {status.get('status')}"),
23791:         check("PASS" if int(status.get("failed_file_count") or 0) == 0 else "WARN", "failed file count is zero"),
23792:     ]
23793:     return print_checks(checks)
