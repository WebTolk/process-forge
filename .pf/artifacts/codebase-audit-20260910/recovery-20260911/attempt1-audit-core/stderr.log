25278: def specialization_doctor_checks(workplace_root: Path, specialization_id: str) -> list[Check]:
25279:     normalized_id = specialization_resource_id(specialization_id)
25280:     checks: list[Check] = []
25281:     path = specialization_manifest_path(workplace_root, normalized_id)
25282:     checks.append(
25283:         check("PASS", "specialization manifest found")
25284:         if path
25285:         else check_with_hint(
25286:             "FAIL",
25287:             "specialization manifest found",
25288:             "The specialization id cannot be resolved through registries/specializations.yaml or the default specialization root.",
25289:             f"python bin/pf.py specialization-create --workplace <workplace-root> --id {normalized_id} --apply",
25290:         )
25291:     )
25292:     if not path:
25293:         return checks
25294:     data = load_doctor_yaml(
25295:         path,
25296:         "specialization.schema.json",
25297:         f"specialization {normalized_id} manifest",
25298:         checks,
25299:     )
25300:     if data is None:
25301:         return checks
25302:     checks.append(check("PASS" if isinstance(data, dict) and data.get("kind") == "processforge.specialization" else "FAIL", "specialization kind valid"))
25303:     checks.append(check("PASS" if data.get("id") == normalized_id else "FAIL", "specialization id matches requested id"))
25304:     checks.append(check("PASS" if is_public_path_safe(path.read_text(encoding="utf-8", errors="replace")) else "FAIL", "specialization has no private absolute paths"))
25305:     for bucket in RESOURCE_BUCKET_KEYS:
25306:         for key in RESOURCE_GROUP_KEYS:
25307:             values = resource_bucket(data.get("resources") if isinstance(data.get("resources"), dict) else {}, bucket, key)
25308:             checks.append(check("PASS", f"resources.{bucket}.{key} valid list") if all(isinstance(item, str) for item in values) else check("FAIL", f"resources.{bucket}.{key} valid list"))
25309:     bindings = data.get("platform_bindings") if isinstance(data.get("platform_bindings"), list) else []
25310:     for index, binding in enumerate(bindings):
25311:         if not isinstance(binding, dict):
25312:             checks.append(check("FAIL", f"platform_bindings[{index}] is object"))
25313:             continue
25314:         checks.append(check("PASS" if list_value(binding.get("platforms")) or list_value(binding.get("platform_stack_includes")) else "WARN", f"platform_bindings[{index}] has platform selector"))
25315:         resources = binding.get("resources") if isinstance(binding.get("resources"), dict) else {}
25316:         for bucket in RESOURCE_BUCKET_KEYS:
25317:             for key in RESOURCE_GROUP_KEYS:
25318:                 values = resource_bucket(resources, bucket, key)
25319:                 checks.append(check("PASS", f"platform_bindings[{index}].resources.{bucket}.{key} valid list") if all(isinstance(item, str) for item in values) else check("FAIL", f"platform_bindings[{index}].resources.{bucket}.{key} valid list"))
25320:     return checks
