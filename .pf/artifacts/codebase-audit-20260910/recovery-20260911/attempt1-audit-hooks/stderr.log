25483: def platform_dependency_preflight(
25484:     workplace_root: Path,
25485:     required_packages: list[str],
25486:     required_templates: list[str],
25487:     required_tools: list[str],
25488:     required_mcp: list[str],
25489: ) -> None:
25490:     missing: list[str] = []
25491:     for package_id in required_packages:
25492:         if not find_workplace_package_manifests(workplace_root, package_id):
25493:             missing.append(f"knowledge package {package_id}")
25494:     for template_id in required_templates:
25495:         if template_manifest_path(workplace_root, template_id) is None:
25496:             missing.append(f"template {template_id}")
25497:     tool_ids = registry_ids_from_workplace(workplace_root, "tools.yaml", "tools")
25498:     mcp_ids = registry_ids_from_workplace(workplace_root, "mcp.yaml", "mcp_servers")
25499:     missing.extend(f"tool {item}" for item in required_tools if item not in tool_ids)
25500:     missing.extend(f"MCP {item}" for item in required_mcp if item not in mcp_ids)
25501:     if missing:
25502:         raise SystemExit("FAIL: required platform resources missing: " + ", ".join(missing))
