 4852: def build_execution_route(project_root: Path, process_id: str | None) -> tuple[dict[str, Any], list[dict[str, Any]]]:
 4853:     route: dict[str, Any] = {
 4854:         "process": process_id or "",
 4855:         "stages": [],
 4856:         "required_capabilities": [],
 4857:         "capability_requirements": [],
 4858:         "required_artifacts": [],
 4859:         "required_evidence": [],
 4860:         "acceptance_criteria": [],
 4861:     }
 4862:     if not process_id:
 4863:         return route, []
 4864:     try:
 4865:         process_ref = resolve_process_definition(project_root, process_id)
 4866:     except SystemExit:
 4867:         return route, []
 4868:     process = process_ref.process if isinstance(process_ref.process, dict) else {}
 4869:     route["process"] = str(process.get("id") or process_ref.process_id or process_id)
 4870:     top_required_capabilities = [str(item) for item in as_list(process.get("required_capabilities")) if str(item)]
 4871:     capability_requirements: list[dict[str, Any]] = [
 4872:         {"capability": item, "required_by": f"process:{route['process']}"}
 4873:         for item in top_required_capabilities
 4874:     ]
 4875:     required_artifacts: set[str] = set(str(item) for item in as_list(process.get("required_artifacts")) if str(item))
 4876:     required_evidence: set[str] = set(str(item) for item in as_list(process.get("required_evidence")) if str(item))
 4877:     acceptance = process.get("acceptance") if isinstance(process.get("acceptance"), dict) else {}
 4878:     if acceptance:
 4879:         required_evidence.update(str(item) for item in as_list(acceptance.get("requires")) if str(item))
 4880:         route["acceptance_criteria"] = [str(item) for item in as_list(acceptance.get("criteria")) if str(item)]
 4881:     stages: list[dict[str, Any]] = []
 4882:     for stage in process.get("stages", []) if isinstance(process.get("stages"), list) else []:
 4883:         if not isinstance(stage, dict):
 4884:             continue
 4885:         stage_id = str(stage.get("id") or "stage")
 4886:         stage_capabilities = [str(item) for item in as_list(stage.get("required_capabilities")) if str(item)]
 4887:         stage_artifacts = [str(item) for item in as_list(stage.get("required_artifacts")) if str(item)]
 4888:         stage_evidence = [str(item) for item in as_list(stage.get("required_evidence")) if str(item)]
 4889:         required_artifacts.update(stage_artifacts)
 4890:         required_evidence.update(stage_evidence)
 4891:         for capability in stage_capabilities:
 4892:             capability_requirements.append({"capability": capability, "required_by": f"{route['process']}:{stage_id}"})
 4893:         stages.append(
 4894:             {
 4895:                 "id": stage_id,
 4896:                 "required_capabilities": stage_capabilities,
 4897:                 "required_artifacts": stage_artifacts,
 4898:                 "required_evidence": stage_evidence,
 4899:                 "exit_gates": [str(item) for item in as_list(stage.get("exit_gates")) if str(item)],
 4900:             }
 4901:         )
 4902:     route["stages"] = stages
 4903:     route["capability_requirements"] = capability_requirements
 4904:     route["required_capabilities"] = dedupe_sorted([item["capability"] for item in capability_requirements])
 4905:     route["required_artifacts"] = dedupe_sorted(list(required_artifacts))
 4906:     route["required_evidence"] = dedupe_sorted(list(required_evidence))
 4907:     return route, []
 4908: 
