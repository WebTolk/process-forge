26039: def build_parser() -> argparse.ArgumentParser:
26040:     parser = argparse.ArgumentParser(description="ProcessForge MVP init and doctor commands.")
26041:     sub = parser.add_subparsers(dest="command", required=True)
26042: 
26043:     init_workplace = sub.add_parser("init-workplace", help="Initialize a ProcessForge workplace layer.")
26044:     init_workplace.add_argument("--root", required=True, help="Workplace root path.")
26045:     init_workplace.add_argument("--answers", help="Optional workplace answers YAML.")
26046:     init_workplace.add_argument("--profile", help="Opaque workplace profile id used to select bundled process packs from manifest data.")
26047:     init_workplace.add_argument("--interactive", action="store_true", help="Accepted for first-run UX; prompts are not required in file-only MVP.")
26048:     init_workplace.add_argument("--dry-run", action="store_true", help="Show planned files without writing.")
26049:     init_workplace.add_argument("--apply", action="store_true", help="Write files.")
26050:     init_workplace.add_argument("--force", action="store_true", help="Overwrite existing files.")
26051:     init_workplace.set_defaults(func=command_init_workplace)
26052: 
26053:     workplace_init = sub.add_parser("workplace-init", help="First-run alias for init-workplace.")
26054:     workplace_init.add_argument("--workplace", dest="root", required=True, help="Workplace root path.")
26055:     workplace_init.add_argument("--answers", help="Optional workplace answers YAML.")
26056:     workplace_init.add_argument("--profile", help="Opaque workplace profile id used to select bundled process packs from manifest data.")
26057:     workplace_init.add_argument("--interactive", action="store_true", help="Accepted for first-run UX; prompts are not required in file-only MVP.")
26058:     workplace_init.add_argument("--dry-run", action="store_true", help="Show planned files without writing.")
26059:     workplace_init.add_argument("--apply", action="store_true", help="Write files.")
26060:     workplace_init.add_argument("--force", action="store_true", help="Overwrite existing files.")
26061:     workplace_init.set_defaults(func=command_init_workplace)
26062: 
26063:     workplace_setup = sub.add_parser("workplace-setup", help="Agent-guided workplace setup workflow.")
26064:     workplace_setup_sub = workplace_setup.add_subparsers(dest="workplace_setup_command", required=True)
26065:     workplace_setup_start = workplace_setup_sub.add_parser("start", help="Start a guided workplace setup session.")
26066:     workplace_setup_start.add_argument("--workplace", required=True, help="Workplace root path.")
26067:     workplace_setup_start.add_argument("--answers", help="Optional guided setup answers YAML.")
26068:     workplace_setup_start.add_argument("--session-id", default="default", help="Setup session id.")
26069:     workplace_setup_start.add_argument("--dry-run", action="store_true", help="Show planned files without writing.")
26070:     workplace_setup_start.add_argument("--apply", action="store_true", help="Write setup session files.")
26071:     workplace_setup_start.set_defaults(func=command_workplace_setup_start)
26072:     workplace_setup_review = workplace_setup_sub.add_parser("review", help="Review guided workplace setup answers and proposal.")
26073:     workplace_setup_review.add_argument("--workplace", required=True, help="Workplace root path.")
26074:     workplace_setup_review.add_argument("--answers", help="Optional guided setup answers YAML.")
26075:     workplace_setup_review.add_argument("--session-id", default="default", help="Setup session id.")
26076:     workplace_setup_review.add_argument("--dry-run", action="store_true", help="Show planned files without writing.")
26077:     workplace_setup_review.add_argument("--apply", action="store_true", help="Accepted for command symmetry; review writes unless --dry-run is used.")
26078:     workplace_setup_review.set_defaults(func=command_workplace_setup_review)
26079:     workplace_setup_apply = workplace_setup_sub.add_parser("apply", help="Apply a guided workplace setup proposal.")
26080:     workplace_setup_apply.add_argument("--workplace", required=True, help="Workplace root path.")
26081:     workplace_setup_apply.add_argument("--answers", help="Optional guided setup answers YAML.")
26082:     workplace_setup_apply.add_argument("--session-id", default="default", help="Setup session id.")
26083:     workplace_setup_apply.add_argument("--dry-run", action="store_true", help="Show planned files without writing.")
26084:     workplace_setup_apply.add_argument("--apply", action="store_true", help="Write workplace files.")
26085:     workplace_setup_apply.set_defaults(func=command_workplace_setup_apply)
26086:     workplace_setup_status = workplace_setup_sub.add_parser("status", help="Show guided workplace setup session status.")
26087:     workplace_setup_status.add_argument("--workplace", required=True, help="Workplace root path.")
26088:     workplace_setup_status.add_argument("--answers", help="Accepted for namespace compatibility.")
26089:     workplace_setup_status.add_argument("--session-id", default="default", help="Setup session id.")
26090:     workplace_setup_status.add_argument("--dry-run", action="store_true", help="Accepted for namespace compatibility.")
26091:     workplace_setup_status.add_argument("--apply", action="store_true", help="Accepted for namespace compatibility.")
26092:     workplace_setup_status.set_defaults(func=command_workplace_setup_status)
26093: 
26094:     global_agents = sub.add_parser("global-agents-section", help="Insert or update the bounded ProcessForge section in an agent instructions file.")
26095:     global_agents.add_argument("--path", required=True, help="Path to AGENTS.md, CODEX.md, or another agent instruction file.")
26096:     global_agents.add_argument("--dry-run", action="store_true", help="Write a .candidate file instead of changing the target.")
26097:     global_agents.add_argument("--force", action="store_true", help="Update the target file in place.")
26098:     global_agents.set_defaults(func=command_global_agents_section)
26099: 
26100:     doctor_workplace = sub.add_parser("doctor-workplace", help="Validate a ProcessForge workplace layer.")
26101:     doctor_workplace.add_argument("--root", required=True, help="Workplace root path.")
26102:     doctor_workplace.set_defaults(func=command_doctor_workplace)
26103: 
26104:     workplace_mode = sub.add_parser("workplace-mode", help="Inspect or change workplace coordination mode.")
