 6344: def release_source_files(root: Path) -> list[tuple[str, Path]]:
 6345:     files: list[tuple[str, Path]] = []
 6346:     for name in RELEASE_ROOT_FILES:
 6347:         path = root / name
 6348:         if path.is_file():
 6349:             files.append((name, path))
 6350:     root_agents = root / "AGENTS.md"
 6351:     pf_agents = root / ".pf" / "AGENTS.md"
 6352:     if root_agents.is_file():
 6353:         files.append(("AGENTS.md", root_agents))
 6354:     elif pf_agents.is_file():
 6355:         files.append(("AGENTS.md", pf_agents))
 6356:     for name in RELEASE_PF_PUBLIC_FILES:
 6357:         path = root / name
 6358:         if path.is_file():
 6359:             files.append((name, path))
 6360:     for dirname in RELEASE_DIRS:
 6361:         base = root / dirname
 6362:         if base.is_dir():
 6363:             for path in base.rglob("*"):
 6364:                 if path.is_file():
 6365:                     files.append((rel(path, root), path))
 6366:     return sorted(files, key=lambda item: item[0])
