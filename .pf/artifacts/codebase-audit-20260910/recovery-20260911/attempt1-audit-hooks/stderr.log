 6081: def command_project_init_repair(args: argparse.Namespace) -> int:
 6082:     request = {"project_root": args.project_root, "workplace": getattr(args, "workplace", None), "repair_action": args.repair_action, "reason": args.reason, "apply": args.apply is True}
 6083:     try:
 6084:         result = project_initialization.repair_project(request, sys.modules[__name__])
 6085:     except project_initialization.ProjectInitializationError as exc:
 6086:         raise _project_initialization_error(exc) from exc
 6087:     print(dump_yaml(result), end="")
 6088:     payload = result.get("result") if isinstance(result.get("result"), dict) else {}
 6089:     if result.get("applied") is not True:
 6090:         return 0
 6091:     if payload.get("doctor") is None:
 6092:         return 0 if payload.get("status") == "complete" else 1
 6093:     return 0 if payload.get("doctor", {}).get("status") == "pass" else 1
