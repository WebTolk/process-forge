22217:     result: dict[tuple[str, str], str] = {}
22218:     for subject in subjects:
22219:         if not isinstance(subject, dict):
22220:             continue
22221:         subject_type = subject.get("type")
22222:         subject_id = subject.get("id")
22223:         version = subject.get("version")
22224:         if isinstance(subject_type, str) and isinstance(subject_id, str) and isinstance(version, str) and version:
22225:             result[(subject_type, subject_id)] = version
22226:     return result
