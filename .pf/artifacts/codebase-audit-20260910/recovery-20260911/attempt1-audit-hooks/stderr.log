 6036: def _project_initialization_error(exc: project_initialization.ProjectInitializationError) -> SystemExit:
 6037:     hints = {
 6038:         "apply_required": "Rerun with --apply (or MCP apply: true).",
 6039:         "workplace_manifest_required": "Initialize the workplace first, or explicitly allow a missing workplace where that is safe.",
 6040:         "project_root_missing": "Create the project root before a dry run, or use --apply for greenfield onboarding.",
 6041:         "project_not_initialized": "Use project-onboard for a new project; repair only accepts an existing .pf project.",
 6042:         "codex_integration_unsupported": "Use a ProcessForge distribution that includes the Codex hook integration service.",
 6043:     }
 6044:     return SystemExit(f"FAIL: {exc.code}. {hints.get(exc.code, 'Check the initialization request.')}")
 6045: 
