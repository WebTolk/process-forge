 1236: def workplace_state_payload(workplace_root: Path, core: Any) -> dict[str, Any]:
 1237:     core.update_stale_agent_presence(workplace_root)
 1238:     presence = core.iter_agent_presence(workplace_root)
 1239:     projects: dict[str, dict[str, Any]] = {}
 1240:     for item in presence:
 1241:         project_id = str(item.get("project_id") or "")
 1242:         if project_id:
 1243:             projects.setdefault(project_id, {"project_id": project_id, "sessions": 0, "online": 0})["sessions"] += 1
 1244:             if item.get("status") == "online":
 1245:                 projects[project_id]["online"] += 1
 1246:     return {"workplace_root": str(workplace_root), "agent_ledger": presence, "projects": sorted(projects.values(), key=lambda item: item["project_id"]), "runtime_cache": "derived"}
