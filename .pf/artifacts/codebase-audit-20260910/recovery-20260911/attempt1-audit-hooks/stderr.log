22294: def build_installed_update_sites(workplace_root: Path) -> tuple[dict[str, Any], list[Check]]:
22295:     checks: list[Check] = []
22296:     overrides_path = update_site_overrides_path(workplace_root)
22297:     if overrides_path.is_file():
22298:         checks.extend(validate_update_site_overrides_data(load_update_yaml(overrides_path), overrides_path))
22299:     overrides = update_site_overrides(workplace_root)
22300:     installed_versions = installed_subject_version_map(workplace_root)
22301:     sites: list[dict[str, Any]] = []
22302:     for record in update_entity_manifest_records(workplace_root):
22303:         installed_version = installed_versions.get((record["type"], record["id"]), record["version"])
22304:         data = record["data"]
22305:         update_sites = data.get("update_sites")
22306:         if isinstance(update_sites, list):
22307:             seen: set[str] = set()
22308:             for index, site in enumerate(update_sites):
22309:                 label = f"{rel(record['manifest_path'], workplace_root)}.update_sites[{index}]"
22310:                 append_update_source_checks(checks, site, label, provider_key="type")
22311:                 if isinstance(site, dict) and isinstance(site.get("manifest_url"), str):
22312:                     source_id = update_site_source_id(site)
22313:                     if source_id in seen:
22314:                         checks.append(check("FAIL", f"{label} duplicate update site id {source_id}"))
22315:                     seen.add(source_id)
22316:                     sites.append(
22317:                         derived_update_site_record(
22318:                             workplace_root,
22319:                             record["type"],
22320:                             record["id"],
22321:                             record["scope"],
22322:                             installed_version,
22323:                             record["manifest_path"],
22324:                             site,
22325:                             overrides,
22326:                         )
22327:                     )
22328:         elif update_sites is not None:
22329:             checks.append(check("FAIL", f"{rel(record['manifest_path'], workplace_root)} update_sites must be a list"))
22330: 
22331:         if record["type"] == "knowledge_package":
22332:             resources = data.get("resources") if isinstance(data.get("resources"), list) else []
22333:             for resource in resources:
22334:                 if not isinstance(resource, dict) or not resource.get("id"):
22335:                     continue
22336:                 update_policy = resource.get("update_policy") if isinstance(resource.get("update_policy"), dict) else {}
22337:                 resource_sites = resource.get("update_sites") or update_policy.get("update_sites")
22338:                 if resource_sites is None:
22339:                     continue
22340:                 resource_subject_id = f"{record['id']}/{resource.get('id')}"
22341:                 if not isinstance(resource_sites, list):
22342:                     checks.append(check("FAIL", f"{rel(record['manifest_path'], workplace_root)} resource {resource.get('id')} update_sites must be a list"))
22343:                     continue
22344:                 for index, site in enumerate(resource_sites):
22345:                     label = f"{rel(record['manifest_path'], workplace_root)}.resources[{resource.get('id')}].update_sites[{index}]"
22346:                     append_update_source_checks(checks, site, label, provider_key="type")
22347:                     if isinstance(site, dict) and isinstance(site.get("manifest_url"), str):
22348:                         sites.append(
22349:                             derived_update_site_record(
22350:                                 workplace_root,
22351:                                 "knowledge_resource",
22352:                                 resource_subject_id,
22353:                                 record["scope"],
22354:                                 str(resource.get("version") or record["version"]),
22355:                                 record["manifest_path"],
22356:                                 site,
22357:                                 overrides,
22358:                                 parent={"type": "knowledge_package", "id": record["id"]},
22359:                             )
22360:                         )
22361: 
22362:     sites.sort(key=lambda item: (item["subject"]["type"], item["subject"]["id"], int(item["source"].get("priority", 1000)), item["site_id"]))
22363:     derived = {"schema_version": 1, "generated_at": now_utc(), "sites": sites}
22364:     return derived, checks
22365: 
