25100: def upsert_registry_entry(path: Path, collection_key: str, entry: dict[str, Any]) -> str:
25101:     if path.exists() and not path.is_file():
25102:         raise SystemExit(f"FAIL: registry path is not a file: {path}")
25103:     if path.is_file():
25104:         data = load_yaml_document(path)
25105:         error = yaml_error(data)
25106:         if error:
25107:             raise SystemExit(f"FAIL: registry YAML invalid; original preserved: {path}: {error}")
25108:         if not isinstance(data, dict) or not data:
25109:             raise SystemExit(f"FAIL: registry must be a non-empty YAML object; original preserved: {path}")
25110:         if collection_key not in data:
25111:             entries = []
25112:             data[collection_key] = entries
25113:         else:
25114:             entries = data.get(collection_key)
25115:         if not isinstance(entries, list):
25116:             raise SystemExit(
25117:                 f"FAIL: registry collection {collection_key} must be a list; original preserved: {path}"
25118:             )
25119:     else:
25120:         data = {"schema_version": 1, collection_key: []}
25121:         entries = data[collection_key]
25122:     result = upsert_resource(entries, entry)
25123:     registry_schemas = {
25124:         "distributions.yaml": "distributions-registry.schema.json",
25125:         "platforms.yaml": "platform-registry.schema.json",
25126:         "knowledge-roots.yaml": "knowledge-roots-registry.schema.json",
25127:         "package-roots.yaml": "package-roots-registry.schema.json",
25128:         "templates.yaml": "template-registry.schema.json",
25129:         "tools.yaml": "tool-registry.schema.json",
25130:         "mcp.yaml": "mcp-registry.schema.json",
25131:         "specializations.yaml": "specialization-registry.schema.json",
25132:         "project-classifiers.yaml": "project-classifier-registry.schema.json",
25133:         "runtime-drivers.yaml": "runtime-driver-registry.schema.json",
25134:         "private-resource-paths.yaml": "private-resource-paths-registry.schema.json",
25135:         "platform-contract-roots.yaml": "platform-contract-roots-registry.schema.json",
25136:     }
25137:     schema_name = registry_schemas.get(path.name)
25138:     if schema_name:
25139:         schema_path = ROOT / "schemas" / schema_name
25140:         try:
25141:             schema = json.loads(schema_path.read_text(encoding="utf-8"))
25142:             errors = validate_update_instance_against_schema(data, schema, schema, "$")
25143:         except (OSError, json.JSONDecodeError, KeyError, ValueError) as exc:
25144:             raise SystemExit(f"FAIL: registry schema validation unavailable for {path}: {exc}") from exc
25145:         if errors:
25146:             raise SystemExit(
25147:                 f"FAIL: registry update rejected; original preserved: {path}: {'; '.join(errors[:8])}"
25148:             )
25149:     path.parent.mkdir(parents=True, exist_ok=True)
25150:     temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
25151:     try:
25152:         temporary.write_text(ensure_trailing_newline(dump_yaml(data)), encoding="utf-8")
25153:         os.replace(temporary, path)
25154:     finally:
25155:         if temporary.exists():
25156:             temporary.unlink()
25157:     return result
25158: 
