 1322: def is_public_path_safe(text: str) -> bool:
 1323:     return not any(pattern.search(text) for pattern in LOCAL_PATH_PATTERNS)
 1324: 
 1325: 
 1326: def contains_secret_value(text: str) -> bool:
 1327:     return any(pattern.search(text) for pattern in SECRET_VALUE_PATTERNS)
