   55: def last_json_object(path: Path, *, chunk_size: int = 8192) -> dict[str, Any] | None:
   56:     """Read the newest valid JSON object without scanning an entire journal."""
   57:     try:
   58:         with path.open("rb") as handle:
   59:             handle.seek(0, os.SEEK_END)
   60:             position = handle.tell()
   61:             pending = b""
   62:             while position > 0:
   63:                 size = min(chunk_size, position)
   64:                 position -= size
   65:                 handle.seek(position)
   66:                 pending = handle.read(size) + pending
   67:                 parts = pending.split(b"\n")
   68:                 candidates = parts if position == 0 else parts[1:]
   69:                 for raw in reversed(candidates):
   70:                     if not raw.strip():
   71:                         continue
   72:                     try:
   73:                         item = json.loads(raw.decode("utf-8"))
   74:                     except (UnicodeDecodeError, json.JSONDecodeError):
   75:                         continue
   76:                     if isinstance(item, dict):
   77:                         return item
   78:                 pending = parts[0] if position > 0 else b""
   79:     except OSError:
   80:         return None
   81:     return None
   82: 
