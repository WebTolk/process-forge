  209: class RawIngressKernel:
  210:     """Append raw events, maintain identity indexes, and return durable receipts."""
  211: 
  212:     def __init__(self, workplace_root: Path | str, *, max_payload_bytes: int = 1_048_576) -> None:
  213:         self.workplace_root = Path(workplace_root).resolve(strict=False)
  214:         self.root = contained_path(self.workplace_root, "runtime", "agent-events")
  215:         if max_payload_bytes <= 0:
  216:             raise RawIngressError("max_payload_bytes must be positive")
  217:         self.max_payload_bytes = max_payload_bytes
  218: 
  219:     def ingest(self, event: NativeAgentEvent, received_at: datetime | None = None) -> RawReceipt:
  220:         _validate(event, self.max_payload_bytes)
  221:         moment = (received_at or datetime.now(timezone.utc)).astimezone(timezone.utc)
  222:         payload_hash = raw_payload_hash(event.raw_payload)
  223:         event_id = raw_event_id(event)
  224:         native_key = stable_native_identity_key(event)
  225:         raw_index = self._index_path("raw_event_id", event_id)
  226:         native_index = self._index_path("native_identity", native_key) if native_key else None
  227:         with _ExclusiveFileLock(contained_path(self.root, "indexes", ".ingress.lock")):
  228:             # An unreadable derived index can be rebuilt from the journal;
  229:             # journal remains the source of truth and corruption there still
  230:             # fails closed in _recover_indexes().
  231:             force_recovery = False
  232:             try:
  233:                 native_existing = self._read_index(native_index)
  234:             except RawIngressError:
  235:                 native_existing = None
  236:                 force_recovery = True
  237:             try:
  238:                 existing = self._read_index(raw_index)
  239:             except RawIngressError:
  240:                 existing = None
  241:                 force_recovery = True
  242:             # Even a full index rebuild must not bypass evidence that a
  243:             # checkpointed raw shard was lost or truncated.
  244:             recovery_needed = self._recovery_needed()
  245:             if force_recovery or recovery_needed:
  246:                 recovered_raw, recovered_native = self._recover_indexes(
  247:                     event_id, native_key, full_scan=force_recovery
  248:                 )
  249:                 native_existing = native_existing or recovered_native
  250:                 existing = existing or recovered_raw
  251:             if native_existing and native_existing.get("raw_payload_hash") != payload_hash:
  252:                 return self._quarantine("native_id_payload_conflict", event, event_id, payload_hash, native_existing)
  253:             if existing:
  254:                 if existing.get("raw_payload_hash") == payload_hash:
  255:                     return RawReceipt(event_id, True, True, existing.get("raw_location"), "duplicate_raw")
  256:                 return self._quarantine("raw_event_id_hash_collision", event, event_id, payload_hash, existing)
  257: 
  258:             shard = self._shard(moment)
  259:             line = canonical_json(self._raw_record(event, event_id, payload_hash, native_key, moment)) + b"\n"
  260:             offset = self._append_line(shard, line)
  261:             location = f"{shard.relative_to(self.root).as_posix()}:{offset}"
  262:             index = {
  263:                 "schema_version": 1,
  264:                 "raw_event_id": event_id,
  265:                 "raw_payload_hash": payload_hash,
  266:                 "native_identity_key": native_key,
  267:                 "raw_location": location,
  268:                 "routing_status": "raw_accepted",
  269:             }
  270:             atomic_write_json(raw_index, index, self.root)
  271:             if native_index is not None:
  272:                 atomic_write_json(native_index, index, self.root)
  273:             self._write_recovery_checkpoint()
  274:             return RawReceipt(event_id, True, False, location, "raw_accepted")
  275: 
  276:     def _shard(self, moment: datetime) -> Path:
  277:         return contained_path(
  278:             self.root, "raw", "v1", f"{moment.year:04d}", f"{moment.month:02d}", f"{moment.day:02d}", f"{moment.hour:02d}.ndjson"
  279:         )
  280: 
  281:     def _index_path(self, kind: str, key: str | None) -> Path:
  282:         if not key or any(char in key for char in ("/", "\\", "\x00")):
  283:             raise RawIngressError("unsafe index key")
  284:         return contained_path(self.root, "indexes", kind, f"{key}.json")
  285: 
  286:     def _append_line(self, shard: Path, line: bytes) -> int:
  287:         shard.parent.mkdir(parents=True, exist_ok=True)
  288:         with _ExclusiveFileLock(shard.with_suffix(shard.suffix + ".lock")):
  289:             descriptor = os.open(str(shard), os.O_CREAT | os.O_APPEND | os.O_WRONLY | getattr(os, "O_BINARY", 0))
  290:             try:
  291:                 offset = os.lseek(descriptor, 0, os.SEEK_END)
  292:                 if os.write(descriptor, line) != len(line):
  293:                     raise OSError("short raw journal write")
  294:                 os.fsync(descriptor)
  295:                 return offset
  296:             finally:
  297:                 os.close(descriptor)
  298: 
  299:     def _read_index(self, path: Path | None) -> Mapping[str, Any] | None:
  300:         if path is None or not path.is_file():
  301:             return None
  302:         try:
  303:             data = json.loads(path.read_text(encoding="utf-8"))
  304:         except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
  305:             raise RawIngressError(f"index is unreadable: {path.name}") from exc
  306:         if not isinstance(data, Mapping):
  307:             raise RawIngressError(f"index is not an object: {path.name}")
  308:         return data
  309: 
  310:     def _recovery_checkpoint_path(self) -> Path:
  311:         return contained_path(self.root, "indexes", "recovery-checkpoint.json")
  312: 
  313:     def _read_recovery_checkpoint(self) -> Mapping[str, Any] | None:
  314:         path = self._recovery_checkpoint_path()
  315:         if not path.is_file():
  316:             return None
  317:         try:
  318:             data = json.loads(path.read_text(encoding="utf-8"))
  319:         except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
  320:             raise RawIngressError("recovery checkpoint is unreadable") from exc
  321:         if not isinstance(data, Mapping) or data.get("schema_version") != 1:
  322:             raise RawIngressError("recovery checkpoint has an unsupported schema")
  323:         shards = data.get("shards")
  324:         if not isinstance(shards, Mapping):
  325:             raise RawIngressError("recovery checkpoint shards are invalid")
  326:         for relative, offset in shards.items():
  327:             if not isinstance(relative, str) or not isinstance(offset, int) or isinstance(offset, bool) or offset < 0:
  328:                 raise RawIngressError("recovery checkpoint offset is invalid")
  329:             contained_path(self.root, relative)
  330:         return data
  331: 
  332:     def _raw_shards(self) -> list[Path]:
  333:         raw_root = contained_path(self.root, "raw", "v1")
  334:         if not raw_root.is_dir():
  335:             return []
  336:         return sorted(path for path in raw_root.rglob("*.ndjson") if path.is_file())
  337: 
  338:     def _recovery_needed(self) -> bool:
  339:         """Return whether raw bytes exist beyond the last indexed checkpoint.
  340: 
  341:         A missing checkpoint is the legacy/migration state.  Once a
  342:         checkpoint exists, only a shard that grew (or appeared) is evidence
  343:         of an unindexed durable append; a normal lookup miss does not scan
  344:         historical records.
  345:         """
  346: 
  347:         shards = self._raw_shards()
  348:         checkpoint = self._read_recovery_checkpoint()
  349:         if checkpoint is None:
  350:             return bool(shards)
  351:         checkpoint_shards = checkpoint["shards"]
  352:         current_names: set[str] = set()
  353:         recovery_needed = False
  354:         for shard in shards:
  355:             relative = shard.relative_to(self.root).as_posix()
  356:             current_names.add(relative)
  357:             recorded = checkpoint_shards.get(relative)
  358:             if recorded is None:
  359:                 recovery_needed = True
  360:                 continue
  361:             size = shard.stat().st_size
  362:             if size < recorded:
  363:                 raise RawIngressError(f"raw journal shard was truncated: {shard.name}")
  364:             if size > recorded:
  365:                 recovery_needed = True
  366:         for relative, recorded in checkpoint_shards.items():
  367:             if relative not in current_names:
  368:                 raise RawIngressError(f"raw journal shard is missing: {relative}")
  369:         return recovery_needed
  370: 
  371:     def _write_recovery_checkpoint(self) -> None:
  372:         """Commit bounded per-shard journal offsets after index writes."""
  373: 
  374:         shards = {
  375:             shard.relative_to(self.root).as_posix(): shard.stat().st_size
  376:             for shard in self._raw_shards()
  377:         }
  378:         atomic_write_json(
  379:             self._recovery_checkpoint_path(),
  380:             {"schema_version": 1, "kind": "raw-ingress-recovery-checkpoint", "shards": shards},
  381:             self.root,
  382:         )
  383: 
  384:     def _decode_raw_record(self, line: bytes, shard: Path) -> Mapping[str, Any]:
  385:         try:
  386:             record = json.loads(line.decode("utf-8"))
  387:         except (UnicodeDecodeError, json.JSONDecodeError) as exc:
  388:             raise RawIngressError(f"corrupt raw journal shard: {shard.name}") from exc
  389:         if not isinstance(record, Mapping):
  390:             raise RawIngressError(f"raw journal record is not an object: {shard.name}")
  391:         if record.get("schema_version") != 1 or any(
  392:             not isinstance(record.get(key), str) or not record[key]
  393:             for key in ("raw_event_id", "raw_payload_hash")
  394:         ):
  395:             raise RawIngressError(f"raw journal record has invalid identity: {shard.name}")
  396:         return record
  397: 
  398:     def _recover_indexes(
  399:         self, event_id: str, native_key: str | None, *, full_scan: bool = False
  400:     ) -> tuple[Mapping[str, Any] | None, Mapping[str, Any] | None]:
  401:         """Rebuild indexes from a legacy journal or an unindexed raw tail.
  402: 
  403:         Commit the checkpoint only after all recovered indexes are durable.
  404:         An append/index crash therefore leaves a measurable tail for the
  405:         next ingest to repair, including when that next event is a duplicate.
  406:         """
  407: 
  408:         raw_found: Mapping[str, Any] | None = None
  409:         native_found: Mapping[str, Any] | None = None
  410:         shards = self._raw_shards()
  411:         if not shards:
  412:             return None, None
  413:         checkpoint = None if full_scan else self._read_recovery_checkpoint()
  414:         if checkpoint is not None:
  415:             checkpoint_shards = checkpoint["shards"]
  416:         else:
  417:             checkpoint_shards = {}
  418:         for shard in shards:
  419:             relative = shard.relative_to(self.root).as_posix()
  420:             start = 0 if full_scan or checkpoint is None else checkpoint_shards.get(relative, 0)
  421:             size = shard.stat().st_size
  422:             if start > size:
  423:                 raise RawIngressError(f"raw journal shard was truncated: {shard.name}")
  424:             offset = start
  425:             with shard.open("rb") as handle:
  426:                 handle.seek(start)
  427:                 for line in handle:
  428:                     if not line.endswith(b"\n"):
  429:                         raise RawIngressError(f"truncated raw journal record: {shard.name}")
  430:                     record = self._decode_raw_record(line, shard)
  431:                     location = f"{shard.relative_to(self.root).as_posix()}:{offset}"
  432:                     candidate = {
  433:                         "schema_version": 1,
  434:                         "raw_event_id": record.get("raw_event_id"),
  435:                         "raw_payload_hash": record.get("raw_payload_hash"),
  436:                         "native_identity_key": record.get("native_identity_key"),
  437:                         "raw_location": location,
  438:                         "routing_status": "raw_recovered",
  439:                     }
  440:                     if candidate["raw_event_id"] == event_id:
  441:                         raw_found = candidate
  442:                     if native_key and candidate["native_identity_key"] == native_key:
  443:                         native_found = candidate
  444:                     if candidate["raw_event_id"]:
  445:                         raw_candidate_path = self._index_path("raw_event_id", str(candidate["raw_event_id"]))
  446:                         if not raw_candidate_path.is_file():
  447:                             atomic_write_json(raw_candidate_path, candidate, self.root)
  448:                     candidate_native = candidate["native_identity_key"]
  449:                     if candidate_native:
  450:                         native_candidate_path = self._index_path("native_identity", str(candidate_native))
  451:                         if not native_candidate_path.is_file():
  452:                             atomic_write_json(native_candidate_path, candidate, self.root)
  453:                     offset += len(line)
  454:         if raw_found:
  455:             atomic_write_json(self._index_path("raw_event_id", event_id), raw_found, self.root)
  456:         if native_key and native_found:
  457:             atomic_write_json(self._index_path("native_identity", native_key), native_found, self.root)
  458:         self._write_recovery_checkpoint()
  459:         return raw_found, native_found
  460: 
  461:     def _raw_record(self, event: NativeAgentEvent, event_id: str, payload_hash: str, native_key: str | None, moment: datetime) -> dict[str, Any]:
  462:         return {
  463:             "schema_version": 1,
  464:             "raw_event_id": event_id,
  465:             "provider": event.provider,
  466:             "adapter": event.adapter,
  467:             "native_event_type": event.native_event_type,
  468:             "native_event_id": event.native_event_id,
  469:             "source_session_id": event.source_session_id,
  470:             "source_project_ref": event.source_project_ref,
  471:             "payload_version": event.payload_version,
  472:             "received_at": moment.isoformat(timespec="microseconds").replace("+00:00", "Z"),
  473:             "raw_payload": event.raw_payload,
  474:             "raw_payload_hash": payload_hash,
  475:             "native_identity_key": native_key,
  476:             "privacy": "private",
  477:         }
  478: 
  479:     def _quarantine(self, code: str, event: NativeAgentEvent, event_id: str, payload_hash: str, existing: Mapping[str, Any]) -> RawReceipt:
  480:         bucket = "poisoned" if code == "native_id_payload_conflict" else "collisions"
  481:         error = contained_path(self.root, "errors", bucket, f"{event_id}.json")
  482:         atomic_write_json(error, {"code": code, "raw_event_id": event_id, "raw_payload_hash": payload_hash, "existing_raw_event_id": existing.get("raw_event_id"), "raw_payload": event.raw_payload, "privacy": "private"}, self.root)
  483:         return RawReceipt(
  484:             raw_event_id=event_id,
  485:             accepted=False,
  486:             deduplicated=False,
  487:             raw_location=None,
  488:             routing_status="quarantined",
  489:             diagnostics={"code": code},
  490:         )
  491: 
  492: 
  493: def _identity_document(event: NativeAgentEvent, include_payload_hash: bool) -> dict[str, Any]:
  494:     stable = _uses_stable_native_id(event)
  495:     document: dict[str, Any] = {
  496:         "contract": "processforge.raw-identity.v1" if include_payload_hash else "processforge.native-identity.v1",
  497:         "provider": _text(event.provider, "provider"),
  498:         "adapter": _text(event.adapter, "adapter"),
  499:         "native_event_type": _text(event.native_event_type, "native_event_type"),
  500:         "native_id_scope": event.native_id_scope,
  501:         "native_event_id": _optional(event.native_event_id) if stable else None,
  502:         "source_session_id": _optional(event.source_session_id) if not stable or event.native_id_scope == "session" else None,
  503:         "source_project_ref": _optional(event.source_project_ref) if not stable or event.native_id_scope == "project" else None,
  504:         "payload_version": _text(event.payload_version, "payload_version"),
  505:     }
  506:     if include_payload_hash:
  507:         document["raw_payload_hash"] = raw_payload_hash(event.raw_payload)
  508:     return document
  509: 
  510: 
  511: def _uses_stable_native_id(event: NativeAgentEvent) -> bool:
  512:     return bool(_optional(event.native_event_id) and event.native_event_id_stable)
  513: 
  514: 
  515: def _validate(event: NativeAgentEvent, max_payload_bytes: int) -> None:
  516:     if not isinstance(event, NativeAgentEvent) or not isinstance(event.raw_payload, Mapping):
  517:         raise RawIngressError("event must be NativeAgentEvent with object raw_payload")
  518:     if event.native_id_scope not in {"provider", "adapter", "session", "project"}:
  519:         raise RawIngressError("unsupported native_id_scope")
  520:     _identity_document(event, include_payload_hash=True)
  521:     if len(canonical_json(event.raw_payload)) > max_payload_bytes:
  522:         raise RawIngressError("raw payload exceeds configured size limit")
  523: 
  524: 
  525: def _normalise_json(value: Any) -> Any:
  526:     if value is None or isinstance(value, (bool, int, float)):
  527:         return value
  528:     if isinstance(value, str):
  529:         return unicodedata.normalize("NFC", value)
  530:     if isinstance(value, Mapping):
  531:         normalised: dict[str, Any] = {}
  532:         for key, item in value.items():
  533:             if not isinstance(key, str):
  534:                 raise RawIngressError("JSON object keys must be strings")
  535:             normalised_key = unicodedata.normalize("NFC", key)
  536:             if normalised_key in normalised:
  537:                 raise RawIngressError("duplicate JSON key after NFC normalisation")
  538:             normalised[normalised_key] = _normalise_json(item)
  539:         return normalised
  540:     if isinstance(value, (list, tuple)):
  541:         return [_normalise_json(item) for item in value]
  542:     raise RawIngressError(f"not JSON serializable: {type(value).__name__}")
  543: 
  544: 
  545: def _text(value: str, name: str) -> str:
  546:     if not isinstance(value, str) or not value.strip():
  547:         raise RawIngressError(f"{name} must be a non-empty string")
  548:     return unicodedata.normalize("NFC", value).strip()
  549: 
  550: 
  551: def _optional(value: str | None) -> str | None:
  552:     return unicodedata.normalize("NFC", value).strip() or None if isinstance(value, str) else None
  553: 
  554: 
  555: def _pid_alive(pid: int) -> bool:
  556:     try:
  557:         os.kill(pid, 0)
  558:     except ProcessLookupError:
  559:         return False
  560:     except PermissionError:
  561:         return True
  562:     except OSError:
  563:         # Windows does not consistently map a non-existent PID to
  564:         # ProcessLookupError (for example WinError 11).  A recovery helper
  565:         # must treat that as dead rather than crash while assessing a stale
  566:         # lease.  PermissionError above remains the conservative live case.
  567:         return False
  568:     return True
  569: 
  570: 
  571: def _fsync_directory(path: Path) -> None:
  572:     if os.name == "nt":
  573:         return
  574:     descriptor = os.open(str(path), os.O_RDONLY)
  575:     try:
  576:         os.fsync(descriptor)
  577:     finally:
  578:         os.close(descriptor)

===== tools/pf_runtime/codex_integration.py =====
    1: """Opt-in installer/status/remover for project-local ProcessForge Codex hooks.
    2: 
    3: It deliberately manages only ``<project>/.codex/hooks.json``.  Codex host MCP
    4: configuration belongs to the user's Codex configuration and is documented,
    5: not silently edited by this project utility.
    6: """
    7: 
    8: from __future__ import annotations
    9: 
   10: import argparse
   11: import json
   12: import shutil
   13: from datetime import datetime, timezone
   14: from pathlib import Path
   15: from typing import Any
   16: 
   17: 
   18: EVENTS = ("SessionStart", "SessionEnd", "PostToolUse", "UserPromptSubmit", "PreCompact", "PostCompact", "Stop", "SubagentStop")
   19: 
   20: 
   21: def hook_command(adapter: Path) -> str:
   22:     # Codex runs hook commands with the session cwd, so use an absolute path.
   23:     return f'py -3 "{adapter}"'
   24: 
   25: 
   26: def managed_handler(adapter: Path, event: str) -> dict[str, Any]:
   27:     command = hook_command(adapter)
   28:     handler: dict[str, Any] = {"type": "command", "command": command, "commandWindows": command, "timeout": 3, "statusMessage": "Recording ProcessForge session facts"}
   29:     # Observation must not hold up high-frequency tool calls. Codex keeps
   30:     # SessionEnd synchronous by contract, so do not claim otherwise there.
   31:     if event != "SessionEnd":
   32:         handler["async"] = True
   33:     return handler
   34: 
   35: 
   36: def load_config(path: Path) -> dict[str, Any]:
   37:     if not path.is_file():
   38:         return {"description": "ProcessForge Codex observation hooks", "hooks": {}}
   39:     try:
   40:         value = json.loads(path.read_text(encoding="utf-8"))
   41:     except json.JSONDecodeError as exc:
   42:         raise SystemExit("FAIL: existing hooks.json is not valid JSON; no changes were made") from exc
   43:     if not isinstance(value, dict) or not isinstance(value.get("hooks", {}), dict):
   44:         raise SystemExit("FAIL: existing hooks.json has no object hooks field; no changes were made")
   45:     value.setdefault("hooks", {})
   46:     return value
   47: 
   48: 
   49: def is_managed(handler: Any, adapter: Path) -> bool:
   50:     return isinstance(handler, dict) and str(handler.get("commandWindows") or "") == hook_command(adapter)
   51: 
   52: 
   53: def install_payload(current: dict[str, Any], adapter: Path) -> tuple[dict[str, Any], list[str]]:
   54:     result = json.loads(json.dumps(current))
   55:     hooks = result.setdefault("hooks", {})
   56:     changed: list[str] = []
   57:     for event in EVENTS:
   58:         groups = hooks.setdefault(event, [])
   59:         if not isinstance(groups, list):
   60:             raise SystemExit(f"FAIL: hooks.{event} is not an array; no changes were made")
   61:         matching = next((group for group in groups if isinstance(group, dict) and str(group.get("matcher") or "") == ""), None)
   62:         if matching is None:
   63:             matching = {"hooks": []}
   64:             groups.append(matching)
   65:         handlers = matching.setdefault("hooks", [])
   66:         if not isinstance(handlers, list):
   67:             raise SystemExit(f"FAIL: hooks.{event}.hooks is not an array; no changes were made")
   68:         if not any(is_managed(item, adapter) for item in handlers):
   69:             handlers.append(managed_handler(adapter, event))
   70:             changed.append(event)
   71:     return result, changed
   72: 
   73: 
   74: def remove_payload(current: dict[str, Any], adapter: Path) -> tuple[dict[str, Any], list[str]]:
   75:     result = json.loads(json.dumps(current))
   76:     hooks = result.get("hooks") if isinstance(result.get("hooks"), dict) else {}
   77:     changed: list[str] = []
   78:     for event in list(hooks):
   79:         groups = hooks[event]
   80:         if not isinstance(groups, list):
   81:             continue
   82:         retained_groups: list[Any] = []
   83:         for group in groups:
   84:             if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
   85:                 retained_groups.append(group)
   86:                 continue
   87:             handlers = [item for item in group["hooks"] if not is_managed(item, adapter)]
   88:             if len(handlers) != len(group["hooks"]):
   89:                 changed.append(event)
   90:             if handlers:
   91:                 retained_groups.append({**group, "hooks": handlers})
   92:         if retained_groups:
   93:             hooks[event] = retained_groups
   94:         else:
   95:             hooks.pop(event, None)
   96:     return result, sorted(set(changed))
   97: 
   98: 
   99: def write_atomic(path: Path, payload: dict[str, Any]) -> Path:
  100:     path.parent.mkdir(parents=True, exist_ok=True)
  101:     backup = path.with_name(path.name + ".pf-backup-" + datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f"))
  102:     if path.exists():
  103:         shutil.copy2(path, backup)
  104:     temporary = path.with_suffix(path.suffix + ".tmp")
  105:     temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
  106:     temporary.replace(path)
  107:     return backup if backup.exists() else Path()
  108: 
  109: 
  110: def main() -> int:
  111:     parser = argparse.ArgumentParser(description=__doc__)
  112:     parser.add_argument("action", choices=("status", "install", "remove"))
  113:     parser.add_argument("--project-root", required=True)
  114:     parser.add_argument("--adapter", default=str(Path(__file__).with_name("codex_hooks.py").resolve()))
  115:     parser.add_argument("--apply", action="store_true", help="write the project-local hooks.json; otherwise show a dry run")
  116:     args = parser.parse_args()
  117:     project = Path(args.project_root).expanduser().resolve()
  118:     target = project / ".codex" / "hooks.json"
  119:     adapter = Path(args.adapter).expanduser().resolve()
  120:     if not adapter.is_file():
  121:         raise SystemExit("FAIL: adapter path does not exist")
  122:     current = load_config(target)
  123:     if args.action == "status":
  124:         installed = [event for event, groups in current.get("hooks", {}).items() if isinstance(groups, list) and any(isinstance(group, dict) and any(is_managed(item, adapter) for item in group.get("hooks", []) if isinstance(group.get("hooks", []), list)) for group in groups)]
  125:         print(json.dumps({"status": "ok", "target": str(target), "adapter": str(adapter), "registered_events": sorted(installed), "complete": set(installed) == set(EVENTS)}, ensure_ascii=False))
  126:         return 0
  127:     payload, changed = install_payload(current, adapter) if args.action == "install" else remove_payload(current, adapter)
  128:     result: dict[str, Any] = {"action": args.action, "target": str(target), "adapter": str(adapter), "changed_events": changed, "applied": bool(args.apply)}
  129:     if args.apply and changed:
  130:         backup = write_atomic(target, payload)
  131:         result["backup"] = str(backup) if backup else None
  132:     print(json.dumps(result, ensure_ascii=False))
  133:     return 0
  134: 
  135: 
  136: if __name__ == "__main__":
  137:     raise SystemExit(main())

