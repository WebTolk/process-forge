22682: def load_yaml_or_json_document(path: Path) -> dict[str, Any]:
22683:     if path.suffix.lower() == ".json":
22684:         try:
22685:             data = json.loads(path.read_text(encoding="utf-8"))
22686:         except (OSError, json.JSONDecodeError):
22687:             return {}
22688:         return data if isinstance(data, dict) else {}
22689:     return load_update_yaml(path)
22690: 
22691: 
22692: def load_yaml_or_json_text(text: str) -> dict[str, Any]:
22693:     try:
22694:         data = json.loads(text)
22695:         return data if isinstance(data, dict) else {}
22696:     except json.JSONDecodeError:
22697:         pass
22698:     try:
22699:         import yaml  # type: ignore
22700: 
22701:         data = yaml.safe_load(text)
22702:     except Exception:
22703:         return {}
22704:     return data if isinstance(data, dict) else {}
