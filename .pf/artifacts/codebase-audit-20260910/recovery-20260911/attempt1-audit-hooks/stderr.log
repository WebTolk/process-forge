21820: def append_update_source_checks(
21821:     checks: list[Check],
21822:     source: Any,
21823:     label: str,
21824:     *,
21825:     provider_key: str,
21826:     defaults: dict[str, Any] | None = None,
21827:     require_subjects: bool = False,
21828:     require_priority: bool = False,
21829: ) -> None:
21830:     if not isinstance(source, dict):
21831:         checks.append(check("FAIL", f"{label} must be an object"))
21832:         return
21833: 
21834:     source_id = source.get("id")
21835:     if source_id is not None and (not isinstance(source_id, str) or not source_id.strip()):
21836:         checks.append(check("FAIL", f"{label} id must be a non-empty string when present"))
21837:     elif isinstance(source_id, str) and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", source_id):
21838:         checks.append(check("FAIL", f"{label} id must use letters, digits, dot, underscore, or hyphen"))
21839: 
21840:     enabled = source.get("enabled")
21841:     if enabled is not None and not isinstance(enabled, bool):
21842:         checks.append(check("FAIL", f"{label} enabled must be a boolean when present"))
21843: 
21844:     provider = source.get(provider_key)
21845:     if not provider:
21846:         provider = source.get("provider" if provider_key == "type" else "type")
21847:     if provider is not None and (not isinstance(provider, str) or not provider.strip()):
21848:         checks.append(check("FAIL", f"{label} {provider_key} must be a non-empty string when present"))
21849: 
21850:     if "url" in source:
21851:         checks.append(check("FAIL", f"{label} uses unsupported url field; use manifest_url"))
21852: 
21853:     if "priority" not in source:
21854:         if require_priority:
21855:             checks.append(check("FAIL", f"{label} missing priority"))
21856:     elif not isinstance(source.get("priority"), int):
21857:         checks.append(check("FAIL", f"{label} priority must be an integer"))
21858: 
21859:     channels = source.get("channels")
21860:     if channels is not None and (
21861:         not isinstance(channels, list) or not all(isinstance(item, str) and item.strip() for item in channels)
21862:     ):
21863:         checks.append(check("FAIL", f"{label} channels must be a list of non-empty strings"))
21864: 
21865:     if require_subjects:
21866:         subjects = source.get("subjects")
21867:         if not isinstance(subjects, list) or not subjects:
21868:             checks.append(check("FAIL", f"{label} missing subjects"))
21869:         else:
21870:             for index, subject in enumerate(subjects):
21871:                 subject_label = f"{label}.subjects[{index}]"
21872:                 if not isinstance(subject, dict):
21873:                     checks.append(check("FAIL", f"{subject_label} must be an object"))
21874:                     continue
21875:                 subject_type = subject.get("type")
21876:                 ids = subject.get("ids")
21877:                 if subject_type not in UPDATE_SUBJECT_TYPES:
21878:                     checks.append(check("FAIL", f"{subject_label}.type unsupported subject type {subject_type!r}"))
21879:                 if not isinstance(ids, list) or not all(isinstance(item, str) and item.strip() for item in ids):
21880:                     checks.append(check("FAIL", f"{subject_label}.ids must be a list of non-empty strings"))
21881: 
21882:     manifest_url = source.get("manifest_url")
21883:     if not isinstance(manifest_url, str) or not manifest_url.strip():
21884:         checks.append(check("FAIL", f"{label} missing manifest_url"))
21885:     else:
21886:         parsed = urlparse(manifest_url)
21887:         scheme = parsed.scheme.lower()
21888:         if scheme in {"http", "https"}:
21889:             valid, reason = valid_remote_url_shape(manifest_url, require_https=source_requires_https(source, defaults))
21890:             if not valid:
21891:                 checks.append(check("FAIL", f"{label} manifest_url {reason}"))
21892:         elif scheme == "file" or not scheme:
21893:             if CONTROL_CHAR_RE.search(manifest_url) or any(char.isspace() for char in manifest_url):
21894:                 checks.append(check("FAIL", f"{label} manifest_url must not contain whitespace or control characters"))
21895:             if scheme == "file" and not (parsed.path or parsed.netloc):
21896:                 checks.append(check("FAIL", f"{label} manifest_url file URL must include a path"))
21897:         else:
21898:             checks.append(check("FAIL", f"{label} manifest_url unsupported scheme {scheme!r}"))
21899: 
21900:     changelog_url = source.get("changelog_url")
21901:     if not isinstance(changelog_url, str) or not changelog_url.strip():
21902:         checks.append(check("FAIL", f"{label} missing changelog_url"))
21903: 
21904:     auth = source.get("auth")
21905:     if isinstance(auth, dict):
21906:         for key in auth:
21907:             if str(key).lower() in {"token", "password", "secret", "authorization", "api_key"}:
21908:                 checks.append(check("FAIL", f"{label} auth must not contain raw secret key {key!r}; use *_env or auth_ref"))
21909:     append_env_reference_checks(checks, source, label)
21910: 
21911: 
21912: def validate_update_source_registry_data(data: dict[str, Any], path: Path) -> list[Check]:
21913:     checks: list[Check] = []
21914:     if not data:
21915:         return [check("FAIL", f"{path} missing or invalid")]
21916:     if data.get("schema_version") != 1:
21917:         checks.append(check("FAIL", "update source registry schema_version must be 1"))
21918:     if data.get("product") != "processforge":
21919:         checks.append(check("FAIL", "update source registry product must be processforge"))
21920:     defaults = data.get("defaults") if isinstance(data.get("defaults"), dict) else {}
21921:     sources = data.get("sources")
21922:     if not isinstance(sources, list):
21923:         checks.append(check("FAIL", "update source registry sources must be a list"))
21924:         return checks
21925: 
21926:     seen: set[str] = set()
21927:     for index, source in enumerate(sources):
21928:         source_id = source.get("id") if isinstance(source, dict) else None
21929:         if isinstance(source_id, str):
21930:             if source_id in seen:
21931:                 checks.append(check("FAIL", f"sources[{index}] duplicate id {source_id}"))
21932:             seen.add(source_id)
21933:         append_update_source_checks(
21934:             checks,
21935:             source,
21936:             f"sources[{index}]",
21937:             provider_key="provider",
21938:             defaults=defaults,
21939:             require_subjects=False,
21940:             require_priority=False,
21941:         )
21942:     if not checks:
21943:         checks.append(check("PASS", f"{path} valid"))
21944:     return checks
21945: 
