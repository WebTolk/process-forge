  663: def command_status(args: argparse.Namespace, core: Any) -> int:
  664:     workplace_root = core.resolve_workplace_root(getattr(args, "workplace", None))
  665:     payload = status_payload(workplace_root, core)
  666:     if getattr(args, "json", False):
  667:         print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
  668:     else:
  669:         print(f"RUNTIME: {payload.get('status')} health={payload.get('health')} pid={payload.get('pid', '')} endpoint={payload.get('endpoint', '')}")
  670:         print(f"PROJECTS: {len(payload.get('known_projects', [])) if isinstance(payload.get('known_projects'), list) else 0}")
  671:         print(f"AGENT_SESSIONS: {payload.get('active_agent_sessions', 0)}")
  672:         print(f"ACTIVE_WORKERS: {payload.get('active_workers', 0)}")
  673:     return 0 if payload.get("status") not in {"failed"} else 1
  674: 
