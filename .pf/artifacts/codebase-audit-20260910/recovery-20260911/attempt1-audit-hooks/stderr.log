 6405: def forbidden_powershell_reference(text: str) -> bool:
 6406:     lower = text.lower()
 6407:     if ".ps1" in lower:
 6408:         return True
 6409:     for line in lower.splitlines():
 6410:         if "powershell" not in line:
 6411:             continue
 6412:         allowed = (
 6413:             "does not require powershell" in line
 6414:             or "powershell is not required" in line
 6415:             or "powershell not required" in line
 6416:             or line.strip() == "```powershell"
 6417:             or ("powershell" in line and "utf-8" in line)
 6418:             or ("powershell" in line and "console encoding" in line)
 6419:             or "не требует powershell" in line
 6420:             or ("powershell" in line and "не требуется" in line)
 6421:             or ("powershell" in line and "не нужен" in line)
 6422:         )
 6423:         if not allowed:
 6424:             return True
 6425:     return False
