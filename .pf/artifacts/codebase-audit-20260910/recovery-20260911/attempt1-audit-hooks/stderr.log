21548: def update_source_kind(source: dict[str, Any]) -> str:
21549:     manifest_url = update_location(source, "provider")
21550:     parsed = urlparse(manifest_url)
21551:     scheme = parsed.scheme.lower()
21552:     if scheme == "file" or not scheme:
21553:         return "local_file"
21554:     if scheme in {"http", "https"}:
21555:         return "http"
21556:     return scheme or "unknown"
21557: 
21558: 
21559: def update_site_source_id(source: dict[str, Any]) -> str:
21560:     raw = source.get("id")
21561:     if isinstance(raw, str) and raw.strip():
21562:         return raw
21563:     manifest_url = update_location(source, "provider")
21564:     digest = hashlib.sha256(manifest_url.encode("utf-8")).hexdigest()[:12] if manifest_url else "missing"
21565:     return f"manifest-{digest}"
