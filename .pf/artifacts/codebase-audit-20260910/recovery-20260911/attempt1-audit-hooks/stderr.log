 1314: def command_projection_doctor(args: argparse.Namespace, core: Any) -> int:
 1315:     project_roots = [resolve_project(value, core) for value in getattr(args, "project_root", [])]
 1316:     checks: list[Any] = []
 1317:     for project_root in project_roots:
 1318:         payload = stage_obligations_payload(project_root, core)
 1319:         label = core.project_id(project_root)
 1320:         rows = payload.get("obligations") if isinstance(payload.get("obligations"), list) else []
 1321:         failed_verification = next((row for row in rows if isinstance(row, dict) and isinstance(row.get("verification"), dict) and str(row["verification"].get("result") or "") != "passed"), None)
 1322:         if failed_verification is not None:
 1323:             checks.append(core.check("FAIL", f"{label} verification obligation is {failed_verification['verification'].get('result')}"))
 1324:         elif payload["status"] == "current":
 1325:             checks.append(core.check("PASS", f"{label} stage obligations projection is current"))
 1326:         elif payload["status"] == "missing":
 1327:             checks.append(core.check("FAIL", f"{label} stage obligations projection has missing required output"))
 1328:         elif payload["status"] == "stale":
 1329:             checks.append(core.check("FAIL", f"{label} stage obligations projection is stale"))
 1330:         else:
 1331:             checks.append(core.check("FAIL", f"{label} stage obligations projection is invalid"))
 1332:     return core.print_checks(checks)

