22367: def print_derived_update_sites(data: dict[str, Any], *, subject_type: str = "all", json_output: bool = False) -> int:
22368:     sites = data.get("sites") if isinstance(data.get("sites"), list) else []
22369:     if subject_type != "all":
22370:         sites = [site for site in sites if isinstance(site, dict) and site.get("subject", {}).get("type") == subject_type]
22371:     if json_output:
22372:         print(json.dumps({"schema_version": 1, "sites": sites}, ensure_ascii=False, indent=2, sort_keys=True))
22373:         return 0
22374:     print("SITE_ID\tENABLED\tSUBJECT_TYPE\tSUBJECT_ID\tSOURCE_TYPE\tLOCATION\tMANIFEST")
22375:     for site in sites:
22376:         if not isinstance(site, dict):
22377:             continue
22378:         subject = site.get("subject") if isinstance(site.get("subject"), dict) else {}
22379:         source = site.get("source") if isinstance(site.get("source"), dict) else {}
22380:         print(
22381:             "\t".join(
22382:                 [
22383:                     str(site.get("site_id", "")),
22384:                     str(bool(site.get("enabled", False))).lower(),
22385:                     str(subject.get("type", "")),
22386:                     str(subject.get("id", "")),
22387:                     str(source.get("type", "")),
22388:                     update_location(source, "type"),
22389:                     str(site.get("manifest_path", "")),
22390:                 ]
22391:             )
22392:         )
22393:     return 0
