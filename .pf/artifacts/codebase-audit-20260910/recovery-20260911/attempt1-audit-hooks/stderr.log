24801:                     "This platform contract recommends the template, but onboarding can continue without it.",
24802:                     f"python bin/pf.py template-create --workplace <workplace-root> --id {template_id} --title \"{template_id}\" --apply",
24803:                 )
24804:             )
24805:         for forbidden in ["package.yaml", "template.yaml"]:
24806:             copied = [path for path in contract_path.parent.rglob(forbidden) if path != contract_path]
24807:             checks.append(check("PASS" if not copied else "FAIL", f"no copied {forbidden} inside platform contract"))
24808:     return print_checks(checks)
