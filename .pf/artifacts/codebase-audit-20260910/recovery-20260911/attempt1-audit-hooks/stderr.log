 5159: def build_project_files(project_root: Path, workplace_manifest: Path, answers: dict[str, Any]) -> dict[Path, str]:
 5160:     flow_root = project_root / PROJECT_FLOW_ROOT
 5161:     detected = detect_project(project_root, workplace_manifest)
 5162:     defaults = project_defaults(project_root, answers, detected)
 5163:     detected["platforms"] = selected_project_platforms(detected, answers, defaults["type"], workplace_manifest, project_root)
 5164:     mode = project_mode(project_root, answers)
 5165:     coordination_answers = answers.get("coordination", {}) if isinstance(answers.get("coordination"), dict) else {}
 5166:     project_coordination = default_project_coordination(coordination_answers.get("mode", "inherit"))
 5167:     if isinstance(coordination_answers.get("director"), dict):
 5168:         project_coordination["director"].update(coordination_answers["director"])
 5169:     required = answers.get("required_capabilities") if isinstance(answers.get("required_capabilities"), list) else []
 5170:     optional = answers.get("optional_capabilities") if isinstance(answers.get("optional_capabilities"), list) else []
 5171:     required = [str(item) for item in required if str(item)]
 5172:     optional = [str(item) for item in optional if str(item)]
 5173:     platform_resolution = resolve_platform_contracts(workplace_manifest, detected["platforms"], project_root=project_root)
 5174:     required_platform_missing, recommended_platform_missing = platform_resource_findings(workplace_manifest, platform_resolution)
 5175:     required = sorted(set(required).union(platform_resolution["required_capabilities"]))
 5176:     matches = match_global_resources(workplace_manifest, detected, required, optional)
 5177:     knowledge_stack = [
 5178:         {"id": "processforge.core", "version": "^1.0", "source": "distribution", "distribution": "processforge"},
 5179:     ]
 5180:     for package_id in platform_resolution["knowledge_packages"]:
 5181:         knowledge_stack.append(
 5182:             {
 5183:                 "id": package_id,
 5184:                 "version": "*",
 5185:                 "source": "workplace",
 5186:                 "registry": "package_roots",
 5187:                 "load_policy": "on_demand",
 5188:                 "required_by": sorted(
 5189:                     item["id"]
 5190:                     for item in platform_resolution["contracts"]
 5191:                     if package_id in item.get("required", {}).get("knowledge_packages", [])
 5192:                     or package_id in item.get("recommended", {}).get("knowledge_packages", [])
 5193:                 ),
 5194:             }
 5195:         )
 5196:     knowledge_stack.append({"id": f"project.{defaults['id']}", "version": "1.0.0", "source": "project"})
 5197:     answered_requirements = answers.get("context_requirements") if isinstance(answers.get("context_requirements"), dict) else {}
 5198:     context_requirements = answered_requirements or {
 5199:         "knowledge_packages": [
 5200:             {"id": "processforge.core", "constraint": "^1.0", "required": True},
 5201:             *[
 5202:                 {"id": package_id, "constraint": "*", "required": package_id in platform_resolution["required_knowledge_packages"]}
 5203:                 for package_id in sorted(set(platform_resolution["knowledge_packages"]))
 5204:             ],
 5205:             {"id": f"project.{defaults['id']}", "constraint": "1.0.0", "required": True},
 5206:         ],
 5207:         "knowledge_resources": [],
 5208:         "template_packages": [],
 5209:         "templates": [{"id": item, "required": item in platform_resolution["required_templates"]} for item in sorted(set(platform_resolution["required_templates"] + platform_resolution["recommended_templates"]))],
 5210:         "tools": [{"id": item, "required": item in platform_resolution["required_tools"]} for item in sorted(set(platform_resolution["required_tools"] + platform_resolution["recommended_tools"]))],
 5211:         "platform_contracts": [{"id": item, "required": True} for item in sorted(set(detected["platforms"]))],
 5212:     }
 5213:     context_policy = answers.get("context_policy") if isinstance(answers.get("context_policy"), dict) else default_context_policy({})
 5214:     project_parameters = answers.get("parameters") if isinstance(answers.get("parameters"), dict) else {}
