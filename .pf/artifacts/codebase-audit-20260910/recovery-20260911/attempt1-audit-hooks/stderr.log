 4944: def resolve_specialization_context(
 4945:     project_root: Path,
 4946:     workplace_manifest: Path | None,
 4947:     *,
 4948:     platform_ids: list[str],
 4949:     process_id: str | None = None,
 4950:     specialization_ids: list[str] | None = None,
 4951:     platform_resolution: dict[str, Any] | None = None,
 4952: ) -> dict[str, Any]:
 4953:     selected_ids = [specialization_resource_id(item) for item in (specialization_ids or [])]
 4954:     platform_resolution = platform_resolution or resolve_platform_contracts(workplace_manifest, platform_ids, project_root=project_root)
 4955:     required = {
 4956:         "knowledge_packages": set(platform_resolution.get("required_knowledge_packages", [])),
 4957:         "tools": set(platform_resolution.get("required_tools", [])),
 4958:         "mcp": set(platform_resolution.get("required_mcp", [])),
 4959:         "templates": set(platform_resolution.get("required_templates", [])),
 4960:     }
 4961:     recommended = {
 4962:         "knowledge_packages": set(platform_resolution.get("recommended_knowledge_packages", [])),
 4963:         "tools": set(platform_resolution.get("recommended_tools", [])),
 4964:         "mcp": set(platform_resolution.get("recommended_mcp", [])),
 4965:         "templates": set(platform_resolution.get("recommended_templates", [])),
 4966:     }
 4967:     optional = {key: set() for key in RESOURCE_GROUP_KEYS}
 4968:     excluded = {key: set() for key in RESOURCE_GROUP_KEYS}
 4969:     reasons: list[dict[str, Any]] = []
 4970:     conflicts: list[dict[str, Any]] = []
 4971:     selected_specializations: list[dict[str, Any]] = []
 4972:     provided_capabilities: set[str] = set()
 4973:     capability_providers: dict[str, list[dict[str, Any]]] = {}
 4974:     for _manifest_path, pack_manifest in active_official_pack_records(workplace_manifest):
 4975:         pack_id = str(pack_manifest.get("id") or "")
 4976:         provided = pack_manifest.get("provides") if isinstance(pack_manifest.get("provides"), dict) else {}
 4977:         knowledge_packages = {
 4978:             str(item)
 4979:             for item in as_list(provided.get("knowledge_packages"))
 4980:             if str(item)
 4981:         }
 4982:         if knowledge_packages:
 4983:             optional["knowledge_packages"].update(knowledge_packages)
 4984:             reasons.append(
 4985:                 {
 4986:                     "source": pack_id,
 4987:                     "reason": "active official process pack knowledge packages merged",
 4988:                 }
 4989:             )
 4990:     index = specialization_manifest_index(workplace_manifest, project_root)
 4991:     for specialization_id in selected_ids:
 4992:         spec = index.get(specialization_id)
 4993:         if not spec:
 4994:             conflicts.append({"id": specialization_id, "kind": "specialization", "reason": "specialization not found"})
 4995:             continue
 4996:         specialization_overrides = project_specialization_override_entries(project_root, specialization_id)
 4997:         for override_entry in specialization_overrides:
 4998:             mode = str(override_entry.get("mode") or "extension")
 4999:             if mode not in PROJECT_OVERRIDE_MODES:
 5000:                 conflicts.append({"id": specialization_id, "kind": "specialization", "reason": f"unsupported project override mode: {mode}"})
 5001:                 continue
 5002:             overlay = load_project_override_document(project_root, override_entry)
 5003:             if overlay:
 5004:                 spec, overlay_notes = apply_specialization_overlay(spec, overlay, mode)
 5005:                 for note in overlay_notes:
 5006:                     reasons.append({"source": "project_override", "target": specialization_id, "reason": note})
 5007:         resources = default_resource_buckets()
 5008:         merge_resource_buckets(resources, spec.get("resources") if isinstance(spec.get("resources"), dict) else {})
 5009:         spec_capabilities = set(str(item) for item in as_list(spec.get("provides_capabilities")) if str(item))
 5010:         matched_bindings: list[dict[str, Any]] = []
 5011:         for binding in spec.get("platform_bindings", []) if isinstance(spec.get("platform_bindings"), list) else []:
 5012:             if isinstance(binding, dict) and platform_binding_matches(binding, platform_ids, platform_resolution.get("platform_stack", []), process_id):
 5013:                 matched_bindings.append(binding)
 5014:                 merge_resource_buckets(resources, binding.get("resources") if isinstance(binding.get("resources"), dict) else {})
 5015:                 spec_capabilities.update(str(item) for item in as_list(binding.get("provides_capabilities")) if str(item))
 5016:         for key in RESOURCE_GROUP_KEYS:
 5017:             required[key].update(resources["requires"][key])
 5018:             recommended[key].update(resources["recommends"][key])
 5019:             optional[key].update(resources["optional"][key])
 5020:             excluded[key].update(resources["excludes"][key])
 5021:         provided_capabilities.update(spec_capabilities)
 5022:         provider = resource_profile_capability_provider(specialization_id, resources)
 5023:         for capability in spec_capabilities:
 5024:             capability_providers.setdefault(capability, []).append(dict(provider))
 5025:         selected_specializations.append(
 5026:             {
 5027:                 "id": specialization_id,
 5028:                 "source": str(spec.get("__source") or "workplace"),
 5029:                 # A selected workplace specialization is a private resolution
 5030:                 # input.  Its absolute manifest path must never escape into a
 5031:                 # public project-context snapshot; Runtime resolves it again
 5032:                 # through the authorized workplace registry when needed.
 5033:                 "path": rel(spec.get("__manifest_path"), project_root)
 5034:                 if isinstance(spec.get("__manifest_path"), Path) and path_is_relative_to(spec["__manifest_path"], project_root)
 5035:                 else "<private-specialization-ref>",
 5036:                 "matched_bindings": [
 5037:                     {
 5038:                         "platforms": list_value(binding.get("platforms")),
 5039:                         "platform_stack_includes": list_value(binding.get("platform_stack_includes")),
 5040:                     }
 5041:                     for binding in matched_bindings
 5042:                 ],
 5043:                 "provides_capabilities": dedupe_sorted(list(spec_capabilities)),
 5044:                 "sha256": sha256_optional_file(spec.get("__manifest_path") if isinstance(spec.get("__manifest_path"), Path) else None),
 5045:             }
 5046:         )
 5047:         reasons.append({"source": specialization_id, "reason": "selected specialization resources merged"})
 5048:     applied_overrides: list[dict[str, Any]] = []
 5049:     for entry in project_override_entries(project_root):
 5050:         kind = str(entry.get("kind") or "")
 5051:         target = str(entry.get("target") or "")
 5052:         mode = str(entry.get("mode") or "extension")
 5053:         if mode not in PROJECT_OVERRIDE_MODES:
 5054:             conflicts.append({"id": target, "kind": kind, "reason": f"unsupported project override mode: {mode}"})
 5055:             continue
 5056:         base_path = None
 5057:         if kind == "specializations":
 5058:             spec = index.get(specialization_resource_id(target))
 5059:             base_path = spec.get("__manifest_path") if isinstance(spec, dict) and isinstance(spec.get("__manifest_path"), Path) else None
 5060:         applied = resolved_override_record(project_root, entry, base_path)
 5061:         applied_overrides.append(applied)
 5062:         if kind in RESOURCE_GROUP_KEYS:
 5063:             if mode == "disable":
 5064:                 excluded[kind].add(target)
 5065:                 reasons.append({"source": "project_override", "target": target, "reason": f"{kind} disabled"})
 5066:             elif mode in {"extension", "parameterize", "overlay", "replace", "fork"}:
 5067:                 bucket = "required" if entry.get("required") is True else "recommended"
 5068:                 (required if bucket == "required" else recommended)[kind].add(str(entry.get("project_package") or target))
 5069:                 reasons.append({"source": "project_override", "target": target, "reason": f"{kind} {mode} applied"})
 5070:         elif kind == "specializations":
 5071:             reasons.append({"source": "project_override", "target": target, "reason": f"specialization {mode} recorded"})
 5072:     activated = {}
 5073:     for key in RESOURCE_GROUP_KEYS:
 5074:         recommended[key] -= required[key]
 5075:         activated_set = required[key].union(recommended[key]).union(optional[key])
 5076:         activated[key] = apply_resource_excludes(required[key], activated_set, excluded[key], conflicts, "project/specialization", key)
 5077:     registry_capabilities, registry_providers = active_registry_capability_providers(workplace_manifest, activated)
 5078:     provided_capabilities.update(registry_capabilities)
 5079:     for capability, providers in registry_providers.items():
 5080:         capability_providers.setdefault(capability, []).extend(providers)
 5081:     effective_fingerprints = {f"{item['kind']}:{item['target']}": item["effective_fingerprint"] for item in applied_overrides}
 5082:     execution_route, route_conflicts = build_execution_route(project_root, process_id)
 5083:     conflicts.extend(route_conflicts)
 5084:     capability_resolution = build_capability_resolution(execution_route, provided_capabilities, capability_providers, activated)
 5085:     for item in capability_resolution["unsatisfied"]:
 5086:         conflicts.append({"id": item["capability"], "kind": "capability", "source": item["required_by"], "reason": item["reason"]})
 5087:     active_resource_profile = {
 5088:         "selected_platform": [platform_contract_id(item) for item in platform_ids],
 5089:         "platform_stack": platform_resolution.get("platform_stack", []),
 5090:         "selected_specializations": selected_specializations,
 5091:         "available_knowledge_packages": dedupe_sorted(list(required["knowledge_packages"].union(recommended["knowledge_packages"]).union(optional["knowledge_packages"]))),
 5092:         "activated_knowledge_packages": dedupe_sorted(list(activated["knowledge_packages"])),
 5093:         "excluded_knowledge_packages": dedupe_sorted(list(excluded["knowledge_packages"])),
 5094:         "available_tools": dedupe_sorted(list(required["tools"].union(recommended["tools"]).union(optional["tools"]))),
 5095:         "activated_tools": dedupe_sorted(list(activated["tools"])),
 5096:         "excluded_tools": dedupe_sorted(list(excluded["tools"])),
 5097:         "available_mcp": dedupe_sorted(list(required["mcp"].union(recommended["mcp"]).union(optional["mcp"]))),
 5098:         "activated_mcp": dedupe_sorted(list(activated["mcp"])),
 5099:         "excluded_mcp": dedupe_sorted(list(excluded["mcp"])),
 5100:         "activated_templates": dedupe_sorted(list(activated["templates"])),
 5101:         "excluded_templates": dedupe_sorted(list(excluded["templates"])),
 5102:         "provided_capabilities": dedupe_sorted(list(provided_capabilities)),
 5103:         "applied_project_overrides": applied_overrides,
 5104:         "effective_resources": [
 5105:             {"kind": key, "id": item, "status": "activated"}
 5106:             for key in RESOURCE_GROUP_KEYS
 5107:             for item in dedupe_sorted(list(activated[key]))
 5108:         ],
 5109:         "effective_fingerprints": effective_fingerprints,
 5110:         "resolution_reasons": reasons,
 5111:         "conflicts": conflicts,
 5112:     }
 5113:     resolution_status = "needs_resources" if capability_resolution["unsatisfied"] else ("conflict" if conflicts else "resolved")
 5114:     return {
 5115:         **active_resource_profile,
 5116:         "status": resolution_status,
 5117:         "process": process_id or "",
 5118:         "active_resource_profile": active_resource_profile,
 5119:         "execution_route": execution_route,
 5120:         "capability_resolution": capability_resolution,
 5121:         "provided_capabilities": active_resource_profile["provided_capabilities"],
 5122:     }
 5123: 
 5124: 
 5125: def optional_platform_resource_warnings(workplace_manifest: Path | None, resolved: dict[str, Any], package_index_ids: set[str] | None = None) -> list[dict[str, Any]]:
 5126:     _required_missing, recommended_missing = platform_resource_findings(workplace_manifest, resolved, package_index_ids)
 5127:     return recommended_missing
 5128: 
 5129: 
 5130: def match_global_resources(workplace_manifest: Path, detected: dict[str, Any], required: list[str], optional: list[str]) -> dict[str, list[str]]:
 5131:     tools_text = registry_text(workplace_manifest, "tools.yaml")
 5132:     mcp_text = registry_text(workplace_manifest, "mcp.yaml")
 5133:     templates_text = registry_text(workplace_manifest, "templates.yaml")
 5134:     package_text = registry_text(workplace_manifest, "package-roots.yaml")
 5135: 
 5136:     available_platform_ids = set(platform_contract_manifest_index(workplace_manifest))
 5137:     available_platform_ids.update(item.removeprefix("platform.") for item in list(available_platform_ids))
 5138:     matched_platforms = [item for item in detected["platforms"] if item and (item in available_platform_ids or platform_contract_id(item) in available_platform_ids)]
 5139:     missing_platforms = [item for item in detected["platforms"] if item and item not in matched_platforms]
 5140:     matched_tools = [cap for cap in required + optional if cap and cap in tools_text]
 5141:     matched_mcp = [cap for cap in required + optional if cap and cap in mcp_text]
 5142:     missing_required = [cap for cap in required if cap not in tools_text and cap not in mcp_text]
 5143:     optional_missing = [cap for cap in optional if cap not in tools_text and cap not in mcp_text]
 5144:     matched_templates = ["template roots configured"] if "template_roots:" in templates_text and "[]" not in templates_text else []
 5145:     matched_packages = ["package roots configured"] if "package_roots:" in package_text and "[]" not in package_text else []
 5146:     return {
 5147:         "matched_platforms": matched_platforms,
 5148:         "missing_platforms": missing_platforms,
 5149:         "matched_packages": matched_packages,
 5150:         "matched_tools": matched_tools,
 5151:         "matched_mcp": matched_mcp,
 5152:         "matched_templates": matched_templates,
 5153:         "missing_required": missing_required,
 5154:         "optional_missing": optional_missing,
 5155:         "conflicts": [],
 5156:     }
 5157: 
