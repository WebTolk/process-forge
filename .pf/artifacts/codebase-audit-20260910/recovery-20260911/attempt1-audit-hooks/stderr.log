23507: def local_search_runtime_snapshot(project_root: Path, workplace_root: Path) -> tuple[dict[str, Any], dict[str, Any]]:
23508:     from processforge_core.garage import snapshot_with_resolved_search_roots
23509: 
23510:     context = project_context_check_result(project_root, explicit_workplace=str(workplace_root))
23511:     snapshot_path, _snapshot_md = project_context_snapshot_paths(project_root)
23512:     snapshot = load_yaml_document(snapshot_path) if snapshot_path.is_file() else {}
23513:     runtime_snapshot = snapshot_with_resolved_search_roots(
23514:         project_root,
23515:         snapshot if isinstance(snapshot, dict) else {},
23516:         workplace_root,
23517:         sys.modules[__name__],
23518:     )
23519:     return context, runtime_snapshot
