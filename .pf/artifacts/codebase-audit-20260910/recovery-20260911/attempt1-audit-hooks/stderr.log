22396: def command_update_entity_sources_rebuild(args: argparse.Namespace) -> int:
22397:     workplace_root = update_workplace_root(args.workplace)
22398:     derived, checks = build_installed_update_sites(workplace_root)
22399:     failures = [item for item in checks if item.level == "FAIL"]
22400:     if failures:
22401:         print_checks(checks)
22402:         return 1
22403:     target = derived_installed_update_sites_path(workplace_root)
22404:     if args.dry_run:
22405:         print(json.dumps(derived, ensure_ascii=False, indent=2, sort_keys=True))
22406:         return 0
22407:     target.parent.mkdir(parents=True, exist_ok=True)
22408:     target.write_text(json.dumps(derived, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
22409:     print(f"SITES: {len(derived['sites'])}")
22410:     print(f"TARGET: {rel(target, workplace_root)}")
22411:     return 0
