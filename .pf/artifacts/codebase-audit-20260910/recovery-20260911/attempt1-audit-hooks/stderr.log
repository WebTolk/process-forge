22534: def render_update_assessment(project_root: Path, current_version: str, channel: str, latest: dict[str, Any] | None) -> str:
22535:     available_version = str(latest.get("version", "none")) if latest else "none"
22536:     migration = latest.get("migration", {}) if latest and isinstance(latest.get("migration"), dict) else {}
22537:     changes = latest.get("changes", []) if latest and isinstance(latest.get("changes"), list) else []
22538:     affected = latest.get("affected_files", []) if latest and isinstance(latest.get("affected_files"), list) else []
22539: 
22540:     def lines(items: list[Any], empty: str = "None.") -> str:
22541:         if not items:
22542:             return f"- {empty}"
22543:         output = []
22544:         for item in items:
22545:             if isinstance(item, dict):
22546:                 output.append(f"- {item.get('type', 'change')}: {item.get('summary', item)}")
22547:             else:
22548:                 output.append(f"- {item}")
22549:         return "\n".join(output)
22550: 
22551:     result = "safe" if available_version in {"none", current_version} else ("requires_migration" if migration.get("required") else "requires_approval")
22552:     return f"""# ProcessForge Update Assessment
22553: 
22554: ## Status
22555: 
22556: {result}
22557: 
22558: ## Project
22559: 
22560: - root: {project_root.name}
22561: - current_version: {current_version}
22562: - available_version: {available_version}
22563: - channel: {channel}
22564: 
22565: ## Breaking Changes
22566: 
22567: {lines([item for item in changes if isinstance(item, dict) and item.get("breaking")], "None recorded.")}
22568: 
22569: ## Required Migrations
22570: 
22571: - required: {bool(migration.get("required", False))}
22572: - guide: {migration.get("guide", "none")}
22573: 
22574: ## Changes
22575: 
22576: {lines(changes)}
22577: 
22578: ## Affected Files
22579: 
22580: {lines(affected, "Review `.pf/process-forge.yaml`, `.pf/hooks.yaml`, and `.pf/contexts/project-context.snapshot.*`.")}
22581: 
22582: ## Required Manual Review
22583: 
22584: - Review migration guide before changing project files.
22585: - Confirm linked distribution registry points to the intended version.
22586: - Run public cleanliness, schema validation, checksum validation, and project doctor after migration.
22587: 
22588: ## Recommended Steps
22589: 
22590: 1. Read the migration guide.
22591: 2. Update the ProcessForge distribution outside the project.
22592: 3. Refresh project context.
22593: 4. Apply project migrations only with approval.
22594: 5. Re-run validation gates.
22595: 
22596: ## Rollback Notes
22597: 
22598: - Keep the previous ProcessForge distribution available in the workplace registry.
22599: - Repoint the workplace distributions registry to the previous version if migration is blocked.
22600: - Do not delete project `.pf/` artifacts created before the update until review passes.
22601: """
22602: 
