23812: def command_core_update_status(args: argparse.Namespace) -> int:
23813:     from processforge_core.core_update import CoreUpdateError, core_status
23814: 
23815:     try:
23816:         payload = core_status(Path(args.core_root).expanduser().resolve())
23817:     except CoreUpdateError as exc:
23818:         print(json.dumps({"error": {"code": exc.code, "message": exc.message}}, indent=2, sort_keys=True))
23819:         return 1
23820:     print(json.dumps(payload, indent=2, sort_keys=True))
23821:     return 0
