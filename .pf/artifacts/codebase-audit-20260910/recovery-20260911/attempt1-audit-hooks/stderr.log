 1158: def project_types_from_manifest(manifest_data: dict[str, Any]) -> list[str]:
 1159:     project = manifest_data.get("project") if isinstance(manifest_data.get("project"), dict) else {}
 1160:     raw_type = project.get("type") or project.get("types") or project.get("project_type")
 1161:     if isinstance(raw_type, str):
 1162:         return [safe_id(raw_type)]
 1163:     if isinstance(raw_type, list):
 1164:         return [safe_id(str(item)) for item in raw_type if item]
 1165:     return []
