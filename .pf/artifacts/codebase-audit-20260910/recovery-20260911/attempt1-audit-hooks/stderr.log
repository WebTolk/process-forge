23522: def workplace_search_package_manifest_index(workplace_root: Path) -> dict[str, dict[str, Any]]:
23523:     """Return one deterministic manifest record for every registered package.
23524: 
23525:     This deliberately starts at Workplace registries rather than a project
23526:     flow root.  Project manifests select resources at query time; they are not
23527:     an input to physical Workplace index maintenance.
23528:     """
23529: 
23530:     workplace_manifest = workplace_root / "workplace.yaml"
23531:     candidates: list[Path] = []
23532:     roots = workplace_package_roots(workplace_manifest)
23533:     if not roots:
23534:         roots = [resolve_package_root(workplace_root, None, mode="read")]
23535:     for root in roots:
23536:         if root.warnings or not root.resolved_path.is_dir():
23537:             continue
23538:         candidates.extend(sorted(root.resolved_path.glob("*.yaml")))
23539:         candidates.extend(sorted(root.resolved_path.glob("*.yml")))
23540:         candidates.extend(sorted(root.resolved_path.glob("*/package.yaml")))
23541:         candidates.extend(sorted(root.resolved_path.glob("*/package.yml")))
23542:     for process_pack_path, process_pack in active_official_pack_records(workplace_manifest):
23543:         provided = process_pack.get("provides") if isinstance(process_pack.get("provides"), dict) else {}
23544:         for package_id in as_list(provided.get("knowledge_packages")):
23545:             package_path = process_pack_path.parent / "knowledge-packages" / f"{package_id}.yaml"
23546:             if package_path.is_file():
23547:                 candidates.append(package_path)
23548:     index: dict[str, dict[str, Any]] = {}
23549:     for path in candidates:
23550:         data = load_yaml_document(path)
23551:         if not isinstance(data, dict) or yaml_error(data) or not data.get("id"):
23552:             continue
23553:         package_id = str(data["id"])
23554:         # The first registered manifest wins deterministically.  A duplicate
23555:         # does not create a second physical copy of a package's resources.
23556:         if package_id in index:
23557:             continue
23558:         record = dict(data)
23559:         record["__manifest_path"] = path
23560:         for root in roots:
23561:             try:
23562:                 path.relative_to(root.resolved_path)
23563:                 record["__package_root_id"] = root.root_id
23564:                 break
23565:             except ValueError:
23566:                 continue
23567:         index[package_id] = record
23568:     return index
23569: 
23570: 
23571: def workplace_search_runtime_snapshot(workplace_root: Path) -> dict[str, Any]:
23572:     """Resolve the source catalogue for the single Workplace search index."""
23573: 
23574:     from processforge_core.garage import snapshot_with_resolved_search_roots
23575: 
23576:     manifest = workplace_root / "workplace.yaml"
23577:     package_index = workplace_search_package_manifest_index(workplace_root)
23578:     resources: list[dict[str, Any]] = []
23579:     for package_id in sorted(package_index):
23580:         package = package_index[package_id]
23581:         for resource in package.get("resources", []) if isinstance(package.get("resources"), list) else []:
23582:             if isinstance(resource, dict):
23583:                 resources.append(resource_record_from_package(package_id, resource, "registered", package.get("__package_root_id")))
23584:     templates = load_workplace_registry(manifest, "templates", "templates.yaml") if manifest.is_file() else {}
23585:     for entry in templates.get("templates", []) if isinstance(templates, dict) else []:
23586:         if not isinstance(entry, dict) or not entry.get("id") or str(entry.get("status") or "available") in {"missing", "disabled"}:
23587:             continue
23588:         template_id = str(entry["id"])
23589:         resources.append(
23590:             {
23591:                 "id": template_id,
23592:                 "resource_id": template_id,
23593:                 "package_id": str(entry.get("template_root") or ""),
23594:                 "kind": "template",
23595:                 "title": str(entry.get("title") or template_id),
23596:                 "description": str(entry.get("description") or ""),
23597:                 "version": str(entry.get("version") or ""),
23598:                 "path_ref": {"registry": "templates", "id": template_id},
23599:                 "status": str(entry.get("status") or "available"),
23600:                 "indexing": entry.get("indexing") if isinstance(entry.get("indexing"), dict) else {
23601:                     "enabled": True,
23602:                     "mode": "metadata",
23603:                     "fields": ["title", "description", "version", "path"],
23604:                     "sources": [
23605:                         {"path": "README.md", "mode": "fulltext", "include": ["README.md"], "role": "description"},
23606:                         {"path": ".", "mode": "metadata", "role": "template_root"},
23607:                     ],
23608:                 },
23609:             }
23610:         )
23611:     fingerprint = hashlib.sha256(json.dumps(resources, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()
23612:     snapshot = {
23613:         "search_index_scope": "workplace",
23614:         "snapshot": {"id": "workplace-resource-catalogue", "checksum": f"sha256:{fingerprint}"},
23615:         "local_search_resources": resources,
23616:     }
23617:     # Use the Workplace root only as the path-ref resolver's neutral anchor;
23618:     # no project context, Runtime, Ledger, or session participates here.
23619:     return snapshot_with_resolved_search_roots(workplace_root, snapshot, workplace_root, sys.modules[__name__])
23620: 
