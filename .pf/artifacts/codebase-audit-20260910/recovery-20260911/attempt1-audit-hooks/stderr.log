22887: def command_update_candidates_refresh(args: argparse.Namespace) -> int:
22888:     workplace_root = update_workplace_root(args.workplace)
22889:     channel = args.channel
22890:     derived, checks = build_installed_update_sites(workplace_root)
22891:     failures = [item for item in checks if item.level == "FAIL"]
22892:     if failures:
22893:         print_checks(checks)
22894:         return 1
22895:     if not args.dry_run:
22896:         target_sites = derived_installed_update_sites_path(workplace_root)
22897:         target_sites.parent.mkdir(parents=True, exist_ok=True)
22898:         target_sites.write_text(json.dumps(derived, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
22899:     installed = installed_subjects_by_key(workplace_root)
22900:     candidates: list[dict[str, Any]] = []
22901:     conflicts: list[dict[str, Any]] = []
22902:     for site in derived.get("sites", []) if isinstance(derived.get("sites"), list) else []:
22903:         if not isinstance(site, dict) or not bool(site.get("enabled", False)):
22904:             continue
22905:         subject = site.get("subject") if isinstance(site.get("subject"), dict) else {}
22906:         if subject.get("type") == "project_pf":
22907:             continue
22908:         source = site.get("source") if isinstance(site.get("source"), dict) else {}
22909:         effective_channel = str(source.get("channel") or channel)
22910:         raw_manifest, warnings = fetch_update_manifest(source, workplace_root)
22911:         if not raw_manifest:
22912:             conflicts.append({"site_id": site.get("site_id"), "reason": "; ".join(warnings) or "manifest fetch failed"})
22913:             continue
22914:         versions = normalize_manifest_versions(raw_manifest, site, effective_channel)
22915:         installed_subject = installed.get((str(subject.get("type")), str(subject.get("id"))), {})
22916:         installed_version = str(subject.get("installed_version") or installed_subject.get("version") or "")
22917:         selected, compare_warnings = selected_update_version(versions, installed_version or None)
22918:         warnings.extend(compare_warnings)
22919:         if not selected:
22920:             continue
22921:         source_policy = update_site_policy(source, installed_subject)
22922:         pinned = source_policy.get("pin_version")
22923:         if isinstance(pinned, str) and pinned.strip() and str(selected.get("version")) != pinned:
22924:             conflicts.append({"site_id": site.get("site_id"), "reason": f"candidate {selected.get('version')} blocked by pin_version {pinned}"})
22925:             continue
22926:         if source_policy.get("allow_major") is False and installed_version:
22927:             installed_major = semantic_version_key(installed_version)[1]
22928:             selected_major = semantic_version_key(str(selected.get("version")))[1]
22929:             if isinstance(installed_major, tuple) and isinstance(selected_major, tuple) and installed_major[0] != selected_major[0]:
22930:                 conflicts.append({"site_id": site.get("site_id"), "reason": f"candidate {selected.get('version')} blocked by allow_major=false"})
22931:                 continue
22932:         trust = source.get("trust") if isinstance(source.get("trust"), dict) else {}
22933:         require_sha = bool(trust.get("require_sha256", trust.get("require_sha256_for_install", source_policy.get("require_sha256", True))))
22934:         sha256 = str(selected.get("sha256") or "")
22935:         installable = bool(selected.get("download_url")) and (not require_sha or bool(sha256))
22936:         status = "available" if installable else "missing_required_hash"
22937:         candidate = {
22938:             "id": update_candidate_id(str(subject.get("type")), str(subject.get("id")), str(selected.get("version")), str(selected.get("source_id"))),
22939:             "subject": selected.get("subject") or subject,
22940:             "installed_version": installed_version or None,
22941:             "current_version": installed_version or None,
22942:             "available_version": str(selected.get("version")),
22943:             "channel": effective_channel,
22944:             "source_id": str(selected.get("source_id")),
22945:             "site_id": site.get("site_id"),
22946:             "manifest_url": selected.get("manifest_url"),
22947:             "changelog_url": selected.get("changelog_url"),
22948:             "download_url": selected.get("download_url"),
22949:             "sha256": sha256 or None,
22950:             "artifact_sha256": sha256 or None,
22951:             "breaking": bool(selected.get("breaking", False)),
22952:             "migration_required": bool(selected.get("migration_required", False)),
22953:             "status": status,
22954:             "installable": installable,
22955:             "reason": None if installable else "sha256 required before stage/apply",
22956:             "warnings": sorted(set(warnings)),
22957:             "update_policy": selected.get("update_policy") or source_policy,
22958:             "post_update_doctor": selected.get("post_update_doctor") or source_policy.get("post_update_doctor", []),
22959:         }
22960:         candidates.append(candidate)
22961:     cache = {"schema_version": 1, "generated_at": now_utc(), "channel": channel, "candidates": candidates, "conflicts": conflicts}
22962:     if args.dry_run:
22963:         print(json.dumps(cache, ensure_ascii=False, indent=2, sort_keys=True))
22964:         return 0
22965:     path = update_candidates_path(workplace_root)
22966:     path.parent.mkdir(parents=True, exist_ok=True)
22967:     path.write_text(json.dumps(cache, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
22968:     create_update_notifications_from_candidates(workplace_root, candidates)
22969:     print(f"CANDIDATES: {len(candidates)}")
22970:     print(f"TARGET: {rel(path, workplace_root)}")
22971:     print(f"NOTIFICATIONS: {rel(update_notifications_path(workplace_root), workplace_root)}")
22972:     return 0
