 2915: def package_root_registry_checks(workplace_root: Path) -> list[Check]:
 2916:     checks: list[Check] = []
 2917:     registry_path = workplace_root / "registries" / "package-roots.yaml"
 2918:     if not registry_path.is_file():
 2919:         return [check("WARN", "registries/package-roots.yaml missing; package writes will use fallback <workplace-root>/packages")]
 2920:     entries = package_root_entries(workplace_root)
 2921:     if not entries:
 2922:         return [check("WARN", "package_roots registry is empty; package writes will use fallback <workplace-root>/packages")]
 2923:     ids: dict[str, int] = {}
 2924:     for entry in entries:
 2925:         root_id = str(entry.get("id", ""))
 2926:         ids[root_id] = ids.get(root_id, 0) + 1
 2927:     for root_id, count in sorted(ids.items()):
 2928:         checks.append(check("FAIL" if count > 1 else "PASS", f"package_root id {root_id or '<missing>'} unique"))
 2929:     selectable = False
 2930:     for entry in entries:
 2931:         if not isinstance(entry, dict):
 2932:             continue
 2933:         root = package_root_resolution_from_entry(workplace_root, entry)
 2934:         label = f"package_root {root.root_id}"
 2935:         if root.warnings:
 2936:             checks.append(
 2937:                 check_with_hint(
 2938:                     "FAIL",
 2939:                     f"{label} path cannot resolve: {'; '.join(root.warnings)}",
 2940:                     "The package root registry points to a path ProcessForge cannot use.",
 2941:                     "edit registries/package-roots.yaml so this package_root path exists and is relative to the workplace when possible",
 2942:                 )
 2943:             )
 2944:             continue
 2945:         exists = root.resolved_path.is_dir()
 2946:         status = str(entry.get("status", "available"))
 2947:         must_exist = status == "available" or bool(entry.get("must_exist", False))
 2948:         checks.append(
 2949:             check("PASS", f"{label} path exists")
 2950:             if exists or not must_exist
 2951:             else check_with_hint(
 2952:                 "FAIL",
 2953:                 f"{label} path missing",
 2954:                 "This package_root is marked available or must_exist but the directory is absent.",
 2955:                 f"create the package root directory or update registries/package-roots.yaml for {root.root_id}",
 2956:             )
 2957:         )
 2958:         if exists and status == "available":
 2959:             selectable = True
 2960:         if str(entry.get("writable", True)).lower() != "false" and exists:
 2961:             checks.append(check("PASS", f"{label} writable candidate"))
 2962:     checks.append(
 2963:         check("PASS", "default/first available package_root can be selected")
 2964:         if selectable
 2965:         else check_with_hint(
 2966:             "FAIL",
 2967:             "default/first available package_root can be selected",
 2968:             "Authoring commands need at least one available package_root unless every write passes an explicit --package-root.",
 2969:             "python bin/pf.py workplace-init --workplace <workplace-root> --apply",
 2970:             "add an available entry to registries/package-roots.yaml",
 2971:         )
 2972:     )
 2973:     return checks
 2974: 
