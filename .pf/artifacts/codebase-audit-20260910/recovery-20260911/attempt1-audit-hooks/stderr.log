23238: def command_update_verify(args: argparse.Namespace) -> int:
23239:     workplace_root = update_workplace_root(args.workplace)
23240:     candidate = find_update_candidate(workplace_root, args.candidate)
23241:     record = read_staged_update_record(workplace_root, args.candidate)
23242:     if not candidate or not record:
23243:         print(f"FAIL: staged candidate not found: {args.candidate}")
23244:         return 1
23245:     artifact_info = record.get("artifact") if isinstance(record.get("artifact"), dict) else {}
23246:     artifact_path = path_resolution_to_path(workplace_path_resolution(workplace_root, str(artifact_info.get("path") or "")))
23247:     if not artifact_path.is_file():
23248:         print(f"FAIL: staged artifact missing: {artifact_path}")
23249:         return 1
23250:     actual_sha = sha256_file(artifact_path)
23251:     expected_sha = str(candidate.get("sha256") or candidate.get("artifact_sha256") or "")
23252:     if expected_sha and actual_sha.lower() != expected_sha.lower():
23253:         print("FAIL: sha256 mismatch")
23254:         return 1
23255:     subject = candidate.get("subject") if isinstance(candidate.get("subject"), dict) else {}
23256:     manifest = artifact_manifest_from_zip(artifact_path) if artifact_path.suffix.lower() == ".zip" else {}
23257:     if manifest:
23258:         if str(manifest.get("id") or "") != str(subject.get("id") or ""):
23259:             print("FAIL: artifact subject id mismatch")
23260:             return 1
23261:         if str(manifest.get("type") or subject.get("type") or "") != str(subject.get("type") or ""):
23262:             print("FAIL: artifact subject type mismatch")
23263:             return 1
23264:         if str(manifest.get("version") or "") != str(candidate.get("available_version") or ""):
23265:             print("FAIL: artifact version mismatch")
23266:             return 1
23267:     record["status"] = "verified"
23268:     record["verified_at"] = now_utc()
23269:     record["verification"] = {"sha256": "pass", "subject_identity": "pass" if manifest else "not_applicable"}
23270:     staged_update_record_path(workplace_root, args.candidate).write_text(dump_yaml(record), encoding="utf-8")
23271:     print(f"VERIFIED: {args.candidate}")
23272:     return 0
