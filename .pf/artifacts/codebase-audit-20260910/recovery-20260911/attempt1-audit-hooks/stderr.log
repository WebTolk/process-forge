 1189: def path_string_is_absolute(value: str) -> bool:
 1190:     text = value.strip().replace("\\", "/")
 1191:     return bool(re.match(r"^[A-Za-z]:/", text) or text.startswith("/") or text.startswith("//"))
 1192: 
 1193: 
 1194: def normalize_path_string(value: str) -> str:
 1195:     return value.replace("\\", "/")
 1196: 
 1197: 
 1198: def load_workplace_path_constants(workplace_manifest: Path | None, workplace_root: Path | None = None) -> dict[str, str]:
 1199:     root = workplace_root or (workplace_manifest.parent if workplace_manifest else Path(".").resolve())
 1200:     constants = dict(DEFAULT_PATH_CONSTANTS)
 1201:     if workplace_manifest and workplace_manifest.is_file():
 1202:         data = load_yaml_document(workplace_manifest)
 1203:         raw_constants = data.get("path_constants") if isinstance(data, dict) else None
 1204:         if isinstance(raw_constants, dict):
 1205:             for key, value in raw_constants.items():
 1206:                 if isinstance(key, str):
 1207:                     constants[key] = "" if value is None else str(value)
 1208:     constants.setdefault("PF_WORKPLACE", ".")
 1209:     constants["_WORKPLACE_ROOT"] = root.as_posix()
 1210:     return constants
 1211: 
 1212: 
 1213: def expand_path_constants(raw_path: str, constants: dict[str, str]) -> tuple[str, list[str], list[str]]:
 1214:     expanded = raw_path
 1215:     used: list[str] = []
 1216:     errors: list[str] = []
 1217:     visiting: list[str] = []
 1218: 
 1219:     def expand_const(name: str) -> str:
 1220:         if name in visiting:
 1221:             errors.append("cyclic path constant reference: " + " -> ".join([*visiting, name]))
 1222:             return "${" + name + "}"
 1223:         if name not in constants:
 1224:             errors.append(f"unknown path constant: {name}")
 1225:             return "${" + name + "}"
 1226:         value = str(constants.get(name, ""))
 1227:         if value == "":
 1228:             errors.append(f"empty path constant: {name}")
 1229:             return ""
 1230:         used.append(name)
 1231:         visiting.append(name)
 1232:         result = PATH_CONSTANT_PATTERN.sub(lambda match: expand_const(match.group(1)), value)
 1233:         visiting.pop()
 1234:         return result
 1235: 
 1236:     for _ in range(20):
 1237:         if not PATH_CONSTANT_PATTERN.search(expanded):
 1238:             break
 1239:         before = expanded
 1240:         expanded = PATH_CONSTANT_PATTERN.sub(lambda match: expand_const(match.group(1)), expanded)
 1241:         if expanded == before:
 1242:             break
 1243:     if PATH_CONSTANT_PATTERN.search(expanded):
 1244:         errors.append("unresolved path constant reference remains")
 1245:     return expanded, sorted(set(used)), sorted(set(errors))
 1246: 
 1247: 
 1248: def resolve_path_with_constants(raw_path: str | None, base_dir: Path, constants: dict[str, str] | None = None) -> dict[str, Any]:
 1249:     original = "" if raw_path is None else str(raw_path)
 1250:     constants = constants or load_workplace_path_constants(None, base_dir)
 1251:     expanded, used_constants, errors = expand_path_constants(original, constants)
 1252:     expanded = normalize_path_string(expanded)
 1253:     status = "resolved"
 1254:     if errors:
 1255:         status = "error"
 1256:     elif used_constants:
 1257:         status = "resolved_from_constant"
 1258:     elif path_string_is_absolute(expanded):
 1259:         status = "absolute"
 1260:     else:
 1261:         status = "resolved_relative"
 1262:     if path_string_is_absolute(expanded):
 1263:         resolved = expanded
 1264:         is_absolute = True
 1265:     else:
 1266:         resolved = normalize_path_string((base_dir / expanded).resolve().as_posix())
 1267:         is_absolute = True
 1268:     return {
 1269:         "original": original,
 1270:         "expanded": expanded,
 1271:         "resolved": resolved,
 1272:         "is_absolute": is_absolute,
 1273:         "is_private": is_absolute,
 1274:         "path_status": status,
 1275:         "constants": used_constants,
 1276:         "errors": errors,
 1277:     }
 1278: 
 1279: 
 1280: def workplace_path_resolution(workplace_root: Path, raw_path: str | None) -> dict[str, Any]:
 1281:     manifest = workplace_root / "workplace.yaml"
 1282:     return resolve_path_with_constants(raw_path, workplace_root, load_workplace_path_constants(manifest, workplace_root))
 1283: 
