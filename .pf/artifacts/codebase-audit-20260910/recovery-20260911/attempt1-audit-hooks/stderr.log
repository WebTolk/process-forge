21807: def append_env_reference_checks(checks: list[Check], source: dict[str, Any], label: str) -> None:
21808:     for field in ("headers_env", "query_env", "custom_headers_env"):
21809:         values = source.get(field)
21810:         if values is None:
21811:             continue
21812:         if not isinstance(values, dict):
21813:             checks.append(check("FAIL", f"{label} {field} must be an object"))
21814:             continue
21815:         for key, value in values.items():
21816:             if not isinstance(value, str) or not ENV_REFERENCE_RE.fullmatch(value):
21817:                 checks.append(check("FAIL", f"{label} {field}.{key} must be an env variable name or auth_ref:/secret_ref: reference"))
21818: 
