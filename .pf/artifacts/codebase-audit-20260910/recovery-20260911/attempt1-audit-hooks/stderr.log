 4736: def apply_specialization_overlay(
 4737:     spec: dict[str, Any],
 4738:     overlay: dict[str, Any],
 4739:     mode: str,
 4740: ) -> tuple[dict[str, Any], list[str]]:
 4741:     effective = dict(spec)
 4742:     notes: list[str] = []
 4743:     if mode == "replace":
 4744:         effective = dict(overlay)
 4745:         notes.append("replace document applied")
 4746:     else:
 4747:         resources = default_resource_buckets()
 4748:         merge_resource_buckets(resources, spec.get("resources") if isinstance(spec.get("resources"), dict) else {})
 4749:         merge_resource_buckets(resources, overlay.get("resources") if isinstance(overlay.get("resources"), dict) else {})
 4750:         effective["resources"] = resources
 4751:         capabilities = set(str(item) for item in as_list(spec.get("provides_capabilities")) if str(item))
 4752:         capabilities.update(str(item) for item in as_list(overlay.get("provides_capabilities")) if str(item))
 4753:         effective["provides_capabilities"] = dedupe_sorted(list(capabilities))
 4754:         overlay_bindings = overlay.get("platform_bindings") if isinstance(overlay.get("platform_bindings"), list) else []
 4755:         if overlay_bindings:
 4756:             effective["platform_bindings"] = list(as_list(spec.get("platform_bindings"))) + [item for item in overlay_bindings if isinstance(item, dict)]
 4757:         notes.append(f"{mode} overlay applied")
 4758:     for key in ["__source", "__manifest_path"]:
 4759:         if key in spec and key not in effective:
 4760:             effective[key] = spec[key]
 4761:     return effective, notes
 4762: 
