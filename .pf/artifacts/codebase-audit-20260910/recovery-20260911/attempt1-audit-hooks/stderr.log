 5961: def execute_project_initialization(request: dict[str, Any], files: dict[Path, str]) -> dict[str, Any]:
 5962:     """CLI writer adapter used only by project_initialization.initialize_project()."""
 5963:     project_root = request["project_root"]
 5964:     project_root.mkdir(parents=True, exist_ok=True)
 5965:     project_type = request.get("project_type")
 5966:     force = bool(request.get("force", False))
 5967:     flow_root = project_root / PROJECT_FLOW_ROOT
 5968:     for dirname in PROJECT_FLOW_DIRS:
 5969:         (flow_root / dirname).mkdir(parents=True, exist_ok=True)
 5970:     emit_process_event(project_root, "project.onboarding.started", process_id="project-onboarding", process_version="1.0.0", payload={"command": request.get("command", "project-onboard")})
 5971:     results = [write_file(path, content, force=force) for path, content in files.items()]
 5972:     results.append(append_gitignore_entries(project_root / ".gitignore", PROJECT_PRIVATE_GITIGNORE, force=force))
 5973:     codex_integration = project_codex_integration_status(project_root)
 5974:     codex_integration.update({"required": False, "severity": "info", "purpose": "optional_host_telemetry"})
 5975:     emit_process_event(project_root, "project.flow_root.created", process_id="project-onboarding", process_version="1.0.0", payload={"flow_root": PROJECT_FLOW_ROOT})
 5976:     emit_process_event(project_root, "project.platform.detected", process_id="project-onboarding", process_version="1.0.0", payload={"project_type": project_type or "auto"})
 5977:     snapshot_status, snapshot_paths, _snapshot, _old_reasons = write_project_context_snapshot_outputs(project_root)
 5978:     emit_process_event(project_root, "project.snapshot.refreshed", process_id="project-onboarding", process_version="1.0.0", payload={"status": snapshot_status, "paths": {key: rel(value, project_root) for key, value in snapshot_paths.items()}})
 5979:     emit_process_event(project_root, "launcher.project_runtime.created", process_id="project-onboarding", process_version="1.0.0", payload={"path": ".pf/runtime/bin/pf.py"})
 5980:     emit_process_event(project_root, "agent.start_prompt.generated", process_id="project-onboarding", process_version="1.0.0", payload={"path": ".pf/START_AGENT_HERE.md"})
 5981:     emit_process_event(project_root, "assignment.created", process_id="project-onboarding", process_version="1.0.0", assignment_id_value="first-assignment", assignment_path=".pf/assignments/first-assignment.yaml", payload={"path": ".pf/assignments/first-assignment.yaml"})
 5982:     doctor_status, doctor_output = run_command_capture(command_doctor_project, argparse.Namespace(project_root=str(project_root)))
 5983:     finalize_project_onboarding_doctor_artifacts(project_root, doctor_status, doctor_output)
 5984:     emit_process_event(
 5985:         project_root,
 5986:         "project.doctor.passed" if doctor_status == 0 else "project.doctor.failed",
 5987:         process_id="project-onboarding",
 5988:         process_version="1.0.0",
 5989:         payload={"status": "pass" if doctor_status == 0 else "fail"},
 5990:     )
 5991:     search_index: dict[str, Any] | None = None
 5992:     workplace_manifest = resolve_project_workplace_manifest(project_root, request.get("workplace"))
 5993:     if workplace_manifest:
 5994:         search_index = search_index_maintenance_for_known_projects(
 5995:             workplace_manifest.parent,
 5996:             reason="project-onboarding",
 5997:             project_roots=[project_root],
 5998:         )
 5999:     emit_process_event(project_root, "project.onboarding.completed", process_id="project-onboarding", process_version="1.0.0", payload={"files": [rel(result.target, project_root) for result in results], "doctor_status": doctor_status})
 6000:     return {
 6001:         "status": "complete" if doctor_status == 0 else "blocked",
 6002:         "project": {"id": project_id(project_root)},
 6003:         "created_or_reused": [{"path": rel(result.target, project_root), "status": result.status} for result in results],
 6004:         "codex_integration": codex_integration,
 6005:         "snapshot": {"status": snapshot_status, "id": _snapshot.get("snapshot", {}).get("id") if isinstance(_snapshot.get("snapshot"), dict) else None},
 6006:         "search_index": search_index,
 6007:         "doctor": {"status": "pass" if doctor_status == 0 else "fail"},
 6008:         "next_action": "continue" if doctor_status == 0 else "resolve_doctor_failures",
 6009:     }
