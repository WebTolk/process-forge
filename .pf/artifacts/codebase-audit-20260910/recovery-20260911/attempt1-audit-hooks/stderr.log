 1155: def work_state_payload(workplace_root: Path, core: Any, *, session: str | None = None, project_root_ref: str | None = None) -> dict[str, Any]:
 1156:     from processforge_core.process_execution import ProcessExecutionService
 1157: 
 1158:     project_root = project_for_session(argparse.Namespace(session=session, project_root=project_root_ref), workplace_root, core)
 1159:     handle = route_project(str(project_root), workplace_root, core)
 1160:     events_path, _outbox = core.event_runtime_paths(project_root)
 1161:     supervisor = core.json_read(core.supervisor_state_path(project_root))
 1162:     projection = stage_obligations_payload(project_root, core)
 1163:     obligations = projection.get("obligations") if isinstance(projection.get("obligations"), list) else []
 1164:     execution = active_execution_records(project_root, core)
 1165:     active = execution[0] if execution else {}
 1166:     active_stage = active.get("stage") if isinstance(active.get("stage"), dict) else {}
 1167:     event_rows = journal_events(project_root, core)
 1168:     current_work_state = {
 1169:         "project": handle["project_id"],
 1170:         "active_sessions": [str(item.get("session_id") or "") for item in core.iter_agent_presence(workplace_root) if str(item.get("project_id") or "") == handle["project_id"]],
 1171:         "active_process": str(active.get("process_id") or ""),
 1172:         "active_stage": str(active.get("stage_id") or ""),
 1173:         "run": str(active.get("run_id") or ""),
 1174:         "task": str(active.get("task_id") or ""),
 1175:         "assignment": str(active.get("task_id") or ""),
 1176:         "workers": [{"task_id": str(row.get("task_id") or ""), "run_id": str(row.get("run_id") or ""), "status": str(row.get("worker_status") or "")} for row in execution],
 1177:         "stage_contract": {
 1178:             "entry_gates": list(active_stage.get("entry_gates") or []) if isinstance(active_stage.get("entry_gates"), list) else [],
 1179:             "exit_gates": list(active_stage.get("exit_gates") or []) if isinstance(active_stage.get("exit_gates"), list) else [],
 1180:         } if active_stage else {},
 1181:         "automation_bindings": obligations,
 1182:         "blockers": [],
 1183:         "execution": execution,
 1184:         "freshness": projection.get("status"),
 1185:         "last_relevant_activity": str(event_rows[-1].get("time") or "") if event_rows else "",
 1186:     }
 1187:     declarative_state = ProcessExecutionService(project_root, workplace_root, core).state(session_id=str(session or ""))
 1188:     if declarative_state.get("action") != "start_recommended":
 1189:         current_work_state.update(
 1190:             {
 1191:                 "active_process": str(declarative_state.get("process", {}).get("id") or current_work_state["active_process"]),
 1192:                 "active_stage": str(declarative_state.get("stage", {}).get("id") or current_work_state["active_stage"]),
 1193:                 "run": str(declarative_state.get("run", {}).get("id") or current_work_state["run"]),
 1194:                 "task": str(declarative_state.get("assignment", {}).get("id") or current_work_state["task"]),
 1195:                 "assignment": str(declarative_state.get("assignment", {}).get("id") or current_work_state["assignment"]),
 1196:                 "stage_contract": {
 1197:                     "entry_gates": declarative_state.get("gates", {}).get("entry", []),
 1198:                     "exit_gates": declarative_state.get("gates", {}).get("exit", []),
 1199:                 },
 1200:                 "automation_bindings": declarative_state.get("obligations", []),
 1201:                 "freshness": "pinned",
 1202:                 "process_execution": declarative_state,
 1203:             }
 1204:         )
 1205:     return {
 1206:         "project": handle,
 1207:         "current_session": core.read_current_project_session(project_root),
 1208:         "agent_presence": [item for item in core.iter_agent_presence(workplace_root) if str(item.get("project_id") or "") == handle["project_id"]],
 1209:         "events_path": core.rel(events_path, project_root),
 1210:         "event_count": len(events_path.read_text(encoding="utf-8", errors="replace").splitlines()) if events_path.is_file() else 0,
 1211:         "supervisor": supervisor,
 1212:         "projections": {"stage_obligations": projection},
 1213:         "current_work_state": current_work_state,
 1214:     }
