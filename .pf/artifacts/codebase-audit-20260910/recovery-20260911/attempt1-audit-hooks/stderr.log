23140: def sha256_file(path: Path) -> str:
23141:     digest = hashlib.sha256()
23142:     with path.open("rb") as handle:
23143:         for chunk in iter(lambda: handle.read(1024 * 1024), b""):
23144:             digest.update(chunk)
23145:     return digest.hexdigest()
