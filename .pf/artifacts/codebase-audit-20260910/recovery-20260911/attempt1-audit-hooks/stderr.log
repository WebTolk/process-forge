22507: def load_update_index(distribution_root: Path) -> dict[str, Any]:
22508:     candidates = [
22509:         distribution_root / "updates" / "processforge-update-index.yaml",
22510:         distribution_root / "updates" / "channels.yaml",
22511:     ]
22512:     for path in candidates:
22513:         if path.is_file():
22514:             data = load_yaml_document(path)
22515:             return data if isinstance(data, dict) else {}
22516:     return {}
