22153: def update_site_overrides(workplace_root: Path) -> dict[str, dict[str, Any]]:
22154:     path = update_site_overrides_path(workplace_root)
22155:     data = load_update_yaml(path)
22156:     overrides = data.get("overrides") if isinstance(data.get("overrides"), list) else []
22157:     result: dict[str, dict[str, Any]] = {}
22158:     for item in overrides:
22159:         if not isinstance(item, dict):
22160:             continue
22161:         key = item.get("site_id") if isinstance(item.get("site_id"), str) else None
22162:         subject = item.get("subject") if isinstance(item.get("subject"), dict) else {}
22163:         update_site_id = item.get("update_site_id") or item.get("source_id")
22164:         if not key and isinstance(update_site_id, str) and subject.get("type") and subject.get("id"):
22165:             key = update_site_stable_key(str(subject.get("type")), str(subject.get("id")), update_site_id)
22166:         if not key and isinstance(item.get("subject_id"), str):
22167:             key = str(item.get("subject_id"))
22168:         if not key and isinstance(item.get("subject"), dict) and subject.get("type") and subject.get("id"):
22169:             key = f"{subject.get('type')}:{subject.get('id')}"
22170:         if key:
22171:             result[key] = item
22172:     return result
22173: 
22174: 
22175: def validate_update_site_overrides_data(data: dict[str, Any], path: Path) -> list[Check]:
22176:     checks: list[Check] = []
22177:     if not data:
22178:         return [check("FAIL", f"{path} missing or invalid")]
22179:     append_json_schema_checks(checks, data, "update-site-overrides.schema.json", str(path))
22180:     overrides = data.get("overrides")
22181:     if not isinstance(overrides, list):
22182:         checks.append(check("FAIL", f"{path} overrides must be a list"))
22183:         return checks
22184:     seen: set[str] = set()
22185:     for index, item in enumerate(overrides):
22186:         label = f"overrides[{index}]"
22187:         if not isinstance(item, dict):
22188:             checks.append(check("FAIL", f"{label} must be an object"))
22189:             continue
22190:         site_id = item.get("site_id")
22191:         subject_id = item.get("subject_id")
22192:         if isinstance(site_id, str) and site_id.strip():
22193:             if site_id in seen:
22194:                 checks.append(check("FAIL", f"{label} duplicate site_id {site_id}"))
22195:             seen.add(site_id)
22196:         elif not (isinstance(subject_id, str) and subject_id.strip()) and not isinstance(item.get("subject"), dict):
22197:             checks.append(check("FAIL", f"{label} missing site_id, subject_id, or subject"))
22198:         if "enabled" in item and not isinstance(item.get("enabled"), bool):
22199:             checks.append(check("FAIL", f"{label}.enabled must be boolean"))
22200:         if "disabled" in item and not isinstance(item.get("disabled"), bool):
22201:             checks.append(check("FAIL", f"{label}.disabled must be boolean"))
22202:         if "channels" in item and (
22203:             not isinstance(item.get("channels"), list) or not all(isinstance(channel, str) and channel.strip() for channel in item.get("channels", []))
22204:         ):
22205:             checks.append(check("FAIL", f"{label}.channels must be a list of non-empty strings"))
22206:         append_env_reference_checks(checks, item, label)
22207:         preserved = item.get("preserved_local") if isinstance(item.get("preserved_local"), dict) else {}
22208:         append_env_reference_checks(checks, preserved, f"{label}.preserved_local")
22209:     if not checks:
22210:         checks.append(check("PASS", f"{path} valid update site overrides"))
22211:     return checks
22212: 
