23288: def update_installed_subject_version(workplace_root: Path, candidate: dict[str, Any], install_path: Path | None = None) -> None:
23289:     path = installed_subjects_registry_path(workplace_root)
23290:     data = load_update_yaml(path)
23291:     if not data:
23292:         data = {"schema_version": 1, "subjects": []}
23293:     subjects = data.get("subjects")
23294:     if not isinstance(subjects, list):
23295:         subjects = []
23296:         data["subjects"] = subjects
23297:     candidate_subject = candidate.get("subject") if isinstance(candidate.get("subject"), dict) else {}
23298:     found = False
23299:     for subject in subjects:
23300:         if not isinstance(subject, dict):
23301:             continue
23302:         if subject.get("type") == candidate_subject.get("type") and subject.get("id") == candidate_subject.get("id"):
23303:             subject["version"] = candidate.get("available_version")
23304:             subject["updated_at"] = now_utc()
23305:             if install_path:
23306:                 subject["install_path"] = rel(install_path, workplace_root)
23307:             found = True
23308:     if not found:
23309:         subjects.append({"type": candidate_subject.get("type"), "id": candidate_subject.get("id"), "scope": candidate_subject.get("scope") or "global", "version": candidate.get("available_version"), "installed_at": now_utc(), "install_path": rel(install_path, workplace_root) if install_path else None})
23310:     data["updated_at"] = now_utc()
23311:     path.parent.mkdir(parents=True, exist_ok=True)
23312:     path.write_text(dump_yaml(data), encoding="utf-8")
