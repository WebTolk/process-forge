25564: def platform_contract_from_values(values: dict[str, Any]) -> dict[str, Any]:
25565:     return {
25566:         "schema_version": 1,
25567:         "id": values["contract_id"],
25568:         "title": values["title"],
25569:         "type": "platform_contract",
25570:         "version": values["version"],
25571:         "status": "draft",
25572:         "project_type_hints": values["project_types"],
25573:         "applies_to": {
25574:             "platforms": [values["platform_id"]],
25575:             "project_type_hints": values["project_types"],
25576:         },
25577:         "requires": {
25578:             "capabilities": ["filesystem.read", "filesystem.write"],
25579:             "knowledge_packages": values["required_packages"],
25580:             "tools": values["required_tools"],
25581:             "mcp": values["required_mcp"],
25582:             "templates": values["required_templates"],
25583:         },
25584:         "recommends": {
25585:             "knowledge_packages": values["recommended_packages"],
25586:             "templates": values["recommended_templates"],
25587:             "tools": values["recommended_tools"],
25588:             "mcp": values["recommended_mcp"],
25589:         },
25590:         "optional": {
25591:             "knowledge_packages": values["optional_packages"],
25592:             "templates": values["optional_templates"],
25593:             "tools": values["optional_tools"],
25594:             "mcp": values["optional_mcp"],
25595:         },
25596:         "includes": {
25597:             "knowledge_packages": values["optional_packages"],
25598:             "templates": values["optional_templates"],
25599:             "tools": values["optional_tools"],
25600:             "mcp": values["optional_mcp"],
