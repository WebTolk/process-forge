 6672: def public_release_checks(root: Path) -> list[Check]:
 6673:     checks: list[Check] = []
 6674:     dist = root / "dist"
 6675:     stale: list[str] = []
 6676:     if dist.is_dir():
 6677:         for path in sorted(dist.glob("processforge*")):
 6678:             if path.name in {"processforge.zip", "processforge.manifest.json"}:
 6679:                 continue
 6680:             if path.suffix.lower() == ".zip" or path.name.endswith(".manifest.json"):
 6681:                 stale.append(rel(path, root))
 6682:     if stale:
 6683:         checks.extend(check("FAIL", f"stale public distribution artifact: {item}") for item in stale)
 6684:     else:
 6685:         checks.append(check("PASS", "dist contains no stale ProcessForge release artifacts"))
 6686: 
 6687:     tagged_warns: list[str] = []
 6688:     parity_root = locate_flow_root(root) / "reviews" / "parity"
 6689:     if parity_root.is_dir():
 6690:         for path in sorted(parity_root.rglob("*.md")):
 6691:             text = path.read_text(encoding="utf-8", errors="replace")
 6692:             if "WARN To Fix Before Public Release" in text:
 6693:                 tagged_warns.append(rel(path, root))
