 2484: def merge_guided_answers(defaults: dict[str, Any], supplied: dict[str, Any]) -> dict[str, Any]:
 2485:     result = dict(defaults)
 2486:     for key, value in supplied.items():
 2487:         if isinstance(value, dict) and isinstance(result.get(key), dict):
 2488:             nested = dict(result[key])
 2489:             nested.update(value)
 2490:             result[key] = nested
 2491:         else:
 2492:             result[key] = value
 2493:     return result
 2494: 
