  366: def stable_event_id(payload: dict[str, Any]) -> str:
  367:     raw = payload.get("event_id") or payload.get("id")
  368:     if raw:
  369:         text = str(raw)
  370:         return text if text.startswith("evt_") else "evt_" + hashlib.sha256(text.encode("utf-8")).hexdigest()[:32]
  371:     basis = json.dumps(payload, ensure_ascii=False, sort_keys=True)
  372:     return "evt_" + hashlib.sha256(basis.encode("utf-8")).hexdigest()
  373: 
