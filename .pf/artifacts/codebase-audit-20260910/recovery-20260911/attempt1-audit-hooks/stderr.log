20515:     blockers = [str(item.get("id")) for item in tasks if item.get("blocking", True) is not False and str(item.get("status")) in {"blocked", "failed"}]
20516:     if blockers:
20517:         print("BLOCKERS: " + ", ".join(blockers))
20518:     return 0
