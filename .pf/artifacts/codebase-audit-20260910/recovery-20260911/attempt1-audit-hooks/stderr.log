 6499: def public_support_policy_violations(archive_path: str, text: str, policy: dict[str, Any]) -> list[str]:
 6500:     violations: list[str] = []
 6501:     group = archive_path.split("/", 1)[0]
 6502:     for entry in policy_entries(policy, "blocked_public_surface_patterns"):
 6503:         groups = [str(item) for item in as_list(entry.get("groups")) if item]
 6504:         if groups and group not in groups:
 6505:             continue
 6506:         allowed_paths = [str(item) for item in as_list(entry.get("allowed_paths")) if item]
 6507:         if any(fnmatch.fnmatch(archive_path, pattern) for pattern in allowed_paths):
 6508:             continue
 6509:         raw_pattern = entry.get("pattern") or entry.get("id")
 6510:         if not raw_pattern:
 6511:             continue
 6512:         flags = re.IGNORECASE if entry.get("case_insensitive", True) else 0
 6513:         try:
 6514:             matched = re.search(str(raw_pattern), text, flags)
 6515:         except re.error:
 6516:             matched = str(raw_pattern).lower() in text.lower() if flags else str(raw_pattern) in text
 6517:         if matched:
 6518:             violations.append(str(entry.get("message", entry.get("id", raw_pattern))))
 6519:     return violations
