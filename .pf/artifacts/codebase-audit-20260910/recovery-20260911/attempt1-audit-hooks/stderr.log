 1050: def command_status(args: argparse.Namespace, core: Any) -> int:
 1051:     project_roots = [resolve_project(value, core) for value in getattr(args, "project_root", [])]
 1052:     workplace_root = resolve_workplace(args, project_roots[0] if project_roots else None, core)
 1053:     payload = status_payload(workplace_root, project_roots, core)
 1054:     if getattr(args, "json", False):
 1055:         print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
 1056:     else:
 1057:         print(f"RUNTIME_HOST: projects={len(payload['projects'])} sessions={len(payload['sessions'])} ledger_sessions={payload['ledger_sessions']}")
 1058:     return 0
