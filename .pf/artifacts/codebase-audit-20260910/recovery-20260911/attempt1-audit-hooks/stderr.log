   84: def read_json(path: Path) -> dict[str, Any]:
   85:     if not path.is_file():
   86:         return {}
   87:     try:
   88:         payload = json.loads(path.read_text(encoding="utf-8"))
   89:     except json.JSONDecodeError:
   90:         return {}
   91:     return payload if isinstance(payload, dict) else {}
   92: 
   93: 
   94: def write_json_atomic(path: Path, payload: dict[str, Any]) -> None:
   95:     path.parent.mkdir(parents=True, exist_ok=True)
   96:     tmp = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
   97:     tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   98:     os.replace(tmp, path)
