23364: def command_update_apply(args: argparse.Namespace) -> int:
23365:     if not args.confirm:
23366:         print("FAIL: update apply requires --confirm")
23367:         return 1
23368:     workplace_root = update_workplace_root(args.workplace)
23369:     candidate = find_update_candidate(workplace_root, args.candidate)
23370:     record = read_staged_update_record(workplace_root, args.candidate)
23371:     if not candidate or not record:
23372:         print(f"FAIL: staged candidate not found: {args.candidate}")
23373:         return 1
23374:     verify_status = command_update_verify(argparse.Namespace(workplace=args.workplace, candidate=args.candidate))
23375:     if verify_status != 0:
23376:         return verify_status
23377:     subject = candidate.get("subject") if isinstance(candidate.get("subject"), dict) else {}
23378:     subject_type = str(subject.get("type") or "")
23379:     policy = candidate.get("update_policy") if isinstance(candidate.get("update_policy"), dict) else {}
23380:     if policy.get("mode") == "custom_command_requires_confirmation" and not args.allow_custom_command:
23381:         print("FAIL: custom command update policy requires explicit --allow-custom-command and is not executed by default")
23382:         return 1
23383:     artifact_info = record.get("artifact") if isinstance(record.get("artifact"), dict) else {}
23384:     artifact_path = path_resolution_to_path(workplace_path_resolution(workplace_root, str(artifact_info.get("path") or "")))
23385:     backup_dir = update_runtime_root(workplace_root) / "backups" / args.candidate
23386:     apply_dir = update_runtime_root(workplace_root) / "applied" / args.candidate
23387:     if args.dry_run:
23388:         print(f"DRY_RUN: would apply {args.candidate}")
23389:         return 0
23390:     if backup_dir.exists():
23391:         shutil.rmtree(backup_dir)
23392:     backup_dir.mkdir(parents=True, exist_ok=True)
23393:     if policy.get("mode") == "replace_file" or subject_type in {"tool_definition", "tool_package", "tool"}:
23394:         paths = policy.get("executable_paths") if isinstance(policy.get("executable_paths"), list) else []
23395:         if not paths:
23396:             print("FAIL: tool update requires update_policy.executable_paths")
23397:             return 1
23398:         destination = path_resolution_to_path(workplace_path_resolution(workplace_root, str(paths[0])))
23399:         if destination.exists():
23400:             backup_target = backup_dir / "previous-file"
23401:             backup_target.parent.mkdir(parents=True, exist_ok=True)
23402:             shutil.copy2(destination, backup_target)
23403:         destination.parent.mkdir(parents=True, exist_ok=True)
23404:         shutil.copy2(artifact_path, destination)
23405:         install_path = destination
23406:     else:
23407:         install_path = update_install_path(workplace_root, candidate)
23408:         if install_path.exists():
23409:             backup_target = backup_dir / "previous"
23410:             shutil.copytree(install_path, backup_target)
23411:             shutil.rmtree(install_path)
23412:         install_path.parent.mkdir(parents=True, exist_ok=True)
23413:         if artifact_path.suffix.lower() == ".zip":
23414:             safe_extract_zip(artifact_path, install_path)
23415:         else:
23416:             install_path.mkdir(parents=True, exist_ok=True)
23417:             shutil.copy2(artifact_path, install_path / artifact_path.name)
23418:     update_installed_subject_version(workplace_root, candidate, install_path)
23419:     apply_dir.mkdir(parents=True, exist_ok=True)
23420:     apply_record = {"schema_version": 1, "candidate_id": args.candidate, "applied_at": now_utc(), "status": "applied", "subject": subject, "installed_version": candidate.get("available_version"), "install_path": rel(install_path, workplace_root), "backup_path": rel(backup_dir, workplace_root), "post_update_doctor": candidate.get("post_update_doctor", [])}
23421:     (apply_dir / "apply-record.yaml").write_text(dump_yaml(apply_record), encoding="utf-8")
23422:     marked = mark_impacted_project_contexts_after_update(workplace_root, candidate, reason="update-applied")
23423:     print(f"APPLIED: {args.candidate}")
23424:     print(f"INSTALL_PATH: {rel(install_path, workplace_root)}")
23425:     print(f"BACKUP: {rel(backup_dir, workplace_root)}")
23426:     if marked:
23427:         print("SNAPSHOTS_MARKED_STALE: " + ", ".join(rel(path, workplace_root) for path in marked))
23428:     print_search_index_maintenance_summary(search_index_maintenance_for_known_projects(workplace_root, reason="update-apply"))
23429:     return 0
23430: 
