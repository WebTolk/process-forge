 6074: def command_project_init_status(args: argparse.Namespace) -> int:
 6075:     project_root = Path(args.project_root).expanduser().resolve()
 6076:     payload = project_initialization.status(project_root, sys.modules[__name__], workplace=getattr(args, "workplace", None))
 6077:     print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if getattr(args, "json", False) else dump_yaml(payload))
 6078:     return 0
