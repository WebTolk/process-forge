  640: def status_payload(workplace_root: Path, core: Any) -> dict[str, Any]:
  641:     active, state = active_service(workplace_root, core)
  642:     if not active and state:
  643:         state = dict(state)
  644:         if state.get("status") == "stopped":
  645:             state["health"] = "stopped"
  646:             return add_runtime_truth(state, core, running=False)
  647:         state["status"] = "stale"
  648:         state["health"] = "stale"
  649:         return add_runtime_truth(state, core, running=False)
  650:     if not active:
  651:         return add_runtime_truth({"schema_version": 1, "status": "not_running", "health": "stopped", "workplace_root": str(workplace_root)}, core, running=False)
  652:     token = load_token(workplace_root)
  653:     endpoint = str(state.get("endpoint") or "")
  654:     code, body = http_json("GET", endpoint.rstrip("/") + "/status", token=token, timeout=2.0)
  655:     if code == 200:
  656:         return add_runtime_truth(body, core, running=True)
  657:     state = dict(state)
  658:     state["health"] = "degraded"
  659:     state["last_status_error"] = body
  660:     return add_runtime_truth(state, core, running=True)
  661: 
