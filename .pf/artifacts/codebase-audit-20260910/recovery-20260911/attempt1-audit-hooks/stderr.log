  471:                 except Exception as exc:  # noqa: BLE001 - return structured local IPC errors.
  472:                     if isinstance(exc, PermissionError):
  473:                         append_operator_log(runtime.workplace_root, runtime.core, "request.forbidden", path=self.path, error=str(exc))
  474:                         self.send_json(403, {"error": str(exc)})
