 3149: def active_organized_project_sessions(workplace_root: Path) -> list[dict[str, Any]]:
 3150:     active: list[dict[str, Any]] = []
 3151:     presence_root = workplace_root / "runtime" / "agent-presence"
 3152:     presence_paths = [*presence_root.glob("*.json"), *presence_root.glob("*/*.json")]
 3153:     for presence_path in sorted(presence_paths):
 3154:         try:
 3155:             data = json_read(presence_path)
 3156:         except (OSError, TypeError, ValueError, json.JSONDecodeError):
 3157:             # Presence is observational. A partially-written or legacy record
 3158:             # must not make workplace-mode inspection unusable.
 3159:             continue
 3160:         if not isinstance(data, dict):
 3161:             continue
 3162:         if data.get("status") != "online":
 3163:             continue
 3164:         project_root_value = data.get("project_root")
 3165:         if not project_root_value:
 3166:             continue
 3167:         project_root = Path(str(project_root_value)).expanduser()
 3168:         if not project_root.is_dir():
 3169:             continue
 3170:         try:
 3171:             status = effective_project_coordination(project_root, str(workplace_root))
 3172:         except SystemExit:
 3173:             continue
 3174:         if status.get("effective_mode") == "organized":
 3175:             active.append({"agent_id": data.get("agent_id"), "session_id": data.get("session_id"), "project_root": normalize_path_string(str(project_root.resolve()))})
 3176:     return active
 3177: 
