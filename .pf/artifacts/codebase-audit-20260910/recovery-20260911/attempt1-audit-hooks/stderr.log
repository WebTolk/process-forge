22024: def update_entity_manifest_records(workplace_root: Path) -> list[dict[str, Any]]:
22025:     manifest = workplace_root / "workplace.yaml"
22026:     records: list[dict[str, Any]] = []
22027:     seen: set[Path] = set()
22028: 
22029:     package_roots = workplace_package_root_paths(manifest if manifest.is_file() else None)
22030:     if not package_roots:
22031:         package_roots = [path_resolution_to_path(workplace_path_resolution(workplace_root, "${PF_WORKPLACE}/packages"))]
22032:     for root in package_roots:
22033:         for path in update_manifest_candidates_under(root, ["*.yaml", "*.yml", "*/package.yaml", "*/package.yml"]):
22034:             if path in seen:
22035:                 continue
22036:             seen.add(path)
22037:             data = load_update_yaml(path)
22038:             if not data.get("id"):
22039:                 continue
22040:             subject_type = str(data.get("type") or "knowledge_package")
22041:             if subject_type not in UPDATE_SUBJECT_TYPES:
22042:                 subject_type = "knowledge_package"
22043:             records.append(
22044:                 {
