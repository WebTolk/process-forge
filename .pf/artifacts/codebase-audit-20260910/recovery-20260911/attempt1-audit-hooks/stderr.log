  277: class RuntimeProcess:
  278:     def __init__(self, workplace_root: Path, core: Any, *, interval: float) -> None:
  279:         self.workplace_root = workplace_root
  280:         self.core = core
  281:         self.interval = max(0.25, float(interval))
  282:         self.token = load_token(workplace_root)
  283:         self.stop_event = threading.Event()
  284:         self.httpd: ThreadingHTTPServer | None = None
  285:         self.instance_id = uuid.uuid4().hex
  286:         self.state: dict[str, Any] = base_state(workplace_root, core, status="starting", instance_id=self.instance_id)
  287:         self.state_lock = threading.RLock()
  288: 
  289:     def save(self) -> None:
  290:         with self.state_lock:
  291:             save_service_state(self.workplace_root, self.core, self.state)
  292: 
  293:     def known_project_roots(self) -> list[Path]:
  294:         state = host.load_state(self.workplace_root)
  295:         roots: list[Path] = []
  296:         for item in state.get("projects", []):
  297:             if isinstance(item, dict) and item.get("project_root"):
  298:                 try:
  299:                     roots.append(host.resolve_project(str(item["project_root"]), self.core))
  300:                 except SystemExit:
  301:                     continue
  302:         return roots
  303: 
  304:     def status_payload(self) -> dict[str, Any]:
  305:         roots = self.known_project_roots()
  306:         runtime_host = host.load_state(self.workplace_root)
  307:         with self.state_lock:
  308:             payload = dict(self.state)
  309:         payload["health"] = "ready" if self.state.get("status") == "ready" else self.state.get("health", self.state.get("status"))
  310:         payload["known_projects"] = runtime_host.get("projects", [])
  311:         payload["active_agent_sessions"] = len(self.core.iter_agent_presence(self.workplace_root))
  312:         payload["active_workers"] = self.active_worker_count(roots)
  313:         payload["pending_runtime_jobs"] = 0
  314:         payload["last_event"] = self.last_event(roots)
  315:         payload["last_scheduler_error"] = self.state.get("last_scheduler_error")
  316:         return payload
  317: 
  318:     def active_worker_count(self, roots: list[Path]) -> int:
  319:         count = 0
  320:         for project_root in roots:
  321:             agent_runs = self.core.locate_flow_root(project_root) / "runtime" / "agent-runs"
  322:             for status_path in agent_runs.glob("*/*/status.json") if agent_runs.is_dir() else []:
  323:                 state = self.core.json_read(status_path)
  324:                 if str(state.get("status") or "") == "running":
  325:                     count += 1
  326:         return count
  327: 
  328:     def last_event(self, roots: list[Path]) -> dict[str, Any] | None:
  329:         latest: dict[str, Any] | None = None
  330:         for project_root in roots:
  331:             events_path, _outbox = self.core.event_runtime_paths(project_root)
  332:             if not events_path.is_file():
  333:                 continue
  334:             item = last_json_object(events_path)
  335:             if item is not None:
  336:                 latest = {"project_id": self.core.project_id(project_root), "event_id": item.get("event_id"), "event_type": item.get("event_type"), "time": item.get("time")}
  337:         return latest
  338: 
  339:     def assert_session_project_scope(self, payload: dict[str, Any]) -> None:
  340:         session_id = str(payload.get("session_id") or "")
  341:         project_ref = payload.get("project_root")
  342:         if not session_id or not project_ref:
  343:             return
  344:         session_project = host.project_for_session(argparse.Namespace(session=session_id, project_root=None), self.workplace_root, self.core)
  345:         requested_project = host.resolve_project(str(project_ref), self.core)
  346:         if self.core.project_id(session_project) != self.core.project_id(requested_project):
  347:             raise PermissionError("session is not authorized for requested project_root")
  348: 
  349:     def scheduler_loop(self) -> None:
  350:         while not self.stop_event.wait(self.interval):
  351:             roots = self.known_project_roots()
  352:             try:
  353:                 self.core.update_stale_agent_presence(self.workplace_root)
  354:                 payload, status = host.tick_payload(self.workplace_root, roots, self.core, director=True, inspector=True)
  355:                 with self.state_lock:
  356:                     jobs = self.state.setdefault("scheduler", {}).setdefault("jobs", {})
  357:                     now = self.core.now_utc()
  358:                     jobs.setdefault("ledger", {})["last_run"] = now
  359:                     jobs["ledger"]["last_result"] = "ok"
  360:                     jobs.setdefault("director", {})["last_run"] = now
  361:                     jobs["director"]["last_result"] = "ok" if status == 0 else "failed"
  362:                     jobs.setdefault("inspector", {})["last_run"] = now
  363:                     jobs["inspector"]["last_result"] = "ok" if status == 0 else "failed"
  364:                     jobs.setdefault("projection", {})["last_run"] = now
  365:                     jobs["projection"]["last_result"] = "ok" if status == 0 else "failed"
  366:                     self.state["last_scheduler_result"] = payload
  367:                     self.state.pop("last_scheduler_error", None)
  368:             except Exception as exc:  # noqa: BLE001 - runtime must degrade, not crash on one bad project.
  369:                 with self.state_lock:
  370:                     self.state["health"] = "degraded"
  371:                     self.state["last_scheduler_error"] = str(exc)
  372:                 append_operator_log(self.workplace_root, self.core, "scheduler.error", error=str(exc))
  373:             self.save()
