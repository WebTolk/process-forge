 6461: def core_hardcode_violations(root: Path) -> list[str]:
 6462:     policy = load_policy_document("core-hardcode-policy.yaml", root)
 6463:     patterns = policy_entries(policy, "forbidden_core_patterns")
 6464:     if not patterns:
 6465:         return []
 6466:     targets = policy.get("targets")
 6467:     target_patterns = [str(item) for item in targets] if isinstance(targets, list) else ["tools/processforge.py"]
 6468:     allowed_patterns = [str(item) for item in policy.get("allowed_paths", [])] if isinstance(policy.get("allowed_paths"), list) else []
 6469:     target_paths: list[Path] = []
 6470:     for target in target_patterns:
 6471:         matches = [path for path in root.glob(target) if path.is_file()] if any(char in target for char in "*?[]") else [root / target]
 6472:         target_paths.extend(path for path in matches if path.is_file())
 6473:     violations: list[str] = []
 6474:     for path in sorted(set(target_paths), key=lambda item: item.as_posix()):
 6475:         target = rel(path, root)
 6476:         if any(fnmatch.fnmatch(target, pattern) for pattern in allowed_patterns):
 6477:             continue
 6478:         text = path.read_text(encoding="utf-8", errors="replace")
 6479:         for entry in patterns:
 6480:             entry_targets = [str(item) for item in entry.get("targets", [])] if isinstance(entry.get("targets"), list) else []
 6481:             if entry_targets and not any(fnmatch.fnmatch(target, pattern) for pattern in entry_targets):
 6482:                 continue
 6483:             entry_allowed = [str(item) for item in entry.get("allowed_paths", [])] if isinstance(entry.get("allowed_paths"), list) else []
 6484:             if any(fnmatch.fnmatch(target, pattern) for pattern in entry_allowed):
 6485:                 continue
 6486:             raw_pattern = entry.get("pattern") or entry.get("id")
 6487:             if not raw_pattern:
 6488:                 continue
 6489:             flags = re.IGNORECASE if bool(entry.get("case_insensitive", False)) else 0
 6490:             try:
 6491:                 matched = re.search(str(raw_pattern), text, flags)
 6492:             except re.error:
 6493:                 matched = str(raw_pattern) in text
 6494:             if matched:
 6495:                 violations.append(f"{target}: {entry.get('id', raw_pattern)}")
 6496:     return violations
 6497: 
