 3908: def project_runtime_launcher_files(flow_root: Path) -> dict[Path, str]:
 3909:     launcher_py = r'''#!/usr/bin/env python3
 3910: """Project-local ProcessForge launcher.
 3911: 
 3912: This file lives under .pf/runtime/ and may read private local paths from
 3913: .pf/process-forge.local.yaml. Public project files should use `pf` or this
 3914: launcher without exposing resolved local paths.
 3915: """
 3916: 
 3917: from __future__ import annotations
 3918: 
 3919: import os
 3920: import subprocess
 3921: import sys
 3922: from pathlib import Path
 3923: 
 3924: 
 3925: def project_marker(path: Path) -> bool:
 3926:     return (path / ".pf" / "process-forge.local.yaml").is_file()
 3927: 
 3928: 
 3929: def find_project_root(start: Path) -> Path | None:
 3930:     current = start.resolve()
 3931:     if project_marker(current):
 3932:         return current
 3933:     script_path = Path(__file__).resolve()
 3934:     script_project = script_path.parents[3] if len(script_path.parents) > 3 else None
 3935:     if script_project and project_marker(script_project):
 3936:         return script_project
 3937:     for candidate in [current, *current.parents, *script_path.parents]:
 3938:         if project_marker(candidate):
 3939:             return candidate
 3940:     return None
 3941: 
 3942: 
 3943: def yaml_scalar(text: str, key: str) -> str | None:
 3944:     prefix = key + ":"
 3945:     for line in text.splitlines():
 3946:         stripped = line.strip()
 3947:         if stripped.startswith(prefix):
 3948:             value = stripped[len(prefix) :].strip()
 3949:             if value in {"", "null", "None", "~"}:
 3950:                 return None
 3951:             return value.strip("'\"")
 3952:     return None
 3953: 
 3954: 
 3955: def resolve_path(base: Path, raw: str) -> Path:
 3956:     path = Path(raw)
 3957:     if path.is_absolute():
 3958:         return path
 3959:     return (base / path).resolve()
 3960: 
 3961: 
 3962: def exec_args(args: list[str]) -> list[str]:
 3963:     if os.name != "nt":
 3964:         return args
 3965:     return [subprocess.list2cmdline([arg]) for arg in args]
 3966: 
 3967: 
 3968: def exec_processforge(cli: Path, argv: list[str]) -> int:
 3969:     args = exec_args([sys.executable, str(cli), *argv])
 3970:     if os.name == "nt":
 3971:         return os.spawnv(os.P_WAIT, sys.executable, args)
 3972:     os.execv(sys.executable, args)
 3973:     return 2
 3974: 
 3975: 
 3976: def distribution_from_workplace(workplace_manifest: Path) -> Path | None:
 3977:     registry = workplace_manifest.parent / "registries" / "distributions.yaml"
 3978:     if not registry.is_file():
 3979:         return None
 3980:     lines = registry.read_text(encoding="utf-8", errors="replace").splitlines()
 3981:     in_processforge = False
 3982:     for line in lines:
 3983:         stripped = line.strip()
 3984:         if stripped.startswith("id:"):
 3985:             in_processforge = stripped.split(":", 1)[1].strip().strip("'\"") == "processforge"
 3986:         elif in_processforge and stripped.startswith("path:"):
 3987:             raw = stripped.split(":", 1)[1].strip().strip("'\"")
 3988:             raw = raw.replace("${PF_WORKPLACE}", str(workplace_manifest.parent))
 3989:             return resolve_path(workplace_manifest.parent, raw)
 3990:     return None
 3991: 
 3992: 
 3993: def distribution_root(project_root: Path) -> Path | None:
 3994:     env_home = os.environ.get("PROCESSFORGE_HOME")
 3995:     local_manifest = project_root / ".pf" / "process-forge.local.yaml"
 3996:     if local_manifest.is_file():
 3997:         text = local_manifest.read_text(encoding="utf-8", errors="replace")
 3998:         override = yaml_scalar(text, "distribution_override")
 3999:         if override:
 4000:             return resolve_path(local_manifest.parent, override)
 4001:         workplace_raw = yaml_scalar(text, "manifest")
 4002:         if workplace_raw:
 4003:             workplace = resolve_path(local_manifest.parent, workplace_raw)
 4004:             found = distribution_from_workplace(workplace)
 4005:             if found:
 4006:                 return found
 4007:     if env_home:
 4008:         return Path(env_home).expanduser().resolve()
 4009:     return None
 4010: 
 4011: 
 4012: def main(argv: list[str]) -> int:
 4013:     project_root = find_project_root(Path.cwd())
 4014:     if project_root is None:
 4015:         message = """FAIL: ProcessForge project root not found.
 4016: 
 4017: Fix:
 4018:   Run this launcher from a ProcessForge project root, pass --project-root to the command, or rerun project-onboard."""
 4019:         print(message, file=sys.stderr)
 4020:         return 1
 4021:     distribution = distribution_root(project_root)
 4022:     if not distribution:
 4023:         message = """FAIL: ProcessForge distribution not found.
 4024: 
 4025: Fix:
 4026:   Set PROCESSFORGE_HOME to the ProcessForge distribution root, or rerun project-onboard from the distribution."""
 4027:         print(message, file=sys.stderr)
 4028:         return 1
 4029:     cli = distribution / "tools" / "processforge.py"
 4030:     if not cli.is_file():
 4031:         message = f"""FAIL: ProcessForge CLI not found under distribution root: {distribution}
 4032: 
 4033: Fix:
 4034:   Check PROCESSFORGE_HOME or rerun project-onboard so .pf/process-forge.local.yaml points to a valid distribution."""
 4035:         print(message, file=sys.stderr)
 4036:         return 1
 4037:     try:
 4038:         return exec_processforge(cli, argv)
 4039:     except OSError as exc:
 4040:         print("FAIL: could not exec ProcessForge CLI", file=sys.stderr)
 4041:         print(f"Reason: {exc}", file=sys.stderr)
 4042:         return 2
 4043: 
 4044: 
 4045: if __name__ == "__main__":
 4046:     raise SystemExit(main(sys.argv[1:]))
 4047: '''
 4048:     launcher_sh = """#!/usr/bin/env sh
 4049: SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
 4050: if command -v python3 >/dev/null 2>&1; then
 4051:   exec python3 "$SCRIPT_DIR/pf.py" "$@"
 4052: fi
 4053: exec python "$SCRIPT_DIR/pf.py" "$@"
 4054: """
 4055:     launcher_bat = """@echo off
 4056: set SCRIPT_DIR=%~dp0
 4057: py -3 "%SCRIPT_DIR%pf.py" %*
 4058: if errorlevel 9009 python "%SCRIPT_DIR%pf.py" %*
 4059: """
 4060:     return {
 4061:         flow_root / "runtime" / "bin" / "pf.py": launcher_py,
 4062:         flow_root / "runtime" / "bin" / "pf": launcher_sh,
 4063:         flow_root / "runtime" / "bin" / "pf.bat": launcher_bat,
 4064:     }
 4065: 
 4066: 
