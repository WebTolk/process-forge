 6096: def gitignore_effectively_protects(project_root: Path, entry: str) -> bool | None:
 6097:     if not (project_root / ".git").exists():
 6098:         return None
 6099:     probe = entry.rstrip("/")
 6100:     if not probe:
 6101:         return None
 6102:     result = subprocess.run(
 6103:         ["git", "check-ignore", "--quiet", "--", probe],
 6104:         cwd=project_root,
 6105:         stdout=subprocess.DEVNULL,
 6106:         stderr=subprocess.DEVNULL,
 6107:         text=True,
 6108:         check=False,
 6109:     )
 6110:     if result.returncode == 0:
 6111:         return True
 6112:     if result.returncode == 1:
 6113:         return False
 6114:     return None
 6115: 
