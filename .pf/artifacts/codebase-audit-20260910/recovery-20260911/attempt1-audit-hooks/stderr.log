 1610: def upsert_bounded_section(existing: str, section: str) -> str:
 1611:     section = ensure_trailing_newline(section).rstrip()
 1612:     pattern = re.compile(
 1613:         re.escape(GLOBAL_AGENT_SECTION_START) + r".*?" + re.escape(GLOBAL_AGENT_SECTION_END),
 1614:         re.DOTALL,
 1615:     )
 1616:     if pattern.search(existing):
 1617:         return ensure_trailing_newline(pattern.sub(section, existing).rstrip())
 1618:     if existing.strip():
 1619:         return ensure_trailing_newline(existing.rstrip() + "\n\n" + section)
 1620:     return ensure_trailing_newline(section)
 1621: 
