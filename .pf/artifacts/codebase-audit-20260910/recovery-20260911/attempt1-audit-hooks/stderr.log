 6428: def forbidden_base_technology_platform_reference(text: str) -> bool:
 6429:     policy = load_policy_document("platform-id-policy.yaml")
 6430:     discouraged = [
 6431:         str(item.get("id") if isinstance(item, dict) else item)
 6432:         for item in policy.get("discouraged_platform_ids", [])
 6433:         if (item.get("id") if isinstance(item, dict) else item)
 6434:     ]
 6435:     if not discouraged:
 6436:         return False
 6437:     allowed_markers = [
 6438:         "incorrect",
 6439:         "discouraged",
 6440:         "do not create",
 6441:         "not as platform contracts",
 6442:         "not platform contracts",
 6443:         "не создавайте",
 6444:         "а не как platform contracts",
 6445:         "не как platform contracts",
 6446:         "не являются platform contracts",
 6447:     ]
 6448:     lines = text.splitlines()
 6449:     for index, line in enumerate(lines):
 6450:         lower = line.lower()
 6451:         matched = [platform_id for platform_id in discouraged if platform_id.lower() in lower]
 6452:         if not matched:
 6453:             continue
 6454:         context = " ".join(lines[max(0, index - 2) : min(len(lines), index + 3)]).lower()
 6455:         allowed_discouraged_example = any(marker in context for marker in allowed_markers)
 6456:         if not allowed_discouraged_example:
 6457:             return True
 6458:     return False
