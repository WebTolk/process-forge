21375:                 "required capabilities covered by explicit runtime-access waiver: " + ", ".join(waived_capabilities),
21376:             )
21377:         )
21378:     elif resource_report.is_file():
21379:         checks.append(check("PASS", "required capabilities are resolved or built in"))
21380:     if report_section_has_items(resource_report, "## Missing Required Platform Contracts"):
21381:         checks.append(check("FAIL", """required platform contract is missing from workplace registry
21382: Why:
