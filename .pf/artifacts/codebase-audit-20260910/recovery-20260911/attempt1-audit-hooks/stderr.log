 6528: def release_checks(root: Path) -> list[Check]:
 6529:     checks: list[Check] = []
 6530:     patterns = release_ignore_patterns(root)
 6531:     public_support_policy = load_policy_document("public-support-policy.yaml", root)
 6532:     public_support_policy_loaded = bool(policy_entries(public_support_policy, "blocked_public_surface_patterns"))
 6533:     public_support_policy_failed = False
 6534:     if not patterns:
 6535:         checks.append(
 6536:             check_with_hint(
 6537:                 "FAIL",
 6538:                 ".processforge-releaseignore missing or empty",
 6539:                 "The release packer needs an explicit exclusion policy.",
 6540:                 "create .processforge-releaseignore with runtime, private, cache, IDE, and archive exclusions",
 6541:             )
 6542:         )
 6543:     else:
 6544:         checks.append(check("PASS", ".processforge-releaseignore loaded"))
 6545: 
 6546:     for required in RELEASE_REQUIRED_PATHS:
 6547:         checks.append(
 6548:             check_with_hint(
 6549:                 "FAIL",
 6550:                 f"required release path missing: {required}",
 6551:                 "The v0.1 archive contract lists this path as part of the public distribution.",
 6552:                 f"restore or generate {required} before release-pack",
 6553:             )
 6554:             if not release_required_path_exists(root, required)
 6555:             else check("PASS", f"required release path present: {required}")
 6556:         )
 6557: 
 6558:     core_violations = core_hardcode_violations(root)
 6559:     if core_violations:
 6560:         for violation in core_violations:
 6561:             checks.append(
 6562:                 check_with_hint(
 6563:                     "FAIL",
 6564:                     f"core platform hardcode policy violation: {violation}",
 6565:                     "ProcessForge core must load platform/package behavior from manifests and policies, not concrete platform ids in Python logic.",
 6566:                     "move the rule to a seed manifest or policy YAML and keep tools/processforge.py generic",
 6567:                 )
 6568:             )
 6569:     elif load_policy_document("core-hardcode-policy.yaml", root):
 6570:         checks.append(
 6571:             check("PASS", "core platform hardcode policy passed")
 6572:         )
 6573: 
 6574:     for archive_path, path in release_source_files(root):
 6575:         if release_ignore_match(archive_path, patterns):
 6576:             continue
 6577:         forbidden = release_path_is_forbidden(archive_path)
 6578:         if forbidden:
 6579:             checks.append(
 6580:                 check_with_hint(
 6581:                     "FAIL",
 6582:                     f"{archive_path}: {forbidden}",
 6583:                     "Release archives must not contain runtime, private, cache, script-wrapper, or previous archive artifacts.",
 6584:                     "python tools/processforge.py clean --root . --release",
 6585:                 )
 6586:             )
 6587:             continue
 6588:         if path.suffix.lower() in RELEASE_TEXT_SUFFIXES:
 6589:             text = path.read_text(encoding="utf-8", errors="replace")
 6590:             lower = text.lower()
 6591:             release_text_group = archive_path.split("/", 1)[0]
 6592:             user_facing_text = release_text_group in {"README.md", "QUICKSTART.md", "CHANGELOG.md", "VERSION", "AGENTS.md", "docs", "prompts", "examples", "processes", "packages", "packs", "templates", "policies", "seeds"}
 6593:             if release_text_group in {"README.md", "QUICKSTART.md", "docs", "prompts", "examples"} and forbidden_powershell_reference(text):
 6594:                 checks.append(
 6595:                     check_with_hint(
 6596:                         "FAIL",
 6597:                         f"{archive_path}: public release text references PowerShell/.ps1",
 6598:                         "The v0.1 flow is Python-first and public docs should not direct users to unsupported wrappers.",
 6599:                         "replace the command with python bin/pf.py or python .pf/runtime/bin/pf.py",
 6600:                     )
 6601:                 )
 6602:             if release_text_group in {"docs", "prompts", "examples", "templates", "packages", "processes"} and forbidden_base_technology_platform_reference(text):
 6603:                 checks.append(
 6604:                     check_with_hint(
 6605:                         "FAIL",
 6606:                         f"{archive_path}: public release text introduces a base-technology platform",
 6607:                         "Base languages and web technologies are knowledge packages and capabilities in v0.1, not platform contracts.",
 6608:                         "replace base-technology platform examples with docs.* knowledge package examples",
 6609:                     )
 6610:                 )
 6611:             for violation in public_support_policy_violations(archive_path, text, public_support_policy):
 6612:                 public_support_policy_failed = True
 6613:                 checks.append(
 6614:                     check_with_hint(
 6615:                         "FAIL",
 6616:                         f"{archive_path}: {violation}",
 6617:                         "Built-in seeds, examples, templates, packages, processes, and prompts must stay neutral unless a support pack is explicitly shipped.",
 6618:                         "replace the public sample with neutral ids or add an explicit policy exception for an intentional support pack",
 6619:                     )
 6620:                 )
 6621:             if user_facing_text and not is_public_path_safe(text):
 6622:                 checks.append(
 6623:                     check_with_hint(
 6624:                         "FAIL",
 6625:                         f"{archive_path}: public text contains a private absolute path",
 6626:                         "Public release files must be portable across machines.",
 6627:                         "replace local filesystem values with path_ref, placeholders, or relative paths",
 6628:                     )
 6629:                 )
 6630:             if user_facing_text and contains_secret_value(text):
 6631:                 checks.append(
 6632:                     check_with_hint(
 6633:                         "FAIL",
 6634:                         f"{archive_path}: public text appears to contain a secret value",
 6635:                         "Release files cannot contain credentials, tokens, or private keys.",
 6636:                         "remove the secret and keep only a named secret reference",
 6637:                     )
 6638:                 )
 6639:     if public_support_policy_loaded and not public_support_policy_failed:
 6640:         checks.append(check("PASS", "public support surface policy passed"))
 6641:     if not any(item.level == "FAIL" for item in checks):
 6642:         checks.append(check("PASS", "release surface excludes runtime/private/cache/script/archive artifacts"))
 6643:     return checks
