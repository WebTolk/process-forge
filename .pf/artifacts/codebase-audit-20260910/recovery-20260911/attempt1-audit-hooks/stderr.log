25552:         "optional_templates": optional_templates,
25553:         "required_tools": required_tools,
25554:         "recommended_tools": recommended_tools,
25555:         "optional_tools": optional_tools,
25556:         "required_mcp": required_mcp,
25557:         "recommended_mcp": recommended_mcp,
