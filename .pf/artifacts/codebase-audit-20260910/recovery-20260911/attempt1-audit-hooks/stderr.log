23432: def command_update_rollback(args: argparse.Namespace) -> int:
23433:     workplace_root = update_workplace_root(args.workplace)
23434:     candidate = find_update_candidate(workplace_root, args.candidate)
23435:     if not candidate:
23436:         print(f"FAIL: candidate not found: {args.candidate}")
23437:         return 1
23438:     subject = candidate.get("subject") if isinstance(candidate.get("subject"), dict) else {}
23439:     policy = candidate.get("update_policy") if isinstance(candidate.get("update_policy"), dict) else {}
23440:     backup_dir = update_runtime_root(workplace_root) / "backups" / args.candidate
23441:     if policy.get("mode") == "replace_file" or subject.get("type") in {"tool_definition", "tool_package", "tool"}:
23442:         paths = policy.get("executable_paths") if isinstance(policy.get("executable_paths"), list) else []
23443:         if not paths:
23444:             print("FAIL: tool rollback requires update_policy.executable_paths")
23445:             return 1
23446:         destination = path_resolution_to_path(workplace_path_resolution(workplace_root, str(paths[0])))
23447:         backup_file = backup_dir / "previous-file"
23448:         if not backup_file.is_file():
23449:             print(f"FAIL: backup not found: {backup_file}")
23450:             return 1
23451:         shutil.copy2(backup_file, destination)
23452:         restore_path = destination
23453:     else:
23454:         install_path = update_install_path(workplace_root, candidate)
23455:         backup_tree = backup_dir / "previous"
23456:         if not backup_tree.is_dir():
23457:             print(f"FAIL: backup not found: {backup_tree}")
23458:             return 1
23459:         if install_path.exists():
23460:             shutil.rmtree(install_path)
23461:         shutil.copytree(backup_tree, install_path)
23462:         restore_path = install_path
23463:     record = {"schema_version": 1, "candidate_id": args.candidate, "rolled_back_at": now_utc(), "status": "rolled_back", "restore_path": rel(restore_path, workplace_root)}
23464:     rollback_dir = update_runtime_root(workplace_root) / "rollbacks" / args.candidate
23465:     rollback_dir.mkdir(parents=True, exist_ok=True)
23466:     (rollback_dir / "rollback-record.yaml").write_text(dump_yaml(record), encoding="utf-8")
23467:     marked = mark_impacted_project_contexts_after_update(workplace_root, candidate, reason="update-rollback")
23468:     print(f"ROLLED_BACK: {args.candidate}")
23469:     print(f"RESTORE_PATH: {rel(restore_path, workplace_root)}")
23470:     if marked:
23471:         print("SNAPSHOTS_MARKED_STALE: " + ", ".join(rel(path, workplace_root) for path in marked))
23472:     print_search_index_maintenance_summary(search_index_maintenance_for_known_projects(workplace_root, reason="update-rollback"))
23473:     return 0
