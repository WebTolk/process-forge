 6816: 
 6817: @dataclass
 6818: class ReleaseCommandResult:
 6819:     label: str
 6820:     status: str
 6821:     code: int
 6822:     output: str
 6823:     started_at: str
 6824:     finished_at: str
 6825:     elapsed_seconds: float
 6826:     timeout_seconds: int
 6827:     command: list[str]
 6828:     layer: str = "public"
 6829:     public_gate: bool = True
 6830: 
 6831: 
 6832: def format_command(command: list[str]) -> str:
 6833:     return format_subprocess_command(command)
 6834: 
 6835: 
 6836: def run_release_command(label: str, command: list[str], cwd: Path, timeout: int, allow_warn: bool = False, *, layer: str = "public", public_gate: bool = True) -> ReleaseCommandResult:
 6837:     started_at = now_utc()
 6838:     started = time.perf_counter()
 6839:     print(f"RUN {label}:")
 6840:     print(f"  {format_command(command)}")
 6841:     print(f"  started_at: {started_at}")
 6842:     sys.stdout.flush()
 6843:     result = run_subprocess_command(command, cwd=cwd, timeout=timeout)
 6844:     elapsed = time.perf_counter() - started
 6845:     finished_at = now_utc()
 6846:     output = "\n".join(part for part in [result.stdout, result.stderr] if part)
 6847:     if result.timed_out:
 6848:         return ReleaseCommandResult(label, "FAIL", 124, f"timeout after {timeout}s\n{diagnostic_text(result)}", started_at, finished_at, elapsed, timeout, command, layer, public_gate)
 6849:     code = int(result.returncode or 0)
 6850:     if code == 0:
 6851:         return ReleaseCommandResult(label, "PASS", 0, output, started_at, finished_at, elapsed, timeout, command, layer, public_gate)
 6852:     if allow_warn:
 6853:         return ReleaseCommandResult(label, "WARN", code, output, started_at, finished_at, elapsed, timeout, command, layer, public_gate)
 6854:     return ReleaseCommandResult(label, "FAIL", code, output, started_at, finished_at, elapsed, timeout, command, layer, public_gate)
 6855: 
 6856: 
 6857: def print_release_command_output(result: ReleaseCommandResult) -> None:
 6858:     print(f"{result.status} {result.label}")
 6859:     print(f"  finished_at: {result.finished_at}")
 6860:     print(f"  elapsed_seconds: {result.elapsed_seconds:.2f}")
 6861:     if result.status != "PASS":
 6862:         print(f"  exit: {result.code}")
 6863:         tail_lines = result.output.splitlines()[-30:]
 6864:         for line in tail_lines:
 6865:             print(f"  {line}")
