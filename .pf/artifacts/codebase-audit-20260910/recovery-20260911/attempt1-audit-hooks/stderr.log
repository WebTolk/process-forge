23881: def write_resource_proposal(workplace_root: Path, command: str, object_id: str, payload: dict[str, Any], slug: str | None = None) -> tuple[str, Path]:
23882:     slug = slug or resource_management_slug(command, object_id)
23883:     proposal = {
23884:         "schema_version": 1,
23885:         "proposal_id": slug,
23886:         "command": command,
23887:         "created_at": now_utc(),
23888:         "mode": "proposal_first",
23889:         "payload": payload,
23890:         "privacy": {
23891:             "public_project_files_must_not_contain_absolute_paths": True,
23892:             "secret_values_stored": False,
23893:         },
23894:     }
23895:     path = write_resource_management_artifact(workplace_root, "proposals", slug, dump_yaml(proposal))
23896:     return slug, path
