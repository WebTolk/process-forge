 6522: def release_required_path_exists(root: Path, archive_path: str) -> bool:
 6523:     if archive_path == "AGENTS.md":
 6524:         return (root / "AGENTS.md").is_file() or (root / ".pf" / "AGENTS.md").is_file()
 6525:     return (root / archive_path).exists()
