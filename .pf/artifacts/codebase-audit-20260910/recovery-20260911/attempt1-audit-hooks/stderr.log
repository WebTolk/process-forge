 1258: 
 1259: def tick_payload(
 1260:     workplace_root: Path,
 1261:     project_roots: list[Path],
 1262:     core: Any,
 1263:     *,
 1264:     director: bool = False,
 1265:     inspector: bool = False,
 1266:     run: str | None = None,
 1267:     profile: str | None = None,
 1268:     driver: str | None = None,
 1269:     wait_ttl: int = 3600,
 1270:     lease_ttl: int = 3600,
 1271: ) -> tuple[dict[str, Any], int]:
 1272:     with state_lock():
 1273:         state = load_state(workplace_root)
 1274:         core.update_stale_agent_presence(workplace_root)
 1275:         results: list[dict[str, Any]] = []
 1276:         status = 0
 1277:         for project_root in project_roots:
 1278:             handle = route_project(str(project_root), workplace_root, core)
 1279:             remember_project(state, handle)
 1280:             item: dict[str, Any] = {"project_id": handle["project_id"], "effective_mode": handle["effective_mode"], "director": "skipped", "inspector": "skipped"}
 1281:             if director:
 1282:                 if handle["effective_mode"] == "organized":
 1283:                     rc = call_quiet(core.command_agent_director_tick, argparse.Namespace(workplace=str(workplace_root), project_root=str(project_root), project_id=handle["project_id"], wait_ttl=wait_ttl, lease_ttl=lease_ttl))
 1284:                     item["director"] = "tick"
 1285:                     status = status or rc
 1286:                 else:
 1287:                     item["director"] = "skipped_simple"
 1288:             if inspector:
 1289:                 rc = call_quiet(core.command_supervisor_tick, argparse.Namespace(project_root=str(project_root), run=run, profile=profile, driver=driver, start_allowed=False))
 1290:                 item["inspector"] = "tick"
 1291:                 status = status or rc
 1292:             stage_projection = rebuild_stage_obligations(project_root, core)
 1293:             item["projection"] = core.rel(stage_projection, project_root)
 1294:             results.append(item)
 1295:         save_state(workplace_root, state, core)
 1296:         payload = {"status": "ok" if status == 0 else "failed", "projects": results}
 1297:         return payload, status
 1298: 
