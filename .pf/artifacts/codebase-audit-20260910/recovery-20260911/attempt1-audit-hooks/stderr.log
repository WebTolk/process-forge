 1249: def command_tick(args: argparse.Namespace, core: Any) -> int:
 1250:     project_roots = [resolve_project(value, core) for value in getattr(args, "project_root", [])]
 1251:     if not project_roots:
 1252:         raise SystemExit("FAIL: runtime-host tick requires at least one --project-root")
 1253:     workplace_root = resolve_workplace(args, project_roots[0], core)
 1254:     payload, status = tick_payload(workplace_root, project_roots, core, director=getattr(args, "director", False), inspector=getattr(args, "inspector", False), run=getattr(args, "run", None), profile=getattr(args, "profile", None), driver=getattr(args, "driver", None), wait_ttl=getattr(args, "wait_ttl", 3600), lease_ttl=getattr(args, "lease_ttl", 3600))
 1255:     print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if getattr(args, "json", False) else core.dump_yaml(payload))
 1256:     return status
