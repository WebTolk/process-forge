 4805: def resource_profile_capability_provider(specialization_id: str, resources: dict[str, Any]) -> dict[str, Any]:
 4806:     provider: dict[str, Any] = {"specialization": specialization_id}
 4807:     for key in RESOURCE_GROUP_KEYS:
 4808:         values: set[str] = set()
 4809:         for bucket in ["requires", "recommends", "optional"]:
 4810:             values.update(resource_bucket(resources, bucket, key))
 4811:         provider[key] = dedupe_sorted(list(values))
 4812:     return provider
