21568: def source_requires_https(source: dict[str, Any], defaults: dict[str, Any] | None = None) -> bool:
21569:     trust = source.get("trust") if isinstance(source.get("trust"), dict) else {}
21570:     if "require_https" in trust:
21571:         return bool(trust.get("require_https"))
21572:     if defaults and "require_https" in defaults:
21573:         return bool(defaults.get("require_https"))
21574:     return True
