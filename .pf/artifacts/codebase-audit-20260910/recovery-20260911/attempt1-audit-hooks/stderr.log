24729:                 check_with_hint(
24730:                     "FAIL",
24731:                     f"circular platform inheritance detected: {cycle}",
24732:                     "Platform inheritance must resolve to an acyclic parent-first stack.",
24733:                     "remove one extends edge from the cycle and rerun platform-contract-doctor",
24734:                 )
24735:             )
24736:         checks.append(check("PASS" if platform_resolution["platform_stack"] else "FAIL", "resolved platform stack valid"))
24737:         checks.append(check("PASS", "resolved platform stack computed without mutating workplace state"))
24738:         inherited_required, inherited_recommended = platform_resource_findings(workplace_root / "workplace.yaml", platform_resolution)
24739:         for item in inherited_required:
24740:             checks.append(
24741:                 check_with_hint(
24742:                     "FAIL",
24743:                     f"required {item['kind']} available through resolved platform stack: {item['id']}",
24744:                     "A platform in the resolved stack marks this resource as required.",
24745:                     "register the missing resource in the workplace registry or package roots before using this platform",
24746:                 )
24747:             )
24748:         for item in inherited_recommended:
24749:             checks.append(
24750:                 check_with_hint(
24751:                     "WARN",
24752:                     f"optional {item['kind']} available through resolved platform stack: {item['id']}",
24753:                     "A platform in the resolved stack recommends this resource, but onboarding can continue.",
24754:                     "register the resource if this platform should provide the optional capability",
24755:                 )
24756:             )
24757:         for package_id in list_value(requires.get("knowledge_packages")):
24758:             manifest = package_manifest_index(workplace_root, None, workplace_root / "workplace.yaml").get(package_id)
24759:             checks.append(
24760:                 check("PASS", f"required knowledge package available: {package_id}")
24761:                 if manifest
24762:                 else check_with_hint(
24763:                     "FAIL",
24764:                     f"required knowledge package available: {package_id}",
24765:                     "This platform contract marks the package as required.",
24766:                     f"python bin/pf.py knowledge-package-create --workplace <workplace-root> --id {package_id} --package-root global --title \"{package_id}\" --apply",
24767:                     "mark it as required: false or move it to includes.knowledge_packages if optional",
24768:                 )
24769:             )
24770:         for package_id in contract_includes(data, "knowledge_packages"):
24771:             manifest = package_manifest_index(workplace_root, None, workplace_root / "workplace.yaml").get(package_id)
24772:             checks.append(
24773:                 check("PASS", f"optional knowledge package available: {package_id}")
24774:                 if manifest
24775:                 else check_with_hint(
24776:                     "WARN",
24777:                     f"optional knowledge package available: {package_id}",
24778:                     "This platform contract recommends the package, but onboarding can continue without it.",
24779:                     f"python bin/pf.py knowledge-package-create --workplace <workplace-root> --id {package_id} --package-root global --title \"{package_id}\" --apply",
24780:                 )
24781:             )
24782:         for template_id in list_value(requires.get("templates")):
24783:             checks.append(
24784:                 check("PASS", f"required template available: {template_id}")
24785:                 if template_manifest_path(workplace_root, template_id)
24786:                 else check_with_hint(
24787:                     "FAIL",
24788:                     f"required template available: {template_id}",
24789:                     "This platform contract marks the template as required.",
24790:                     f"python bin/pf.py template-create --workplace <workplace-root> --id {template_id} --title \"{template_id}\" --apply",
24791:                     "move it to includes.templates if optional",
24792:                 )
24793:             )
24794:         for template_id in contract_includes(data, "templates"):
24795:             checks.append(
24796:                 check("PASS", f"optional template available: {template_id}")
24797:                 if template_manifest_path(workplace_root, template_id)
24798:                 else check_with_hint(
24799:                     "WARN",
