23010: def create_update_notifications_from_candidates(workplace_root: Path, candidates: list[dict[str, Any]]) -> dict[str, Any]:
23011:     path = update_notifications_path(workplace_root)
23012:     existing = {}
23013:     if path.is_file():
23014:         try:
23015:             data = json.loads(path.read_text(encoding="utf-8"))
23016:             for item in data.get("notifications", []) if isinstance(data, dict) and isinstance(data.get("notifications"), list) else []:
23017:                 if isinstance(item, dict) and item.get("id"):
23018:                     existing[str(item["id"])] = item
23019:         except json.JSONDecodeError:
23020:             existing = {}
23021:     now = now_utc()
23022:     for candidate in candidates:
23023:         if candidate.get("status") != "available":
23024:             continue
23025:         subject = candidate.get("subject") if isinstance(candidate.get("subject"), dict) else {}
23026:         notification_id = f"notification-{candidate.get('id')}"
23027:         previous = existing.get(notification_id, {})
23028:         if previous.get("status") == "acknowledged":
23029:             continue
23030:         existing[notification_id] = {
23031:             "id": notification_id,
23032:             "type": "update_available",
23033:             "candidate_id": candidate.get("id"),
23034:             "subject": subject,
23035:             "channel": candidate.get("channel") or "stable",
23036:             "version": candidate.get("available_version"),
23037:             "current_version": candidate.get("installed_version") or candidate.get("current_version"),
23038:             "available_version": candidate.get("available_version"),
23039:             "source_id": candidate.get("source_id"),
23040:             "changelog_url": candidate.get("changelog_url"),
23041:             "message": f"Update available: {subject.get('id')} {candidate.get('installed_version') or 'unknown'} -> {candidate.get('available_version')}",
23042:             "first_seen_at": previous.get("first_seen_at") or now,
23043:             "last_notified_at": now,
23044:             "status": "notified",
23045:             "acknowledged_at": None,
23046:             "snoozed_until": None,
23047:         }
23048:     result = {"schema_version": 1, "updated_at": now, "notifications": sorted(existing.values(), key=lambda item: str(item.get("id")))}
23049:     path.parent.mkdir(parents=True, exist_ok=True)
23050:     path.write_text(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
23051:     mirror_update_notifications_to_director(workplace_root, result)
23052:     return result
