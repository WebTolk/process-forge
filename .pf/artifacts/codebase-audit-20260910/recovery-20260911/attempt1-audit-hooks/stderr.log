  110: def load_token(workplace_root: Path) -> str:
  111:     payload = read_json(token_path(workplace_root))
  112:     token = str(payload.get("token") or "")
  113:     if token:
  114:         return token
  115:     token = secrets.token_urlsafe(32)
  116:     write_json_atomic(token_path(workplace_root), {"schema_version": 1, "token": token})
  117:     return token
