 6315: def release_ignore_patterns(root: Path) -> list[str]:
 6316:     path = root / ".processforge-releaseignore"
 6317:     if not path.is_file():
 6318:         return []
 6319:     patterns: list[str] = []
 6320:     for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
 6321:         value = line.strip()
 6322:         if value and not value.startswith("#"):
 6323:             patterns.append(value.replace("\\", "/"))
 6324:     return patterns
 6325: 
 6326: 
 6327: def release_ignore_match(rel_path: str, patterns: list[str]) -> bool:
 6328:     normalized = rel_path.replace("\\", "/").lstrip("./")
 6329:     for pattern in patterns:
 6330:         candidate = pattern.lstrip("./")
 6331:         if candidate.startswith("/"):
 6332:             candidate = candidate[1:]
 6333:         if candidate.endswith("/"):
 6334:             prefix = candidate.rstrip("/")
 6335:             if normalized == prefix or normalized.startswith(prefix + "/"):
 6336:                 return True
 6337:         if fnmatch.fnmatch(normalized, candidate) or fnmatch.fnmatch(Path(normalized).name, candidate):
 6338:             return True
 6339:         if normalized == candidate:
 6340:             return True
 6341:     return False
 6342: 
