 6657: def russian_mojibake_checks(root: Path) -> list[Check]:
 6658:     checks: list[Check] = []
 6659:     failures: list[str] = []
 6660:     for path in russian_documentation_files(root):
 6661:         text = path.read_text(encoding="utf-8", errors="replace")
 6662:         markers = [marker for marker in RUSSIAN_MOJIBAKE_MARKERS if marker in text]
 6663:         if markers:
 6664:             failures.append(f"{rel(path, root)} markers={','.join(markers)}")
 6665:     if failures:
 6666:         checks.extend(check("FAIL", f"Russian documentation mojibake: {item}") for item in failures)
 6667:     else:
 6668:         checks.append(check("PASS", "Russian documentation has no known mojibake markers"))
 6669:     return checks
