21954: def print_update_source_list(data: dict[str, Any], *, json_output: bool = False) -> int:
21955:     sources = sorted_update_sources(data)
21956:     if json_output:
21957:         print(json.dumps({"schema_version": 1, "sources": sources}, ensure_ascii=False, indent=2, sort_keys=True))
21958:         return 0
21959:     print("ID\tENABLED\tPRIORITY\tSOURCE_KIND\tCHANNELS\tLOCATION")
21960:     for source in sources:
21961:         channels = ",".join(str(item) for item in source.get("channels", [])) if isinstance(source.get("channels"), list) else ""
21962:         print(
21963:             "\t".join(
21964:                 [
21965:                     str(source.get("id", "")),
21966:                     str(bool(source.get("enabled", False))).lower(),
21967:                     str(source.get("priority", "")),
21968:                     update_source_kind(source),
21969:                     channels,
21970:                     update_location(source, "provider"),
21971:                 ]
21972:             )
21973:         )
21974:     return 0
