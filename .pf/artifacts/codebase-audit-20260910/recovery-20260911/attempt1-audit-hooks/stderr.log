 6708: def safe_remove_generated_path(path: Path, root: Path) -> bool:
 6709:     def retry_readonly_removal(func: Any, target: str, _exc_info: Any) -> None:
 6710:         """Retry an approved generated-file removal after clearing Windows ReadOnly.
 6711: 
 6712:         Git object files copied into a temporary release stage can retain the
 6713:         Windows ReadOnly attribute.  ``shutil.rmtree`` otherwise aborts the
 6714:         entire release cleanup even though the enclosing path has already
 6715:         passed this function's generated-path containment checks.
 6716:         """
 6717: 
 6718:         target_path = Path(target)
 6719:         target_path.chmod(target_path.stat().st_mode | stat.S_IWRITE)
 6720:         func(target)
 6721: 
 6722:     resolved_root = root.resolve()
 6723:     resolved_path = path.resolve()
 6724:     try:
 6725:         resolved_path.relative_to(resolved_root)
 6726:     except ValueError:
 6727:         return False
 6728:     if path.is_dir() and resolved_path == (resolved_root / ".pf" / "runtime"):
 6729:         shutil.rmtree(path, onerror=retry_readonly_removal)
 6730:         return True
 6731:     if path.is_dir() and path.name in RELEASE_GENERATED_DIRS:
 6732:         shutil.rmtree(path, onerror=retry_readonly_removal)
 6733:         return True
 6734:     if path.is_file() and path.suffix.lower() in RELEASE_GENERATED_SUFFIXES:
 6735:         try:
 6736:             path.unlink()
 6737:         except PermissionError:
 6738:             path.chmod(path.stat().st_mode | stat.S_IWRITE)
 6739:             path.unlink()
 6740:         return True
 6741:     return False
 6742: 
