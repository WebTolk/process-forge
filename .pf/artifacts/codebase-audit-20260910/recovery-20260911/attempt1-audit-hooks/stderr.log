 6369: def release_path_is_forbidden(rel_path: str) -> str | None:
 6370:     normalized = rel_path.replace("\\", "/")
 6371:     if normalized.startswith(("processes/user/", "processes/custom/")) and Path(normalized).name != ".gitkeep":
 6372:         return "private user/custom process definition"
 6373:     for prefix in RELEASE_FORBIDDEN_PF_PREFIXES:
 6374:         if normalized == prefix.rstrip("/") or normalized.startswith(prefix):
 6375:             return f"forbidden .pf release prefix {prefix.rstrip('/')}"
 6376:     parts = Path(rel_path).parts
 6377:     suffix = Path(rel_path).suffix.lower()
 6378:     for part in parts:
 6379:         if part in RELEASE_FORBIDDEN_DIR_PARTS:
 6380:             return f"forbidden directory part {part}"
 6381:     if suffix in RELEASE_FORBIDDEN_SUFFIXES:
 6382:         return f"forbidden suffix {suffix}"
 6383:     if rel_path.endswith(".env") or "/.env" in rel_path or Path(rel_path).name.startswith(".env."):
 6384:         return "private env file"
 6385:     if Path(rel_path).name == "process-forge.local.yaml" and not rel_path.startswith(("examples/", "templates/")):
 6386:         return "private local config"
 6387:     if "runtime/hooks/outbox" in rel_path or "hooks/outbox" in rel_path:
 6388:         return "hook outbox payload"
 6389:     if "runtime/chat/transcripts" in rel_path or "chat/transcripts" in rel_path:
 6390:         return "local chat transcript"
 6391:     return None
