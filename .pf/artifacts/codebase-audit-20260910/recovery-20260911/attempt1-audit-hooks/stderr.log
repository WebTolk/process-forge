23058:         return
23059:     for item in notifications.get("notifications", []) if isinstance(notifications.get("notifications"), list) else []:
23060:         if not isinstance(item, dict) or item.get("status") == "acknowledged":
23061:             continue
23062:         target = office / f"{safe_id(str(item.get('id')))}.json"
23063:         if target.exists():
23064:             continue
23065:         target.write_text(json.dumps(item, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
