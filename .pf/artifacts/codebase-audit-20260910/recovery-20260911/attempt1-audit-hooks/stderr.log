 1395: def format_scalar(value: Any) -> str:
 1396:     if value is True:
 1397:         return "true"
 1398:     if value is False:
 1399:         return "false"
 1400:     if value is None:
 1401:         return "null"
 1402:     if isinstance(value, (int, float)):
 1403:         return str(value)
 1404:     text = str(value)
 1405:     if text == "":
 1406:         return '""'
 1407:     yaml_literals = {"*", "null", "true", "false", "yes", "no", "on", "off", "~"}
 1408:     special_start = ("-", "?", "&", "*", "!", "%", "@", "`", ">", "|")
 1409:     if (
 1410:         text.lower() in yaml_literals
 1411:         or text.startswith(special_start)
 1412:         or any(char in text for char in [":", "#", "{", "}", "[", "]", "\\"])
 1413:         or text.strip() != text
 1414:     ):
 1415:         return "'" + text.replace("'", "''") + "'"
 1416:     return text
 1417: 
 1418: 
 1419: def dump_yaml(data: Any, indent: int = 0) -> str:
 1420:     lines: list[str] = []
 1421:     prefix = " " * indent
 1422:     if isinstance(data, dict):
 1423:         if not data:
 1424:             lines.append(f"{prefix}{{}}")
 1425:         for key, value in data.items():
 1426:             if isinstance(value, (dict, list)):
 1427:                 lines.append(f"{prefix}{key}:")
 1428:                 lines.append(dump_yaml(value, indent + 2))
 1429:             else:
 1430:                 lines.append(f"{prefix}{key}: {format_scalar(value)}")
 1431:     elif isinstance(data, list):
 1432:         if not data:
 1433:             lines.append(f"{prefix}[]")
 1434:         for item in data:
 1435:             if isinstance(item, dict):
 1436:                 lines.append(f"{prefix}-")
 1437:                 lines.append(dump_yaml(item, indent + 2))
 1438:             elif isinstance(item, list):
 1439:                 lines.append(f"{prefix}-")
 1440:                 lines.append(dump_yaml(item, indent + 2))
 1441:             else:
 1442:                 lines.append(f"{prefix}- {format_scalar(item)}")
 1443:     else:
 1444:         lines.append(f"{prefix}{format_scalar(data)}")
 1445:     return "\n".join(lines)
 1446: 
 1447: 
 1448: def ensure_trailing_newline(text: str) -> str:
 1449:     return text if text.endswith("\n") else text + "\n"
 1450: 
 1451: 
 1452: def write_file(path: Path, content: str, *, force: bool = False) -> WriteResult:
 1453:     content = ensure_trailing_newline(content)
 1454:     path.parent.mkdir(parents=True, exist_ok=True)
 1455:     if path.exists():
 1456:         existing = path.read_text(encoding="utf-8", errors="replace")
 1457:         if existing == content:
 1458:             return WriteResult(path, "unchanged", path)
 1459:         if not force:
 1460:             candidate = path.with_name(path.name + ".candidate")
 1461:             candidate.write_text(content, encoding="utf-8")
 1462:             return WriteResult(path, "candidate", candidate)
 1463:     path.write_text(content, encoding="utf-8")
 1464:     return WriteResult(path, "written", path)
 1465: 
 1466: 
 1467: def append_gitignore_entries(path: Path, entries: list[str], *, force: bool = False) -> WriteResult:
 1468:     existing = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
 1469:     lines = existing.splitlines()
 1470:     changed = False
 1471:     for entry in entries:
 1472:         if entry not in lines:
 1473:             lines.append(entry)
 1474:             changed = True
 1475:     if not changed:
 1476:         return WriteResult(path, "unchanged", path)
 1477:     content = "\n".join(lines).rstrip() + "\n"
 1478:     if path.exists() and existing and not force:
 1479:         candidate = path.with_name(path.name + ".candidate")
 1480:         candidate.write_text(content, encoding="utf-8")
 1481:         return WriteResult(path, "candidate", candidate)
 1482:     path.write_text(content, encoding="utf-8")
 1483:     return WriteResult(path, "written", path)
