 2597:     }
 2598:     md = f"""# Guided Workplace Setup Proposal
 2599: 
 2600: ## Session
 2601: 
 2602: - id: `{safe_id(session_id, "setup-session")}`
 2603: - status: `ready_for_review`
 2604: 
 2605: ## Layout
 2606: 
 2607: - ProcessForge root: `{proposal["processforge"]["root_ref"]}`
 2608: - Workplace: `{proposal["workplace"]["path_ref"]}`
 2609: - Local docs: `{proposal["local_docs"]["path_ref"]}`
 2610: - Project roots: {", ".join(proposal["project_roots"]) if proposal["project_roots"] else "not set"}
 2611: - Director capability: {str(proposal["coordination"]["director_capability"]).lower()}
 2612: - Default project mode: {proposal["coordination"]["default_project_mode"]}
 2613: - Initialize Director Office: {str(proposal["coordination"]["initialize_director_office"]).lower()}
 2614: 
 2615: ## Agent Environments
 2616: 
 2617: - Tools: {", ".join(proposal["agent_environments"])}
 2618: - Instruction targets: {", ".join(proposal["instruction_targets"])}
 2619: 
 2620: ## Device Discovery
 2621: 
 2622: - Enabled: {proposal["device_discovery"]["enabled"]}
 2623: - Read only: {str(proposal["device_discovery"]["read_only"]).lower()}
 2624: - Outputs: {", ".join(proposal["device_discovery"]["outputs"])}
 2625: 
 2626: ## Apply Plan
