22754: def normalize_manifest_versions(raw: dict[str, Any], site: dict[str, Any], channel: str) -> list[dict[str, Any]]:
22755:     subject = site.get("subject") if isinstance(site.get("subject"), dict) else {}
22756:     manifest_subject = raw.get("subject") if isinstance(raw.get("subject"), dict) else {}
22757:     subject_type = str(manifest_subject.get("type") or subject.get("type") or "")
22758:     subject_id = str(manifest_subject.get("id") or subject.get("id") or "")
22759:     source = site.get("source") if isinstance(site.get("source"), dict) else site
22760:     source_id = str(source.get("id") or site.get("site_id") or "update-site")
22761:     manifest_url = update_location(source, "provider")
22762:     site_changelog = str(source.get("changelog_url") or "")
22763:     versions: list[dict[str, Any]] = []
22764: 
22765:     channels = raw.get("channels") if isinstance(raw.get("channels"), dict) else {}
22766:     channel_data = channels.get(channel)
22767:     if isinstance(channel_data, dict):
22768:         for item in channel_data.get("versions", []) if isinstance(channel_data.get("versions"), list) else []:
22769:             if not isinstance(item, dict):
22770:                 continue
22771:             versions.append(
22772:                 {
22773:                     "subject": {"type": subject_type, "id": subject_id, "scope": str(subject.get("scope") or "global")},
22774:                     "version": str(item.get("version") or ""),
22775:                     "source_id": source_id,
22776:                     "manifest_url": manifest_url,
22777:                     "changelog_url": str(item.get("changelog_url") or site_changelog),
22778:                     "download_url": str(item.get("download_url") or item.get("url") or ""),
22779:                     "sha256": str(item.get("sha256") or ""),
22780:                     "size_bytes": item.get("size_bytes") or item.get("size"),
22781:                     "breaking": bool(item.get("breaking", False)),
22782:                     "migration_required": bool(item.get("migration_required", False)),
22783:                     "notes": item.get("notes"),
22784:                     "post_update_doctor": item.get("post_update_doctor") if isinstance(item.get("post_update_doctor"), list) else [],
22785:                     "update_policy": item.get("update_policy") if isinstance(item.get("update_policy"), dict) else {},
22786:                 }
22787:             )
22788: 
22789:     for manifest_subject_item in raw.get("subjects", []) if isinstance(raw.get("subjects"), list) else []:
22790:         if not isinstance(manifest_subject_item, dict):
22791:             continue
22792:         normalized_subject = {
22793:             "type": str(manifest_subject_item.get("type") or subject_type),
22794:             "id": str(manifest_subject_item.get("id") or subject_id),
22795:             "scope": str(subject.get("scope") or manifest_subject_item.get("scope") or "global"),
22796:         }
22797:         if normalized_subject["id"] and subject_id and normalized_subject["id"] != subject_id:
22798:             continue
22799:         for item in manifest_subject_item.get("versions", []) if isinstance(manifest_subject_item.get("versions"), list) else []:
22800:             if not isinstance(item, dict):
22801:                 continue
22802:             item_channels = item.get("channels")
22803:             if isinstance(item_channels, list) and channel not in item_channels:
22804:                 continue
22805:             artifacts = item.get("artifacts") if isinstance(item.get("artifacts"), list) else []
22806:             artifact = next((entry for entry in artifacts if isinstance(entry, dict)), {})
22807:             migration = item.get("migration") if isinstance(item.get("migration"), dict) else {}
22808:             release = item.get("release") if isinstance(item.get("release"), dict) else {}
22809:             versions.append(
22810:                 {
22811:                     "subject": normalized_subject,
22812:                     "version": str(item.get("version") or ""),
22813:                     "source_id": source_id,
22814:                     "manifest_url": manifest_url,
22815:                     "changelog_url": str(item.get("changelog_url") or release.get("changelog_url") or site_changelog),
22816:                     "download_url": str(artifact.get("url") or ""),
22817:                     "sha256": str(artifact.get("sha256") or ""),
22818:                     "size_bytes": artifact.get("size") or artifact.get("size_bytes"),
22819:                     "breaking": any(bool(change.get("breaking")) for change in item.get("changes", []) if isinstance(change, dict)),
22820:                     "migration_required": bool(migration.get("required", False)),
22821:                     "notes": item.get("notes"),
22822:                     "post_update_doctor": item.get("post_update_doctor") if isinstance(item.get("post_update_doctor"), list) else [],
22823:                     "update_policy": item.get("update_policy") if isinstance(item.get("update_policy"), dict) else {},
22824:                 }
22825:             )
22826:     return [item for item in versions if item.get("version")]
22827: 
22828: 
22829: def selected_update_version(versions: list[dict[str, Any]], installed: str | None) -> tuple[dict[str, Any] | None, list[str]]:
22830:     warnings: list[str] = []
22831:     newer: list[dict[str, Any]] = []
22832:     for item in versions:
22833:         is_newer, warning = version_is_newer(str(item.get("version") or ""), installed)
22834:         if warning:
22835:             warnings.append(warning)
22836:         if is_newer:
22837:             newer.append(item)
22838:     if not newer:
22839:         return None, warnings
22840:     newer.sort(key=lambda item: semantic_version_key(str(item.get("version") or "")))
22841:     return newer[-1], sorted(set(warnings))
22842: 
