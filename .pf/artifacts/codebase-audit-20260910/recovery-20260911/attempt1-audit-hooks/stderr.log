20835: def command_iteration_add(args: argparse.Namespace) -> int:
20836:     project_root = Path(args.project_root).expanduser().resolve()
20837:     task_id = safe_id(args.task, "task")
20838:     task = load_task(project_root, task_id)
20839:     kind = safe_id(args.kind, "work")
20840:     if kind not in ITERATION_KINDS:
20841:         raise SystemExit(f"FAIL: invalid iteration kind: {kind}")
20842:     status = args.status
20843:     if status not in ITERATION_STATUSES:
20844:         raise SystemExit(f"FAIL: invalid iteration status: {status}")
20845:     iter_id = safe_id(args.id, "iter") if args.id else next_iteration_id(task)
20846:     iterations = task.get("iterations") if isinstance(task.get("iterations"), list) else []
20847:     if any(isinstance(item, dict) and item.get("id") == iter_id for item in iterations):
20848:         raise SystemExit(f"FAIL: duplicate iteration id: {iter_id}")
20849:     artifact_kind = "debug-log.md" if kind == "debug" else "work-log.md"
20850:     artifact = rel(task_artifacts_root(project_root, str(task.get("run_id", "")), task_id) / artifact_kind, project_root)
20851:     iteration = {"id": iter_id, "kind": kind, "status": status, "started_at": now_utc(), "summary": args.summary, "artifacts": [artifact]}
20852:     if status in {"completed", "passed", "failed", "cancelled"}:
20853:         iteration["completed_at"] = now_utc()
20854:     if getattr(args, "dry_run", False):
20855:         print(f"DRY-RUN: would add {iter_id} to {task_id}")
20856:         return 0
20857:     task_artifacts_root(project_root, str(task.get("run_id", "")), task_id).mkdir(parents=True, exist_ok=True)
20858:     iterations.append(iteration)
20859:     task["iterations"] = iterations
20860:     if status == "in_progress":
20861:         task["status"] = "debugging" if kind == "debug" else "in_progress"
20862:     save_task(project_root, task)
20863:     emit_process_event(project_root, "iteration.added", process_id=task_process_id(task), subject=iter_id, assignment_id_value=task_id, assignment_path=rel(assignment_yaml_path(project_root, task_id), project_root), payload={"run_id": task.get("run_id"), "task_id": task_id, "iteration_id": iter_id, "kind": kind, "status": status}, correlation_id=f"run-{task.get('run_id')}")
20864:     print(f"ADDED: {iter_id}")
20865:     return 0
