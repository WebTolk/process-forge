21510: def update_registry_file(workplace_root: Path, registry_key: str, default_name: str) -> Path:
21511:     manifest = workplace_root / "workplace.yaml"
21512:     if manifest.is_file():
21513:         data = load_yaml_document(manifest)
21514:         registries = data.get("registries") if isinstance(data, dict) else None
21515:         raw = registries.get(registry_key) if isinstance(registries, dict) else None
21516:         if isinstance(raw, str) and raw.strip():
21517:             return path_resolution_to_path(workplace_path_resolution(workplace_root, raw))
21518:     return workplace_root / "registries" / default_name
