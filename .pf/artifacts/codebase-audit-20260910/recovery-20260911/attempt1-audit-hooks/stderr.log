22229: def derived_update_site_record(
22230:     workplace_root: Path,
22231:     subject_type: str,
22232:     subject_id: str,
22233:     subject_scope: str,
22234:     installed_version: str,
22235:     manifest_path: Path,
22236:     site: dict[str, Any],
22237:     overrides: dict[str, dict[str, Any]],
22238:     *,
22239:     parent: dict[str, Any] | None = None,
22240: ) -> dict[str, Any]:
22241:     source_id = update_site_source_id(site)
22242:     site_id = update_site_stable_key(subject_type, subject_id, source_id)
22243:     source = {key: site[key] for key in UPDATE_SOURCE_PUBLIC_KEYS if key in site}
22244:     source["id"] = source_id
22245:     source["type"] = update_source_kind(source)
22246:     if "channel" not in source:
22247:         channels = site.get("channels")
22248:         if isinstance(channels, list) and channels:
22249:             source["channel"] = str(channels[0])
22250:     enabled = bool(site.get("enabled", True))
22251:     preserved = {key: site[key] for key in UPDATE_SOURCE_LOCAL_KEYS if key in site}
22252:     override = overrides.get(site_id, {}) or overrides.get(subject_id, {}) or overrides.get(f"{subject_type}:{subject_id}", {})
22253:     if isinstance(override, dict):
22254:         if "enabled" in override or "disabled" in override:
22255:             enabled = bool(override.get("enabled", not bool(override.get("disabled"))))
22256:         if isinstance(override.get("channels"), list):
22257:             source["channels"] = override.get("channels")
22258:         if isinstance(override.get("channel"), str):
22259:             source["channel"] = override.get("channel")
22260:             source["channels"] = [override.get("channel")]
22261:         if isinstance(override.get("manifest_url"), str):
22262:             source["manifest_url"] = override.get("manifest_url")
22263:         if not isinstance(source.get("policy"), dict):
22264:             source["policy"] = {}
22265:         if isinstance(override.get("pin_version"), str):
22266:             source["policy"]["pin_version"] = override.get("pin_version")
22267:         if "allow_major" in override:
22268:             source["policy"]["allow_major"] = bool(override.get("allow_major"))
22269:         if "auto_apply" in override:
22270:             source["policy"]["auto_apply"] = bool(override.get("auto_apply"))
22271:         preserved_override = override.get("preserved_local") if isinstance(override.get("preserved_local"), dict) else {}
22272:         for key in UPDATE_SOURCE_LOCAL_KEYS:
22273:             if key in override:
22274:                 preserved[key] = override[key]
22275:         preserved.update(preserved_override)
22276: 
22277:     subject: dict[str, Any] = {"type": subject_type, "id": subject_id, "scope": subject_scope}
22278:     if installed_version:
22279:         subject["installed_version"] = installed_version
22280:     if parent:
22281:         subject["parent"] = parent
22282:     record: dict[str, Any] = {
22283:         "site_id": site_id,
22284:         "subject": subject,
22285:         "source": source,
22286:         "manifest_path": rel(manifest_path, workplace_root),
22287:         "enabled": enabled,
22288:     }
22289:     if preserved:
22290:         record["preserved_local"] = preserved
22291:     return record
22292: 
