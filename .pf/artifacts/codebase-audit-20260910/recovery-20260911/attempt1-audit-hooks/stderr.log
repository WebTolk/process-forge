 4693: def project_override_entries(project_root: Path) -> list[dict[str, Any]]:
 4694:     data = load_project_overrides(project_root)
 4695:     overrides = data.get("overrides") if isinstance(data.get("overrides"), dict) else {}
 4696:     entries: list[dict[str, Any]] = []
 4697:     for raw_kind, items in overrides.items():
 4698:         kind = PROJECT_OVERRIDE_KINDS.get(str(raw_kind), str(raw_kind))
 4699:         for item in items if isinstance(items, list) else []:
 4700:             if isinstance(item, dict) and item.get("target"):
 4701:                 record = dict(item)
 4702:                 record["kind"] = kind
 4703:                 record["source"] = rel(project_overrides_path(project_root), project_root)
 4704:                 entries.append(record)
 4705:     return entries
