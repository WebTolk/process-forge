 3310: def command_director_inbox_submit(args: argparse.Namespace) -> int:
 3311:     project_root = Path(args.project_root).expanduser().resolve() if args.project_root else None
 3312:     workplace_root = normalize_workplace_path(Path(args.workplace)) if args.workplace else None
 3313:     if project_root:
 3314:         require_flow_root(project_root)
 3315:         status = effective_project_coordination(project_root, str(workplace_root) if workplace_root else None)
 3316:         workplace_root = Path(str(status["workplace_root"])) if status.get("workplace_root") else workplace_root
 3317:         if status["effective_mode"] == "simple" and not args.allow_simple_submit and args.message_type != "operator_note":
 3318:             message = "\n".join(
 3319:                 [
 3320:                     "FAIL: project is in simple coordination mode.",
 3321:                     "Director inbox is available at the workplace, but this project is not organized.",
 3322:                     "Run:",
 3323:                     "  pf project-mode set --project-root <project> --mode organized",
 3324:                     "or submit as workspace-level/operator note if appropriate.",
 3325:                 ]
 3326:             )
 3327:             if args.json:
 3328:                 print(json.dumps({"status": "fail", "error": message, "effective_mode": "simple"}, indent=2, sort_keys=True))
 3329:                 return 1
 3330:             raise SystemExit(message)
 3331:         if status["effective_mode"] == "organized" and not status["workplace_director_enabled"]:
 3332:             raise SystemExit("FAIL: workplace Director is not enabled")
 3333:         coordination = status
 3334:     else:
 3335:         if not workplace_root:
 3336:             raise SystemExit("FAIL: director-inbox-submit requires --project-root or --workplace")
 3337:         cfg = workplace_coordination_config(workplace_root / "workplace.yaml")
 3338:         if not cfg.get("director_enabled"):
 3339:             raise SystemExit("FAIL: workplace Director is not enabled")
 3340:         coordination = {"effective_mode": "workspace", "workplace_root": normalize_path_string(str(workplace_root))}
 3341:     if not workplace_root:
 3342:         raise SystemExit("FAIL: workplace root could not be resolved")
 3343:     paths = initialize_director_office(workplace_root)
 3344:     payload = director_message_payload(workplace_root, project_root, args.message_type, args.content or "", coordination)
 3345:     message_path = paths["inbox_path"] / f"{payload['id']}.yaml"
 3346:     write_yaml_file(message_path, payload)
 3347:     if args.json:
 3348:         print(json.dumps({"status": "pass", "message": rel(message_path, workplace_root), "payload": payload}, indent=2, sort_keys=True))
 3349:     else:
 3350:         print(f"WROTE: {rel(message_path, workplace_root)}")
 3351:     return 0
