  520: def command_start(args: argparse.Namespace, core: Any) -> int:
  521:     workplace_root = core.resolve_workplace_root(getattr(args, "workplace", None))
  522:     inspection = inspect_lifecycle(workplace_root, core)
  523:     state = inspection["state"]
  524:     if inspection["kind"] == "ready":
  525:         payload = {"status": "already_running", "pid": state.get("pid"), "endpoint": state.get("endpoint")}
  526:         print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if getattr(args, "json", False) else f"RUNTIME: already running pid={payload['pid']} endpoint={payload['endpoint']}")
  527:         return 0
  528:     if inspection["kind"] == "starting":
  529:         ready, ready_state = wait_for_ready_service(workplace_root, core, float(getattr(args, "timeout", 10.0) or 10.0))
  530:         if not ready:
  531:             raise SystemExit(f"FAIL: PF Runtime is still starting for workplace: pid={inspection['pid']}")
  532:         payload = {"status": "already_running", "pid": ready_state.get("pid"), "endpoint": ready_state.get("endpoint")}
  533:         print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if getattr(args, "json", False) else f"RUNTIME: already running pid={payload['pid']} endpoint={payload['endpoint']}")
  534:         return 0
  535:     if inspection["kind"] in {"stopping", "failed", "orphaned"}:
  536:         raise SystemExit(f"FAIL: PF Runtime requires stop/recovery before start: state={inspection['kind']} pid={inspection['pid']}")
  537:     cleanup_stale_runtime(workplace_root, core)
  538:     log_dir = runtime_root(workplace_root) / "logs"
  539:     log_dir.mkdir(parents=True, exist_ok=True)
  540:     stdout = (log_dir / "runtime.stdout.log").open("ab")
  541:     stderr = (log_dir / "runtime.stderr.log").open("ab")
  542:     command = [sys.executable, str(core.ROOT / "tools" / "processforge.py"), "runtime", "serve", "--workplace", str(workplace_root), "--port", str(int(getattr(args, "port", 0) or 0)), "--interval", str(float(getattr(args, "interval", 2.0) or 2.0))]
  543:     creationflags = 0
  544:     kwargs: dict[str, Any] = {}
  545:     if os.name == "nt":
  546:         creationflags = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0) | getattr(subprocess, "DETACHED_PROCESS", 0)
  547:         kwargs["creationflags"] = creationflags
  548:     else:
  549:         kwargs["start_new_session"] = True
  550:     proc = subprocess.Popen(command, cwd=str(core.ROOT), stdout=stdout, stderr=stderr, stdin=subprocess.DEVNULL, close_fds=True, **kwargs)
  551:     stdout.close()
  552:     stderr.close()
  553:     deadline = time.monotonic() + float(getattr(args, "timeout", 10.0) or 10.0)
  554:     ready_state: dict[str, Any] = {}
  555:     while time.monotonic() < deadline:
  556:         if proc.poll() is not None:
  557:             raise SystemExit(f"FAIL: runtime exited during startup with code {proc.returncode}")
  558:         ready_state = read_json(service_path(workplace_root))
  559:         endpoint = str(ready_state.get("endpoint") or "")
  560:         if endpoint and ready_state.get("status") == "ready":
  561:             code, body = http_json("GET", endpoint.rstrip("/") + "/readyz", timeout=1.0)
  562:             if code == 200 and body.get("ready"):
  563:                 payload = {"status": "started", "pid": ready_state.get("pid"), "endpoint": endpoint}
  564:                 print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) if getattr(args, "json", False) else f"RUNTIME: started pid={payload['pid']} endpoint={payload['endpoint']}")
  565:                 return 0
  566:         time.sleep(0.1)
  567:     proc.terminate()
  568:     try:
  569:         proc.wait(timeout=2)
  570:     except subprocess.TimeoutExpired:
  571:         proc.kill()
  572:     cleanup_stale_runtime(workplace_root, core)
  573:     raise SystemExit("FAIL: runtime did not become ready before timeout")
