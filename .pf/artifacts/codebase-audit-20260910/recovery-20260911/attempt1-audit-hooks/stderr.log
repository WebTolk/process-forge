22607:     update_index = load_update_index(distribution_root)
22608:     if not update_index:
22609:         print(f"FAIL: update index not found under {distribution_root / 'updates'}")
22610:         return 1
22611:     latest = latest_update_version(update_index, channel)
22612:     product = update_index.get("product", {}) if isinstance(update_index.get("product"), dict) else {}
22613:     current = str(args.current_version or product.get("current_version") or "1.0.0")
22614:     print(f"PRODUCT: {product.get('id', 'processforge')}")
22615:     print(f"CURRENT: {current}")
22616:     print(f"CHANNEL: {channel}")
22617:     print(f"LATEST: {latest.get('version') if latest else 'none'}")
22618:     if latest and str(latest.get("version")) != current:
22619:         migration = latest.get("migration", {}) if isinstance(latest.get("migration"), dict) else {}
22620:         print(f"UPDATE: available")
22621:         print(f"MIGRATION_REQUIRED: {bool(migration.get('required', False))}")
22622:         if migration.get("guide"):
22623:             print(f"GUIDE: {migration.get('guide')}")
22624:     else:
22625:         print("UPDATE: none")
22626:     return 0
