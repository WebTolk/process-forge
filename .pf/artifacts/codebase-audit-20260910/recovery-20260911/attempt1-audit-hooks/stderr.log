 6013:     """Deterministic refresh-only repair adapter; semantic artifacts are untouched."""
 6014:     status, paths, snapshot, _old_reasons = write_project_context_snapshot_outputs(project_root, explicit_workplace=workplace)
 6015:     doctor_status, doctor_output = run_command_capture(command_doctor_project, argparse.Namespace(project_root=str(project_root)))
 6016:     finalize_project_onboarding_doctor_artifacts(project_root, doctor_status, doctor_output)
 6017:     emit_process_event(project_root, "context.snapshot.refreshed", process_id="project-initialization", process_version="1.0.0", payload={"status": status, "reason": reason, "paths": {key: rel(path, project_root) for key, path in paths.items()}})
 6018:     search_index: dict[str, Any] | None = None
