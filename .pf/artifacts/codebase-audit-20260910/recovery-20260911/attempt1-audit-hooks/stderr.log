 3374:         snapshot = load_yaml_document(snapshot_path)
 3375:         project_data = snapshot.get("project") if isinstance(snapshot, dict) else {}
 3376:         project_id_value = str(project_data.get("id") or snapshot_path.parents[3].name) if isinstance(project_data, dict) else snapshot_path.parents[3].name
 3377:         coordination = snapshot.get("workplace_coordination") if isinstance(snapshot.get("workplace_coordination"), dict) else {}
 3378:         effective_mode = str(coordination.get("effective_mode") or "simple")
 3379:         if effective_mode != "organized" and project_id_value not in inbox_project_ids and not include_simple:
 3380:             continue
 3381:         case_path = paths["cases_path"] / f"{safe_id(project_id_value, 'project')}.yaml"
 3382:         write_yaml_file(
 3383:             case_path,
 3384:             {
 3385:                 "schema_version": 1,
