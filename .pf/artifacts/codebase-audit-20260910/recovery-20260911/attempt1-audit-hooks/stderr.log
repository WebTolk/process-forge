   93:         return ""
   94:     stages = process.get("stages") if isinstance(process.get("stages"), list) else []
   95:     stage_ids = {str(item.get("id") or "") for item in stages if isinstance(item, dict)}
   96:     declared = str(task.get("stage") or "")
   97:     if declared in stage_ids:
   98:         return declared
   99:     boundary = process.get("runtime_execution_boundary") if isinstance(process.get("runtime_execution_boundary"), dict) else {}
  100:     by_status = boundary.get("stage_by_worker_status") if isinstance(boundary.get("stage_by_worker_status"), dict) else {}
  101:     mapped = str(by_status.get(str(run_state.get("status") or "")) or "")
  102:     return mapped if mapped in stage_ids else ""
  103: 
  104: 
  105: def resolved_process(project_root: Path, process_id: str, core: Any) -> dict[str, Any] | None:
  106:     """Resolve a process once, then invalidate only when its declaration changes."""
  107:     resolved_project_root = project_root.resolve()
  108:     key = (str(resolved_project_root), process_id)
  109:     cached = PROCESS_DEFINITION_CACHE.get(key)
  110:     if cached is not None:
  111:         path, modified_ns, process = cached
  112:         try:
  113:             if path.is_file() and path.stat().st_mtime_ns == modified_ns:
  114:                 return process
  115:         except OSError:
  116:             pass
  117:     try:
  118:         from processforge_core.process_catalog import (
  119:             ProcessCatalogContext,
  120:             resolve_process_definition as resolve_process_definition_core,
  121:         )
  122: 
  123:         workplace_manifest = core.resolve_project_workplace_manifest(resolved_project_root)
  124:         context = ProcessCatalogContext(
  125:             project_root=resolved_project_root,
  126:             flow_root=core.locate_flow_root(resolved_project_root),
  127:             distribution_root=core.ROOT.resolve(),
  128:             active_official_pack_ids=frozenset(core.active_process_pack_ids(workplace_manifest)),
  129:         )
  130:         definition = resolve_process_definition_core(context, process_id)
  131:     except SystemExit:
  132:         return None
  133:     try:
  134:         modified_ns = definition.path.stat().st_mtime_ns
  135:     except OSError:
  136:         modified_ns = -1
  137:     process = definition.process
  138:     PROCESS_DEFINITION_CACHE[key] = (definition.path, modified_ns, process)
  139:     return process
  140: 
  141: 
  142: def declared_stage_obligations(project_root: Path, core: Any) -> list[dict[str, Any]]:
  143:     """Read technical obligations from process definitions, never from Runtime policy."""
  144:     flow_root = core.locate_flow_root(project_root)
  145:     results: list[dict[str, Any]] = []
  146:     process_cache: dict[str, dict[str, Any] | None] = {}
  147:     for assignment_path in sorted((flow_root / "assignments").glob("*.yaml")):
  148:         task = core.load_yaml_document(assignment_path)
  149:         if not isinstance(task, dict) or not task.get("id"):
  150:             continue
  151:         process_id = core.task_process_id(task)
  152:         if not process_id:
  153:             continue
  154:         if process_id not in process_cache:
  155:             process_cache[process_id] = resolved_process(project_root, process_id, core)
  156:         process = process_cache[process_id]
  157:         if not process:
  158:             continue
  159:         run_id = str(task.get("run_id") or "")
  160:         run_state = core.load_agent_run_state(project_root, run_id, str(task.get("id"))) if run_id else {}
  161:         stage_id = execution_stage(task, run_state, process)
  162:         stages = process.get("stages") if isinstance(process.get("stages"), list) else []
  163:         stage = next((item for item in stages if isinstance(item, dict) and str(item.get("id") or "") == stage_id), None)
  164:         obligations = stage.get("automation_bindings") if isinstance(stage, dict) and isinstance(stage.get("automation_bindings"), list) else []
  165:         if not obligations and isinstance(stage, dict) and isinstance(stage.get("technical_obligations"), list):
  166:             obligations = stage["technical_obligations"]
  167:         for obligation in obligations:
  168:             if isinstance(obligation, dict) and str(obligation.get("projector") or ""):
  169:                 results.append({"task": task, "run_state": run_state, "process_id": process_id, "stage_id": stage_id, "process": process, "obligation": obligation})
  170:     return results
  171: 
  172: 
  173: def required_outputs_for_task(project_root: Path, task: dict[str, Any], core: Any) -> list[dict[str, Any]]:
  174:     required = [output_fact(project_root, output, core) for output in core.normalize_required_outputs(task.get("required_outputs")) if bool(output.get("required", True))]
  175:     expected = task.get("expected_report") if isinstance(task.get("expected_report"), dict) else {}
  176:     expected_path = str(expected.get("artifact") or "")
  177:     if expected_path:
  178:         required.append(output_fact(project_root, {"id": "expected-report", "path": expected_path}, core))
  179:     return required
  180: 
  181: 
  182: def obligation_base(item: dict[str, Any], required: list[dict[str, Any]], core: Any) -> dict[str, Any]:
  183:     task = item["task"]
  184:     obligation = item["obligation"]
  185:     return {
  186:         "id": f"{item['process_id']}:{item['stage_id']}:{obligation.get('id') or 'obligation'}:{task['id']}",
  187:         "projector": str(obligation.get("projector") or ""),
  188:         "task_id": str(task["id"]),
  189:         "run_id": str(task.get("run_id") or ""),
  190:         "process_id": item["process_id"],
  191:         "stage_id": item["stage_id"],
  192:         "obligation_id": str(obligation.get("id") or "obligation"),
  193:         "gate": str(obligation.get("gate") or ""),
  194:         "required_outputs": required,
  195:     }
  196: 
  197: 
  198: def build_required_output_readiness(item: dict[str, Any], project_root: Path, core: Any) -> dict[str, Any]:
  199:     task = item["task"]
  200:     required = required_outputs_for_task(project_root, task, core)
  201:     statuses = {str(output.get("status") or "") for output in required}
  202:     readiness = "invalid" if "invalid" in statuses else ("missing" if "missing" in statuses else "ready")
  203:     row = obligation_base(item, required, core)
  204:     row["readiness"] = readiness
  205:     row["source_fingerprint"] = content_hash({"assignment": task, "worker_state": item["run_state"], "required_outputs": required, "process": item["process"], "obligation": item["obligation"]})
  206:     return row
  207: 
  208: 
  209: def declared_verification_event(project_root: Path, task_id: str, verification: dict[str, Any], core: Any) -> dict[str, Any] | None:
  210:     passed_event = str(verification.get("passed_event") or "")
  211:     failed_event = str(verification.get("failed_event") or "")
  212:     for event in reversed(journal_events(project_root, core)):
  213:         event_type = str(event.get("event_type") or "")
  214:         assignment = event.get("assignment") if isinstance(event.get("assignment"), dict) else {}
  215:         if event_type in {passed_event, failed_event} and (str(assignment.get("id") or "") == task_id or str(event.get("subject") or "") == task_id):
  216:             return event
  217:     return None
  218: 
  219: 
  220: def build_verification_state(item: dict[str, Any], project_root: Path, core: Any) -> dict[str, Any]:
  221:     task = item["task"]
  222:     obligation = item["obligation"]
  223:     verification = obligation.get("verification") if isinstance(obligation.get("verification"), dict) else {}
  224:     required = required_outputs_for_task(project_root, task, core)
  225:     event = declared_verification_event(project_root, str(task["id"]), verification, core)
  226:     passed_event = str(verification.get("passed_event") or "")
  227:     failed_event = str(verification.get("failed_event") or "")
  228:     event_type = str(event.get("event_type") or "") if event else ""
  229:     result = "passed" if event_type == passed_event else ("failed" if event_type == failed_event else "not_run")
  230:     event_data = event.get("data") if event and isinstance(event.get("data"), dict) else {}
  231:     current_inputs = core.task_verification_fingerprint(project_root, task)
  232:     evidence_inputs = str(event_data.get("verification_fingerprint") or "")
  233:     readiness = "ready" if result == "passed" and evidence_inputs == current_inputs else ("stale" if result == "passed" and evidence_inputs else ("missing" if result == "passed" else ("invalid" if result == "failed" else "missing")))
  234:     row = obligation_base(item, required, core)
  235:     row["readiness"] = readiness
  236:     row["verification"] = {"result": result, "event_id": str(event.get("event_id") or "") if event else "", "event_type": event_type, "time": str(event.get("time") or "") if event else "", "input_fingerprint": evidence_inputs}
  237:     row["source_fingerprint"] = content_hash({"assignment": task, "required_outputs": required, "process": item["process"], "obligation": obligation, "verification": verification, "event": event or {}, "current_inputs": current_inputs})
  238:     return row
  239: 
  240: 
  241: PROJECTOR_BUILDERS = {"required-output-readiness": build_required_output_readiness, "verification-state": build_verification_state}
  242: 
  243: 
  244: def stage_obligation_rows(project_root: Path, core: Any) -> list[dict[str, Any]]:
  245:     rows: list[dict[str, Any]] = []
  246:     for item in declared_stage_obligations(project_root, core):
  247:         builder = PROJECTOR_BUILDERS.get(str(item["obligation"].get("projector") or ""))
  248:         if builder is not None:
  249:             rows.append(builder(item, project_root, core))
  250:     return rows
  251: 
  252: 
  253: def rebuild_stage_obligations(project_root: Path, core: Any) -> Path:
  254:     rows = stage_obligation_rows(project_root, core)
  255:     payload = {
  256:         "schema_version": 1,
  257:         "kind": "stage-obligations",
  258:         "generated_at": core.now_utc(),
  259:         "project_id": core.project_id(project_root),
  260:         "source": {"event_journal": core.rel(core.event_runtime_paths(project_root)[0], project_root), "authority": "process-definitions+durable-assignments+inspector-state"},
  261:         "obligations": rows,
  262:     }
  263:     out = stage_obligations_path(project_root, core)
  264:     write_json(out, payload)
  265:     return out
  266: 
  267: 
  268: def stage_obligations_payload(project_root: Path, core: Any) -> dict[str, Any]:
  269:     path = stage_obligations_path(project_root, core)
  270:     if not path.is_file():
  271:         return {"status": "missing", "path": core.rel(path, project_root), "obligations": []}
  272:     try:
  273:         stored = read_json(path)
  274:     except (OSError, json.JSONDecodeError):
  275:         return {"status": "invalid", "path": core.rel(path, project_root), "obligations": []}
  276:     if str(stored.get("kind") or "") != "stage-obligations" or not isinstance(stored.get("obligations"), list):
  277:         return {"status": "invalid", "path": core.rel(path, project_root), "obligations": []}
  278:     projected: list[dict[str, Any]] = []
  279:     for row in stored["obligations"]:
  280:         if not isinstance(row, dict):
  281:             continue
  282:         readiness = str(row.get("readiness") or "invalid")
  283:         freshness = "current" if readiness == "ready" else readiness
  284:         try:
  285:             task = core.load_task(project_root, str(row.get("task_id") or ""))
  286:             for output in row.get("required_outputs") if isinstance(row.get("required_outputs"), list) else []:
  287:                 if isinstance(output, dict):
  288:                     current = output_fact(project_root, {"id": output.get("id"), "path": output.get("path")}, core)
  289:                     if current.get("status") != output.get("status") or current.get("sha256") != output.get("sha256"):
  290:                         freshness = "stale"
  291:             verification = row.get("verification") if isinstance(row.get("verification"), dict) else {}
  292:             if verification and str(verification.get("input_fingerprint") or "") != core.task_verification_fingerprint(project_root, task):
  293:                 freshness = "stale"
  294:         except (OSError, SystemExit, ValueError):
  295:             freshness = "stale"
  296:         projected.append({**row, "freshness": freshness})
  297:     status = "current"
  298:     if any(row.get("freshness") == "invalid" for row in projected):
  299:         status = "invalid"
  300:     elif any(row.get("freshness") == "missing" for row in projected):
  301:         status = "missing"
  302:     elif any(row.get("freshness") == "stale" for row in projected):
  303:         status = "stale"
  304:     return {"status": status, "path": core.rel(path, project_root), "generated_at": stored.get("generated_at"), "obligations": projected}
  305: 
  306: 
  307: def read_json(path: Path) -> dict[str, Any]:
  308:     if not path.is_file():
  309:         return {}
  310:     return json.loads(path.read_text(encoding="utf-8"))
  311: 
  312: 
  313: def write_json(path: Path, payload: dict[str, Any]) -> None:
  314:     path.parent.mkdir(parents=True, exist_ok=True)
  315:     tmp = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
  316:     tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
  317:     os.replace(tmp, path)
  318: 
  319: 
  320: def call_quiet(func: Any, args: argparse.Namespace) -> int:
  321:     with contextlib.redirect_stdout(io.StringIO()):
  322:         return int(func(args) or 0)
  323: 
