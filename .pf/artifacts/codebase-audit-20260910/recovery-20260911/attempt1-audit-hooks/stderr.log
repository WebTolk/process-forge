23828:         payload = build_plan(
23829:             Path(args.core_root).expanduser().resolve(),
23830:             Path(args.archive).expanduser().resolve(),
23831:             workplace_root=Path(args.workplace_root).expanduser().resolve() if args.workplace_root else None,
23832:         )
23833:     except CoreUpdateError as exc:
23834:         print(json.dumps({"error": {"code": exc.code, "message": exc.message}}, indent=2, sort_keys=True))
23835:         return 1
23836:     printable = {key: value for key, value in payload.items() if key != "new_manifest"}
