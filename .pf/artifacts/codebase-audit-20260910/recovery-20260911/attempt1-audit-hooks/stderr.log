24504: def platform_contract_semantic_checks(
24505:     workplace_root: Path,
24506:     data: dict[str, Any],
24507:     platform: str,
24508:     *,
24509:     platform_resolution: dict[str, Any] | None = None,
24510: ) -> list[Check]:
24511:     checks: list[Check] = []
24512:     checks.append(check("PASS" if data.get("id") else "FAIL", "platform contract id present"))
24513:     contract_id = platform_contract_id(str(data.get("id") or platform))
24514:     for entry in policy_entries(load_policy_document("platform-id-policy.yaml"), "discouraged_platform_ids"):
24515:         if policy_id_matches(contract_id, entry):
24516:             checks.append(
24517:                 check_with_hint(
24518:                     str(entry.get("user_created_behavior", "WARN")).upper(),
24519:                     str(entry.get("message", f"platform id discouraged: {contract_id}")),
24520:                     str(entry.get("why", "The platform id matched a data-driven platform id policy.")),
24521:                     str(entry.get("fix", "update the platform id or policy manifest")),
24522:                 )
24523:             )
24524:     hints = data.get("project_type_hints")
24525:     if not isinstance(hints, list):
24526:         applies_to = data.get("applies_to") if isinstance(data.get("applies_to"), dict) else {}
24527:         hints = applies_to.get("project_type_hints") if isinstance(applies_to.get("project_type_hints"), list) else []
24528:     checks.append(check("PASS" if isinstance(hints, list) and hints else "WARN", "project_type_hints configured"))
24529:     requires = data.get("requires") if isinstance(data.get("requires"), dict) else {}
24530:     checks.append(check("PASS" if requires.get("capabilities") else "WARN", "required capabilities listed"))
24531:     extends_refs = contract_extends(data)
24532:     required_platform_refs = contract_required_platforms(data)
24533:     checks.append(check("PASS", "extends entries are valid") if all(ref.get("id") for ref in extends_refs) else check("FAIL", "extends entries are valid"))
24534:     checks.append(check("PASS", "requires.platforms entries are valid") if all(ref.get("id") for ref in required_platform_refs) else check("FAIL", "requires.platforms entries are valid"))
24535:     for ref in extends_refs:
24536:         if ref.get("required") is False:
24537:             checks.append(
24538:                 check_with_hint(
24539:                     "FAIL",
24540:                     f"extends parent is required: {ref['id']}",
24541:                     "Platform inheritance cannot be optional in the pre-release contract model.",
24542:                     "set required: true or move the platform reference to requires.platforms if it is only a dependency",
24543:                 )
24544:             )
24545:     required_platform_by_id = {str(ref["id"]): bool(ref.get("required", True)) for ref in required_platform_refs}
24546:     for ref in extends_refs:
24547:         if required_platform_by_id.get(str(ref["id"])) is False:
24548:             checks.append(
24549:                 check_with_hint(
24550:                     "FAIL",
24551:                     f"child platform cannot weaken required parent dependency: {ref['id']}",
24552:                     "An inherited parent is required by definition; requires.platforms cannot mark the same parent optional.",
24553:                     "set requires.platforms[].required: true for the parent platform",
24554:                 )
24555:             )
24556:     platform_resolution = platform_resolution or resolve_platform_contracts(workplace_root / "workplace.yaml", [data.get("id") or platform])
24557:     for missing in platform_resolution["missing_required_contracts"]:
24558:         checks.append(
24559:             check_with_hint(
24560:                 "FAIL",
24561:                 f"required platform available: {missing}",
24562:                 "The platform contract extends or requires a platform that is not registered in the workplace.",
24563:                 f"python bin/pf.py platform-create --workplace <workplace-root> --id {missing} --title \"{missing}\" --apply",
24564:             )
24565:         )
24566:     for cycle in platform_resolution["circular_platforms"]:
24567:         checks.append(
24568:             check_with_hint(
24569:                 "FAIL",
24570:                 f"circular platform inheritance detected: {cycle}",
24571:                 "Platform inheritance must resolve to an acyclic parent-first stack.",
24572:                 "remove one extends edge from the cycle and rerun platform-contract-doctor",
24573:             )
24574:         )
24575:     checks.append(check("PASS" if platform_resolution["platform_stack"] else "FAIL", "resolved platform stack valid"))
24576:     checks.append(check("PASS", "resolved platform stack computed without mutating workplace state"))
24577:     inherited_required, inherited_recommended = platform_resource_findings(workplace_root / "workplace.yaml", platform_resolution)
24578:     for item in inherited_required:
24579:         checks.append(
24580:             check_with_hint(
24581:                 "FAIL",
24582:                 f"required {item['kind']} available through resolved platform stack: {item['id']}",
24583:                 "A platform in the resolved stack marks this resource as required.",
24584:                 "register the missing resource in the workplace registry or package roots before using this platform",
24585:             )
24586:         )
24587:     for item in inherited_recommended:
24588:         checks.append(
24589:             check_with_hint(
24590:                 "WARN",
24591:                 f"optional {item['kind']} available through resolved platform stack: {item['id']}",
24592:                 "A platform in the resolved stack recommends this resource, but onboarding can continue.",
24593:                 "register the resource if this platform should provide the optional capability",
24594:             )
24595:         )
24596:     for package_id in list_value(requires.get("knowledge_packages")):
24597:         manifest = package_manifest_index(workplace_root, None, workplace_root / "workplace.yaml").get(package_id)
24598:         checks.append(
24599:             check("PASS", f"required knowledge package available: {package_id}")
24600:             if manifest
24601:             else check_with_hint(
24602:                 "FAIL",
24603:                 f"required knowledge package available: {package_id}",
24604:                 "This platform contract marks the package as required.",
24605:                 f"python bin/pf.py knowledge-package-create --workplace <workplace-root> --id {package_id} --package-root global --title \"{package_id}\" --apply",
24606:                 "mark it as required: false or move it to includes.knowledge_packages if optional",
24607:             )
24608:         )
24609:     for package_id in contract_includes(data, "knowledge_packages"):
24610:         manifest = package_manifest_index(workplace_root, None, workplace_root / "workplace.yaml").get(package_id)
24611:         checks.append(
24612:             check("PASS", f"optional knowledge package available: {package_id}")
24613:             if manifest
24614:             else check_with_hint(
24615:                 "WARN",
24616:                 f"optional knowledge package available: {package_id}",
24617:                 "This platform contract recommends the package, but onboarding can continue.",
24618:                 f"python bin/pf.py knowledge-package-create --workplace <workplace-root> --id {package_id} --package-root global --title \"{package_id}\" --apply",
24619:             )
24620:         )
24621:     for template_id in list_value(requires.get("templates")):
24622:         checks.append(
24623:             check("PASS", f"required template available: {template_id}")
24624:             if template_manifest_path(workplace_root, template_id)
24625:             else check_with_hint(
24626:                 "FAIL",
24627:                 f"required template available: {template_id}",
24628:                 "This platform contract marks the template as required.",
24629:                 f"python bin/pf.py template-create --workplace <workplace-root> --id {template_id} --title \"{template_id}\" --apply",
24630:                 "move it to includes.templates if optional",
24631:             )
24632:         )
24633:     for template_id in contract_includes(data, "templates"):
24634:         checks.append(
24635:             check("PASS", f"optional template available: {template_id}")
24636:             if template_manifest_path(workplace_root, template_id)
24637:             else check_with_hint(
24638:                 "WARN",
24639:                 f"optional template available: {template_id}",
24640:                 "This platform contract recommends the template, but onboarding can continue without it.",
24641:                 f"python bin/pf.py template-create --workplace <workplace-root> --id {template_id} --title \"{template_id}\" --apply",
24642:             )
24643:         )
24644:     return checks
