  350: def event_exists(project_root: Path, event_id: str, core: Any) -> bool:
  351:     events_path, _outbox = core.event_runtime_paths(project_root)
  352:     if not events_path.is_file():
  353:         return False
  354:     for line in events_path.read_text(encoding="utf-8", errors="replace").splitlines():
  355:         if not line.strip():
  356:             continue
  357:         try:
  358:             item = json.loads(line)
  359:         except json.JSONDecodeError:
  360:             continue
  361:         if isinstance(item, dict) and core.event_id_value(item) == event_id:
  362:             return True
  363:     return False
