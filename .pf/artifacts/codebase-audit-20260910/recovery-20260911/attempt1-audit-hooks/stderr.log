 1047: def planned_registry_upsert(
 1048:     path: Path,
 1049:     collection_key: str,
 1050:     entry: dict[str, Any],
 1051:     schema_name: str,
 1052: ) -> tuple[bytes, str, dict[str, Any]]:
 1053:     if path.exists() and not path.is_file():
 1054:         raise SystemExit(f"FAIL: registry path is not a file: {path}")
 1055:     if path.is_file():
 1056:         data = load_yaml_document(path)
 1057:         error = yaml_error(data)
 1058:         if error:
 1059:             raise SystemExit(f"FAIL: registry YAML invalid; original preserved: {path}: {error}")
 1060:         if not isinstance(data, dict) or not data:
 1061:             raise SystemExit(f"FAIL: registry must be a non-empty YAML object; original preserved: {path}")
 1062:         entries = data.get(collection_key)
 1063:         if entries is None:
 1064:             entries = []
 1065:             data[collection_key] = entries
 1066:         if not isinstance(entries, list):
 1067:             raise SystemExit(
 1068:                 f"FAIL: registry collection {collection_key} must be a list; original preserved: {path}"
 1069:             )
 1070:     else:
 1071:         data = {"schema_version": 1, collection_key: []}
 1072:         entries = data[collection_key]
 1073:     result = upsert_resource(entries, entry)
 1074:     require_json_schema_document(data, schema_name, f"registry {path.name}")
 1075:     return ensure_trailing_newline(dump_yaml(data)).encode("utf-8"), result, data
