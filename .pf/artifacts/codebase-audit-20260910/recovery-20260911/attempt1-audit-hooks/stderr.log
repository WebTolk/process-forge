 1350: def parse_simple_yaml(text: str) -> dict[str, Any]:
 1351:     """Parse the small mapping-only YAML subset used by init answers."""
 1352:     root: dict[str, Any] = {}
 1353:     stack: list[tuple[int, dict[str, Any]]] = [(-1, root)]
 1354:     for raw_line in text.splitlines():
 1355:         line = raw_line.split("#", 1)[0].rstrip()
 1356:         if not line.strip():
 1357:             continue
 1358:         indent = len(line) - len(line.lstrip(" "))
 1359:         stripped = line.strip()
 1360:         if stripped.startswith("- "):
 1361:             continue
 1362:         if ":" not in stripped:
 1363:             continue
 1364:         key, value = stripped.split(":", 1)
 1365:         key = key.strip()
 1366:         while stack and indent <= stack[-1][0]:
 1367:             stack.pop()
 1368:         parent = stack[-1][1] if stack else root
 1369:         if value.strip() == "":
 1370:             child: dict[str, Any] = {}
 1371:             parent[key] = child
 1372:             stack.append((indent, child))
 1373:         else:
 1374:             parent[key] = parse_scalar(value)
 1375:     return root
 1376: 
 1377: 
 1378: def load_answers(path: Path | None) -> dict[str, Any]:
 1379:     if path is None:
 1380:         return {}
 1381:     if not path.is_file():
 1382:         raise SystemExit(f"FAIL: answers file not found: {path}")
 1383:     text = path.read_text(encoding="utf-8")
 1384:     if contains_secret_value(text):
 1385:         raise SystemExit("FAIL: answers file appears to contain a secret value")
 1386:     try:
 1387:         import yaml  # type: ignore
 1388: 
 1389:         data = yaml.safe_load(text)
 1390:         return data if isinstance(data, dict) else {}
 1391:     except ModuleNotFoundError:
 1392:         return parse_simple_yaml(text)
 1393: 
