 4718: def project_override_path(project_root: Path, entry: dict[str, Any]) -> Path | None:
 4719:     raw = entry.get("path") or entry.get("project_package")
 4720:     if not raw:
 4721:         return None
 4722:     path = Path(str(raw))
 4723:     if path.is_absolute():
 4724:         return path
 4725:     return project_root / path
