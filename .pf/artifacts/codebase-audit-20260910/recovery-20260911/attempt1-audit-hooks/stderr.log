  760: def _is_safe_automatic_content(content: str) -> bool:
  761:     # Marker names may appear in a safe worker report that explains which
  762:     # private values were withheld. Reject their values (via secret/path
  763:     # checks below), not the vocabulary used to describe that policy.
  764:     return not bool(__import__("re").search(r"(?:[a-zA-Z]:[\\/]|/(?:users|home|tmp|var)/)", content))
  765: 
  766: 
  767: def worker_input_summary(run_id: str, task_id: str, attempt: str, payload_hash: str, expected_report: str) -> str:
  768:     return (
  769:         f"ProcessForge launched worker run `{run_id}`, task `{task_id}`, attempt `{attempt}`; "
  770:         f"stdin_payload_hash=`{payload_hash}`; expected_report=`{expected_report}`."
  771:     )
  772: 
  773: 
  774: def _worker_input_contract(envelope: dict[str, Any], project_root: Path, core: Any) -> dict[str, Any] | None:
  775:     raw = envelope.get("raw_payload") if isinstance(envelope.get("raw_payload"), dict) else {}
  776:     run_id, task_id, attempt = (str(raw.get(key) or "") for key in ("run_id", "task_id", "attempt"))
  777:     payload = raw.get("stdin_payload")
  778:     payload_hash = str(raw.get("stdin_payload_hash") or "")
  779:     expected_report = str(raw.get("expected_report") or "")
  780:     if not run_id or not task_id or not attempt or not isinstance(payload, str) or not payload_hash or not expected_report:
  781:         return None
  782:     if payload_hash != "sha256:" + hashlib.sha256(payload.encode("utf-8")).hexdigest():
  783:         return None
  784:     contract_path = project_root / ".pf" / "runtime" / "agent-runs" / core.safe_id(run_id, "run") / core.safe_id(task_id, "task") / "worker-input-contract.json"
  785:     try:
  786:         contract = json.loads(contract_path.read_text(encoding="utf-8"))
  787:     except (OSError, json.JSONDecodeError):
  788:         return None
  789:     required = {"run_id": run_id, "task_id": task_id, "attempt": attempt, "stdin_payload_hash": payload_hash, "expected_report": expected_report}
  790:     if any(str(contract.get(key) or "") != value for key, value in required.items()):
  791:         return None
  792:     summary = worker_input_summary(run_id, task_id, attempt, payload_hash, expected_report)
  793:     if str(contract.get("summary") or "") != summary:
  794:         return None
  795:     return {**required, "summary": summary}
  796: 
  797: 
  798: def _allowed_conversation_message(envelope: dict[str, Any], item: dict[str, Any]) -> bool:
  799:     provider, adapter, event_type = (str(envelope.get(key) or "") for key in ("provider", "adapter", "native_event_type"))
  800:     role = str(item.get("message_role") or "")
  801:     source = item.get("content_source") if isinstance(item.get("content_source"), dict) else {}
  802:     kind, provenance = str(source.get("kind") or ""), str(source.get("content_provenance") or "")
  803:     raw = envelope.get("raw_payload") if isinstance(envelope.get("raw_payload"), dict) else {}
  804:     session = str(envelope.get("source_session_id") or "")
  805:     if (provider, adapter, event_type, role, kind, provenance) == ("codex", "codex-hooks", "UserPromptSubmit", "user", "codex_hook", "provider_payload"):
  806:         return isinstance(raw.get("prompt"), str) and item.get("content") == raw.get("prompt")
  807:     if (provider, adapter, event_type, role, kind, provenance) in {
  808:         ("codex", "codex-hooks", "Stop", "assistant", "codex_hook", "provider_payload"),
  809:         ("codex", "codex-hooks", "SubagentStop", "assistant", "codex_hook", "provider_payload"),
  810:         ("codex", "codex-hooks", "SessionEnd", "assistant", "codex_hook", "provider_payload"),
  811:     }:
  812:         return isinstance(raw.get("last_assistant_message"), str) and item.get("content") == raw.get("last_assistant_message") and str(item.get("session_id") or session) == session
  813:     if provider != "processforge" or adapter != "pf-codex-exec-worker":
  814:         return False
  815:     run_id, task_id, attempt = (str(raw.get(key) or "") for key in ("run_id", "task_id", "attempt"))
  816:     if session != f"pf-worker:{run_id}:{task_id}:attempt:{attempt}":
  817:         return False
  818:     if event_type == "WorkerPromptPayloadSubmitted":
  819:         return (
  820:             (role, kind, provenance) == ("system", "pf_codex_exec_input", "pf_owned_safe_summary")
  821:             and str(envelope.get("native_event_id") or "") == f"worker-input:{run_id}:{task_id}:attempt:{attempt}"
  822:             and item.get("content") == worker_input_summary(run_id, task_id, attempt, str(raw.get("stdin_payload_hash") or ""), str(raw.get("expected_report") or ""))
  823:         )
  824:     if event_type == "WorkerExpectedReportCaptured":
  825:         report_content = raw.get("report_content")
  826:         report_hash = "sha256:" + hashlib.sha256(report_content.encode("utf-8")).hexdigest() if isinstance(report_content, str) else ""
  827:         return (
  828:             (role, kind, provenance) == ("assistant", "pf_codex_exec_output", "pf_owned_output_file")
  829:             and str(envelope.get("native_event_id") or "") == f"worker-output:{run_id}:{task_id}:attempt:{attempt}:{report_hash}"
  830:             and item.get("content") == report_content
  831:         )
  832:     return False
  833: 
  834: 
  835: def _worker_session_authorized(envelope: dict[str, Any], project_root: Path, core: Any) -> bool:
  836:     raw = envelope.get("raw_payload") if isinstance(envelope.get("raw_payload"), dict) else {}
  837:     run_id, task_id = str(raw.get("run_id") or ""), str(raw.get("task_id") or "")
  838:     if not run_id or not task_id:
  839:         return False
  840:     try:
  841:         task = core.load_task(project_root, task_id)
  842:     except (OSError, SystemExit):
  843:         return False
  844:     if str(task.get("run_id") or "") != run_id:
  845:         return False
  846:     state = core.load_agent_run_state(project_root, run_id, task_id)
  847:     attempt = str(raw.get("attempt") or "")
  848:     if not state or attempt != str(state.get("attempt") or ""):
  849:         return False
  850:     expected = task.get("expected_report") if isinstance(task.get("expected_report"), dict) else {}
  851:     expected_report = str(expected.get("artifact") or "")
  852:     if str(raw.get("expected_report") or "") != expected_report:
  853:         return False
  854:     if str(envelope.get("native_event_type") or "") == "WorkerPromptPayloadSubmitted" and _worker_input_contract(envelope, project_root, core) is None:
  855:         return False
  856:     if str(envelope.get("native_event_type") or "") == "WorkerExpectedReportCaptured":
  857:         report = project_root / expected_report
  858:         if not report.is_file() or report.read_text(encoding="utf-8", errors="replace") != raw.get("report_content"):
  859:             return False
  860:     return True
  861: 
  862: 
  863: def _is_session_end_fallback_duplicate(envelope: dict[str, Any], item: dict[str, Any], project_root: Path, core: Any) -> bool:
  864:     if str(envelope.get("provider") or "") != "codex" or str(envelope.get("adapter") or "") != "codex-hooks":
  865:         return False
  866:     if str(envelope.get("native_event_type") or "") != "SessionEnd" or str(item.get("message_role") or "") != "assistant":
  867:         return False
  868:     content = item.get("content")
  869:     turn_id = str(item.get("turn_id") or "")
  870:     session_id = str(envelope.get("source_session_id") or "")
  871:     if not isinstance(content, str) or not content.strip() or not session_id:
  872:         return False
  873:     for existing in core.load_chat_messages(project_root, session_id):
  874:         body = existing.get("message") if isinstance(existing.get("message"), dict) else {}
  875:         participant = existing.get("participant") if isinstance(existing.get("participant"), dict) else {}
  876:         existing_primary = str(participant.get("id") or "") == "codex" or str(participant.get("type") or "") == "subagent"
  877:         if (
  878:             (not turn_id or str(existing.get("turn_id") or "") == turn_id)
  879:             and existing_primary
  880:             and body.get("role") == "assistant"
  881:             and body.get("content") == content
  882:         ):
  883:             return True
  884:     return False
  885: 
  886: 
  887: def _conversation_messages(
  888:     envelope: dict[str, Any],
  889:     receipt: Any,
  890:     project_root: Path,
  891:     workplace_root: Path,
  892:     core: Any,
  893:     *,
  894:     ended_session_presence: dict[str, Any] | None = None,
  895: ) -> tuple[list[str], dict[str, Any]]:
  896:     messages = envelope.get("derived_conversation_messages")
  897:     if messages is None:
  898:         return [], {}
  899:     if not isinstance(messages, list):
  900:         return _conversation_denial("messages_not_list")
  901:     session_id = str(envelope.get("source_session_id") or "")
  902:     if not session_id:
  903:         return _conversation_denial("missing_session")
  904:     is_worker = _is_worker_conversation(envelope)
  905:     presence = ledger_session(session_id, workplace_root, core)
  906:     if is_worker:
  907:         authorized = _worker_session_authorized(envelope, project_root, core)
  908:     else:
  909:         active_presence = presence or ended_session_presence or {}
  910:         authorized = bool(active_presence) and str(active_presence.get("project_id") or "") == core.project_id(project_root)
  911:     if not authorized:
  912:         return _conversation_denial("session_not_authorized", session_id=session_id)
  913:     identifiers: list[str] = []
  914:     for sequence, item in enumerate(messages):
  915:         if not isinstance(item, dict):
  916:             return _conversation_denial("message_not_object", sequence=sequence)
  917:         content = item.get("content")
  918:         role = str(item.get("message_role") or "")
  919:         participant = item.get("participant") if isinstance(item.get("participant"), dict) else {}
  920:         source = item.get("content_source") if isinstance(item.get("content_source"), dict) else {}
  921:         if not isinstance(content, str) or not content.strip() or role not in {"user", "assistant", "system"}:
  922:             return _conversation_denial("invalid_message", sequence=sequence)
  923:         if not _allowed_conversation_message(envelope, item):
  924:             return _conversation_denial("untrusted_conversation_provenance", sequence=sequence)
  925:         if _is_session_end_fallback_duplicate(envelope, item, project_root, core):
  926:             continue
  927:         if not _is_safe_automatic_content(content) or not _is_safe_automatic_content(json.dumps(source, ensure_ascii=False, sort_keys=True)) or core.contains_secret_value(content):
  928:             return _conversation_denial("unsafe_automatic_content", sequence=sequence)
  929:         raw_id = str(receipt.raw_event_id or "")
  930:         key = deterministic_derived_key(
  931:             raw_id,
  932:             "conversation_message",
  933:             f"processforge.conversation-capture.{envelope['adapter']}",
  934:             "1",
  935:             {
  936:                 "session_id": session_id,
  937:                 "turn_id": str(item.get("turn_id") or raw_id),
  938:                 "message_role": role,
  939:                 "delivery_sequence": int((item.get("delivery") or {}).get("sequence") or sequence),
  940:                 "content_hash": "sha256:" + hashlib.sha256(content.encode("utf-8")).hexdigest(),
  941:             },
  942:         )
  943:         message_id = "msg_" + key[:32]
  944:         event_id = "evt_" + hashlib.sha256(("chat.message.recorded:" + message_id).encode("utf-8")).hexdigest()[:32]
  945:         _path, record, _event = core.append_chat_message(
  946:             project_root,
  947:             session_id=session_id,
  948:             participant_id=str(participant.get("id") or envelope.get("adapter") or "agent"),
  949:             participant_role=str(participant.get("role") or role),
  950:             participant_type=str(participant.get("type") or "agent"),
  951:             message_role=role,
  952:             content=content,
  953:             turn_id=str(item.get("turn_id") or raw_id),
  954:             parent_message_id=str(item.get("parent_message_id") or "") or None,
  955:             source_kind=str(source.get("kind") or "automatic_capture"),
  956:             assignment_id_value=str((envelope.get("raw_payload") or {}).get("task_id") or "") or None,
  957:             message_id=message_id,
  958:             event_id=event_id,
  959:         )
  960:         identifiers.append(str(record.get("message_id") or message_id))
  961:     return identifiers, {}
  962: 
  963: 
  964: def ingest_event(raw: dict[str, Any], workplace_root: Path | None, core: Any, *, project_ref: str | None = None) -> dict[str, Any]:
  965:     """Persist a private raw event before attempting its derived project effect.
  966: 
  967:     Adapters provide native envelopes and may attach an already-normalized
  968:     ``derived_event``.  The Host remains provider-neutral: it only validates
  969:     project scope and executes the existing normalized-event behavior.
  970:     """
  971: 
  972:     envelope = dict(raw) if _is_native_envelope(raw) else _runtime_native_envelope(raw, project_ref)
  973:     source_project_ref = str(envelope.get("source_project_ref") or project_ref or "")
  974:     if not source_project_ref:
  975:         raise SystemExit("FAIL: runtime event requires --project-root or project_root/cwd in input")
  976:     project_root = resolve_project(source_project_ref, core)
  977:     workplace_root = workplace_root or core.resolve_workplace_root(None, project_root=project_root)
  978:     native = NativeAgentEvent(
  979:         provider=str(envelope["provider"]),
  980:         adapter=str(envelope["adapter"]),
  981:         native_event_type=str(envelope["native_event_type"]),
  982:         raw_payload=dict(envelope["raw_payload"]),
  983:         payload_version=str(envelope.get("payload_version") or "1"),
  984:         native_event_id=str(envelope.get("native_event_id") or "") or None,
  985:         native_id_scope=str(envelope.get("native_id_scope") or "provider"),
  986:         native_event_id_stable=bool(envelope.get("native_event_id_stable", True)),
  987:         source_session_id=str(envelope.get("source_session_id") or "") or None,
  988:         source_project_ref=source_project_ref,
  989:     )
  990:     receipt = RawIngressKernel(workplace_root).ingest(native)
  991:     response = _raw_receipt_payload(receipt)
  992:     if not receipt.accepted:
  993:         return response
  994: 
  995:     derived = envelope.get("derived_event")
  996:     derived_event_type = _derived_event_type(derived) if isinstance(derived, dict) else ""
  997:     derived_session_id = _derived_session_id(derived) if isinstance(derived, dict) else ""
  998:     ended_session_presence: dict[str, Any] | None = None
  999:     if (
 1000:         isinstance(derived, dict)
 1001:         and derived_event_type in {"agent.session.ended", "agent.session.stopped"}
 1002:         and isinstance(envelope.get("derived_conversation_messages"), list)
 1003:         and derived_session_id
 1004:     ):
 1005:         ended_session_presence = ledger_session(derived_session_id, workplace_root, core)
 1006: 
 1007:     if isinstance(derived, dict):
 1008:         derived_ref = str(derived.get("project_root") or derived.get("cwd") or "")
 1009:         if derived_ref and resolve_project(derived_ref, core) != project_root:
 1010:             raise PermissionError("derived event project_root does not match native envelope")
 1011:         # Preserve the established CLI/Runtime 403 behavior for project/session
 1012:         # denial.  The raw receipt already exists at this point for later audit.
 1013:         routed = _ingest_derived_event(derived, workplace_root, core, project_ref=str(project_root))
 1014:         response = {
 1015:             **routed,
 1016:             **response,
 1017:             "routing_status": "routed",
 1018:             "normalized_event_ids": [str(routed["event_id"])],
 1019:         }
 1020:         if derived_event_type in {"agent.session.started", "agent.session.resumed"}:
 1021:             flushed_ids, flushed_diagnostics = _flush_deferred_conversation(project_root, workplace_root, derived_session_id, core)
 1022:             response["chat_message_ids"] = [*response["chat_message_ids"], *flushed_ids]
 1023:             response["diagnostics"] = {**response["diagnostics"], **flushed_diagnostics}
 1024: 
 1025:     chat_message_ids, conversation_diagnostics = _conversation_messages(
 1026:         envelope,
 1027:         receipt,
 1028:         project_root,
 1029:         workplace_root,
 1030:         core,
 1031:         ended_session_presence=ended_session_presence,
 1032:     )
 1033:     if (
 1034:         _conversation_reason(conversation_diagnostics) == "session_not_authorized"
 1035:         and not _is_worker_conversation(envelope)
 1036:         and derived_event_type not in {"agent.session.ended", "agent.session.stopped"}
 1037:         and str(envelope.get("source_session_id") or "")
 1038:         and not ledger_session(str(envelope.get("source_session_id") or ""), workplace_root, core)
 1039:     ):
 1040:         _defer_conversation_capture(envelope, receipt, project_root, workplace_root, core)
 1041:         chat_message_ids, conversation_diagnostics = _conversation_deferred(
 1042:             "session_not_authorized",
 1043:             session_id=str(envelope.get("source_session_id") or ""),
 1044:         )
 1045:     response["chat_message_ids"] = [*response["chat_message_ids"], *chat_message_ids]
 1046:     response["diagnostics"] = {**response["diagnostics"], **conversation_diagnostics}
 1047:     return response
 1048: 
