 1623: def write_global_agent_section(path: Path, *, dry_run: bool = False, force: bool = False) -> WriteResult:
 1624:     existing = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
 1625:     updated = upsert_bounded_section(existing, GLOBAL_AGENT_SECTION)
 1626:     if existing == updated:
 1627:         return WriteResult(path, "unchanged", path)
 1628:     if dry_run or (path.exists() and not force):
 1629:         candidate = path.with_name(path.name + ".candidate")
 1630:         candidate.parent.mkdir(parents=True, exist_ok=True)
 1631:         candidate.write_text(updated, encoding="utf-8")
 1632:         return WriteResult(path, "candidate", candidate)
 1633:     path.parent.mkdir(parents=True, exist_ok=True)
 1634:     path.write_text(updated, encoding="utf-8")
 1635:     return WriteResult(path, "written", path)
