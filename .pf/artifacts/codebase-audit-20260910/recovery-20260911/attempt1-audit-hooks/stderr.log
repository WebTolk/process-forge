 6156: def start_agent_run_block(project_root: Path) -> str:
 6157:     active_runs = active_run_ids(project_root)
 6158:     if active_runs:
 6159:         return f"""## Active Run
 6160: 
 6161: Current ProcessForge run:
 6162: 
 6163: ```bash
 6164: python .pf/runtime/bin/pf.py run-status --project-root . --run {active_runs[0]}
 6165: ```
 6166: 
 6167: Work loop:
 6168: 
 6169: ```bash
 6170: python .pf/runtime/bin/pf.py task-list --project-root . --run {active_runs[0]}
 6171: python .pf/runtime/bin/pf.py iteration-add --project-root . --task <task-id> --kind work --summary "..." --apply
 6172: python .pf/runtime/bin/pf.py iteration-add --project-root . --task <task-id> --kind debug --summary "..." --apply
 6173: python .pf/runtime/bin/pf.py task-complete --project-root . --task <task-id> --summary "..." --apply
 6174: python .pf/runtime/bin/pf.py run-summary --project-root . --run {active_runs[0]} --apply
 6175: ```
 6176: """
 6177:     return """## Create A Run
 6178: 
 6179: ```bash
 6180: python .pf/runtime/bin/pf.py run-create --project-root . --id <run-id> --title "<title>" --process task-batch-execution --apply
 6181: ```
 6182: 
 6183: ## Create A Process
 6184: 
 6185: ```bash
 6186: python .pf/runtime/bin/pf.py process-authoring-start --project-root . --id <process-id> --title "<title>" --apply
 6187: python .pf/runtime/bin/pf.py process-authoring-review --project-root . --process <process-id>
 6188: python .pf/runtime/bin/pf.py process-authoring-apply --project-root . --process <process-id>
 6189: python .pf/runtime/bin/pf.py process-doctor --project-root . --process <process-id>
 6190: ```
 6191: """
 6192: 
 6193: 
 6194: def refresh_start_agent_run_block(project_root: Path, text: str) -> str:
 6195:     block = start_agent_run_block(project_root).rstrip() + "\n"
 6196:     markers = ["## Active Run", "## Create A Run"]
 6197:     positions = [text.find(marker) for marker in markers if marker in text]
 6198:     if positions:
 6199:         start = min(positions)
 6200:         return text[:start].rstrip() + "\n\n" + block
 6201:     return text.rstrip() + "\n\n" + block
