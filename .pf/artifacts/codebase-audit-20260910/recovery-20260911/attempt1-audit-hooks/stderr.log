25748: def build_platform_authoring_plan(
25749:     args: argparse.Namespace,
25750:     command_name: str,
25751: ) -> tuple[AuthoringPlan, dict[str, Any], Path]:
25752:     workplace_root = Path(args.workplace).expanduser().resolve()
25753:     if not (workplace_root / "workplace.yaml").is_file():
25754:         raise SystemExit(f"FAIL: workplace is not initialized: {workplace_root}")
25755:     values = platform_authoring_values(args)
25756:     platform_dependency_preflight(
25757:         workplace_root,
25758:         values["required_packages"],
25759:         values["required_templates"],
25760:         values["required_tools"],
25761:         values["required_mcp"],
25762:     )
25763:     root_id, platform_root = resolve_platform_root(
25764:         workplace_root,
25765:         getattr(args, "platform_root", None),
25766:         mode="read",
25767:     )
25768:     target = contained_resource_path(
25769:         platform_root,
25770:         platform_root / values["contract_id"],
25771:         "platform",
25772:     )
25773:     contract_path = target / "platform-contract.yaml"
25774:     legacy_path = (
25775:         workplace_root
25776:         / "platforms"
25777:         / values["platform_id"]
25778:         / "platform.yaml"
25779:     )
25780:     registry_data = load_yaml_document(workplace_root / "registries" / "platforms.yaml")
25781:     registry_entries = (
25782:         registry_data.get("platforms")
25783:         if isinstance(registry_data.get("platforms"), list)
25784:         else []
25785:     )
25786:     existing_entry = next(
25787:         (
25788:             item
25789:             for item in registry_entries
25790:             if isinstance(item, dict)
25791:             and str(item.get("id")) == values["platform_id"]
25792:         ),
25793:         None,
25794:     )
25795:     if legacy_path.is_file():
25796:         raise SystemExit(
25797:             "FAIL: unsupported legacy platform state exists at "
25798:             f"{legacy_path}; remove or recreate it through a separately reviewed conversion"
25799:         )
25800:     if existing_entry and "platforms/" in str(existing_entry.get("path") or "").replace("\\", "/"):
25801:         raise SystemExit(
25802:             "FAIL: unsupported legacy platform registry entry; remove or recreate it "
25803:             "through a separately reviewed conversion"
25804:         )
25805:     force = bool(getattr(args, "force", False))
25806:     if contract_path.exists() and not force:
25807:         raise SystemExit(f"FAIL: platform contract already exists: {contract_path}")
25808:     contract = platform_contract_from_values(values)
25809:     require_json_schema_document(
25810:         contract,
25811:         "platform-contract.schema.json",
25812:         f"platform {values['contract_id']} contract",
25813:     )
25814:     registry_path = workplace_root / "registries" / "platforms.yaml"
25815:     registry_bytes, _result, _proposed = planned_registry_upsert(
25816:         registry_path,
25817:         "platforms",
25818:         {
25819:             "id": values["platform_id"],
25820:             "name": values["title"],
25821:             "package_id": values["contract_id"],
25822:             "path": rel(contract_path, workplace_root),
25823:             "status": "available",
25824:         },
25825:         "platform-registry.schema.json",
25826:     )
25827:     registry_writes: list[AuthoringWrite] = []
25828:     root_registry = workplace_root / "registries" / "platform-contract-roots.yaml"
25829:     root_data = load_yaml_document(root_registry)
25830:     roots = (
25831:         root_data.get("platform_contract_roots")
25832:         if isinstance(root_data.get("platform_contract_roots"), list)
25833:         else []
25834:     )
25835:     if not roots:
25836:         root_bytes, _root_result, _root_proposed = planned_registry_upsert(
25837:             root_registry,
25838:             "platform_contract_roots",
25839:             {
25840:                 "id": "global",
25841:                 "label": "Global platform contracts",
25842:                 "path": "${PF_PLATFORM_CONTRACTS}",
25843:                 "scope": "workplace",
25844:                 "status": "available",
25845:             },
25846:             "platform-contract-roots-registry.schema.json",
25847:         )
25848:         registry_writes.append(
25849:             AuthoringWrite(
25850:                 root_registry,
25851:                 root_bytes,
25852:                 role="registry",
25853:                 operation="replace" if root_registry.is_file() else "create",
25854:                 schema_name="platform-contract-roots-registry.schema.json",
25855:                 allow_replace=root_registry.is_file(),
25856:             )
25857:         )
25858:     registry_writes.append(
25859:         AuthoringWrite(
25860:             registry_path,
25861:             registry_bytes,
25862:             role="registry",
25863:             operation="replace" if registry_path.is_file() else "create",
25864:             schema_name="platform-registry.schema.json",
25865:             allow_replace=registry_path.is_file(),
25866:         )
25867:     )
25868:     entity_writes = [
25869:         AuthoringWrite(
25870:             path,
25871:             content,
25872:             role="entity",
25873:             operation="replace" if path.exists() else "create",
25874:             schema_name=schema_name,
25875:             allow_replace=force,
25876:         )
25877:         for path, content, schema_name in platform_entity_documents(
25878:             target,
25879:             values,
25880:             contract,
25881:             root_id,
25882:         )
25883:     ]
25884:     transaction_id = f"{safe_id(command_name, 'platform')}-{values['platform_id']}-{uuid.uuid4().hex[:12]}"
25885:     plan = AuthoringPlan(
25886:         transaction_id=transaction_id,
25887:         command=command_name,
25888:         runtime_root=workplace_root / "runtime",
25889:         authoritative_writes=entity_writes,
25890:         registry_writes=registry_writes,
25891:         post_commit_effects=[],
25892:         validation_callbacks=[],
25893:     )
25894: 
25895:     def validate_platform_plan(_plan: AuthoringPlan, staged: dict[Path, Path] | None) -> None:
25896:         candidate = contract
25897:         if staged is not None:
25898:             candidate = load_yaml_document(staged[contract_path])
25899:         require_json_schema_document(
25900:             candidate,
25901:             "platform-contract.schema.json",
25902:             f"platform {values['contract_id']} staged contract",
25903:         )
25904:         platform_resolution = resolve_platform_contracts(
25905:             workplace_root / "workplace.yaml",
25906:             [values["contract_id"]],
25907:             contract_overrides={values["contract_id"]: candidate},
25908:         )
25909:         failures = [
25910:             item.message
25911:             for item in platform_contract_semantic_checks(
25912:                 workplace_root,
25913:                 candidate,
25914:                 values["contract_id"],
25915:                 platform_resolution=platform_resolution,
25916:             )
25917:             if item.level == "FAIL"
25918:         ]
25919:         if failures:
25920:             raise SystemExit("FAIL: staged platform validation failed: " + "; ".join(failures))
25921: 
25922:     plan.validation_callbacks.append(validate_platform_plan)
25923:     plan.post_commit_effects.append(
25924:         AuthoringEffect(
25925:             "platform-audit-events",
25926:             "runtime/resource-management/proposals/<transaction>.yaml and runtime/events/events.ndjson",
25927:             kind="platform_audit",
25928:             payload={
25929:                 "workplace_root": str(workplace_root),
25930:                 "command": command_name,
25931:                 "contract_id": values["contract_id"],
25932:                 "proposal_payload": {
25933:                     "transaction_id": transaction_id,
25934:                     "platform": values["contract_id"],
25935:                     "platform_root": root_id,
25936:                     "target": rel(contract_path, workplace_root),
25937:                 },
25938:                 "events": [
25939:                     {
25940:                         "event_type": "platform.contract.created",
25941:                         "status": "created",
25942:                         "message": "platform contract created",
25943:                         "target": {"platform": values["contract_id"], "transaction_id": transaction_id},
25944:                     },
25945:                     {
25946:                         "event_type": "platform.contract.linked",
25947:                         "status": "linked",
25948:                         "message": "platform registry updated",
25949:                         "target": {"platform": values["contract_id"], "transaction_id": transaction_id},
25950:                     },
25951:                     {
25952:                         "event_type": "platform.contract.doctor.passed",
25953:                         "status": "passed",
25954:                         "message": "staged platform checks passed",
25955:                         "target": {"platform": values["contract_id"], "transaction_id": transaction_id},
25956:                     },
25957:                     {
25958:                         "event_type": "platform.authoring.completed",
25959:                         "status": "completed",
25960:                         "message": "platform authoring completed",
25961:                         "target": {"platform": values["contract_id"], "transaction_id": transaction_id},
25962:                     },
25963:                 ],
25964:             },
25965:         )
25966:     )
25967:     return plan, values, contract_path
25968: 
25969: 
25970: def command_platform_create(args: argparse.Namespace) -> int:
25971:     mode = authoring_mode(args)
25972:     plan, _values, contract_path = build_platform_authoring_plan(args, "platform-create")
25973:     workplace_root = Path(args.workplace).expanduser().resolve()
25974:     if mode == "dry_run":
25975:         render_authoring_dry_run(plan, workplace_root)
25976:         return 0
25977:     execute_authoring_plan(plan)
25978:     print(f"PLATFORM: {rel(contract_path, workplace_root)}")
25979:     print_search_index_maintenance_summary(search_index_maintenance_for_known_projects(workplace_root, reason="platform-create"))
25980:     return 0
25981: 
25982: 
25983: def install_platform_args(args: argparse.Namespace) -> argparse.Namespace:
25984:     platform_id = validate_resource_id(
25985:         str(args.id).removeprefix("platform."),
25986:         "platform",
25987:     )
25988:     return argparse.Namespace(
25989:         workplace=args.workplace,
25990:         id=platform_id,
25991:         title=title_from_id(platform_id),
25992:         version=args.version,
25993:         platform_root=None,
25994:         project_type=[platform_id],
25995:         requires_package=[item for item in args.required_packages.split(",") if item],
25996:         recommends_package=[
25997:             item for item in args.recommended_packages.split(",") if item
25998:         ],
25999:         optional_package=[],
26000:         requires_template=[
26001:             item for item in args.required_templates.split(",") if item
26002:         ],
26003:         recommends_template=[
26004:             item for item in args.recommended_templates.split(",") if item
26005:         ],
26006:         optional_template=[],
26007:         requires_tool=[item for item in args.required_tools.split(",") if item],
26008:         recommends_tool=[
26009:             item for item in args.recommended_tools.split(",") if item
26010:         ],
26011:         optional_tool=[],
26012:         requires_mcp=[item for item in args.required_mcp.split(",") if item],
26013:         recommends_mcp=[item for item in args.recommended_mcp.split(",") if item],
26014:         optional_mcp=[],
26015:         process=[],
26016:         force=False,
26017:         apply=bool(getattr(args, "apply", False)),
26018:         dry_run=bool(getattr(args, "dry_run", False)),
26019:     )
26020: 
26021: 
26022: def command_platform_contract_install(args: argparse.Namespace) -> int:
26023:     normalized = install_platform_args(args)
26024:     mode = authoring_mode(normalized)
26025:     plan, _values, contract_path = build_platform_authoring_plan(
26026:         normalized,
26027:         "platform-contract-install",
26028:     )
26029:     workplace_root = Path(args.workplace).expanduser().resolve()
26030:     if mode == "dry_run":
26031:         render_authoring_dry_run(plan, workplace_root)
26032:         return 0
26033:     execute_authoring_plan(plan)
26034:     print(f"CONTRACT: {rel(contract_path, workplace_root)}")
26035:     print_search_index_maintenance_summary(search_index_maintenance_for_known_projects(workplace_root, reason="platform-contract-install"))
26036:     return 0
