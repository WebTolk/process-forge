 2765:     next_steps = f"""# Next Steps
 2766: 
 2767: ## Project Onboarding
 2768: 
 2769: ```bash
 2770: python {machine.get("processforge_root") or "<processforge-root>"}/bin/pf.py project-onboard --project-root <project-root> --workplace {workplace} --type generic --apply
 2771: ```
 2772: 
 2773: Inside an onboarded project, read `.pf/START_AGENT_HERE.md` and use `python .pf/runtime/bin/pf.py`.
 2774: """
 2775:     (session_dir / "apply-report.md").write_text(ensure_trailing_newline(report), encoding="utf-8")
 2776:     (session_dir / "next-steps.md").write_text(ensure_trailing_newline(next_steps), encoding="utf-8")
 2777:     append_workplace_event(workplace, "workplace.setup.applied", payload={"session_id": session_id, "doctor_status": status})
 2778:     print(output, end="")
 2779:     print(f"WROTE: {rel(session_dir / 'apply-report.md', workplace)}")
