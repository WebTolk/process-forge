 4685:     if not isinstance(data, dict) or yaml_error(data):
 4686:         return {"schema_version": 1, "kind": "processforge.project_overrides", "overrides": {}}
 4687:     overrides = data.get("overrides")
 4688:     if not isinstance(overrides, dict):
 4689:         data["overrides"] = {}
