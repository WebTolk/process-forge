 6744: def command_clean(args: argparse.Namespace) -> int:
 6745:     root = Path(args.root).expanduser().resolve()
 6746:     if not args.release:
 6747:         print("WARN: nothing selected; use --release to remove safe generated release artifacts")
 6748:         return 0
 6749:     removed: list[str] = []
 6750:     for path in sorted(root.rglob("*"), key=lambda item: len(item.parts), reverse=True):
 6751:         if path.name in {".git", ".idea", ".serena"}:
 6752:             continue
 6753:         if safe_remove_generated_path(path, root):
 6754:             removed.append(rel(path, root))
 6755:     for item in removed:
 6756:         print(f"REMOVED: {item}")
 6757:     print(f"PASS: release cleanup removed {len(removed)} generated paths.")
 6758:     return 0
