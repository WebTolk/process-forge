 2336: def workplace_event(root: Path, event_type: str, *, payload: dict[str, Any] | None = None) -> dict[str, Any]:
 2337:     manifest = root / "workplace.yaml"
 2338:     workplace_id = safe_id(root.name or "workplace", "workplace")
 2339:     if manifest.is_file():
 2340:         data = load_yaml_document(manifest)
 2341:         workplace = data.get("workplace") if isinstance(data, dict) else None
 2342:         if isinstance(workplace, dict) and workplace.get("id"):
 2343:             workplace_id = safe_id(str(workplace["id"]), "workplace")
 2344:     return {
 2345:         "schema_version": 1,
 2346:         "event_id": f"evt_{uuid.uuid4().hex}",
 2347:         "event_type": event_type,
 2348:         "source": "processforge.cli",
 2349:         "subject": workplace_id,
 2350:         "time": now_utc(),
 2351:         "correlation_id": f"workplace-init-{workplace_id}",
 2352:         "project": {"flow_root": "workplace", "project_id": workplace_id},
 2353:         "process": {"id": "workplace-initialization", "version": "1.0.0", "stage_id": None, "process_run_id": None},
 2354:         "assignment": {"id": None, "path": None},
 2355:         "actor": {"type": "agent", "id": "processforge-cli", "role": "orchestrator"},
 2356:         "session": {"id": None},
 2357:         "data": payload or {},
 2358:         "severity": "info",
 2359:         "privacy": "private",
 2360:     }
 2361: 
 2362: 
 2363: def append_workplace_event(root: Path, event_type: str, *, payload: dict[str, Any] | None = None) -> Path:
 2364:     events_path = root / "runtime" / "events" / "events.ndjson"
 2365:     events_path.parent.mkdir(parents=True, exist_ok=True)
 2366:     with events_path.open("a", encoding="utf-8") as handle:
 2367:         handle.write(json.dumps(workplace_event(root, event_type, payload=payload), ensure_ascii=False, sort_keys=True) + "\n")
 2368:     return events_path
 2369: 
 2370: 
 2371: def command_init_workplace(args: argparse.Namespace) -> int:
 2372:     root = Path(args.root).expanduser().resolve()
 2373:     answers = load_answers(Path(args.answers).expanduser().resolve() if args.answers else None)
 2374:     profile = str(getattr(args, "profile", "") or "").strip()
 2375:     if profile:
 2376:         answers = dict(answers)
 2377:         answers["profile"] = profile
 2378:     files = build_workplace_files(root, answers)
 2379:     planned_dirs = [root / "cache", root / "runtime", root / "runtime" / "events", root / "logs", root / "artifacts", root / "reviews", root / "handoffs", root / "packages", root / "knowledge", root / "reusable-templates", root / "platform-contracts", root / "specializations", root / "runtime-drivers", root / "tools", root / "mcp"]
 2380:     if not args.apply:
 2381:         print_plan("workplace init dry run", list(files) + planned_dirs, root)
 2382:         return 0
 2383:     append_workplace_event(root, "workplace.initialization.started", payload={"command": getattr(args, "command", "init-workplace")})
 2384:     for directory in planned_dirs:
 2385:         directory.mkdir(parents=True, exist_ok=True)
 2386:     results: list[WriteResult] = []
 2387:     for path, content in files.items():
 2388:         if path.name == "AGENTS.md":
 2389:             results.append(write_global_agent_section(path, force=args.force))
 2390:         else:
 2391:             results.append(write_file(path, content, force=args.force))
 2392:     workplace_coordination = workplace_coordination_config(root / "workplace.yaml")
 2393:     if workplace_coordination.get("director_office_enabled"):
 2394:         initialize_director_office(root, workplace_coordination)
 2395:     append_workplace_event(root, "workplace.structure.created", payload={"directories": [rel(path, root) for path in planned_dirs]})
 2396:     append_workplace_event(root, "workplace.path_constants.created", payload={"manifest": "workplace.yaml"})
 2397:     append_workplace_event(root, "workplace.registry.created", payload={"registries": "registries/"})
 2398:     doctor_status, doctor_output = run_command_capture(command_doctor_workplace, argparse.Namespace(root=str(root)))
 2399:     print(doctor_output, end="")
 2400:     finalize_workplace_doctor_artifacts(root, doctor_status, doctor_output)
 2401:     append_workplace_event(
 2402:         root,
 2403:         "workplace.doctor.passed" if doctor_status == 0 else "workplace.doctor.failed",
 2404:         payload={"status": "pass" if doctor_status == 0 else "fail"},
 2405:     )
 2406:     maintenance = search_index_maintenance_for_known_projects(root, reason="workplace-init")
 2407:     append_workplace_event(root, "workplace.initialization.completed", payload={"files": [rel(result.target, root) for result in results], "doctor_status": doctor_status})
 2408:     print_search_index_maintenance_summary(maintenance)
 2409:     for result in results:
 2410:         print(f"{result.status.upper()}: {rel(result.target, root)}")
 2411:     return doctor_status
