  325: def load_state(workplace_root: Path) -> dict[str, Any]:
  326:     payload = read_json(state_path(workplace_root))
  327:     if not payload:
  328:         payload = {
  329:             "schema_version": 1,
  330:             "runtime_protocol_version": RUNTIME_PROTOCOL_VERSION,
  331:             "status": "lazy",
  332:             "projects": [],
  333:             "sessions": {},
  334:         }
  335:     payload.setdefault("schema_version", 1)
  336:     payload.setdefault("runtime_protocol_version", RUNTIME_PROTOCOL_VERSION)
  337:     payload.setdefault("status", "lazy")
  338:     payload.setdefault("projects", [])
  339:     payload.setdefault("sessions", {})
  340:     return payload
