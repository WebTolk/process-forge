23727: def print_search_index_status(payload: dict[str, Any]) -> None:
23728:     sqlite_info = payload.get("sqlite") if isinstance(payload.get("sqlite"), dict) else {}
23729:     print(f"STATUS: {payload.get('status')}")
23730:     print(f"GENERATION: {payload.get('generation') or 'none'}")
23731:     print(f"SQLITE_VERSION: {sqlite_info.get('sqlite_version') or 'unknown'}")
23732:     print(f"FTS5: {'available' if sqlite_info.get('fts5_available') else 'unavailable'}")
23733:     print(f"RESOURCES: {payload.get('resource_count')}")
23734:     print(f"DOCUMENTS: {payload.get('document_count')}")
23735:     print(f"STALE_RESOURCES: {payload.get('stale_resource_count')}")
23736:     print(f"FAILED_FILES: {payload.get('failed_file_count')}")
23737:     print(f"LAST_SUCCESSFUL_REFRESH: {payload.get('last_successful_refresh') or 'none'}")
23738:     print(f"LAST_FULL_RECONCILIATION: {payload.get('last_full_reconciliation') or 'none'}")
23739:     if payload.get("error"):
23740:         print(f"ERROR: {payload.get('error')}")
23741:     if payload.get("path"):
23742:         print(f"INDEX: {payload.get('path')}")
23743: 
