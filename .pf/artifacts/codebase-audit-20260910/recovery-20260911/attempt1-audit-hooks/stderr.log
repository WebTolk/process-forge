 4799: def apply_resource_excludes(required: set[str], candidates: set[str], excludes: set[str], conflicts: list[dict[str, Any]], source: str, kind: str) -> set[str]:
 4800:     for item in sorted(required.intersection(excludes)):
 4801:         conflicts.append({"id": item, "kind": kind, "source": source, "reason": "cannot exclude required resource"})
 4802:     return candidates - (excludes - required)
 4803: 
