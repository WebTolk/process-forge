20566: def _command_run_complete_locked(args: argparse.Namespace) -> int:
20567:     project_root = Path(args.project_root).expanduser().resolve()
20568:     run = load_run(project_root, args.run)
20569:     run_id = str(run.get("id", safe_id(args.run, "run")))
20570:     tasks = [item for item in run.get("tasks", []) if isinstance(item, dict)] if isinstance(run.get("tasks"), list) else []
20571:     incomplete = [str(item.get("id")) for item in tasks if item.get("blocking", True) is not False and str(item.get("status")) != "done"]
20572:     if incomplete:
20573:         raise SystemExit("FAIL: blocking tasks are not done: " + ", ".join(incomplete))
20574:     if getattr(args, "dry_run", False):
20575:         print(f"DRY-RUN: would complete run {run_id}")
20576:         return 0
20577:     run["status"] = "completed"
20578:     emitted = run.setdefault("events", {}).setdefault("emitted", []) if isinstance(run.setdefault("events", {}), dict) else []
20579:     if isinstance(emitted, list) and "run.completed" not in emitted:
20580:         emitted.append("run.completed")
20581:     summary = run_summary_path(project_root, run_id)
20582:     handoff = run_handoff_path(project_root, run_id)
20583:     artifacts = [rel(summary, project_root), rel(handoff, project_root)]
20584:     run["final_artifacts"] = artifacts
20585:     if isinstance(emitted, list) and "run.summary.created" not in emitted:
20586:         emitted.append("run.summary.created")
20587:     save_run_locked(project_root, run, include_summary_handoff=True)
20588:     emit_process_event(project_root, "run.completed", process_id=str(run.get("process", "")), subject=run_id, payload={"run_id": run_id}, correlation_id=f"run-{run_id}")
20589:     emit_process_event(project_root, "run.summary.created", process_id=str(run.get("process", "")), subject=run_id, payload={"run_id": run_id, "artifacts": artifacts}, correlation_id=f"run-{run_id}")
20590:     print(f"COMPLETED: {run_id}")
20591:     return 0
