  693: def runtime_request(args: argparse.Namespace, core: Any, path: str, payload: dict[str, Any]) -> int:
  694:     workplace_root = core.resolve_workplace_root(getattr(args, "workplace", None))
  695:     active, state = active_service(workplace_root, core)
  696:     if not active:
  697:         raise SystemExit("FAIL: runtime is not running")
  698:     token = load_token(workplace_root)
  699:     endpoint = str(state.get("endpoint") or "")
  700:     code, body = http_json("POST", endpoint.rstrip("/") + path, token=token, payload=payload, timeout=5.0)
  701:     print(json.dumps(body, ensure_ascii=False, indent=2, sort_keys=True) if getattr(args, "json", False) else core.dump_yaml(body))
  702:     return 0 if 200 <= code < 300 else 1
  703: 
