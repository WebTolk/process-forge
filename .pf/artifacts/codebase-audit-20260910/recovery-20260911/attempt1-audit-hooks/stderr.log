 3255: def command_project_mode_set(args: argparse.Namespace) -> int:
 3256:     project_root = Path(args.project_root).expanduser().resolve()
 3257:     flow_root = require_flow_root(project_root)
 3258:     mode = normalize_project_coordination_mode(args.mode)
 3259:     if mode == "organized":
 3260:         status = effective_project_coordination(project_root, getattr(args, "workplace", None))
 3261:         if not status["workplace_director_enabled"]:
 3262:             raise SystemExit("FAIL: organized project mode requires workplace director_enabled=true")
 3263:         workplace_root = Path(str(status["workplace_root"])) if status.get("workplace_root") else None
 3264:         if workplace_root and (args.init_office or status.get("workplace_director_office_enabled")):
 3265:             initialize_director_office(workplace_root)
 3266:         elif not status.get("director_office_exists"):
 3267:             raise SystemExit("FAIL: organized project mode requires an initialized Director Office; rerun with --init-office or enable workplace Director Office")
 3268:     manifest = flow_root / "process-forge.yaml"
 3269:     data = read_yaml_file(manifest)
 3270:     coordination = data.get("coordination") if isinstance(data.get("coordination"), dict) else default_project_coordination()
 3271:     director = coordination.get("director") if isinstance(coordination.get("director"), dict) else {}
 3272:     coordination["mode"] = mode
 3273:     director.setdefault("use_workplace_director", True)
 3274:     director.setdefault("inbox_submit_required", False)
