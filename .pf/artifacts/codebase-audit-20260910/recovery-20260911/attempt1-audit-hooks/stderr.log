 6208:     if target.is_file() and "python tools/processforge.py" not in target.read_text(encoding="utf-8", errors="replace"):
 6209:         text = refresh_start_agent_run_block(project_root, target.read_text(encoding="utf-8", errors="replace"))
 6210:         target.write_text(ensure_trailing_newline(text), encoding="utf-8")
 6211:     else:
 6212:         text = default_start_agent_here(project_root)
 6213:         target.write_text(ensure_trailing_newline(text), encoding="utf-8")
 6214:         emit_process_event(project_root, "artifact.created", payload={"path": rel(target, project_root)})
 6215:         emit_process_event(project_root, "agent.start_prompt.generated", payload={"path": rel(target, project_root)})
 6216:     print(text.rstrip())
 6217:     return 0
