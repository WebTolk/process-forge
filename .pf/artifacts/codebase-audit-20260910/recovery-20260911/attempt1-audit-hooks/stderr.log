21576: 
21577: def update_schema_type_matches(value: Any, expected: str) -> bool:
21578:     if expected == "object":
21579:         return isinstance(value, dict)
21580:     if expected == "array":
21581:         return isinstance(value, list)
21582:     if expected == "string":
21583:         return isinstance(value, str)
21584:     if expected == "integer":
21585:         return isinstance(value, int) and not isinstance(value, bool)
21586:     if expected == "number":
21587:         return isinstance(value, (int, float)) and not isinstance(value, bool)
21588:     if expected == "boolean":
21589:         return isinstance(value, bool)
21590:     if expected == "null":
21591:         return value is None
21592:     return True
21593: 
21594: 
21595: def update_resolve_schema_ref(schema: dict[str, Any], ref: str) -> dict[str, Any]:
21596:     if not ref.startswith("#/"):
21597:         raise ValueError(f"unsupported external ref {ref}")
21598:     node: Any = schema
21599:     for part in ref[2:].split("/"):
21600:         node = node[part]
21601:     if not isinstance(node, dict):
21602:         raise ValueError(f"ref {ref} does not resolve to schema object")
21603:     return node
21604: 
21605: 
21606: def validate_update_instance_against_schema(value: Any, node: dict[str, Any], root_schema: dict[str, Any], path: str) -> list[str]:
21607:     errors: list[str] = []
21608:     if "$ref" in node:
21609:         return validate_update_instance_against_schema(value, update_resolve_schema_ref(root_schema, str(node["$ref"])), root_schema, path)
21610: 
21611:     all_of = node.get("allOf")
21612:     if isinstance(all_of, list):
21613:         for alternative in all_of:
21614:             if isinstance(alternative, dict):
21615:                 errors.extend(
21616:                     validate_update_instance_against_schema(
21617:                         value,
21618:                         alternative,
21619:                         root_schema,
21620:                         path,
21621:                     )
21622:                 )
21623: 
21624:     any_of = node.get("anyOf")
21625:     if isinstance(any_of, list):
21626:         matches = sum(
21627:             1
21628:             for alternative in any_of
21629:             if isinstance(alternative, dict)
21630:             and not validate_update_instance_against_schema(value, alternative, root_schema, path)
21631:         )
21632:         if matches == 0:
21633:             errors.append(f"{path}: expected at least one anyOf alternative")
21634: 
21635:     one_of = node.get("oneOf")
21636:     if isinstance(one_of, list):
21637:         matches = sum(
21638:             1
21639:             for alternative in one_of
21640:             if isinstance(alternative, dict)
21641:             and not validate_update_instance_against_schema(value, alternative, root_schema, path)
21642:         )
21643:         if matches != 1:
21644:             errors.append(f"{path}: expected exactly one oneOf alternative, got {matches}")
21645: 
21646:     excluded = node.get("not")
21647:     if isinstance(excluded, dict) and not validate_update_instance_against_schema(
21648:         value,
21649:         excluded,
21650:         root_schema,
21651:         path,
21652:     ):
21653:         errors.append(f"{path}: matched forbidden not schema")
21654: 
21655:     conditional = node.get("if")
21656:     if isinstance(conditional, dict):
21657:         condition_matches = not validate_update_instance_against_schema(
21658:             value,
21659:             conditional,
21660:             root_schema,
21661:             path,
21662:         )
21663:         branch = node.get("then") if condition_matches else node.get("else")
21664:         if isinstance(branch, dict):
21665:             errors.extend(
21666:                 validate_update_instance_against_schema(
21667:                     value,
21668:                     branch,
21669:                     root_schema,
21670:                     path,
21671:                 )
21672:             )
21673: 
21674:     expected_type = node.get("type")
21675:     if isinstance(expected_type, list):
21676:         if not any(update_schema_type_matches(value, item) for item in expected_type):
21677:             errors.append(f"{path}: expected one of {expected_type}, got {type(value).__name__}")
21678:             return errors
21679:     elif isinstance(expected_type, str) and not update_schema_type_matches(value, expected_type):
21680:         errors.append(f"{path}: expected {expected_type}, got {type(value).__name__}")
21681:         return errors
21682: 
21683:     if "const" in node and value != node["const"]:
21684:         errors.append(f"{path}: expected const {node['const']!r}")
21685:     if "enum" in node and value not in node["enum"]:
21686:         errors.append(f"{path}: expected one of {node['enum']!r}")
21687:     if "minimum" in node and isinstance(value, (int, float)) and value < node["minimum"]:
21688:         errors.append(f"{path}: expected minimum {node['minimum']}")
21689:     if "minLength" in node and isinstance(value, str) and len(value) < node["minLength"]:
21690:         errors.append(f"{path}: expected minLength {node['minLength']}")
21691:     if "minItems" in node and isinstance(value, list) and len(value) < node["minItems"]:
21692:         errors.append(f"{path}: expected minItems {node['minItems']}")
21693:     if "uniqueItems" in node and node["uniqueItems"] is True and isinstance(value, list):
21694:         normalized = [json.dumps(item, ensure_ascii=False, sort_keys=True) for item in value]
21695:         if len(normalized) != len(set(normalized)):
21696:             errors.append(f"{path}: expected uniqueItems")
21697:     if "minProperties" in node and isinstance(value, dict) and len(value) < node["minProperties"]:
21698:         errors.append(f"{path}: expected minProperties {node['minProperties']}")
21699:     if "pattern" in node and isinstance(value, str) and not re.fullmatch(str(node["pattern"]), value):
21700:         errors.append(f"{path}: does not match pattern {node['pattern']!r}")
21701: 
21702:     if isinstance(value, dict):
21703:         required = node.get("required", [])
21704:         if isinstance(required, list):
21705:             for key in required:
21706:                 if key not in value:
21707:                     errors.append(f"{path}: missing required key {key}")
21708:         properties = node.get("properties", {})
21709:         if isinstance(properties, dict):
21710:             for key, child_schema in properties.items():
21711:                 if key in value and isinstance(child_schema, dict):
21712:                     errors.extend(validate_update_instance_against_schema(value[key], child_schema, root_schema, f"{path}.{key}"))
21713:         additional = node.get("additionalProperties", True)
21714:         if additional is False and isinstance(properties, dict):
21715:             for key in value:
21716:                 if key not in properties:
21717:                     errors.append(f"{path}: unexpected key {key}")
21718:         elif isinstance(additional, dict) and isinstance(properties, dict):
21719:             for key, child_schema in value.items():
21720:                 if key not in properties:
21721:                     errors.extend(validate_update_instance_against_schema(child_schema, additional, root_schema, f"{path}.{key}"))
21722: 
21723:     if isinstance(value, list):
21724:         items_schema = node.get("items")
21725:         if isinstance(items_schema, dict):
21726:             for index, item in enumerate(value):
21727:                 errors.extend(validate_update_instance_against_schema(item, items_schema, root_schema, f"{path}[{index}]"))
21728: 
21729:     return errors
21730: 
21731: 
21732: def append_json_schema_checks(checks: list[Check], data: Any, schema_name: str, label: str) -> None:
21733:     schema_path = ROOT / "schemas" / schema_name
21734:     try:
21735:         schema = json.loads(schema_path.read_text(encoding="utf-8"))
21736:     except (OSError, json.JSONDecodeError) as exc:
21737:         checks.append(check("FAIL", f"{label} schema {schema_name} could not be loaded: {exc}"))
21738:         return
21739:     try:
21740:         errors = validate_update_instance_against_schema(data, schema, schema, "$")
21741:     except (KeyError, ValueError) as exc:
21742:         checks.append(check("FAIL", f"{label} schema {schema_name} is unsupported: {exc}"))
21743:         return
21744:     for message in errors:
21745:         checks.append(check("FAIL", f"{label} schema validation failed: {message}"))
21746:     if not errors:
21747:         checks.append(check("PASS", f"{label} matches {schema_name}"))
21748: 
21749: 
21750: def require_json_schema_document(data: Any, schema_name: str, label: str) -> None:
21751:     """Fail an apply/release precondition when a governed document is invalid."""
21752:     checks: list[Check] = []
21753:     append_json_schema_checks(checks, data, schema_name, label)
21754:     failures = [item.message for item in checks if item.level == "FAIL"]
21755:     if failures:
21756:         raise SystemExit("FAIL: " + "; ".join(failures))
21757: 
