23148: def copy_or_download_update_artifact(candidate: dict[str, Any], target: Path, workplace_root: Path) -> Path:
23149:     url = str(candidate.get("download_url") or "")
23150:     if not url:
23151:         raise ValueError("candidate has no download_url")
23152:     parsed = urlparse(url)
23153:     if parsed.scheme in {"", "file"}:
23154:         source = file_url_to_path(url, workplace_root)
23155:         if not source.is_file():
23156:             raise FileNotFoundError(source)
23157:         target_name = source.name
23158:         destination = target / target_name
23159:         shutil.copy2(source, destination)
23160:         return destination
23161:     if parsed.scheme in {"http", "https"}:
23162:         destination = target / Path(parsed.path).name
23163:         with urlopen(url, timeout=30) as response, destination.open("wb") as output:
23164:             shutil.copyfileobj(response, output)
23165:         return destination
23166:     raise ValueError(f"unsupported artifact URL scheme: {parsed.scheme}")
23167: 
23168: 
23169: def safe_extract_zip(archive_path: Path, destination: Path) -> None:
23170:     destination_resolved = destination.resolve()
23171:     with zipfile.ZipFile(archive_path) as archive:
23172:         for info in archive.infolist():
23173:             target = (destination / info.filename).resolve()
23174:             if destination_resolved != target and destination_resolved not in target.parents:
23175:                 raise ValueError(f"unsafe archive member: {info.filename}")
23176:         archive.extractall(destination)
23177: 
23178: 
23179: def artifact_manifest_from_zip(archive_path: Path) -> dict[str, Any]:
23180:     with zipfile.ZipFile(archive_path) as archive:
23181:         names = [name for name in archive.namelist() if name.endswith((".yaml", ".yml", ".json"))]
23182:         preferred = [name for name in names if Path(name).name in {"package.yaml", "package.yml", "template.yaml", "template.yml", "tool.yaml", "tool.yml", "process.yaml", "process.yml"}]
23183:         for name in preferred + names:
23184:             try:
23185:                 text = archive.read(name).decode("utf-8")
23186:             except Exception:
23187:                 continue
23188:             data = load_yaml_or_json_text(text)
23189:             if data.get("id"):
23190:                 return data
23191:     return {}
