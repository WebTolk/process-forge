  481:     def serve(self, port: int) -> int:
  482:         acquire_singleton(self.workplace_root, self.core, self.instance_id)
  483:         try:
  484:             self.state = base_state(self.workplace_root, self.core, status="starting", instance_id=self.instance_id)
  485:             self.state["token_hash"] = token_hash(self.token)
  486:             self.save()
  487:             self.httpd = ThreadingHTTPServer(("127.0.0.1", int(port)), self.make_handler())
  488:             host_name, bound_port = self.httpd.server_address
  489:             endpoint = f"http://{host_name}:{bound_port}"
  490:             self.state["endpoint"] = endpoint
  491:             self.state["status"] = "ready"
  492:             self.state["health"] = "ready"
  493:             self.save()
  494:             append_operator_log(self.workplace_root, self.core, "runtime.started", endpoint=endpoint, pid=os.getpid())
  495:             threading.Thread(target=self.scheduler_loop, daemon=True).start()
  496:             self.httpd.serve_forever(poll_interval=0.2)
  497:             self.state["status"] = "stopped"
  498:             self.state["health"] = "stopped"
  499:             self.save()
  500:             append_operator_log(self.workplace_root, self.core, "runtime.stopped", pid=os.getpid())
  501:             return 0
  502:         except BaseException as exc:
  503:             with self.state_lock:
  504:                 self.state["status"] = "failed"
  505:                 self.state["health"] = "failed"
  506:                 self.state["last_error"] = str(exc)
  507:             self.save()
  508:             append_operator_log(self.workplace_root, self.core, "runtime.failed", pid=os.getpid(), error=str(exc))
  509:             raise
  510:         finally:
  511:             release_singleton(self.workplace_root, self.instance_id)
  512: 
