24484: def normalize_platform_id(raw: str) -> tuple[str, str]:
24485:     platform_id = safe_id(raw.removeprefix("platform."), "platform")
24486:     return platform_id, platform_contract_id(platform_id)
24487: 
24488: 
24489: def platform_contract_path(workplace_root: Path, platform: str) -> Path | None:
24490:     platform_id, contract_id = normalize_platform_id(platform)
24491:     for candidate_id in [contract_id, platform_id]:
24492:         entry = platform_contract_registry_entry(workplace_root / "workplace.yaml", candidate_id)
24493:         if entry and entry.get("path"):
24494:             path = workplace_root / str(entry["path"])
24495:             if path.is_file():
24496:                 return path
24497:     _root_id, root_path = resolve_platform_root(workplace_root, None, mode="read")
24498:     for candidate in [root_path / contract_id / "platform-contract.yaml", root_path / platform_id / "platform-contract.yaml", workplace_root / "platforms" / platform_id / "platform.yaml"]:
24499:         if candidate.is_file():
24500:             return candidate
24501:     return None
24502: 
