 2795: def check(level: str, message: str) -> Check:
 2796:     return Check(level.upper(), message)
 2797: 
 2798: 
 2799: def print_checks(checks: list[Check]) -> int:
 2800:     failed = False
 2801:     for item in checks:
 2802:         print(f"{item.level}: {item.message}")
 2803:         failed = failed or item.level == "FAIL"
 2804:     return 1 if failed else 0
 2805: 
 2806: 
 2807: def check_with_hint(level: str, message: str, why: str, fix: str, alternative: str | None = None) -> Check:
 2808:     details = [message, "", "Why:", f"  {why}", "", "Fix:"]
 2809:     details.extend(f"  {line}" if line else "" for line in fix.splitlines())
 2810:     if alternative:
 2811:         details.extend(["", "Or:"])
 2812:         details.extend(f"  {line}" if line else "" for line in alternative.splitlines())
 2813:     return check(level, "\n".join(details))
 2814: 
 2815: 
 2816: def run_command_capture(func: Any, args: argparse.Namespace) -> tuple[int, str]:
 2817:     buffer = io.StringIO()
 2818:     status = 0
 2819:     with contextlib.redirect_stdout(buffer):
 2820:         try:
 2821:             status = int(func(args) or 0)
 2822:         except SystemExit as exc:
 2823:             status = int(exc.code) if isinstance(exc.code, int) else 1
 2824:             if exc.code and not isinstance(exc.code, int):
 2825:                 print(str(exc.code))
 2826:     return status, buffer.getvalue()
 2827: 
 2828: 
 2829: def path_constant_checks(workplace_root: Path, workplace_manifest: Path) -> list[Check]:
 2830:     checks: list[Check] = []
 2831:     data = load_yaml_document(workplace_manifest)
 2832:     constants_data = data.get("path_constants") if isinstance(data, dict) else None
 2833:     checks.append(check("PASS" if isinstance(constants_data, dict) else "WARN", "path_constants configured" if isinstance(constants_data, dict) else "path_constants missing; defaults will be used"))
 2834:     constants = load_workplace_path_constants(workplace_manifest, workplace_root)
 2835:     for name, value in constants.items():
 2836:         if name.startswith("_"):
 2837:             continue
 2838:         if not isinstance(value, str) or value == "":
 2839:             checks.append(check("FAIL", f"path constant {name} has empty value"))
 2840:             continue
 2841:         resolution = resolve_path_with_constants("${" + name + "}", workplace_root, constants)
 2842:         errors = resolution.get("errors", [])
 2843:         if errors:
 2844:             checks.append(check("FAIL", f"path constant {name} failed: {', '.join(errors)}"))
 2845:         else:
 2846:             checks.append(check("PASS", f"path constant {name} resolves ({resolution.get('path_status')})"))
 2847:     return checks
 2848: 
 2849: 
 2850: def registry_path_resolution_checks(workplace_root: Path, workplace_manifest: Path) -> list[Check]:
 2851:     checks: list[Check] = []
 2852:     constants = load_workplace_path_constants(workplace_manifest, workplace_root)
 2853:     manifest_data = load_yaml_document(workplace_manifest)
 2854:     registries = manifest_data.get("registries", {}) if isinstance(manifest_data.get("registries"), dict) else {}
 2855:     for key, default_name in [
 2856:         ("distributions", "distributions.yaml"),
 2857:         ("platforms", "platforms.yaml"),
 2858:         ("knowledge_roots", "knowledge-roots.yaml"),
 2859:         ("package_roots", "package-roots.yaml"),
 2860:         ("templates", "templates.yaml"),
 2861:         ("tools", "tools.yaml"),
 2862:         ("mcp", "mcp.yaml"),
 2863:         ("process_packs", "process-packs.yaml"),
 2864:     ]:
 2865:         raw_path = str(registries.get(key) or f"registries/{default_name}")
 2866:         resolution = resolve_path_with_constants(raw_path, workplace_root, constants)
 2867:         errors = resolution.get("errors", [])
 2868:         if errors:
 2869:             checks.append(check("FAIL", f"registry {key} path failed: {', '.join(errors)}"))
 2870:         else:
 2871:             path = path_resolution_to_path(resolution)
 2872:             checks.append(check("PASS" if path.is_file() else "FAIL", f"registry {key} resolves to {normalize_path_string(str(path))}"))
 2873:     registry_specs = [
 2874:         ("knowledge-roots.yaml", "knowledge_roots", "path"),
 2875:         ("package-roots.yaml", "package_roots", "path"),
 2876:         ("templates.yaml", "template_roots", "path"),
 2877:         ("tools.yaml", "tools", "command"),
 2878:         ("mcp.yaml", "mcp_servers", "command"),
 2879:     ]
 2880:     for registry_file, collection_key, path_key in registry_specs:
 2881:         registry_path = resolve_registry_path(workplace_manifest, collection_key if collection_key != "mcp_servers" else "mcp", registry_file)
 2882:         if collection_key == "template_roots":
 2883:             registry_path = resolve_registry_path(workplace_manifest, "templates", registry_file)
 2884:         elif collection_key == "tools":
 2885:             registry_path = resolve_registry_path(workplace_manifest, "tools", registry_file)
 2886:         elif collection_key == "knowledge_roots":
 2887:             registry_path = resolve_registry_path(workplace_manifest, "knowledge_roots", registry_file)
 2888:         elif collection_key == "package_roots":
 2889:             registry_path = resolve_registry_path(workplace_manifest, "package_roots", registry_file)
 2890:         if not registry_path.is_file():
 2891:             continue
 2892:         data = load_yaml_document(registry_path)
 2893:         entries = data.get(collection_key) if isinstance(data, dict) else None
 2894:         if not isinstance(entries, list):
 2895:             continue
 2896:         for entry in entries:
 2897:             if not isinstance(entry, dict) or not entry.get(path_key):
 2898:                 continue
 2899:             entry_id = str(entry.get("id", "entry"))
 2900:             resolution = resolve_path_with_constants(str(entry[path_key]), workplace_root, constants)
 2901:             errors = resolution.get("errors", [])
 2902:             if errors:
 2903:                 checks.append(check("FAIL", f"{collection_key}.{entry_id}.{path_key} failed: {', '.join(errors)}"))
 2904:                 continue
 2905:             if path_key == "path":
 2906:                 resolved_path = path_resolution_to_path(resolution)
 2907:                 requires_existing = str(entry.get("status", "available")) == "available" or bool(entry.get("must_exist", False))
 2908:                 level = "PASS" if resolved_path.exists() or not requires_existing else "WARN"
 2909:                 checks.append(check(level, f"{collection_key}.{entry_id}.path resolves ({resolution.get('path_status')})"))
 2910:             else:
 2911:                 checks.append(check("PASS", f"{collection_key}.{entry_id}.{path_key} resolves constants"))
 2912:     return checks
 2913: 
