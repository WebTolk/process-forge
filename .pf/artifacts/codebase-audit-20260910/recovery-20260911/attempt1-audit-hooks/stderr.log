25423: def command_project_override_add(args: argparse.Namespace) -> int:
25424:     project_root = Path(args.project_root).expanduser().resolve()
25425:     flow_root = locate_flow_root(project_root)
25426:     kind = PROJECT_OVERRIDE_KINDS.get(str(args.kind), str(args.kind))
25427:     mode = str(args.mode)
25428:     if kind not in {"templates", "knowledge_packages", "tools", "mcp", "specializations"}:
25429:         raise SystemExit(f"FAIL: unsupported project override kind: {args.kind}")
25430:     if mode not in PROJECT_OVERRIDE_MODES:
25431:         raise SystemExit(f"FAIL: unsupported project override mode: {mode}")
25432:     path = project_overrides_path(project_root)
25433:     data = load_project_overrides(project_root)
25434:     overrides = data.setdefault("overrides", {})
25435:     entries = overrides.setdefault(kind, [])
25436:     if not isinstance(entries, list):
25437:         entries = []
25438:         overrides[kind] = entries
25439:     entry = {"target": str(args.target), "mode": mode, "reason": str(args.reason)}
25440:     if getattr(args, "path", None):
25441:         entry["path"] = str(args.path)
25442:     if getattr(args, "project_package", None):
25443:         entry["project_package"] = str(args.project_package)
25444:     params: dict[str, Any] = {}
25445:     for value in getattr(args, "param", []) or []:
25446:         if "=" not in value:
25447:             raise SystemExit("FAIL: --param must use key=value")
25448:         key, param_value = value.split("=", 1)
25449:         params[key] = param_value
25450:     if params:
25451:         entry["params"] = params
25452:     existing = next((item for item in entries if isinstance(item, dict) and str(item.get("target")) == str(args.target)), None)
25453:     if existing:
25454:         existing.update(entry)
25455:     else:
25456:         entries.append(entry)
25457:     if not getattr(args, "apply", False):
25458:         print(dump_yaml(data), end="")
25459:         return 0
25460:     flow_root.mkdir(parents=True, exist_ok=True)
25461:     write_authoring_text(path, dump_yaml(data))
25462:     print(f"WROTE: {rel(path, project_root)}")
25463:     return 0
