25024: def template_manifest_path(workplace_root: Path, template_id: str) -> Path | None:
25025:     _root_id, root_path = resolve_template_root(workplace_root, None, mode="read")
25026:     candidate = root_path / template_id / "template.yaml"
25027:     if candidate.is_file():
25028:         return candidate
25029:     registry = load_yaml_document(workplace_root / "registries" / "templates.yaml")
25030:     entries = registry.get("templates") if isinstance(registry, dict) else None
25031:     if isinstance(entries, list):
25032:         for entry in entries:
25033:             if isinstance(entry, dict) and str(entry.get("id")) == template_id and entry.get("path"):
25034:                 path = workplace_root / str(entry["path"])
25035:                 return path if path.is_file() else None
25036:     return None
