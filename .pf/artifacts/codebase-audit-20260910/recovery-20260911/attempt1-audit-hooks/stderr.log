 6025:         )
 6026:     return {
 6027:         "status": "complete" if doctor_status == 0 else "blocked",
 6028:         "repair_action": "refresh_context",
 6029:         "snapshot": {"status": status, "id": snapshot.get("snapshot", {}).get("id") if isinstance(snapshot.get("snapshot"), dict) else None},
 6030:         "search_index": search_index,
 6031:         "doctor": {"status": "pass" if doctor_status == 0 else "fail"},
 6032:         "next_action": "continue" if doctor_status == 0 else "resolve_doctor_failures",
 6033:     }
