27878:         "knowledge-add-url",
27879:         "knowledge-add-resource",
27880:         "platform-contract-install",
27881:         "platform-create",
27882:         "process-authoring-apply",
27883:         "process-create",
27884:     }
27885:     apply_optional = (
27886:         (args.command == "workplace-setup" and getattr(args, "workplace_setup_command", "") in {"review", "status"})
27887:         or args.command == "project-context-refresh"
27888:     )
27889:     if hasattr(args, "apply") and args.apply and getattr(args, "dry_run", False):
27890:         parser.error("choose either --dry-run or --apply")
27891:     if args.command in strict_authoring_commands and not (
27892:         bool(getattr(args, "apply", False)) ^ bool(getattr(args, "dry_run", False))
27893:     ):
27894:         parser.error("choose exactly one of --dry-run or --apply")
27895:     if (
27896:         hasattr(args, "apply")
27897:         and not args.apply
27898:         and not apply_optional
27899:         and args.command not in strict_authoring_commands
27900:     ):
27901:         if not getattr(args, "dry_run", False):
27902:             args.mode_implicit = True
27903:         args.dry_run = True
27904:     return args.func(args)
27905: 
