   46: @dataclass(frozen=True)
   47: class RawReceipt:
   48:     raw_event_id: str | None
   49:     accepted: bool
   50:     deduplicated: bool
   51:     raw_location: str | None
   52:     routing_status: str
   53:     normalized_event_ids: tuple[str, ...] = ()
   54:     chat_message_ids: tuple[str, ...] = ()
   55:     diagnostics: Mapping[str, Any] = field(default_factory=dict)
   56: 
   57: 
   58: def canonical_json(value: Any) -> bytes:
   59:     """Return deterministic UTF-8 JSON with NFC strings and sorted keys."""
   60: 
   61:     return json.dumps(
   62:         _normalise_json(value), ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False
   63:     ).encode("utf-8")
   64: 
   65: 
   66: def raw_payload_hash(payload: Mapping[str, Any]) -> str:
   67:     return "sha256:" + hashlib.sha256(canonical_json(payload)).hexdigest()
   68: 
   69: 
   70: def raw_event_id(event: NativeAgentEvent) -> str:
   71:     """Derive the v1 raw identity, excluding receipt/transport metadata."""
   72: 
   73:     document = _identity_document(event, include_payload_hash=True)
   74:     return "raw_" + hashlib.sha256(canonical_json(document)).hexdigest()
   75: 
   76: 
   77: def stable_native_identity_key(event: NativeAgentEvent) -> str | None:
   78:     """Return the conflict-detection key, deliberately excluding payload hash."""
   79: 
   80:     if not _uses_stable_native_id(event):
   81:         return None
   82:     digest = hashlib.sha256(canonical_json(_identity_document(event, include_payload_hash=False))).hexdigest()
   83:     return "native_" + digest
   84: 
   85: 
   86: def deterministic_derived_key(
   87:     raw_id: str, derived_kind: str, processor_id: str, processor_version: str, semantic_target: Any
   88: ) -> str:
   89:     """Return a deterministic idempotency key for a derived sink effect."""
   90: 
   91:     if not raw_id.startswith("raw_"):
   92:         raise RawIngressError("raw_id must start with raw_")
   93:     return hashlib.sha256(
   94:         canonical_json(
   95:             {
   96:                 "contract": "processforge.derived-id.v1",
   97:                 "raw_event_id": raw_id,
   98:                 "derived_kind": _text(derived_kind, "derived_kind"),
   99:                 "processor_id": _text(processor_id, "processor_id"),
  100:                 "processor_version": _text(processor_version, "processor_version"),
  101:                 "semantic_target": semantic_target,
  102:             }
  103:         )
  104:     ).hexdigest()
  105: 
  106: 
  107: def _strip_windows_extended_prefix(value: str) -> str:
  108:     """Return a normal spelling for an equivalent Win32 extended path."""
  109: 
  110:     if value.startswith("\\\\?\\UNC\\"):
  111:         return "\\\\" + value[8:]
  112:     if value.startswith("\\\\?\\"):
  113:         return value[4:]
  114:     return value
  115: 
  116: 
  117: def _resolved_for_containment(path: Path | str) -> Path:
  118:     resolved = Path(path).resolve(strict=False)
  119:     if os.name == "nt":
  120:         return Path(_strip_windows_extended_prefix(str(resolved)))
  121:     return resolved
  122: 
  123: 
  124: def contained_path(root: Path | str, *parts: str) -> Path:
  125:     root_path = _resolved_for_containment(root)
  126:     candidate = _resolved_for_containment(root_path.joinpath(*parts))
  127:     try:
  128:         candidate.relative_to(root_path)
  129:     except ValueError as exc:
  130:         raise PathContainmentError(f"path escapes runtime root: {candidate}") from exc
  131:     return candidate
  132: 
  133: 
  134: def atomic_write_json(path: Path, data: Mapping[str, Any], root: Path) -> None:
  135:     """Atomically replace an index/checkpoint file confined to *root*."""
  136: 
  137:     target = contained_path(root, str(path.relative_to(root)))
  138:     target.parent.mkdir(parents=True, exist_ok=True)
  139:     temporary: Path | None = None
  140:     try:
  141:         with tempfile.NamedTemporaryFile("wb", dir=target.parent, prefix=f".{target.name}.", delete=False) as handle:
  142:             temporary = Path(handle.name)
  143:             handle.write(canonical_json(data) + b"\n")
  144:             handle.flush()
  145:             os.fsync(handle.fileno())
  146:         os.replace(temporary, target)
  147:         _fsync_directory(target.parent)
  148:     finally:
  149:         if temporary is not None and temporary.exists():
  150:             temporary.unlink(missing_ok=True)
  151: 
  152: 
  153: class _ExclusiveFileLock:
  154:     """Cross-process lock; stale locks require explicit, auditable recovery."""
  155: 
  156:     def __init__(self, path: Path, timeout_seconds: float = 20.0) -> None:
  157:         self.path = path
  158:         self.timeout_seconds = timeout_seconds
  159:         self._fd: int | None = None
  160: 
  161:     def __enter__(self) -> "_ExclusiveFileLock":
  162:         self.path.parent.mkdir(parents=True, exist_ok=True)
  163:         deadline = time.monotonic() + self.timeout_seconds
  164:         while True:
  165:             try:
  166:                 self._fd = os.open(str(self.path), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
  167:                 os.write(self._fd, json.dumps({"pid": os.getpid(), "host": socket.gethostname(), "created_at": time.time()}).encode("utf-8"))
  168:                 return self
  169:             except FileExistsError:
  170:                 if time.monotonic() >= deadline:
  171:                     raise RawIngressError(f"timed out waiting for raw ingress lock: {self.path.name}")
  172:                 time.sleep(0.05)
  173: 
  174:     def __exit__(self, *_: object) -> None:
  175:         if self._fd is not None:
  176:             os.close(self._fd)
  177:         self.path.unlink(missing_ok=True)
  178: 
  179: 
  180: def recover_stale_lock(path: Path, *, stale_seconds: float, force: bool = False) -> bool:
  181:     """Explicitly reap a dead local lock; callers must audit forced recovery.
  182: 
  183:     No live lock is removed automatically.  This function reaps only a lock
  184:     older than the declared lease whose recorded PID is no longer alive on the
  185:     same host, unless an operator passes ``force=True``.
  186:     """
  187: 
  188:     if not path.is_file():
  189:         return False
  190:     try:
  191:         owner = json.loads(path.read_text(encoding="utf-8"))
  192:         age = time.time() - float(owner["created_at"])
  193:         same_host = owner.get("host") == socket.gethostname()
  194:         pid = int(owner["pid"])
  195:     except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
  196:         if not force:
  197:             raise RawIngressError(f"lock metadata is unreadable; explicit force required: {path.name}")
  198:         path.unlink(missing_ok=True)
  199:         return True
  200:     if age < stale_seconds:
  201:         return False
  202:     alive = same_host and _pid_alive(pid)
  203:     if alive and not force:
  204:         return False
  205:     path.unlink(missing_ok=True)
  206:     return True
  207: 
