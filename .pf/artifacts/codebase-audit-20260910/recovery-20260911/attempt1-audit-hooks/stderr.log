===== schemas/hook-delivery.schema.json =====
    1: {
    2:   "$schema": "https://json-schema.org/draft/2020-12/schema",
    3:   "$id": "https://processforge.local/schemas/hook-delivery.schema.json",
    4:   "title": "Hook Delivery",
    5:   "type": "object",
    6:   "required": ["schema_version", "delivery_id", "delivery_time", "target_id", "mode", "event"],
    7:   "properties": {
    8:     "schema_version": { "type": "integer", "minimum": 1 },
    9:     "delivery_id": { "type": "string", "pattern": "^del_[a-z0-9]+$" },
