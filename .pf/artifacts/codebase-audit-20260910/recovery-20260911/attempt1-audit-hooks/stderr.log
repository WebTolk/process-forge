 6047: def command_init_project(args: argparse.Namespace) -> int:
 6048:     request = {
 6049:         "project_root": args.project_root,
 6050:         "workplace": args.workplace,
 6051:         "answers_path": args.answers,
 6052:         "project_type": getattr(args, "project_type", None),
 6053:         "coordination_mode": getattr(args, "coordination_mode", None),
 6054:         "platforms": list(getattr(args, "platform", []) or []),
 6055:         "specializations": list(getattr(args, "specialization", []) or []),
 6056:         "process": getattr(args, "process", None),
 6057:         "force": bool(args.force),
 6058:         "allow_missing_workplace": bool(args.allow_missing_workplace),
 6059:         "apply": args.apply is True,
 6060:         "command": getattr(args, "command", "project-onboard"),
 6061:     }
 6062:     try:
 6063:         result = project_initialization.initialize_project(request, sys.modules[__name__])
 6064:     except project_initialization.ProjectInitializationError as exc:
 6065:         raise _project_initialization_error(exc) from exc
 6066:     if result.get("applied") is not True:
 6067:         print(dump_yaml(result), end="")
 6068:         return 0
 6069:     payload = result.get("result") if isinstance(result.get("result"), dict) else {}
 6070:     print(dump_yaml(payload), end="")
 6071:     return 0 if payload.get("doctor", {}).get("status") == "pass" else 1
 6072: 
