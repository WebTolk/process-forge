 1111: def active_execution_records(project_root: Path, core: Any) -> list[dict[str, Any]]:
 1112:     """Return current execution facts directly from durable assignments and run state."""
 1113:     flow_root = core.locate_flow_root(project_root)
 1114:     records: list[dict[str, Any]] = []
 1115:     process_cache: dict[str, dict[str, Any] | None] = {}
 1116:     for assignment_path in sorted((flow_root / "assignments").glob("*.yaml")):
 1117:         task = core.load_yaml_document(assignment_path)
 1118:         if not isinstance(task, dict) or not task.get("id"):
 1119:             continue
 1120:         task_status = str(task.get("status") or "")
 1121:         if task_status in {"done", "completed", "cancelled", "failed"}:
 1122:             continue
 1123:         process_id = core.task_process_id(task)
 1124:         if process_id not in process_cache:
 1125:             process_cache[process_id] = resolved_process(project_root, process_id, core) if process_id else None
 1126:         process = process_cache[process_id]
 1127:         run_id = str(task.get("run_id") or "")
 1128:         run_state = core.load_agent_run_state(project_root, run_id, str(task["id"])) if run_id else {}
 1129:         stage_id = execution_stage(task, run_state, process) if process else ""
 1130:         worker_status = str(run_state.get("status") or "")
 1131:         priority = 0 if worker_status == "running" else (1 if task_status in {"in_progress", "debugging", "review", "blocked"} else 2)
 1132:         records.append(
 1133:             {
 1134:                 "process_id": process_id,
 1135:                 "stage_id": stage_id,
 1136:                 "run_id": run_id,
 1137:                 "task_id": str(task["id"]),
 1138:                 "assignment": core.rel(assignment_path, project_root),
 1139:                 "task_status": task_status,
 1140:                 "worker_status": worker_status,
 1141:                 "priority": priority,
 1142:                 "stage": next((item for item in process.get("stages", []) if isinstance(item, dict) and str(item.get("id") or "") == stage_id), {}) if process and stage_id else {},
 1143:             }
 1144:         )
 1145:     return sorted(records, key=lambda item: (item["priority"], item["run_id"], item["task_id"]))
 1146: 
