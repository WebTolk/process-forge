  134: def atomic_write_json(path: Path, data: Mapping[str, Any], root: Path) -> None:
  135:     """Atomically replace an index/checkpoint file confined to *root*."""
  136: 
  137:     target = contained_path(root, str(path.relative_to(root)))
  138:     target.parent.mkdir(parents=True, exist_ok=True)
  139:     temporary: Path | None = None
  140:     try:
  141:         with tempfile.NamedTemporaryFile("wb", dir=target.parent, prefix=f".{target.name}.", delete=False) as handle:
  142:             temporary = Path(handle.name)
  143:             handle.write(canonical_json(data) + b"\n")
  144:             handle.flush()
  145:             os.fsync(handle.fileno())
  146:         os.replace(temporary, target)
  147:         _fsync_directory(target.parent)
  148:     finally:
  149:         if temporary is not None and temporary.exists():
  150:             temporary.unlink(missing_ok=True)
