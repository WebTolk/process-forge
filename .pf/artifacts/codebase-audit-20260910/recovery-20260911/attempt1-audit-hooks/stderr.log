  441: def normalize_event(raw: dict[str, Any], project_root: Path, core: Any) -> dict[str, Any]:
  442:     event_type = str(raw.get("event_type") or raw.get("type") or "")
  443:     if not event_type:
  444:         raise SystemExit("FAIL: runtime event input missing event_type")
  445:     source = raw.get("source") if isinstance(raw.get("source"), dict) else {}
  446:     adapter = str(source.get("adapter") or raw.get("adapter") or "generic")
  447:     agent_id = str(source.get("agent") or raw.get("agent_id") or raw.get("agent") or "agent")
  448:     session_id = str(source.get("session_id") or raw.get("session_id") or "")
  449:     run_id = str(raw.get("run_id") or "")
  450:     task_id = str(raw.get("task_id") or "")
  451:     subject = str(raw.get("subject") or task_id or run_id or session_id or event_type)
  452:     data = raw.get("payload") if isinstance(raw.get("payload"), dict) else raw.get("data")
  453:     if not isinstance(data, dict):
  454:         data = {}
  455:     if run_id and "run_id" not in data:
  456:         data["run_id"] = run_id
  457:     if task_id and "task_id" not in data:
  458:         data["task_id"] = task_id
  459:     event = core.processforge_event(
  460:         project_root,
  461:         event_type,
  462:         session_id=session_id or None,
  463:         assignment_id_value=task_id or None,
  464:         subject=subject,
  465:         data=data,
  466:         correlation_id=str(raw.get("correlation_id") or session_id or run_id or ""),
  467:         event_id=stable_event_id(raw),
  468:         actor={"type": "agent", "id": core.safe_id(agent_id, "agent"), "role": str(raw.get("role") or "")},
  469:     )
  470:     event["source"] = f"processforge.runtime.{core.safe_id(adapter, 'adapter')}"
  471:     return event
  472: 
  473: 
  474: def ledger_from_event(raw: dict[str, Any], project_root: Path, workplace_root: Path, handle: dict[str, Any], core: Any) -> None:
  475:     event_type = str(raw.get("event_type") or raw.get("type") or "")
  476:     source = raw.get("source") if isinstance(raw.get("source"), dict) else {}
  477:     agent_id = str(source.get("agent") or raw.get("agent_id") or raw.get("agent") or "agent")
  478:     session_id = str(source.get("session_id") or raw.get("session_id") or "")
  479:     role = raw.get("role") or source.get("role") or []
  480:     roles = [role] if isinstance(role, str) and role else [str(item) for item in role] if isinstance(role, list) else []
  481:     common = {
  482:         "workplace": str(workplace_root),
  483:         "project_root": str(project_root),
  484:         "agent": agent_id,
  485:         "session": session_id,
  486:         "process": str(raw.get("process_id") or ""),
  487:         "run": str(raw.get("run_id") or ""),
  488:         "task": str(raw.get("task_id") or ""),
  489:     }
  490:     if event_type in {"agent.session.started", "agent.session.resumed"}:
  491:         call_quiet(core.command_agent_checkin, argparse.Namespace(**common, project_id=handle["project_id"], role=roles, capability=[], supports_specialization=[], ttl=int(raw.get("ttl") or 300), json=False))
  492:     elif event_type in {"agent.heartbeat", "agent.command.completed", "agent.tool.completed"} and session_id:
  493:         presence = core.find_agent_presence(workplace_root, agent_id=agent_id, session_id=session_id)
  494:         if presence:
  495:             call_quiet(core.command_agent_heartbeat, argparse.Namespace(**common))
  496:     elif event_type in {"agent.session.ended", "agent.session.stopped"} and session_id:
  497:         presence = core.find_agent_presence(workplace_root, agent_id=agent_id, session_id=session_id)
  498:         if presence:
  499:             call_quiet(core.command_agent_checkout, argparse.Namespace(**common))
  500: 
  501: 
  502: def rebuild_projection(project_root: Path, core: Any) -> Path:
  503:     with state_lock():
  504:         events_path, _outbox = core.event_runtime_paths(project_root)
  505:         rows: list[dict[str, Any]] = []
  506:         if events_path.is_file():
  507:             for line in events_path.read_text(encoding="utf-8", errors="replace").splitlines():
  508:                 if not line.strip():
  509:                     continue
  510:                 try:
  511:                     item = json.loads(line)
  512:                 except json.JSONDecodeError:
  513:                     continue
  514:                 if isinstance(item, dict) and str(item.get("event_type") or "").startswith("agent."):
  515:                     rows.append(item)
  516:         out = projection_path(project_root, core)
  517:         lines = [
  518:             "# Runtime Command History",
  519:             "",
  520:             f"- source: `{core.rel(events_path, project_root)}`",
  521:             f"- generated_at: `{core.now_utc()}`",
  522:             "",
  523:             "| time | event | actor | session | subject | status |",
  524:             "| --- | --- | --- | --- | --- | --- |",
  525:         ]
  526:         for item in rows:
  527:             data = item.get("data") if isinstance(item.get("data"), dict) else {}
  528:             actor = item.get("actor") if isinstance(item.get("actor"), dict) else {}
  529:             session = item.get("session") if isinstance(item.get("session"), dict) else {}
  530:             status = data.get("status") or data.get("exit_code") or ""
  531:             lines.append(
  532:                 "| {time} | `{event}` | `{actor}` | `{session}` | `{subject}` | `{status}` |".format(
  533:                     time=str(item.get("time") or ""),
  534:                     event=str(item.get("event_type") or ""),
  535:                     actor=str(actor.get("id") or ""),
  536:                     session=str(session.get("id") or ""),
  537:                     subject=str(item.get("subject") or ""),
  538:                     status=str(status),
  539:                 )
  540:             )
  541:         out.parent.mkdir(parents=True, exist_ok=True)
  542:         tmp = out.with_name(f".{out.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
  543:         tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
  544:         os.replace(tmp, out)
  545:         return out
  546: 
  547: 
  548: def command_init(args: argparse.Namespace, core: Any) -> int:
  549:     project_roots = [resolve_project(value, core) for value in getattr(args, "project_root", [])]
  550:     workplace_root = resolve_workplace(args, project_roots[0] if project_roots else None, core)
  551:     with state_lock():
  552:         state = load_state(workplace_root)
  553:         for project_root in project_roots:
  554:             remember_project(state, route_project(str(project_root), workplace_root, core))
  555:         save_state(workplace_root, state, core)
  556:     print(f"RUNTIME_HOST: initialized projects={len(state.get('projects', []))}")
  557:     return 0
  558: 
  559: 
  560: def command_event(args: argparse.Namespace, core: Any) -> int:
  561:     raw = load_input(args)
  562:     workplace_root = resolve_workplace(args, None, core) if getattr(args, "workplace", None) else None
  563:     payload = ingest_event(raw, workplace_root, core, project_ref=getattr(args, "project_root", None))
  564:     if getattr(args, "json", False):
  565:         print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
  566:     else:
  567:         print(f"EVENT: {payload['event_id']} duplicate={str(payload['duplicate']).lower()} project={payload['project_id']}")
  568:     return 0
  569: 
  570: 
  571: def _ingest_derived_event(raw: dict[str, Any], workplace_root: Path | None, core: Any, *, project_ref: str | None = None) -> dict[str, Any]:
  572:     project_ref = project_ref or raw.get("project_root") or raw.get("cwd")
  573:     if not project_ref:
  574:         raise SystemExit("FAIL: runtime event requires --project-root or project_root/cwd in input")
  575:     project_root = resolve_project(str(project_ref), core)
  576:     workplace_root = workplace_root or core.resolve_workplace_root(None, project_root=project_root)
  577:     with state_lock():
  578:         handle = route_project(str(project_root), workplace_root, core)
  579:         state = load_state(workplace_root)
  580:         source = raw.get("source") if isinstance(raw.get("source"), dict) else {}
  581:         session_id = str(source.get("session_id") or raw.get("session_id") or "")
  582:         event_type = str(raw.get("event_type") or raw.get("type") or "")
  583:         if session_id:
  584:             presence = ledger_session(session_id, workplace_root, core)
  585:             if presence:
  586:                 if str(presence.get("project_id") or "") != handle["project_id"]:
  587:                     raise PermissionError("session is not authorized for requested project_root")
  588:             elif event_type not in {"agent.session.started", "agent.session.resumed"}:
  589:                 raise PermissionError(f"runtime session is not routed: {session_id}")
  590:         remember_project(state, handle)
  591:         event = normalize_event(raw, project_root, core)
  592:         duplicate = event_exists(project_root, core.event_id_value(event), core)
  593:         if not duplicate:
  594:             ledger_from_event(raw, project_root, workplace_root, handle, core)
  595:             core.append_process_event(project_root, event)
  596:         remember_session(state, session_id, handle, str(source.get("agent") or raw.get("agent_id") or raw.get("agent") or ""), core)
  597:         save_state(workplace_root, state, core)
  598:         projection = rebuild_projection(project_root, core)
  599:         stage_projection = rebuild_stage_obligations(project_root, core)
  600:         payload = {"event_id": core.event_id_value(event), "duplicate": duplicate, "project_id": handle["project_id"], "events": core.rel(core.event_runtime_paths(project_root)[0], project_root), "projection": core.rel(projection, project_root), "stage_projection": core.rel(stage_projection, project_root)}
  601:         return payload
  602: 
  603: 
  604: def _is_native_envelope(raw: dict[str, Any]) -> bool:
  605:     return bool(
  606:         raw.get("provider")
  607:         and raw.get("adapter")
  608:         and raw.get("native_event_type")
  609:         and isinstance(raw.get("raw_payload"), dict)
  610:     )
