20802: def task_verification_fingerprint(project_root: Path, task: dict[str, Any]) -> str:
20803:     """Fingerprint the task declaration and its declared verification inputs."""
20804:     inputs: list[dict[str, Any]] = []
20805:     for output in normalize_required_outputs(task.get("required_outputs")):
20806:         if not bool(output.get("required", True)):
20807:             continue
20808:         path = task_output_path(project_root, output)
20809:         item = {"id": str(output.get("id") or "output"), "path": rel(path, project_root) if path else "", "status": "missing"}
20810:         if path and path.is_file():
20811:             item.update({"status": "present", "sha256": "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()})
20812:         inputs.append(item)
20813:     expected = task.get("expected_report") if isinstance(task.get("expected_report"), dict) else {}
20814:     expected_path = str(expected.get("artifact") or "")
20815:     if expected_path:
20816:         path = project_root / normalize_assignment_path(expected_path)
20817:         item = {"id": "expected-report", "path": normalize_assignment_path(expected_path), "status": "missing"}
20818:         if path.is_file():
20819:             item.update({"status": "present", "sha256": "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()})
20820:         inputs.append(item)
20821:     payload = {"assignment": task, "inputs": inputs}
20822:     return "sha256:" + hashlib.sha256(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()
20823: 
