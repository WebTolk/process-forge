 3191: def command_workplace_mode_set(args: argparse.Namespace) -> int:
 3192:     workplace_root = normalize_workplace_path(Path(args.workplace))
 3193:     if args.director_enabled is None and args.director_office_enabled is None:
 3194:         raise SystemExit("FAIL: workplace-mode set requires --director-enabled and/or --director-office-enabled")
 3195:     if args.director_enabled is not None and not parse_cli_bool(args.director_enabled, name="--director-enabled") and not args.force:
 3196:         active = active_organized_project_sessions(workplace_root)
 3197:         if active:
 3198:             raise SystemExit("FAIL: cannot disable workplace Director while organized project sessions are active; use --force after migration")
 3199: 
 3200:     def updater(cfg: dict[str, Any]) -> None:
 3201:         if args.director_enabled is not None:
 3202:             cfg["director_enabled"] = parse_cli_bool(args.director_enabled, name="--director-enabled")
 3203:         if args.director_office_enabled is not None:
 3204:             cfg["director_office_enabled"] = parse_cli_bool(args.director_office_enabled, name="--director-office-enabled")
 3205: 
 3206:     cfg = update_workplace_coordination(workplace_root, updater)
 3207:     if cfg.get("director_office_enabled"):
 3208:         initialize_director_office(workplace_root, cfg)
 3209:     print(f"UPDATED: {rel(workplace_root / 'workplace.yaml', workplace_root)}")
 3210:     return command_workplace_mode_status(argparse.Namespace(workplace=str(workplace_root), json=args.json))
