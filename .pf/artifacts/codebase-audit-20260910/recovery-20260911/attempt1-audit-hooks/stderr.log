 1224: def resolve_payload(workplace_root: Path, core: Any, *, session: str | None = None, project_root_ref: str | None = None, resource_id: str | None = None) -> dict[str, Any]:
 1225:     from processforge_core.garage import ResourceResolveService
 1226: 
 1227:     project_root = project_for_session(argparse.Namespace(session=session, project_root=project_root_ref), workplace_root, core)
 1228:     handle = route_project(str(project_root), workplace_root, core)
 1229:     resolved_payload = ResourceResolveService(project_root, workplace_root, core).resolve(resource_id=resource_id)
 1230:     payload: dict[str, Any] = {"workplace_root": str(workplace_root), "project": handle, "session": session or ""}
 1231:     if not resource_id:
 1232:         return payload
 1233:     return {**payload, "resource": resolved_payload.get("resource", {})}
