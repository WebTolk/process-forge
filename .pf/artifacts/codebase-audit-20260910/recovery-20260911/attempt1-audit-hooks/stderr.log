21108: def command_doctor_context(args: argparse.Namespace) -> int:
21109:     project_root = Path(args.project_root).expanduser().resolve()
21110:     flow_root = require_flow_root(project_root)
21111:     checks: list[Check] = []
21112:     manifest = flow_root / "process-forge.yaml"
21113:     checks.append(check("PASS" if manifest.is_file() else "FAIL", f"{rel(manifest, project_root)} found"))
21114:     if manifest.is_file():
21115:         manifest_text = manifest.read_text(encoding="utf-8", errors="replace")
21116:         checks.append(check("PASS" if is_public_path_safe(manifest_text) else "FAIL", "public manifest has no local absolute paths"))
21117:         checks.append(check("PASS" if not contains_secret_value(manifest_text) else "FAIL", "public manifest contains no secret values"))
21118: 
21119:     snapshot_yaml, snapshot_md = project_context_snapshot_paths(project_root)
21120:     context_index = flow_root / "contexts" / "context-index.yaml"
21121:     resolved_rules = flow_root / "contexts" / "resolved-rules.yaml"
21122:     conflict_report = flow_root / "contexts" / "context-conflict-report.md"
21123:     cache = flow_root / "runtime" / "cache" / "context-cache.yaml"
21124:     checks.append(check("PASS" if snapshot_yaml.is_file() else "WARN", "project context snapshot YAML found"))
21125:     checks.append(check("PASS" if snapshot_md.is_file() else "WARN", "project context snapshot MD found"))
21126:     snapshot_freshness, snapshot_stale, snapshot = project_context_freshness(project_root)
21127:     if snapshot_yaml.is_file():
21128:         checks.append(check("PASS" if snapshot_freshness == "fresh" else "FAIL", f"project context snapshot freshness is {snapshot_freshness}" + (f": {', '.join(snapshot_stale)}" if snapshot_stale else "")))
21129:         health = snapshot.get("snapshot", {}).get("health", {}).get("status", "pass") if isinstance(snapshot.get("snapshot"), dict) else "pass"
21130:         checks.append(check("PASS" if health != "blocked" else "FAIL", f"project context snapshot health is {health}"))
21131:     checks.append(check("PASS" if context_index.is_file() else ("WARN" if snapshot_yaml.is_file() else "FAIL"), "context index found"))
21132:     checks.append(check("PASS" if resolved_rules.is_file() else ("WARN" if snapshot_yaml.is_file() else "FAIL"), "resolved rules found"))
21133:     checks.append(check("PASS" if conflict_report.is_file() else ("WARN" if snapshot_yaml.is_file() else "FAIL"), "conflict report found"))
21134:     status = context_report_status(conflict_report)
21135:     if conflict_report.is_file():
21136:         checks.append(check("PASS" if status in {"resolved", "warn", "requires_approval"} else "FAIL", f"conflict status is {status}"))
21137:     freshness, stale = context_freshness(project_root)
21138:     if context_index.is_file():
21139:         checks.append(check("PASS" if freshness == "fresh" else "FAIL", f"context freshness is {freshness}" + (f": {', '.join(stale)}" if stale else "")))
21140:     checks.append(check("PASS" if cache.is_file() else "WARN", "context cache found"))
21141: 
21142:     gitignore = project_root / ".gitignore"
21143:     if gitignore.is_file():
21144:         ignore_text = gitignore.read_text(encoding="utf-8", errors="replace")
21145:         runtime_cache_ignored = "runtime/cache/" in ignore_text or "/runtime/cache/" in ignore_text or "runtime/" in ignore_text or ".pf/runtime/" in ignore_text
21146:         checks.append(check("PASS" if runtime_cache_ignored else "FAIL", ".gitignore contains runtime cache ignore"))
21147:     else:
21148:         checks.append(check("WARN", ".gitignore missing"))
21149: 
21150:     if args.assignment:
21151:         assignment = Path(args.assignment).expanduser().resolve()
21152:         _index, _resolved, report, assignment_status = build_context_payload(project_root, assignment)
21153:         context_status = normalized_context_status(assignment_status)
21154:         assignment_conflict_report = flow_root / "contexts" / f"{assignment_id(assignment)}.conflicts.md"
21155:         if assignment_status == "blocked":
21156:             checks.append(check("FAIL", "assignment context status is blocked"))
21157:         elif assignment_status == "requires_approval":
21158:             checks.append(check("FAIL", "assignment context requires approval"))
21159:         elif assignment_status == "warn":
21160:             checks.append(check("WARN", "assignment context is usable with warnings"))
21161:         else:
21162:             checks.append(check("PASS", "assignment context status is pass"))
21163:         checks.append(check("PASS" if assignment_conflict_report.is_file() else "FAIL", "assignment-specific conflict report found"))
21164:         if assignment_conflict_report.is_file():
21165:             checks.append(check("PASS" if context_report_status(assignment_conflict_report) == assignment_status else "FAIL", "assignment conflict report status matches resolver"))
21166:         ecp_candidates = sorted((flow_root / "contexts").glob(f"{assignment_id(assignment)}*.ecp.yaml"), key=lambda path: path.stat().st_mtime, reverse=True)
21167:         ecp = ecp_candidates[0] if ecp_candidates else flow_root / "contexts" / f"{assignment_id(assignment)}.ecp.yaml"
21168:         if ecp.is_file():
21169:             ecp_text = ecp.read_text(encoding="utf-8", errors="replace")
21170:             checksum = sha256_file(assignment) if assignment.is_file() else "missing"
21171:             checks.append(check("PASS" if checksum in ecp_text else "FAIL", f"assignment ECP is fresh ({rel(ecp, project_root)})"))
21172:             ecp_data = load_answers(ecp)
21173:             ecp_status = ecp_data.get("context_status") if isinstance(ecp_data, dict) else None
21174:             checks.append(check("PASS" if ecp_status == context_status else "FAIL", f"assignment ECP context_status is {ecp_status}"))
21175:             report_ref = ecp_data.get("conflict_report") if isinstance(ecp_data, dict) else None
21176:             checks.append(check("PASS" if report_ref == rel(assignment_conflict_report, project_root) else "FAIL", "assignment ECP references assignment conflict report"))
21177:             ecp_checksums = ecp_data.get("checksums", {}) if isinstance(ecp_data, dict) else {}
21178:             expected_context_index_checksum = sha256_file(context_index) if context_index.is_file() else "missing"
21179:             checks.append(
21180:                 check(
21181:                     "PASS" if ecp_checksums.get("context_index") == expected_context_index_checksum else "FAIL",
21182:                     "assignment ECP context index checksum is fresh",
21183:                 )
21184:             )
21185:         else:
21186:             checks.append(check("FAIL" if assignment_status != "blocked" else "PASS", "assignment ECP missing"))
21187: 
21188:     result = print_checks(checks)
21189:     emit_process_event(
21190:         project_root,
21191:         "gate.failed" if result else "gate.passed",
21192:         severity="error" if result else "info",
21193:         payload={"command": "doctor-context", "result": "fail" if result else "pass"},
21194:     )
21195:     return result
21196: 
