23636: def search_index_maintenance_for_known_projects(
23637:     workplace_root: Path,
23638:     *,
23639:     reason: str,
23640:     project_roots: list[Path] | None = None,
23641:     verify_files: bool = True,
23642: ) -> dict[str, Any]:
23643:     """Maintain the one Workplace index without consulting project Runtime state.
23644: 
23645:     The retained name is a compatibility shim for existing resource-management
23646:     call sites.  ``project_roots`` is intentionally ignored: selection is a
23647:     query-time project-snapshot concern, never an index-maintenance concern.
23648:     """
23649:     from processforge_core.local_resource_search import ResourceSearchIndex
23650: 
23651:     del project_roots
23652:     payload: dict[str, Any] = {
23653:         "schema_version": 1,
23654:         "kind": "pf.search_index.maintenance",
23655:         "created_at": now_utc(),
23656:         "reason": reason,
23657:         "scope": "workplace",
23658:         "project_count": 0,
23659:         "results": [],
23660:     }
23661:     results = payload["results"]
23662:     assert isinstance(results, list)
23663:     row: dict[str, Any] = {"scope": "workplace", "status": "pending"}
23664:     try:
23665:         snapshot = workplace_search_runtime_snapshot(workplace_root)
23666:         tick = ResourceSearchIndex(workplace_root, snapshot, workplace_root).maintenance_tick(verify_files=verify_files)
23667:         after = tick.get("after") if isinstance(tick.get("after"), dict) else {}
23668:         row.update(
23669:             {
23670:                 "status": "ok" if after.get("status") == "fresh" else "degraded",
23671:                 "action": tick.get("action"),
23672:                 "search_status": after.get("status"),
23673:                 "generation": after.get("generation"),
23674:                 "document_count": after.get("document_count"),
23675:                 "stale_resource_count": after.get("stale_resource_count"),
23676:                 "failed_file_count": after.get("failed_file_count"),
23677:             }
23678:         )
23679:         if after.get("error"):
23680:             row["error"] = after.get("error")
23681:     except Exception as exc:  # pragma: no cover - defensive CLI boundary.
23682:         row.update({"status": "error", "error": f"{type(exc).__name__}: {exc}"})
23683:     results.append(row)
23684:     report_path = write_search_index_maintenance_runtime_report(workplace_root, payload)
23685:     payload["report"] = rel(report_path, workplace_root)
23686:     try:
23687:         append_workplace_event(
23688:             workplace_root,
23689:             "search.index.maintenance.completed",
23690:             payload={
23691:                 "reason": reason,
23692:                 "project_count": payload["project_count"],
23693:                 "report": payload["report"],
23694:                 "statuses": [row.get("status") for row in results if isinstance(row, dict)],
23695:             },
23696:         )
23697:     except Exception:
23698:         pass
23699:     return payload
23700: 
23701: 
23702: def print_search_index_maintenance_summary(payload: dict[str, Any]) -> None:
23703:     print(f"SEARCH_INDEX_SCOPE: {payload.get('scope') or 'workplace'}")
23704:     if payload.get("report"):
23705:         print(f"SEARCH_INDEX_REPORT: {payload.get('report')}")
23706:     results = payload.get("results") if isinstance(payload.get("results"), list) else []
23707:     for row in results:
23708:         if not isinstance(row, dict):
23709:             continue
23710:         project = row.get("project") or row.get("scope")
23711:         if row.get("status") in {"ok", "degraded"}:
23712:             print(
23713:                 "SEARCH_INDEX: "
23714:                 f"{project} action={row.get('action')} status={row.get('search_status')} "
23715:                 f"generation={row.get('generation') or 'none'} documents={row.get('document_count')}"
23716:             )
23717:         elif row.get("status") == "skipped":
23718:             print(
23719:                 "SEARCH_INDEX_SKIPPED: "
23720:                 f"{project} reason={row.get('reason')} context={row.get('context_status') or 'unknown'} "
23721:                 f"next={row.get('recommended_action') or 'none'}"
23722:             )
23723:         elif row.get("status") == "error":
23724:             print(f"SEARCH_INDEX_ERROR: {project} error={row.get('error')}")
23725: 
