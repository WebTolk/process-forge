 4626: def specialization_manifest_index(workplace_manifest: Path | None, project_root: Path | None = None) -> dict[str, dict[str, Any]]:
 4627:     workplace_root = workplace_manifest.parent if workplace_manifest and workplace_manifest.is_file() else None
 4628:     index: dict[str, dict[str, Any]] = {}
 4629:     paths: list[Path] = []
 4630:     if workplace_root:
 4631:         registry = load_yaml_document(specialization_registry_path(workplace_root))
 4632:         entries = registry.get("specializations") if isinstance(registry, dict) else []
 4633:         if isinstance(entries, list):
 4634:             for entry in entries:
 4635:                 if isinstance(entry, dict):
 4636:                     path = specialization_path_from_registry_entry(workplace_root, entry, workplace_manifest)
 4637:                     if path:
 4638:                         paths.append(path)
 4639:         for root in [workplace_root / "specializations", workplace_root / "specializations" / "user", workplace_root / "specializations" / "custom"]:
 4640:             if root.is_dir():
 4641:                 paths.extend(sorted(root.glob("*.yaml")))
 4642:                 paths.extend(sorted(root.glob("*.yml")))
 4643:     if project_root:
 4644:         flow_root = locate_flow_root(project_root)
 4645:         for root in [flow_root / "specializations", flow_root / "specializations" / "user", flow_root / "specializations" / "custom"]:
 4646:             if root.is_dir():
 4647:                 paths.extend(sorted(root.glob("*.yaml")))
 4648:                 paths.extend(sorted(root.glob("*.yml")))
 4649:     for path in paths:
 4650:         data = load_yaml_document(path)
 4651:         if not isinstance(data, dict) or yaml_error(data) or not data.get("id"):
 4652:             continue
 4653:         normalized_id = specialization_resource_id(str(data["id"]))
 4654:         source = "project" if project_root and path_is_relative_to(path, locate_flow_root(project_root)) else "workplace"
 4655:         record = dict(data)
 4656:         record["id"] = normalized_id
 4657:         record["__manifest_path"] = path
 4658:         record["__source"] = source
 4659:         index[normalized_id] = record
 4660:     return index
