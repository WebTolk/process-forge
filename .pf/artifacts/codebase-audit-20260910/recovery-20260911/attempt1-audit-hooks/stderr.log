   30: @dataclass(frozen=True)
   31: class NativeAgentEvent:
   32:     """The provider-neutral event passed from a thin adapter to ingress."""
   33: 
   34:     provider: str
   35:     adapter: str
   36:     native_event_type: str
   37:     raw_payload: Mapping[str, Any]
   38:     payload_version: str = "1"
   39:     native_event_id: str | None = None
   40:     native_id_scope: str = "provider"
   41:     native_event_id_stable: bool = True
   42:     source_session_id: str | None = None
   43:     source_project_ref: str | None = None
