 1081: def project_for_session(args: argparse.Namespace, workplace_root: Path, core: Any) -> Path:
 1082:     session_id = getattr(args, "session", None)
 1083:     if getattr(args, "project_root", None):
 1084:         return resolve_project(getattr(args, "project_root"), core)
 1085:     if not session_id:
 1086:         raise SystemExit("FAIL: --session or --project-root is required")
 1087:     presence = ledger_session(str(session_id), workplace_root, core)
 1088:     project_ref = str(presence.get("project_root") or "") if presence else ""
 1089:     if not project_ref:
 1090:         raise SystemExit(f"FAIL: runtime session is not routed by Agent Ledger: {session_id}")
 1091:     project_root = resolve_project(project_ref, core)
 1092:     if str(presence.get("project_id") or "") != core.project_id(project_root):
 1093:         raise SystemExit(f"FAIL: Agent Ledger project binding is invalid: {session_id}")
 1094:     return project_root
