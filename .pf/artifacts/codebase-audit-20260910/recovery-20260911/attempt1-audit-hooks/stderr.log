  586:                 if str(presence.get("project_id") or "") != handle["project_id"]:
  587:                     raise PermissionError("session is not authorized for requested project_root")
  588:             elif event_type not in {"agent.session.started", "agent.session.resumed"}:
  589:                 raise PermissionError(f"runtime session is not routed: {session_id}")
  590:         remember_project(state, handle)
  591:         event = normalize_event(raw, project_root, core)
  592:         duplicate = event_exists(project_root, core.event_id_value(event), core)
