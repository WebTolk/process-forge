  101: def append_operator_log(workplace_root: Path, core: Any, event: str, **payload: Any) -> None:
  102:     path = operator_log_path(workplace_root)
  103:     path.parent.mkdir(parents=True, exist_ok=True)
  104:     record = {"time": core.now_utc(), "event": event}
  105:     record.update(payload)
  106:     with path.open("a", encoding="utf-8") as handle:
  107:         handle.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")
