  576: def command_stop(args: argparse.Namespace, core: Any) -> int:
  577:     workplace_root = core.resolve_workplace_root(getattr(args, "workplace", None))
  578:     inspection = inspect_lifecycle(workplace_root, core)
  579:     state = inspection["state"]
  580:     if inspection["kind"] == "orphaned":
  581:         endpoint = str(state.get("endpoint") or "")
  582:         code, body = http_json("GET", endpoint.rstrip("/") + "/readyz", timeout=1.0) if endpoint else (0, {})
  583:         if code != 200 or not body.get("ready"):
  584:             raise SystemExit(f"FAIL: orphaned PF Runtime has no verified ready endpoint: pid={inspection['pid']}")
  585:         inspection["kind"] = "ready"
  586:     if inspection["kind"] == "starting":
  587:         ready, state = wait_for_ready_service(workplace_root, core, min(2.0, float(getattr(args, "timeout", 10.0) or 10.0)))
  588:         if not ready:
  589:             pid = inspection["pid"]
  590:             if not isinstance(pid, int) or not terminate_owned_process(pid, core, float(getattr(args, "timeout", 10.0) or 10.0)):
  591:                 raise SystemExit(f"FAIL: runtime starting process did not stop: pid={pid}")
  592:             cleanup_stale_runtime(workplace_root, core)
  593:             print("RUNTIME: stopped")
  594:             return 0
  595:     elif inspection["kind"] in {"stopping", "failed"}:
  596:         pid = inspection["pid"]
  597:         if not isinstance(pid, int) or not terminate_owned_process(pid, core, float(getattr(args, "timeout", 10.0) or 10.0)):
  598:             raise SystemExit(f"FAIL: runtime process did not stop: pid={pid}")
  599:         cleanup_stale_runtime(workplace_root, core)
  600:         print("RUNTIME: stopped")
  601:         return 0
  602:     elif inspection["kind"] != "ready":
  603:         cleanup_stale_runtime(workplace_root, core)
  604:         print("RUNTIME: not running")
  605:         return 0
  606:     token = load_token(workplace_root)
  607:     endpoint = str(state.get("endpoint") or "")
  608:     code, body = http_json("POST", endpoint.rstrip("/") + "/shutdown", token=token, payload={}, timeout=2.0)
  609:     if code != 200:
  610:         raise SystemExit(f"FAIL: runtime stop request failed: {code} {body}")
  611:     pid = state.get("pid")
  612:     deadline = time.monotonic() + float(getattr(args, "timeout", 10.0) or 10.0)
  613:     while isinstance(pid, int) and core.process_pid_running(pid) and time.monotonic() < deadline:
  614:         time.sleep(0.1)
  615:     if isinstance(pid, int) and core.process_pid_running(pid):
  616:         raise SystemExit(f"FAIL: runtime did not stop before timeout: pid={pid}")
  617:     cleanup_stale_runtime(workplace_root, core)
  618:     print("RUNTIME: stopped")
  619:     return 0
  620: 
