 4910: def build_capability_resolution(
 4911:     execution_route: dict[str, Any],
 4912:     provided_capabilities: set[str],
 4913:     capability_providers: dict[str, list[dict[str, Any]]],
 4914:     activated: dict[str, set[str]],
 4915: ) -> dict[str, list[dict[str, Any]]]:
 4916:     satisfied: list[dict[str, Any]] = []
 4917:     unsatisfied: list[dict[str, Any]] = []
 4918:     seen: set[tuple[str, str]] = set()
 4919:     for requirement in execution_route.get("capability_requirements", []) if isinstance(execution_route.get("capability_requirements"), list) else []:
 4920:         if not isinstance(requirement, dict):
 4921:             continue
 4922:         capability = str(requirement.get("capability") or "")
 4923:         required_by = str(requirement.get("required_by") or execution_route.get("process") or "")
 4924:         if not capability or (capability, required_by) in seen:
 4925:             continue
 4926:         seen.add((capability, required_by))
 4927:         if capability in provided_capabilities:
 4928:             provider = dict((capability_providers.get(capability) or [{"provider": "active_resource_profile"}])[0])
 4929:             for key in RESOURCE_GROUP_KEYS:
 4930:                 provider[key] = [item for item in as_list(provider.get(key)) if item in activated.get(key, set())]
 4931:             satisfied.append({"capability": capability, "required_by": required_by, "satisfied_by": provider})
 4932:         else:
 4933:             unsatisfied.append(
 4934:                 {
 4935:                     "capability": capability,
 4936:                     "required_by": required_by,
 4937:                     "reason": "selected resource profile does not provide required capability",
 4938:                     "suggested_fix": "select or update a specialization/platform binding that provides this capability",
 4939:                 }
 4940:             )
 4941:     return {"satisfied": satisfied, "unsatisfied": unsatisfied}
 4942: 
