  158: def http_json(method: str, url: str, token: str | None = None, payload: dict[str, Any] | None = None, timeout: float = 5.0) -> tuple[int, dict[str, Any]]:
  159:     data = None if payload is None else json.dumps(payload, ensure_ascii=False).encode("utf-8")
  160:     request = urllib.request.Request(url, data=data, method=method)
  161:     request.add_header("Accept", "application/json")
  162:     if data is not None:
  163:         request.add_header("Content-Type", "application/json")
  164:     if token:
  165:         request.add_header("Authorization", f"Bearer {token}")
  166:     try:
  167:         with urllib.request.urlopen(request, timeout=timeout) as response:
  168:             text = response.read().decode("utf-8")
  169:             return response.status, json.loads(text) if text.strip() else {}
  170:     except urllib.error.HTTPError as exc:
  171:         text = exc.read().decode("utf-8", errors="replace")
  172:         try:
  173:             body = json.loads(text) if text.strip() else {}
  174:         except json.JSONDecodeError:
  175:             body = {"error": text}
  176:         return exc.code, body
  177:     except (urllib.error.URLError, OSError) as exc:
  178:         return 0, {"error": str(exc)}
  179: 
  180: 
  181: def inspect_lifecycle(workplace_root: Path, core: Any) -> dict[str, Any]:
  182:     """Return the sole lifecycle interpretation for lock, state, PID and readiness."""
  183:     state = read_json(service_path(workplace_root))
  184:     lock = read_json(lock_path(workplace_root))
  185:     pid = lock.get("pid")
  186:     instance_id = str(lock.get("instance_id") or "")
  187:     state_instance_id = str(state.get("instance_id") or "")
  188:     matching = bool(instance_id and instance_id == state_instance_id and pid == state.get("pid"))
  189:     pid_running = isinstance(pid, int) and core.process_pid_running(pid)
  190:     status = str(state.get("status") or "")
  191:     endpoint = str(state.get("endpoint") or "")
  192:     ready = False
  193:     if matching and pid_running and endpoint:
  194:         code, body = http_json("GET", endpoint.rstrip("/") + "/readyz", timeout=1.0)
  195:         ready = code == 200 and bool(body.get("ready"))
  196:     if matching and pid_running:
  197:         kind = "ready" if ready else (status if status in {"starting", "stopping", "failed"} else "failed")
  198:     elif state_instance_id and isinstance(state.get("pid"), int) and core.process_pid_running(state["pid"]):
  199:         # The daemon may have lost its lock file while its service record and
  200:         # endpoint remain live.  This is not stale: starting another daemon
  201:         # would create two owners for one workplace.
  202:         kind = "orphaned"
  203:     elif not lock and status == "stopped":
  204:         kind = "stopped"
  205:     elif not lock and not state:
  206:         kind = "not_running"
  207:     else:
  208:         kind = "stale"
  209:     return {"kind": kind, "state": state, "lock": lock, "pid": pid, "instance_id": instance_id, "matching": matching, "pid_running": pid_running}
  210: 
  211: 
  212: def active_service(workplace_root: Path, core: Any) -> tuple[bool, dict[str, Any]]:
  213:     inspection = inspect_lifecycle(workplace_root, core)
  214:     return inspection["kind"] == "ready", inspection["state"]
  215: 
  216: 
  217: def wait_for_ready_service(workplace_root: Path, core: Any, timeout: float) -> tuple[bool, dict[str, Any]]:
  218:     deadline = time.monotonic() + max(0.0, timeout)
  219:     while True:
  220:         inspection = inspect_lifecycle(workplace_root, core)
  221:         if inspection["kind"] == "ready":
  222:             return True, inspection["state"]
  223:         if inspection["kind"] != "starting" or time.monotonic() >= deadline:
  224:             return False, inspection["state"]
  225:         time.sleep(0.05)
  226: 
  227: 
  228: def cleanup_stale_runtime(workplace_root: Path, core: Any) -> None:
  229:     inspection = inspect_lifecycle(workplace_root, core)
  230:     if inspection["kind"] in {"ready", "starting", "stopping", "failed", "orphaned", "stopped", "not_running"}:
  231:         return
  232:     lock_path(workplace_root).unlink(missing_ok=True)
  233:     state = inspection["state"]
  234:     if state:
  235:         state["status"] = "stale"
  236:         state["health"] = "stale"
  237:         state["stale_detected_at"] = core.now_utc()
  238:         write_json_atomic(service_path(workplace_root), state)
  239: 
  240: 
  241: def terminate_owned_process(pid: int, core: Any, timeout: float) -> bool:
  242:     try:
  243:         if os.name == "nt":
  244:             subprocess.run(["taskkill", "/PID", str(pid), "/T", "/F"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
  245:         else:
  246:             os.kill(pid, signal.SIGTERM)
  247:     except OSError:
  248:         pass
  249:     deadline = time.monotonic() + max(0.0, timeout)
  250:     while core.process_pid_running(pid) and time.monotonic() < deadline:
  251:         time.sleep(0.05)
  252:     return not core.process_pid_running(pid)
  253: 
  254: 
  255: def acquire_singleton(workplace_root: Path, core: Any, instance_id: str) -> int:
  256:     runtime_root(workplace_root).mkdir(parents=True, exist_ok=True)
  257:     cleanup_stale_runtime(workplace_root, core)
  258:     path = lock_path(workplace_root)
  259:     try:
  260:         fd = os.open(str(path), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
  261:     except FileExistsError:
  262:         inspection = inspect_lifecycle(workplace_root, core)
  263:         if inspection["kind"] in {"ready", "starting", "stopping", "failed"}:
  264:             raise SystemExit(f"FAIL: PF Runtime already owns workplace: state={inspection['kind']} pid={inspection['pid']}")
  265:         path.unlink(missing_ok=True)
  266:         fd = os.open(str(path), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
  267:     with os.fdopen(fd, "w", encoding="utf-8") as handle:
  268:         handle.write(json.dumps({"instance_id": instance_id, "pid": os.getpid(), "created_at": core.now_utc()}, sort_keys=True) + "\n")
  269:     return os.getpid()
  270: 
  271: 
  272: def release_singleton(workplace_root: Path, instance_id: str) -> None:
  273:     if str(read_json(lock_path(workplace_root)).get("instance_id") or "") == instance_id:
  274:         lock_path(workplace_root).unlink(missing_ok=True)
