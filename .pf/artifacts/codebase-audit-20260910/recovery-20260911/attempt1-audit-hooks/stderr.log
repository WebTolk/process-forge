 1526: def project_codex_integration_status(project_root: Path) -> dict[str, Any]:
 1527:     project_root = Path(project_root).expanduser().resolve()
 1528:     target = project_root / ".codex" / "hooks.json"
 1529:     adapter = _codex_hook_adapter_path().resolve()
 1530:     payload: dict[str, Any] = {
 1531:         "status": "missing",
 1532:         "target": ".codex/hooks.json",
 1533:         "adapter": _repo_relative(adapter, ROOT),
 1534:         "event_types": [],
 1535:         "registered_events": [],
 1536:         "missing_events": [],
 1537:         "global_hooks": {"exists": (Path.home() / ".codex" / "hooks.json").is_file(), "managed": False},
 1538:         "restart_required": True,
 1539:         "scope": "project-local",
 1540:     }
 1541:     if not adapter.is_file():
 1542:         payload.update({"status": "unavailable", "error": "adapter_missing", "restart_required": False})
 1543:         return payload
 1544:     integration = _codex_integration_module()
 1545:     events = sorted(str(item) for item in integration.EVENTS)
 1546:     payload["event_types"] = events
 1547:     try:
 1548:         current = integration.load_config(target)
 1549:     except SystemExit as exc:
 1550:         payload.update({"status": "invalid", "error": str(exc), "missing_events": events})
 1551:         return payload
 1552:     registered = _codex_registered_events(current, adapter, integration)
 1553:     missing = [event for event in events if event not in registered]
 1554:     payload["registered_events"] = registered
 1555:     payload["missing_events"] = missing
 1556:     if not target.is_file():
 1557:         payload["status"] = "missing"
 1558:     elif missing:
 1559:         payload["status"] = "stale"
 1560:     else:
 1561:         payload["status"] = "installed"
 1562:         payload["restart_required"] = False
 1563:     return payload
 1564: 
 1565: 
 1566: def project_codex_integration_install(project_root: Path) -> dict[str, Any]:
 1567:     project_root = Path(project_root).expanduser().resolve()
 1568:     target = project_root / ".codex" / "hooks.json"
 1569:     adapter = _codex_hook_adapter_path().resolve()
 1570:     if not adapter.is_file():
 1571:         raise SystemExit("FAIL: Codex hook adapter path does not exist")
 1572:     integration = _codex_integration_module()
 1573:     current = integration.load_config(target)
 1574:     payload, changed = integration.install_payload(current, adapter)
 1575:     result: dict[str, Any] = {
 1576:         "status": "installed",
 1577:         "target": ".codex/hooks.json",
 1578:         "adapter": _repo_relative(adapter, ROOT),
 1579:         "changed_events": sorted(changed),
 1580:         "restart_required": bool(changed),
 1581:     }
 1582:     if changed:
 1583:         backup = integration.write_atomic(target, payload)
 1584:         result["backup"] = rel(backup, project_root) if str(backup) else None
 1585:     result["after"] = project_codex_integration_status(project_root)
 1586:     return result
 1587: 
 1588: 
 1589: def execute_project_codex_integration_repair(project_root: Path) -> dict[str, Any]:
 1590:     result = project_codex_integration_install(project_root)
 1591:     emit_process_event(
 1592:         project_root,
 1593:         "project.codex_hooks.installed",
 1594:         process_id="project-initialization",
 1595:         process_version="1.0.0",
 1596:         payload={
 1597:             "target": result.get("target"),
 1598:             "changed_events": result.get("changed_events", []),
 1599:             "restart_required": result.get("restart_required"),
 1600:         },
 1601:     )
 1602:     return {
 1603:         "status": "complete",
 1604:         "repair_action": "install_codex_hooks",
 1605:         "codex_integration": result,
 1606:         "next_action": "restart_codex_session" if result.get("restart_required") else "continue",
 1607:     }
