+def test_closing_after_captured_corruption_retains_incomplete_provenance(
+    tmp_path: Path,
+) -> None:
+    damage = b"{broken\n"
+    source = _source(tmp_path, damage + _line(_event("first")))
+    report: JsonObject = {}
+    iterator = JournalScanService().rows(
+        [("events", source)],
+        tmp_path,
+        report,
