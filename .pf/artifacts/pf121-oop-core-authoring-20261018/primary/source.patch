diff --git a/src/processforge_core/common/status.py b/src/processforge_core/common/status.py
new file mode 100644
index 0000000..7d1b4bf
--- /dev/null
+++ b/src/processforge_core/common/status.py
@@ -0,0 +1,14 @@
+from __future__ import annotations
+
+
+def aggregate_status(statuses: list[str]) -> str:
+    normalized = [status for status in statuses if status]
+    if not normalized:
+        return "SKIP"
+    if "FAIL" in normalized:
+        return "FAIL"
+    if "WARN" in normalized:
+        return "WARN"
+    if all(status == "SKIP" for status in normalized):
+        return "SKIP"
+    return "PASS"
