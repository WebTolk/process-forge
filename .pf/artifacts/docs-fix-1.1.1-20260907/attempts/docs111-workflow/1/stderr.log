+    "evidence": [
+      {
+        "kind": "artifact",
+        "id": "task-result",
+        "path": ".pf/artifacts/result.md"
+      },
+      {
+        "kind": "gate",
+        "id": "all-blocking-tasks-completed",
+        "status": "passed",
