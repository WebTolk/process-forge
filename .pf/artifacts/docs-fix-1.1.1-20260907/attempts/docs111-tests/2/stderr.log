+                    raise AssertionError(f"broken local link in {path.relative_to(ROOT)}: {raw_target}")
+    if checked < 100:
+        raise AssertionError(f"insufficient local-link coverage: only {checked} links checked")
+    return checked
+
+
+def assignment_example() -> dict:
