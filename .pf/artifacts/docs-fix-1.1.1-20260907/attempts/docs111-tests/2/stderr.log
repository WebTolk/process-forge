#!/usr/bin/env python3
"""Regression coverage for published docs against the current CLI contract."""

from __future__ import annotations

import importlib.util
import shlex
import sys
from pathlib import Path

import yaml


ROOT = Path(__file__).resolve().parents[1]
DOC_ROOTS = [ROOT / "docs", ROOT / "prompts", ROOT / "templates"]


def load_processforge_module():
    tools_path = str(ROOT / "tools")
    if tools_path not in sys.path:
        sys.path.insert(0, tools_path)
    path = ROOT / "tools" / "processforge.py"
    spec = importlib.util.spec_from_file_location("processforge_docs_contract", path)
    if spec is None or spec.loader is None:
        raise AssertionError(f"cannot load parser module: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def iter_markdown_fences(text: str) -> list[tuple[str, list[str]]]:
    blocks: list[tuple[str, list[str]]] = []
    in_block = False
    language = ""
    lines: list[str] = []
    for raw_line in text.splitlines():
        line = raw_line.rstrip("\n")
        stripped = line.lstrip()
        if stripped.startswith("```"):
            if in_block:
                blocks.append((language, lines))
                in_block = False
                language = ""
                lines = []
            else:
                in_block = True
                language = stripped[3:].strip().lower()
                lines = []
            continue
        if in_block:
            lines.append(line)
    return blocks


def is_pf_cli_line(line: str) -> bool:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return False
    tokens = shlex.split(stripped, posix=False)
    if not tokens:
        return False
    first = tokens[0]
    if first in {"python", "python3", "py"} and len(tokens) > 1:
        return "pf.py" in tokens[1]
    return first.endswith("pf.py") or first == "pf"


def parse_pf_cli_line(parser, line: str, source: str) -> None:
    tokens = shlex.split(line, posix=False)
    if not tokens:
        return
    if tokens[0] in {"python", "python3", "py"} and len(tokens) > 1 and "pf.py" in tokens[1]:
        args = tokens[2:]
    elif tokens[0].endswith("pf.py") or tokens[0] == "pf":
        args = tokens[1:]
    else:
        return
    if not args:
        return
    try:
        parser.parse_args(args)
    except SystemExit as exc:  # pragma: no cover - defensive reporting
        raise AssertionError(f"{source}: CLI example rejected by current parser: {line}") from exc


def read_markdown(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def load_assignment() -> dict:
    assignment = ROOT / ".pf" / "assignments" / "docs111-tests.yaml"
    raw = assignment.read_text(encoding="utf-8")
    if raw.lstrip().startswith("---"):
        parts = raw.split("---", 2)
        if len(parts) < 3:
            raise AssertionError("assignment front matter is malformed")
        data = yaml.safe_load(parts[1])
    else:
        data = yaml.safe_load(raw)
    if not isinstance(data, dict):
        raise AssertionError("assignment data must be a mapping")
    return data


def check_assignment_required_outputs() -> None:
    data = load_assignment()
    required_outputs = data.get("required_outputs")
    if not isinstance(required_outputs, list):
        raise AssertionError("assignment required_outputs must be a list of records")
    if any(not isinstance(item, dict) for item in required_outputs):
        raise AssertionError("assignment required_outputs must contain record objects")
    expected_path = ".pf/artifacts/docs-fix-1.1.1-20260907/docs111-tests-report.md"
    if expected_path not in {str(item.get("path", "")) for item in required_outputs}:
        raise AssertionError(f"assignment required_outputs missing {expected_path}")
    if not any(item.get("id") == "docs111-tests-report" for item in required_outputs):
        raise AssertionError("assignment required_outputs missing docs111-tests-report id")


def check_command_docs(parser) -> int:
    checked = 0
    for root in DOC_ROOTS:
        for path in sorted(root.rglob("*.md")):
            text = read_markdown(path)
            for language, lines in iter_markdown_fences(text):
                if language and language not in {"bash", "sh", "shell", "text"}:
                    continue
                for line in lines:
                    if not is_pf_cli_line(line):
                        continue
                    parse_pf_cli_line(parser, line, str(path.relative_to(ROOT)))
                    checked += 1
    if checked == 0:
        raise AssertionError("no PF CLI examples were checked")
    return checked


def check_ordinary_workflow_docs() -> None:
    en_workflow = read_markdown(ROOT / "docs" / "getting-started" / "task-batch-workflow.md")
    ru_workflow = read_markdown(ROOT / "docs" / "ru" / "getting-started" / "task-batch-workflow.md")
    for text, label in [(en_workflow, "EN"), (ru_workflow, "RU")]:
        for marker in ["run-create", "task-create", "iteration-add", "task-complete", "run-summary", "run-doctor", "run-complete"]:
            if marker not in text:
                raise AssertionError(f"{label} task batch workflow missing {marker}")
        if "blocking" not in text.lower():
            raise AssertionError(f"{label} task batch workflow does not explain blocking-task completion")
    for path in [
        ROOT / "docs" / "concepts" / "declarative-process-execution.md",
        ROOT / "docs" / "ru" / "concepts" / "declarative-process-execution.md",
    ]:
        text = read_markdown(path)
        for marker in ["pf.work.start", "process_choice_required", "process_id", "run_completed", "pf.work.transition"]:
            if marker not in text:
                raise AssertionError(f"{path.relative_to(ROOT)} missing workflow marker: {marker}")
        for marker in ["passed", "approved", "not_applicable"]:
            if marker not in text:
                raise AssertionError(f"{path.relative_to(ROOT)} missing evidence status marker: {marker}")


def check_ru_update_examples() -> None:
    text = read_markdown(ROOT / "docs" / "ru" / "getting-started" / "update-system.md")
    if "--workplace-root" not in text:
        raise AssertionError("Russian update-system examples must request --workplace-root")
    for marker in ["core-update plan", "core-update apply", "core-update status"]:
        if marker not in text:
            raise AssertionError(f"Russian update-system doc missing {marker}")


def check_checksum_text() -> None:
    text = read_markdown(ROOT / "docs" / "validation" / "validation.md")
    for marker in [
        "checks only public file inventories",
        "It does not validate context capsules.",
        "capsule-doctor",
        "project-context-check",
    ]:
        if marker not in text:
            raise AssertionError(f"validation doc missing marker: {marker}")


def main() -> int:
    parser_module = load_processforge_module()
    parser = parser_module.build_parser()

    checked = check_command_docs(parser)
    check_assignment_required_outputs()
    check_ordinary_workflow_docs()
    check_ru_update_examples()
    check_checksum_text()

    print(f"PASS: docs and prompts match the current PF CLI contract ({checked} CLI examples checked)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


