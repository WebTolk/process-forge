+def observe_search_index_for_project(
+    workplace_root: Path, *, reason: str,
+) -> dict[str, Any]:
+    """Project operations observe search state without starting maintenance."""
+    from processforge_core.resources.index_observation import IndexObservationService
+
+    state = IndexObservationService(workplace_root, distribution_root=ROOT).observe()
+    row: dict[str, Any] = {
+        "scope": "workplace",
+        "status": "ok" if state.get("status") == "fresh" else "degraded",
+        "action": "none",
+        "search_status": state.get("status"),
+        "generation": state.get("generation"),
+        "document_count": state.get("document_count"),
+        "stale_resource_count": state.get("stale_resource_count"),
+        "failed_file_count": state.get("failed_file_count"),
+    }
+    if state.get("error"):
+        row["error"] = state["error"]
+    report = workplace_root / "runtime" / "search" / "latest-maintenance.yaml"
+    return {
+        "schema_version": 1,
+        "kind": "pf.search_index.maintenance",
+        "created_at": _core_common_clock.now_utc(),
+        "reason": reason,
+        "scope": "workplace",
+        "project_count": 0,
+        "results": [row],
+        "report": rel(report, workplace_root) if report.is_file() else None,
+    }
+
+
 def search_index_project_label(project_root: Path, workplace_root: Path) -> str:
