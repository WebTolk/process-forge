 18575: def normalize_agent_model(value: Any) -> str:
 18576:     if value in (None, ""):
 18577:         return ""
 18578:     text = str(value).strip()
 18579:     if not text:
 18580:         return ""
 18581:     if any(char in text for char in "\r\n\0"):
 18582:         raise SystemExit("FAIL: agent model contains unsupported control characters")
 18583:     return text
 18584: 
 18585: 
 18586: def normalize_agent_reasoning_effort(value: Any) -> str:
 18587:     if value in (None, ""):
 18588:         return ""
 18589:     text = str(value).strip().lower()
 18590:     if not text:
 18591:         return ""
 18592:     if text not in {"minimal", "low", "medium", "high"}:
 18593:         raise SystemExit(f"FAIL: agent reasoning effort must be one of minimal, low, medium, high; got {text}")
 18594:     return text
