 18597: def worker_sandbox_for_task(task: dict[str, Any]) -> str:
 18598:     execution = task.get("execution_mode") if isinstance(task.get("execution_mode"), dict) else {}
 18599:     ownership = task.get("ownership") if isinstance(task.get("ownership"), dict) else {}
