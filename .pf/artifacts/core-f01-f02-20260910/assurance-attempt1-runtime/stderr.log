  176:             "reference": selected.get("path_ref") or selected.get("path") or "",
  177:             "application": selected.get("application") or {"package_id": selected.get("package_id"), "kind": selected.get("kind")},
  178:         }
  179:         if isinstance(selected.get("path_ref"), dict):
