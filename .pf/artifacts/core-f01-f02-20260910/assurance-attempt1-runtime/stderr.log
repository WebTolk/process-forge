  392: def add_private_navigation(payload: dict[str, Any], runtime_snapshot: dict[str, Any]) -> None:
  393:     resources = runtime_snapshot.get("local_search_resources") if isinstance(runtime_snapshot.get("local_search_resources"), list) else []
  394:     by_id = {str(item.get("id") or item.get("resource_id") or ""): item for item in resources if isinstance(item, dict)}
  395:     for match in payload.get("results", []):
  396:         if not isinstance(match, dict):
  397:             continue
  398:         resource = by_id.get(str(match.get("resource_id") or ""))
  399:         roots = resource.get("content_roots") if isinstance(resource, dict) and isinstance(resource.get("content_roots"), list) else []
  400:         for raw_root in roots:
  401:             root = Path(str(raw_root)).resolve()
  402:             candidate = (root / str(match.get("canonical_path") or "")).resolve() if root.is_dir() else root
  403:             try:
  404:                 candidate.relative_to(root if root.is_dir() else candidate)
  405:             except ValueError:
  406:                 continue
  407:             if candidate.is_file():
  408:                 match["local_path"] = str(candidate)
  409:                 match["navigation"] = "private_runtime_authorized"
  410:                 break
