  369: def resource_selection_summary(snapshot: dict[str, Any]) -> dict[str, Any]:
  370:     selection = snapshot.get("resource_selection") if isinstance(snapshot.get("resource_selection"), dict) else {}
  371:     resolved = snapshot.get("resolved") if isinstance(snapshot.get("resolved"), dict) else {}
  372:     selected = resolved.get("knowledge_resources") if isinstance(resolved.get("knowledge_resources"), list) else []
  373:     preferred = [
