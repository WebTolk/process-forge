  335: def resolve_garage_path_ref(project_root: Path, path_ref: dict[str, Any], workplace_root: Path, core: Any) -> dict[str, Any]:
  336:     resolution = core.resolve_workspace_path_ref(project_root, path_ref, workplace_manifest=workplace_root / "workplace.yaml")
  337:     if resolution.get("status") == "resolved":
  338:         return resolution
  339:     package_id = str(path_ref.get("package") or "")
  340:     relative_path = str(path_ref.get("relative_path") or "").strip()
  341:     if not package_id.startswith("project."):
  342:         return resolution
  343:     base = core.locate_flow_root(project_root)
  344:     candidate = (base / relative_path).resolve() if relative_path else base.resolve()
  345:     try:
  346:         candidate.relative_to(base.resolve())
  347:     except ValueError:
  348:         return {"status": "unresolved", "reason": "invalid_path_ref: relative_path escapes project flow root"}
  349:     return {"status": "resolved" if candidate.exists() else "missing", "path": str(candidate)}
