  355:     for key in ("knowledge_resources",):
  356:         if isinstance(resolved.get(key), list):
  357:             candidates.extend(resolved[key])
  358:     if isinstance(snapshot.get("local_search_resources"), list):
  359:         candidates.extend(snapshot["local_search_resources"])
  360:     for item in candidates:
  361:         if not isinstance(item, dict):
  362:             continue
  363:         ids = {str(item.get("id") or ""), str(item.get("resource_id") or ""), str(item.get("instance_id") or "")}
  364:         if resource_id in ids:
  365:             return item
  366:     return {}
