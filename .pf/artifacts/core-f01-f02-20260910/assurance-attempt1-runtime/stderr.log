  347: def unowned_path_blocker(core_root: Path, relative_path: str) -> dict[str, str] | None:
  348:     """Return a blocker when an added payload would replace an unowned path.
  349: 
  350:     ``Path.exists()`` does not report broken symlinks, and resolving a path
  351:     through a non-directory ancestor can defer the failure until apply has
  352:     already created update state.  Inspect the lexical path first so all
  353:     existing objects, including symlinks, are protected before any mutation.
  354:     """
  355:     target = core_root / relative_path
  356:     if os.path.lexists(target):
  357:         return {"code": "unowned_path_collision", "path": relative_path, "conflict_path": relative_path}
  358: 
  359:     ancestor = target.parent
  360:     while ancestor != core_root:
  361:         if os.path.lexists(ancestor) and (ancestor.is_symlink() or not ancestor.is_dir()):
  362:             conflict_path = ancestor.relative_to(core_root).as_posix()
  363:             return {"code": "unowned_path_collision", "path": relative_path, "conflict_path": conflict_path}
  364:         ancestor = ancestor.parent
  365:     return None
