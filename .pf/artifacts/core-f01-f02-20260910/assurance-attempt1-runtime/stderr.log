  323: def snapshot_with_resolved_search_roots(project_root: Path, snapshot: dict[str, Any], workplace_root: Path, core: Any) -> dict[str, Any]:
  324:     runtime_snapshot = copy.deepcopy(snapshot)
  325:     resources = runtime_snapshot.get("local_search_resources") if isinstance(runtime_snapshot.get("local_search_resources"), list) else []
  326:     for resource in resources:
  327:         if not isinstance(resource, dict) or not isinstance(resource.get("path_ref"), dict):
  328:             continue
  329:         resolution = resolve_garage_path_ref(project_root, resource["path_ref"], workplace_root, core)
  330:         if resolution.get("status") == "resolved" and resolution.get("path"):
  331:             resource["content_roots"] = [str(resolution["path"])]
  332:     return runtime_snapshot
