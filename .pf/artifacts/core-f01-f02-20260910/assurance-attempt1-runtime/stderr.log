  144:         readiness = self.readiness(snapshot=runtime_snapshot, check=check)
  145:         query_index = ResourceSearchIndex(self.project_root, runtime_snapshot, self.workplace_root)
  146:         payload = query_index.search(query=query, limit=limit, limitstart=limitstart, offset=offset)
  147:         payload["garage_readiness"] = readiness
  148:         payload["search"] = readiness
