  385:         "available_count": int(selection.get("available_count") or len(resolved.get("available_knowledge_resources") or [])),
  386:         "selected_count": int(selection.get("selected_count") or len(preferred)),
  387:         "target_versions": selection.get("target_versions") if isinstance(selection.get("target_versions"), list) else [],
  388:         "preferred": preferred,
