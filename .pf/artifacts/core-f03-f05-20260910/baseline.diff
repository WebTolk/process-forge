+            if (
+                conflict_path in removable_owned_paths
+                and ancestor.is_file()
+                and not ancestor.is_symlink()
+            ):
+                ancestor = ancestor.parent
+                continue
+            return {"code": "unowned_path_collision", "path": relative_path, "conflict_path": conflict_path}
+        ancestor = ancestor.parent
+    return None
