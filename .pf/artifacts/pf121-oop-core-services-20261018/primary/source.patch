+        for key in [
+            "process_transitions",
+            "agent_requirements",
+            "responsibility_boundaries",
+            "subagent_policy",
+            "runtime_requirements",
+            "runtime_execution_boundary",
+            "stage_completion",
+            "run_completion",
+            "metadata",
+        ]:
+            if key in process:
+                answers[key] = process[key]
+        return answers
diff --git a/src/processforge_core/process_catalog/coordination.py b/src/processforge_core/process_catalog/coordination.py
