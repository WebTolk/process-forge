@@ -0,0 +1,102 @@
+"""Markdown presentation for process import and parity."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from processforge_core.common.checks import Check
+from processforge_core.common.paths import rel
+
+
+class ProcessParityRenderer:
+
+    def import_report(self, process: dict[str, Any], process_path: Path, paths: dict[str, Path], project_root: Path, unsupported: list[dict[str, str]]) -> str:
+        status = "WARN" if unsupported else "PASS"
+        lines = [
+            f"# Process Authoring Import: {process.get('id', process_path.stem)}",
+            "",
+            "## Result",
+            "",
+            status,
+            "",
+            "## Source",
+            "",
+            f"- Path: `{rel(process_path, project_root)}`",
+            f"- Process id: `{process.get('id', process_path.stem)}`",
+            "",
+            "## Created",
+            "",
+            f"- `{rel(paths['answers'], project_root)}`",
+            f"- `{rel(paths['draft'], project_root)}`",
+            f"- `{rel(paths['source'], project_root)}`",
+            f"- `{rel(paths['semantic_map'], project_root)}`",
+            f"- `{rel(paths['unsupported'], project_root)}`",
+            "",
+            "## Unsupported Fields",
+            "",
+        ]
+        if unsupported:
+            lines.extend(f"- `{item['path']}`: {item['reason']}" for item in unsupported)
+        else:
+            lines.append("- None.")
+        return "\n".join(lines) + "\n"
+
+    def parity_report(self, process_id: str, source_path: Path, project_root: Path, status: str, diffs: list[dict[str, str]], unsupported: list[dict[str, str]], logic_checks: list[Check]) -> str:
+        lines = [
+            f"# Process Parity: {process_id}",
+            "",
+            "## Result",
+            "",
+            status,
+            "",
+            "## Source",
+            "",
+            f"- Path: `{rel(source_path, project_root)}`",
+            f"- Process id: `{process_id}`",
+            "",
+            "## Authoring Coverage",
+            "",
+            "| Area | Status | Notes |",
+            "|---|---|---|",
+        ]
+        logic_diff_levels = [item["level"] for item in diffs if item["area"] == "logic_review"]
+        logic_status = "FAIL" if "FAIL" in logic_diff_levels else ("WARN" if "WARN" in logic_diff_levels else "PASS")
+        lines.append(f"| logic_review | {logic_status} | {len(logic_checks)} checks |")
+        lines.append(f"| unsupported_fields | {'WARN' if unsupported else 'PASS'} | {len(unsupported)} unsupported fields |")
+        lines.append(f"| semantic_diff | {status} | {len(diffs)} differences |")
+        lines.extend(["", "## Semantic Diff", ""])
+        if diffs:
+            lines.extend(f"- {item['level']} `{item['area']}`: {item['message']}" for item in diffs)
+        else:
+            lines.append("- No meaningful differences.")
+        lines.extend(["", "## Unsupported Fields", ""])
+        if unsupported:
+            lines.extend(f"- `{item['path']}`: {item['reason']}" for item in unsupported)
+        else:
+            lines.append("- None.")
+        expected_warns = [item for item in diffs if item["level"] == "WARN" and item["area"] in {"logic_review", "unsupported_fields"}]
+        action_warns = [item for item in diffs if item["level"] == "WARN" and item["area"] not in {"logic_review", "unsupported_fields"}]
+        lines.extend(["", "## Checked", ""])
+        lines.append("- Process id, run model, roles, stages, artifacts, gates, emitted events, and resource requirements.")
+        lines.append("- Candidate process logic against ProcessForge authoring rules.")
+        lines.extend(["", "## Skipped", ""])
+        lines.append("- Byte-for-byte YAML formatting and key order are intentionally not compared.")
+        lines.extend(["", "## Expected WARN", ""])
+        if expected_warns:
+            lines.extend(f"- `{item['area']}`: {item['message']}" for item in expected_warns)
+        else:
+            lines.append("- None.")
+        lines.extend(["", "## Public Release WARN Actions", ""])
+        if action_warns:
+            lines.extend(f"- `{item['area']}`: {item['message']}" for item in action_warns)
+        else:
+            lines.append("- None.")
+        lines.extend(["", "## Recommendation", ""])
+        if status == "PASS":
+            lines.append("Process is semantically reproducible through authoring import.")
+        elif status == "WARN":
+            lines.append("Process is reproducible with documented warnings; public-release action items are listed explicitly when present.")
+        else:
+            lines.append("Process is not reproducible enough for release parity; fix FAIL items before public release.")
+        return "\n".join(lines) + "\n"
diff --git a/src/processforge_core/process_catalog/semantics.py b/src/processforge_core/process_catalog/semantics.py
new file mode 100644
index 0000000..330529e
--- /dev/null
+++ b/src/processforge_core/process_catalog/semantics.py
@@ -0,0 +1,164 @@
+"""Process semantic projection and comparison policy."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from processforge_core.common.ids import safe_id
+from processforge_core.common.paths import rel
+from processforge_core.common.values import as_list, string_list
+
+
+PROCESS_AUTHORING_SUPPORTED_TOP_LEVEL = {
+    "schema_version",
+    "id",
+    "name",
+    "kind",
+    "scope",
+    "version",
+    "status",
+    "description",
+    "purpose",
+    "execution_mode",
+    "execution_mode_questions",
+    "coordination_requirements",
+    "error_handling",
+    "run_model",
+    "required_capabilities",
+    "hooks",
+    "evolve",
+    "roles",
+    "stages",
+    "artifact_definitions",
+    "evidence_definitions",
+    "gates",
+    "required_packages",
+    "required_templates",
+    "allowed_tools",
+    "forbidden_actions",
+    "evolution_policy",
+    "expected_artifacts",
+    "process_transitions",
+    "agent_requirements",
+    "responsibility_boundaries",
+    "subagent_policy",
+    "runtime_requirements",
+    "runtime_execution_boundary",
+    "stage_completion",
+    "run_completion",
+    "metadata",
+    "catalog",
+    "process_pack",
+    "public_surface",
+    "agent_prompt",
+    "input_definitions",
+    "external_artifacts",
+    "virtual_artifacts",
+    "generated_files",
+}
+
+
+class ProcessSemanticPolicy:
+
+    def unsupported_fields(self, process: dict[str, Any]) -> list[dict[str, str]]:
+        unsupported: list[dict[str, str]] = []
+        for key in sorted(process.keys()):
+            if key not in PROCESS_AUTHORING_SUPPORTED_TOP_LEVEL:
+                unsupported.append({"path": key, "reason": "not represented in process-authoring answers schema"})
+        return unsupported
+
+    def map(self, process: dict[str, Any], process_path: Path, project_root: Path, unsupported: list[dict[str, str]]) -> dict[str, Any]:
+        return {
+            "schema_version": 1,
+            "source": {"type": "process", "id": str(process.get("id", process_path.stem)), "path": rel(process_path, project_root)},
+            "mapped": {
+                "id": "process.id",
+                "title": "process.name",
+                "purpose": "process.description",
+                "stages": "stages",
+                "roles": "roles",
+                "gates": "gates",
+                "artifacts": "artifact_definitions",
+                "events": "hooks.emit",
+                "evolve": "evolve",
+                "run_model": "run_model",
+                "requirements": "required_packages|required_templates|allowed_tools|required_capabilities",
+            },
+            "unsupported": unsupported,
+        }
+
+    def describe(self, process: dict[str, Any]) -> dict[str, Any]:
+        return {
+            "id": safe_id(str(process.get("id", "")), "process"),
+            "title": str(process.get("name") or ""),
+            "kind": str(process.get("kind") or ""),
+            "scope": str(process.get("scope") or ""),
+            "purpose": str(process.get("purpose") or process.get("description") or ""),
+            "run_model": process.get("run_model") if isinstance(process.get("run_model"), dict) else {},
+            "roles": self.objects(process.get("roles"), ["title", "responsibility"]),
+            "stages": self.objects(process.get("stages"), ["title", "required_role", "required_inputs", "produced_artifacts", "required_artifacts", "required_evidence", "entry_gates", "exit_gates", "automation_bindings", "handoff_required"]),
+            "artifact_definitions": self.objects(process.get("artifact_definitions"), ["title", "owner_role", "template", "lifecycle"]),
+            "evidence_definitions": self.objects(process.get("evidence_definitions"), ["title", "kind", "artifact"]),
+            "gates": self.objects(process.get("gates"), ["description", "blocking", "required_artifact", "stage", "stage_id"]),
+            "events": {"emits": self.events(process)},
+            "requirements": {
+                "required_capabilities": self.strings(process.get("required_capabilities")),
+                "required_packages": self.strings(process.get("required_packages")),
+                "required_templates": self.strings(process.get("required_templates")),
+                "allowed_tools": self.strings(process.get("allowed_tools")),
+                "forbidden_actions": self.strings(process.get("forbidden_actions")),
+            },
+        }
+
+    def compare(self, source: dict[str, Any], candidate: dict[str, Any]) -> tuple[str, list[dict[str, str]]]:
+        source_sem = self.describe(source)
+        candidate_sem = self.describe(candidate)
+        diffs: list[dict[str, str]] = []
+
+        def add(level: str, area: str, message: str) -> None:
+            diffs.append({"level": level, "area": area, "message": message})
+
+        for area in ["id", "run_model"]:
+            if source_sem.get(area) != candidate_sem.get(area):
+                add("FAIL", area, f"{area} differs")
+        for area in ["title", "kind", "scope", "purpose"]:
+            if area in {"kind", "scope"} and area not in source:
+                continue
+            if source_sem.get(area) != candidate_sem.get(area):
+                add("WARN", area, f"{area} differs")
+        for area in ["roles", "stages", "artifact_definitions", "gates"]:
+            source_ids = set(source_sem[area].keys())
+            candidate_ids = set(candidate_sem[area].keys())
+            for missing in sorted(source_ids - candidate_ids):
+                add("FAIL", area, f"{area} missing: {missing}")
+            for extra in sorted(candidate_ids - source_ids):
+                add("WARN", area, f"{area} extra: {extra}")
+        for area, label in [("events", "emits")]:
+            source_values = set(source_sem[area][label])
+            candidate_values = set(candidate_sem[area][label])
+            for missing in sorted(source_values - candidate_values):
+                add("FAIL", area, f"event missing: {missing}")
+        for key, source_values in source_sem["requirements"].items():
+            candidate_values = set(candidate_sem["requirements"].get(key, []))
+            for missing in sorted(set(source_values) - candidate_values):
+                add("FAIL", key, f"{key} missing: {missing}")
+        status = "FAIL" if any(item["level"] == "FAIL" for item in diffs) else ("WARN" if any(item["level"] == "WARN" for item in diffs) else "PASS")
+        return status, diffs
+
+    def strings(self, values: Any) -> list[str]:
+        return sorted(set(string_list(values)))
+
+    def events(self, process: dict[str, Any]) -> list[str]:
+        hooks = process.get("hooks") if isinstance(process.get("hooks"), dict) else {}
+        emits = hooks.get("emit") if isinstance(hooks.get("emit"), list) else []
+        return sorted({str(item.get("event")) for item in emits if isinstance(item, dict) and item.get("event")})
+
+    def objects(self, items: Any, keys: list[str]) -> dict[str, dict[str, Any]]:
+        result: dict[str, dict[str, Any]] = {}
+        for item in as_list(items):
+            if not isinstance(item, dict):
+                continue
+            item_id = safe_id(str(item.get("id", "")), "item")
+            result[item_id] = {key: item.get(key) for key in keys if key in item}
+        return result
diff --git a/src/processforge_core/project/platform_resolution.py b/src/processforge_core/project/platform_resolution.py
new file mode 100644
index 0000000..bc5e1dc
--- /dev/null
+++ b/src/processforge_core/project/platform_resolution.py
@@ -0,0 +1,187 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from ..common.values import parameter_payload
+from ..resources.project_packages import ProjectPackageCatalogReader
+from .platform_policy import PlatformContractPolicy
+from .platforms import PlatformContractReader
+
+
+class PlatformContractResolver:
+    """Resolve platform inheritance and its project resource requirements."""
+
+    def __init__(self, distribution_root: Path):
+        self.distribution_root = distribution_root
+        self._platform_contract_reader = PlatformContractReader(distribution_root)
+        self._platform_contract_policy = PlatformContractPolicy(self._platform_contract_reader)
+        self._package_catalog = ProjectPackageCatalogReader(distribution_root)
+
+    def merge_ids(self, target: dict[str, str], values: list[str], owner: str, conflicts: list[dict[str, Any]]) -> None:
+        for value in values:
+            if value not in target:
+                target[value] = owner
+            elif target[value] != owner:
+                conflicts.append({"id": value, "first_owner": target[value], "second_owner": owner, "resolution": "dedupe"})
+
+    def resolve(
+        self,
+        workplace_manifest: Path | None,
+        platform_ids: list[str],
+        project_root: Path | None = None,
+        contract_overrides: dict[str, dict[str, Any]] | None = None,
+    ) -> dict[str, Any]:
+        contracts_by_id: dict[str, dict[str, Any]] = {}
+        platform_stack: list[dict[str, Any]] = []
+        required_capabilities: set[str] = set()
+        required_knowledge_packages: dict[str, str] = {}
+        recommended_knowledge_packages: dict[str, str] = {}
+        required_tools: dict[str, str] = {}
+        recommended_tools: dict[str, str] = {}
+        required_mcp: dict[str, str] = {}
+        recommended_mcp: dict[str, str] = {}
+        required_templates: dict[str, str] = {}
+        recommended_templates: dict[str, str] = {}
+        missing_required_contracts: list[str] = []
+        circular_platforms: list[str] = []
+        dependency_conflicts: list[dict[str, Any]] = []
+        resource_conflicts: list[dict[str, Any]] = []
+        resolved: set[str] = set()
+        resolving: list[str] = []
+
+        def resolve_one(raw_platform_id: str, *, relation: str = "selected", inherited_by: str | None = None, include_resources: bool = True, required: bool = True) -> None:
+            contract_id = self._platform_contract_reader.contract_id(raw_platform_id)
+            if contract_id in resolving:
+                cycle = " -> ".join([*resolving[resolving.index(contract_id):], contract_id])
+                circular_platforms.append(cycle)
+                return
+            if contract_id in resolved:
+                return
+            resolving.append(contract_id)
+            if contract_overrides and contract_id in contract_overrides:
+                contract = contract_overrides[contract_id]
+                entry = {"id": contract_id, "status": "available", "source": "staged"}
+                status = "available"
+                source = "staged"
+            else:
+                contract, entry, status, source = self._platform_contract_reader.load(workplace_manifest, contract_id, project_root)
+            extends_refs = self._platform_contract_policy.extends(contract)
+            required_platform_refs = self._platform_contract_policy.required_platforms(contract)
+            for ref in extends_refs:
+                if ref["id"] in resolving:
+                    cycle = " -> ".join([*resolving[resolving.index(ref["id"]):], ref["id"]])
+                    circular_platforms.append(cycle)
+                    continue
+                resolve_one(ref["id"], relation="extends", inherited_by=contract_id, include_resources=True, required=bool(ref.get("required", True)))
+            for ref in required_platform_refs:
+                if ref["id"] in resolving:
+                    cycle = " -> ".join([*resolving[resolving.index(ref["id"]):], ref["id"]])
+                    circular_platforms.append(cycle)
+                    continue
+                resolve_one(ref["id"], relation="requires.platforms", inherited_by=contract_id, include_resources=False, required=bool(ref.get("required", True)))
+            if status != "available" and required:
+                missing_required_contracts.append(contract_id)
+            platform_record = {
+                "id": contract_id,
+                "platform": contract_id.removeprefix("platform."),
+                "source": source,
+                "status": "available" if status == "available" else "missing",
+                "relation": relation,
+                "required": required,
+                "inherited_by": inherited_by,
+                "extends": [ref["id"] for ref in extends_refs],
+                "requires_platforms": [ref["id"] for ref in required_platform_refs],
+            }
+            platform_stack.append(platform_record)
+            if include_resources:
+                required_capabilities.update(self._platform_contract_policy.required_capabilities(contract))
+                owner = contract_id
+                self.merge_ids(required_knowledge_packages, self._platform_contract_policy.required_items(contract, "knowledge_packages"), owner, resource_conflicts)
+                self.merge_ids(recommended_knowledge_packages, self._platform_contract_policy.recommended_items(contract, "knowledge_packages"), owner, resource_conflicts)
+                self.merge_ids(required_tools, self._platform_contract_policy.required_items(contract, "tools"), owner, resource_conflicts)
+                self.merge_ids(recommended_tools, self._platform_contract_policy.recommended_items(contract, "tools"), owner, resource_conflicts)
+                self.merge_ids(required_mcp, self._platform_contract_policy.required_items(contract, "mcp"), owner, resource_conflicts)
+                self.merge_ids(recommended_mcp, self._platform_contract_policy.recommended_items(contract, "mcp"), owner, resource_conflicts)
+                self.merge_ids(required_templates, self._platform_contract_policy.required_items(contract, "templates"), owner, resource_conflicts)
+                self.merge_ids(recommended_templates, self._platform_contract_policy.recommended_items(contract, "templates"), owner, resource_conflicts)
+            contracts_by_id[contract_id] = {
+                "id": contract_id,
+                "platform": contract_id.removeprefix("platform."),
+                "source": source,
+                "status": "available" if status == "available" else "missing",
+                "registry_entry": str(entry.get("id")) if isinstance(entry, dict) and entry.get("id") else None,
+                "required_contract": required,
+                "relation": relation,
+                "inherited_by": inherited_by,
+                "extends": [ref["id"] for ref in extends_refs],
+                "requires_platforms": [ref["id"] for ref in required_platform_refs],
+                "required_capabilities": sorted(self._platform_contract_policy.required_capabilities(contract)),
+                "required": {
+                    "knowledge_packages": sorted(self._platform_contract_policy.required_items(contract, "knowledge_packages")),
+                    "tools": sorted(self._platform_contract_policy.required_items(contract, "tools")),
+                    "mcp": sorted(self._platform_contract_policy.required_items(contract, "mcp")),
+                    "templates": sorted(self._platform_contract_policy.required_items(contract, "templates")),
+                },
+                "recommended": {
+                    "knowledge_packages": sorted(self._platform_contract_policy.recommended_items(contract, "knowledge_packages")),
+                    "tools": sorted(self._platform_contract_policy.recommended_items(contract, "tools")),
+                    "mcp": sorted(self._platform_contract_policy.recommended_items(contract, "mcp")),
+                    "templates": sorted(self._platform_contract_policy.recommended_items(contract, "templates")),
+                },
+                "optional": {
+                    "knowledge_packages": sorted(self._platform_contract_policy.optional_items(contract, "knowledge_packages")),
+                    "tools": sorted(self._platform_contract_policy.optional_items(contract, "tools")),
+                    "mcp": sorted(self._platform_contract_policy.optional_items(contract, "mcp")),
+                    "templates": sorted(self._platform_contract_policy.optional_items(contract, "templates")),
+                },
+                "parameters": parameter_payload(contract),
+            }
+            resolving.pop()
+            resolved.add(contract_id)
+
+        for platform_id in platform_ids:
+            resolve_one(platform_id)
+
+        package_index_root = project_root or (workplace_manifest.parent if workplace_manifest and workplace_manifest.is_file() else self.distribution_root)
+        package_index = self._package_catalog.index(package_index_root, self.distribution_root, workplace_manifest)
+        dependency_queue = list(required_knowledge_packages)
+        while dependency_queue:
+            package_id = dependency_queue.pop(0)
+            manifest = package_index.get(package_id)
+            if not isinstance(manifest, dict):
+                continue
+            for dependency_id in self._package_catalog.dependencies(manifest):
+                if dependency_id not in required_knowledge_packages:
+                    required_knowledge_packages[dependency_id] = f"package:{package_id}"
+                    dependency_queue.append(dependency_id)
+
+        required_knowledge_ids = set(required_knowledge_packages)
+        recommended_knowledge_ids = set(recommended_knowledge_packages) - required_knowledge_ids
+        required_tool_ids = set(required_tools)
+        recommended_tool_ids = set(recommended_tools) - required_tool_ids
+        required_mcp_ids = set(required_mcp)
+        recommended_mcp_ids = set(recommended_mcp) - required_mcp_ids
+        required_template_ids = set(required_templates)
+        recommended_template_ids = set(recommended_templates) - required_template_ids
+        return {
+            "contracts": [contracts_by_id[item["id"]] for item in platform_stack if item["id"] in contracts_by_id],
+            "platform_stack": platform_stack,
+            "missing_required_contracts": sorted(set(missing_required_contracts)),
+            "circular_platforms": sorted(set(circular_platforms)),
+            "dependency_conflicts": dependency_conflicts,
+            "resource_conflicts": resource_conflicts,
