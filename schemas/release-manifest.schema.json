{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessForge Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "schema_bundle_version",
    "release_eligible",
    "build",
    "source",
    "archive",
    "official_packs",
    "files"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "const": "processforge" },
    "version": { "type": "string", "minLength": 1 },
    "schema_bundle_version": { "type": "string", "minLength": 1 },
    "release_eligible": { "type": "boolean", "const": true },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_date_epoch", "generated_at", "deterministic"],
      "properties": {
        "source_date_epoch": { "type": "integer", "minimum": 315532800 },
        "generated_at": {
          "type": "string",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
        },
        "deterministic": { "type": "boolean", "const": true }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcs", "commit", "tree", "dirty"],
      "properties": {
        "vcs": { "type": "string", "const": "git" },
        "commit": { "type": "string", "pattern": "[0-9a-f]{40}" },
        "tree": { "type": "string", "pattern": "[0-9a-f]{40}" },
        "dirty": { "type": "boolean", "const": false }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "format", "size", "sha256", "entry_count"],
      "properties": {
        "filename": { "type": "string", "pattern": "[A-Za-z0-9._-]+\\.zip" },
        "format": { "type": "string", "const": "zip" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "[0-9a-f]{64}" },
        "entry_count": { "type": "integer", "minimum": 1 }
      }
    },
    "official_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "manifest_path", "manifest_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "manifest_path": { "type": "string", "minLength": 1 },
          "manifest_sha256": { "type": "string", "pattern": "[0-9a-f]{64}" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "[0-9a-f]{64}" }
        }
      }
    }
  }
}
