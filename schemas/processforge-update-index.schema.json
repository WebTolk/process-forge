{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/processforge-update-index.schema.json",
  "title": "ProcessForge Update Index",
  "type": "object",
  "required": ["schema_version", "product", "channels", "versions"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "product": { "type": "object", "required": ["id"], "additionalProperties": true },
    "channels": { "type": "object", "additionalProperties": true },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "channel"],
        "properties": {
          "version": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "minLength": 1 },
          "released_at": { "type": "string" },
          "compatibility": { "type": "object", "additionalProperties": true },
          "migration": { "type": "object", "additionalProperties": true },
          "changes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "affected_files": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
