{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/project-configuration.schema.json",
  "title": "Project logging overrides",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "logging": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "raw_hooks": {"type": ["boolean", "null"], "default": null},
        "events": {"type": ["boolean", "null"], "default": null}
      }
    }
  }
}
