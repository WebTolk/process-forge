{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/project-configuration.schema.json",
  "title": "Project operational configuration overrides",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "garage_hooks": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "temporary_files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "notify",
                "off",
                null
              ],
              "default": null
            },
            "max_age_hours": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 1,
              "maximum": 87600,
              "default": null
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_hooks": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "events": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "driver",
              "path"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "project"
                ]
              },
              "driver": {
                "const": "sqlite"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))(?!.*[\\u0000$%~:])(?!.*[\\\\/]{2})(?!.*[\\\\/]$).+$"
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 30000,
                "default": 100
              }
            }
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_main": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        }
      }
    }
  }
}
