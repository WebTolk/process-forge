{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/project-context-snapshot.schema.json",
  "title": "Project Context Snapshot",
  "type": "object",
  "required": ["schema_version", "snapshot", "project", "flow", "sources", "resolved_policies", "capabilities", "session"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string" },
    "generated_at": { "type": "string" },
    "snapshot": {
      "type": "object",
      "required": ["id", "generated_at", "valid_until", "refresh_policy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "valid_until": { "type": "string", "minLength": 1 },
        "refresh_policy": { "type": "object", "additionalProperties": true },
        "health": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": ["array", "string"] }
      },
      "additionalProperties": true
    },
    "project_classification": {
      "type": "object",
      "properties": {
        "status": { "enum": ["classified", "unclassified"] },
        "project_types": { "type": "array", "items": { "type": "string" } },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["low", "medium", "high"] },
        "loaded_classifiers": { "type": "array", "items": { "type": "string" } },
        "matched_rules": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "flow": {
      "type": "object",
      "required": ["root", "manifest", "local_config"],
      "properties": {
        "root": { "type": "string" },
        "layout": { "type": "string" },
        "manifest": { "type": "string" },
        "local_config": { "type": "string" }
      },
      "additionalProperties": true
    },
    "process_forge": { "type": "object", "additionalProperties": true },
    "platform_contracts": { "type": "object", "additionalProperties": true },
    "sources": {
      "type": "object",
      "required": ["fingerprints"],
      "properties": {
        "fingerprints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "checksum"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "checksum": { "type": "string" },
              "private": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "requirements_fingerprint": { "type": "object", "additionalProperties": { "type": "string" } },
    "context_requirements": { "type": "object", "additionalProperties": true },
    "context_policy": { "type": "object", "additionalProperties": true },
    "resolved_parameters": { "type": "object", "additionalProperties": true },
    "parameter_resolution": { "type": "object", "additionalProperties": true },
    "resolved_context": { "type": "object", "additionalProperties": true },
    "active_resource_profile": { "type": "object", "additionalProperties": true },
    "execution_route": { "type": "object", "additionalProperties": true },
    "capability_resolution": { "type": "object", "additionalProperties": true },
    "selected_specializations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "applied_project_overrides": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "effective_fingerprints": { "type": "object", "additionalProperties": { "type": "string" } },
    "resolution_reasons": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "conflicts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "resolved": {
      "type": "object",
      "properties": {
        "knowledge_packages": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "knowledge_resources": { "type": "array", "items": { "$ref": "#/$defs/resolvedResource" } },
        "template_packages": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "templates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "tools": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "platform_contracts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "process_packages": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "freshness": {
      "type": "object",
      "properties": {
        "status": { "enum": ["fresh", "fresh_with_updates", "stale", "broken"] },
        "checked_at": { "type": "string" },
        "stale_reasons": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "update_available": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "broken_refs": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "reproducibility": { "type": "object", "additionalProperties": true },
    "source_fingerprints": { "type": "object", "additionalProperties": { "type": "string" } },
    "knowledge_stack": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "platform_stack": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "knowledge_resources": { "type": "object", "additionalProperties": true },
    "resource_selection": { "type": "object", "additionalProperties": true },
    "resolved_policies": { "type": "object", "additionalProperties": true },
    "capabilities": { "type": "object", "additionalProperties": true },
    "tools": { "type": "object", "additionalProperties": true },
    "mcp": { "type": "object", "additionalProperties": true },
    "templates": { "type": "object", "additionalProperties": true },
    "processes": { "type": "object", "additionalProperties": true },
    "packages": { "type": "object", "additionalProperties": true },
    "workplace_coordination": {
      "type": "object",
      "properties": {
        "project_mode": { "enum": ["inherit", "simple", "organized"] },
        "workplace_default_project_mode": { "enum": ["simple", "organized"] },
        "effective_mode": { "enum": ["simple", "organized"] },
        "director_enabled": { "type": "boolean" },
        "director_available_at_workplace": { "type": "boolean" },
        "director_required": { "type": "boolean" },
        "director_process": { "type": ["string", "null"] },
        "director_inbox": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "session": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "resolvedResource": {
      "type": "object",
      "required": ["id", "kind", "versioning_mode", "retention_policy", "instance_id", "fingerprint", "reproducibility"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "package_id": { "type": "string" },
        "versioning_mode": { "enum": ["multi_version", "single_current", "rolling_index", "external_live"] },
        "retention_policy": { "enum": ["keep_versions", "keep_last_n", "replace_in_place", "external_only"] },
        "resolved_version": { "type": "string" },
        "resolved_generation": { "type": "string" },
        "instance_id": { "type": "string", "minLength": 1 },
        "path_ref": { "type": ["object", "string", "null"], "additionalProperties": true },
        "current_marker_path_ref": { "type": ["object", "string", "null"], "additionalProperties": true },
        "fingerprint": { "type": "object", "required": ["type", "value"], "additionalProperties": true },
        "reproducibility": { "type": "object", "required": ["level"], "additionalProperties": true },
        "snapshot_behavior": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
