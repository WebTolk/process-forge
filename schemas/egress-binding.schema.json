{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/egress-binding.schema.json",
  "title": "Explicit immutable egress binding",
  "type": "object",
  "required": [
    "policy_id",
    "recipient",
    "purpose",
    "policy_checksum",
    "detector_checksum",
    "minimum_enforcement",
    "limits"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "policy_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "detector_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "minimum_enforcement": {
      "const": "mediated_session"
    },
    "limits": {
      "type": "object",
      "required": [
        "unit_bytes",
        "envelope_bytes",
        "attempt_bytes",
        "disclosures",
        "json_depth",
        "classification_ms",
        "token_seconds"
      ],
      "properties": {
        "unit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "envelope_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "attempt_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "disclosures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "json_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "classification_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "token_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
