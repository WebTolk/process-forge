{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/specialization-registry.schema.json",
  "title": "Specialization Registry",
  "type": "object",
  "required": ["schema_version", "specializations"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "specializations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "draft", "missing", "disabled", "deprecated"] },
          "scope": { "enum": ["workplace", "project", "package"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
