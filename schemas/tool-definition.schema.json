{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/tool-definition.schema.json",
  "title": "Tool Definition",
  "type": "object",
  "required": ["id", "capability", "command", "scope", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "capability": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "status": { "enum": ["configured", "optional", "missing", "disabled"] },
    "healthcheck": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
