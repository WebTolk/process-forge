{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/orchestrator-shell-agent-plan.schema.json",
  "title": "Orchestrator Shell Agent Plan",
  "type": "object",
  "required": ["schema_version", "run", "orchestrator", "workers"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "run": { "type": "object", "additionalProperties": true },
    "orchestrator": { "type": "object", "additionalProperties": true },
    "runtime": { "type": "object", "additionalProperties": true },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "allow_subagents": { "type": "boolean" },
          "subagent_policy": {
            "type": "object",
            "properties": {
              "allow": { "type": "boolean" },
              "max_subagents": { "type": "integer", "minimum": 0 },
              "allowed_roles": { "type": "array", "items": { "type": "string" } },
              "require_reports": { "type": "boolean" },
              "reports_dir": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
}
