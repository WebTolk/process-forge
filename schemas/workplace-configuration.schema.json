{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/workplace-configuration.schema.json",
  "title": "Workplace operational configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "logging": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "raw_hooks": {"type": "boolean", "default": true},
        "events": {"type": "boolean", "default": true}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "garage_hooks": {"type": "boolean", "default": false},
        "temporary_files": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["notify", "off"], "default": "notify"},
            "max_age_hours": {"type": "number", "minimum": 1, "maximum": 87600, "default": 168}
          }
        },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "interval_seconds": {"type": "number", "minimum": 1, "maximum": 60, "default": 10}
          }
        }
      }
    }
  }
}
