{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/resource-management-event.schema.json",
  "title": "Resource Management Event",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "scope", "source", "target", "result"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["workplace", "project"] },
    "source": {
      "type": "object",
      "required": ["command", "actor_type"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "actor_type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "target": { "type": "object", "additionalProperties": true },
    "result": {
      "type": "object",
      "required": ["status", "message"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
