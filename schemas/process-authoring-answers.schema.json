{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/process-authoring-answers.schema.json",
  "title": "Process Authoring Answers",
  "type": "object",
  "required": ["schema_version", "process", "evolve", "roles", "stages", "artifacts", "gates"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "process": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "status": { "type": "string" },
        "kind": { "type": "string" },
        "scope": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "process_root": { "enum": ["user", "custom", "core"] },
        "path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "run_model": {
      "type": "object",
      "properties": {
        "supports_multiple_tasks": { "type": "boolean" },
        "default_task_loop": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "execution_mode": {
      "enum": ["single_agent", "single_agent_with_subagents", "orchestrated_agents", "process_factory"]
    },
    "execution_mode_questions": {
      "type": "object",
      "properties": {
        "single_agent": { "type": "object", "additionalProperties": true },
        "single_agent_with_subagents": { "type": "object", "additionalProperties": true },
        "orchestrated_agents": { "type": "object", "additionalProperties": true },
        "process_factory": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "coordination_requirements": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["simple_allowed", "organized_required", "organized_optional"] },
        "director_inbox": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "optional": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "error_workflow": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["none", "director_inbox", "route_to_process", "needs_operator"] }
          },
          "additionalProperties": true
        },
        "simple_mode_behavior": { "enum": ["disable_director_features", "optional", "fail_validation"] }
      },
      "additionalProperties": true
    },
    "error_handling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["none", "director_inbox", "route_to_process", "needs_operator"] },
        "fallback_if_no_director": { "enum": ["needs_operator", "fail_validation"] }
      },
      "additionalProperties": true
    },
    "evolve": {
      "type": "object",
      "required": ["enabled", "decision"],
      "properties": {
        "enabled": { "type": "boolean" },
        "decision": {
          "type": "object",
          "required": ["value", "reason"],
          "properties": {
            "value": { "enum": ["enabled", "disabled"] },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "mode": { "enum": ["disabled", "optional", "required"] },
        "timing": { "enum": ["end_of_stage", "end_of_task", "end_of_run"] },
        "default_scope": { "enum": ["project", "workplace", "package", "platform", "core"] },
        "candidate_targets": {
          "type": "array",
          "items": { "enum": ["knowledge_package", "template_package", "process_definition", "delivery_profile", "project_rule", "workplace_rule", "platform_contract", "core_docs", "core_schema", "regression_check"] }
        },
        "candidate_targeting": {
          "type": "object",
          "properties": {
            "ask_target_layer": { "type": "boolean" },
            "ask_applicability": { "type": "boolean" },
            "ask_not_applicable": { "type": "boolean" },
            "ask_generalization_level": { "type": "boolean" },
            "default_to_narrowest_scope": { "type": "boolean" },
            "default_scope": { "enum": ["project", "workplace", "package", "platform", "parent_platform", "platform_family", "process", "core"] },
            "require_applicability": { "type": "boolean" },
            "require_target": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "extraction_hints": { "type": "array", "items": { "type": "string" } },
        "prompts": { "type": "array", "items": { "type": "string" } },
        "required_outputs": { "type": "array", "items": { "type": "string" } },
        "privacy": { "type": "object", "additionalProperties": true },
        "apply_policy": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "roles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "stages": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "gates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "required_capabilities": { "type": "array", "items": { "type": "string" } },
    "required_packages": { "type": "array", "items": { "type": "string" } },
    "required_templates": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "process_transitions": {
      "type": ["object", "array"],
      "properties": {
        "can_handoff": { "type": "boolean" },
        "routes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "offline_agent_policy": { "type": "string" },
        "continuation_capsule_required": { "type": "boolean" },
        "post_handoff_run_owner": { "type": "string" }
      },
      "items": { "type": "object", "additionalProperties": true },
      "additionalProperties": true
    },
    "agent_requirements": {
      "type": "object",
      "properties": {
        "required_role": { "type": "string" },
        "required_capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "responsibility_boundaries": {
      "type": "object",
      "properties": {
        "coordinator_role": { "type": "string" },
        "execution_inspector_role": { "type": "string" },
        "worker_role": { "type": "string" },
        "needs_agent_director": { "type": "boolean" },
        "needs_execution_inspector": { "type": "boolean" },
        "director_decisions": { "type": "array", "items": { "type": "string" } },
        "inspector_checks": { "type": "array", "items": { "type": "string" } },
        "worker_actions": { "type": "array", "items": { "type": "string" } },
        "automatic_cli_checks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "subagent_policy": {
      "type": "object",
      "properties": {
        "allowed": { "type": "boolean" },
        "require_reports": { "type": "boolean" },
        "worker_shell_agents_may_call_subagents": { "type": "boolean" },
        "allowed_roles": { "type": "array", "items": { "type": "string" } },
        "required_reports": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "runtime_requirements": { "type": "object", "additionalProperties": true },
    "stage_completion": { "type": "object", "additionalProperties": true },
    "run_completion": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
