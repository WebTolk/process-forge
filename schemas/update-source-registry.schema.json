{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/update-source-registry.schema.json",
  "title": "ProcessForge Global Bootstrap Update Source Registry",
  "type": "object",
  "required": ["schema_version", "product", "sources"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "product": { "const": "processforge" },
    "updated_at": { "type": ["string", "null"] },
    "defaults": {
      "type": "object",
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "cache_ttl_seconds": { "type": "integer", "minimum": 0 },
        "require_https": { "type": "boolean" },
        "require_sha256_for_download": { "type": "boolean" },
        "require_sha256_for_install": { "type": "boolean" },
        "require_signature_for_install": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "envRef": { "type": "string", "pattern": "^([A-Z_][A-Z0-9_]*|\\$\\{[A-Z_][A-Z0-9_]*\\}|(auth_ref|secret_ref):[A-Za-z0-9][A-Za-z0-9_.-]*)$" },
    "remoteUrl": { "type": "string", "pattern": "^https?://[^\\s/?#]+[^\\s]*$" },
    "subjectType": {
      "enum": [
        "*",
        "processforge_distribution",
        "workplace",
        "process_package",
        "knowledge_package",
        "template_package",
        "tool_package",
        "tool_definition",
        "mcp_definition",
        "knowledge_resource",
        "process_definition",
        "reusable_template",
        "platform_contract",
        "project_pf",
        "template",
        "tool",
        "mcp_server",
        "package"
      ]
    },
    "subjectFilter": {
      "type": "object",
      "required": ["type", "ids"],
      "properties": {
        "type": { "$ref": "#/$defs/subjectType" },
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "assetPatterns": {
      "type": "object",
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "trust": {
      "type": "object",
      "properties": {
        "require_https": { "type": "boolean" },
        "require_sha256_for_install": { "type": "boolean" },
        "require_signature_for_install": { "type": "boolean" },
        "trusted_signers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["manifest_url", "changelog_url"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "manifest_url": { "type": "string", "minLength": 1 },
        "changelog_url": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "api_base_url": { "$ref": "#/$defs/remoteUrl" },
        "channels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "include_prereleases": { "type": "boolean" },
        "subjects": { "type": "array", "items": { "$ref": "#/$defs/subjectFilter" } },
        "asset_patterns": { "$ref": "#/$defs/assetPatterns" },
        "auth": { "type": "object", "additionalProperties": true },
        "auth_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "query_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "custom_headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "trust": { "$ref": "#/$defs/trust" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
