{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/private-resource-paths-registry.schema.json",
  "title": "Private Resource Paths Registry",
  "type": "object",
  "required": ["schema_version", "private_resource_paths"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "private_resource_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "label", "path", "visibility", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "visibility": { "const": "private" },
        "status": { "enum": ["available", "missing", "disabled"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
