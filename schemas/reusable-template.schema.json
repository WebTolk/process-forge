{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/reusable-template.schema.json",
  "title": "Reusable Template Manifest",
  "type": "object",
  "required": ["schema_version", "type", "id", "title", "kind", "version", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "type": { "const": "reusable_template" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["document", "scaffold", "prompt", "assignment", "media_prompt"] },
    "version": { "type": "string", "minLength": 1 },
    "source_package": { "$ref": "#/$defs/id" },
    "description": { "type": "string" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "prompts": { "type": "array", "items": { "$ref": "#/$defs/prompt" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "update_sites": { "type": "array", "items": { "$ref": "#/$defs/updateSite" } }
  },
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "input": {
      "type": "object",
      "required": ["id", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "file": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "prompt": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "envRef": {
      "type": "string",
      "pattern": "^([A-Z_][A-Z0-9_]*|\\$\\{[A-Z_][A-Z0-9_]*\\}|(auth_ref|secret_ref):[A-Za-z0-9][A-Za-z0-9_.-]*)$"
    },
    "remoteUrl": { "type": "string", "pattern": "^https?://[^\\s/?#]+[^\\s]*$" },
    "updateSite": {
      "type": "object",
      "required": ["manifest_url", "changelog_url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "manifest_url": { "type": "string", "minLength": 1 },
        "changelog_url": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "api_base_url": { "$ref": "#/$defs/remoteUrl" },
        "channels": { "type": "array", "items": { "type": "string" } },
        "include_prereleases": { "type": "boolean" },
        "asset_patterns": { "type": "object", "additionalProperties": true },
        "auth_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "query_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "custom_headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "trust": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  }
}
