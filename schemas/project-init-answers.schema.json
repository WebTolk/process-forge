{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/project-init-answers.schema.json",
  "title": "Project Init Answers",
  "type": "object",
  "required": ["schema_version", "project"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "type_hint": { "type": "string" },
        "platform": { "type": "string" },
        "platform_hint": { "type": "string" },
        "mode": { "enum": ["greenfield", "brownfield", "auto"] }
      },
      "additionalProperties": true
    },
    "intake": { "type": "object", "additionalProperties": true },
    "coordination": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["inherit", "simple", "organized"] },
        "director": {
          "type": "object",
          "properties": {
            "use_workplace_director": { "type": "boolean" },
            "inbox_submit_required": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "required_capabilities": { "type": "array", "items": { "type": "string" } },
    "optional_capabilities": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
