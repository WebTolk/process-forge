{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/agent-registry.schema.json",
  "title": "Agent Registry",
  "type": "object",
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "roles", "capabilities"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "supports_specializations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$" }
  },
  "additionalProperties": true
}
