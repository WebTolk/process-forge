{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/package-manifest.schema.json",
  "title": "Knowledge Package Manifest",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "kind", "scope"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "kind": { "enum": ["core", "organization", "direction", "specialization", "platform", "toolchain", "documentation", "project", "process", "task", "agent_profile"] },
    "scope": { "type": "string" },
    "package_root": { "type": "string" },
    "description": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "rules": { "type": "array", "items": { "type": "object" } },
    "templates": { "type": "array", "items": { "type": "string" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "tools": { "type": "array", "items": { "type": "object" } },
    "mcp_servers": { "type": "array", "items": { "type": "object" } },
    "validation": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "resource": {
      "type": "object",
      "required": ["id", "kind", "title", "load_policy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path_ref": { "type": "object", "additionalProperties": true },
        "path_status": { "type": "string" },
        "load_policy": { "type": "string", "minLength": 1 },
        "index_policy": { "type": "string" },
        "license": { "type": "object", "additionalProperties": true },
        "source": { "type": "object", "additionalProperties": true },
        "update_policy": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
