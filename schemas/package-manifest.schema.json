{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/package-manifest.schema.json",
  "title": "Knowledge Package Manifest",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "kind", "scope"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "kind": { "enum": ["core", "organization", "direction", "specialization", "platform", "toolchain", "documentation", "project", "process", "task", "agent_profile"] },
    "scope": { "type": "string" },
    "package_root": { "type": "string" },
    "description": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "rules": { "type": "array", "items": { "type": "object" } },
    "templates": { "type": "array", "items": { "type": "string" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "tools": { "type": "array", "items": { "type": "object" } },
    "mcp_servers": { "type": "array", "items": { "type": "object" } },
    "update_sites": { "type": "array", "items": { "$ref": "#/$defs/updateSite" } },
    "validation": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "envRef": { "type": "string", "pattern": "^([A-Z_][A-Z0-9_]*|\\$\\{[A-Z_][A-Z0-9_]*\\}|(auth_ref|secret_ref):[A-Za-z0-9][A-Za-z0-9_.-]*)$" },
    "remoteUrl": { "type": "string", "pattern": "^https?://[^\\s/?#]+[^\\s]*$" },
    "updateSite": {
      "type": "object",
      "required": ["id", "enabled", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "url": { "$ref": "#/$defs/remoteUrl" },
        "path": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "api_base_url": { "$ref": "#/$defs/remoteUrl" },
        "channels": { "type": "array", "items": { "type": "string" } },
        "include_prereleases": { "type": "boolean" },
        "asset_patterns": { "type": "object", "additionalProperties": true },
        "auth_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "query_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "custom_headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "trust": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["id", "kind", "title", "load_policy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path_ref": { "type": "object", "additionalProperties": true },
        "path_status": { "type": "string" },
        "load_policy": { "type": "string", "minLength": 1 },
        "index_policy": { "type": "string" },
        "license": { "type": "object", "additionalProperties": true },
        "source": { "type": "object", "additionalProperties": true },
        "update_policy": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
