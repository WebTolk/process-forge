            },
            "writer": {
              "type": "boolean"
            },
            "owned_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "owned_globs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "non_overlap": {
          "type": "object",
          "additionalProperties": true
        },
        "execution_mode": {
          "type": "object",
          "required": [
            "kind",
            "code_changes_allowed",
            "artifact_changes_allowed",
            "requires_review"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "code_changes_allowed": {
              "type": "boolean"
            },
            "artifact_changes_allowed": {
              "type": "boolean"
            },
            "requires_review": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "outputs": {
          "type": "object",
          "required": [
            "required_outputs",
            "expected_report"
          ],
          "properties": {
            "required_outputs": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": true
                  }
                ]
              }
            },
            "expected_report": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "scope": {
          "type": "object",
          "required": [
            "allowed_files",
            "allowed_read_files",
            "forbidden_files",
            "allowed_actions",
            "forbidden_actions",
