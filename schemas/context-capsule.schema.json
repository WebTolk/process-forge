{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/context-capsule.schema.json",
  "title": "Context Capsule",
  "type": "object",
  "required": ["schema_version", "capsule", "assignment", "context"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "capsule": {
      "type": "object",
      "required": ["id", "worker_may_rebuild_context"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ecp": { "type": "string" },
        "generated_at": { "type": "string" },
        "assignment_id": { "type": "string" },
        "assignment_path": { "type": "string" },
        "assignment_checksum": { "type": "string" },
        "snapshot": { "type": "string" },
        "snapshot_checksum": { "type": "string" },
        "immutable": { "type": "boolean" },
        "worker_may_rebuild_context": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "assignment": { "type": "object", "additionalProperties": true },
    "context_snapshot": {
      "type": "object",
      "required": ["id", "sha256", "freshness_at_creation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 },
        "generated_at": { "type": ["string", "null"] },
        "freshness_at_creation": { "enum": ["fresh", "fresh_with_updates", "stale", "broken"] }
      },
      "additionalProperties": true
    },
    "project_classification": { "type": "object", "additionalProperties": true },
    "resolved_resources": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "effective_specializations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "project_override_summary": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "active_resource_profile": { "type": "object", "additionalProperties": true },
    "execution_route_summary": { "type": "object", "additionalProperties": true },
    "capability_resolution_summary": { "type": "object", "additionalProperties": true },
    "effective_resources": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "context": {
      "type": "object",
      "properties": {
        "snapshot_id": { "type": "string" },
        "freshness": { "type": "string" },
        "required_sources": { "type": "array", "items": { "type": "string" } },
        "context_artifacts": { "type": "array", "items": { "$ref": "#/$defs/context_artifact" } },
        "selected_specializations": { "type": "array", "items": { "type": "string" } },
        "applied_project_overrides": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_files": { "type": "array", "items": { "type": "string" } },
        "allowed_read_files": { "type": "array", "items": { "type": "string" } },
        "forbidden_files": { "type": "array", "items": { "type": "string" } },
        "ownership": { "$ref": "#/$defs/ownership" },
        "non_overlap": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "properties": {
        "required_outputs": { "type": "array", "items": { "$ref": "#/$defs/required_output" } },
        "expected_report": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "optional": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "required_sources": { "type": "array", "items": { "type": "string" } },
    "allowed_files": { "type": "array", "items": { "type": "string" } },
    "forbidden_files": { "type": "array", "items": { "type": "string" } },
    "required_outputs": { "type": "array", "items": { "$ref": "#/$defs/required_output" } },
    "required_capabilities": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "optional_capabilities": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "selected_sources": { "type": "array", "items": { "type": "string" } },
    "telemetry": { "type": "object", "additionalProperties": true },
    "event_correlation_id": { "type": "string" },
    "allowed_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "context_artifact": {
      "type": ["object", "string"],
      "properties": {
        "path": { "type": "string" },
        "role": { "type": "string" },
        "required": { "type": "boolean" },
        "mutable_by_worker": { "type": "boolean" },
        "checksum": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ownership": {
      "type": "object",
      "properties": {
        "owner_id": { "type": "string" },
        "owner_label": { "type": "string" },
        "role": { "type": "string" },
        "writer": { "type": "boolean" },
        "owned_files": { "type": "array", "items": { "type": "string" } },
        "owned_globs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "required_output": {
      "type": ["object", "string"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
