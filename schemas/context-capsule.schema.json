{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/context-capsule.schema.json",
  "title": "Context Capsule",
  "type": "object",
  "required": [
    "schema_version",
    "capsule",
    "assignment",
    "context"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "capsule": {
      "type": "object",
      "required": [
        "id",
        "worker_may_rebuild_context"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ecp": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "assignment_id": {
          "type": "string"
        },
        "assignment_path": {
          "type": "string"
        },
        "assignment_checksum": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "snapshot_checksum": {
          "type": "string"
        },
        "immutable": {
          "type": "boolean"
        },
        "worker_may_rebuild_context": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "assignment": {
      "type": "object",
      "additionalProperties": true
    },
    "resource_bindings": {
      "$ref": "#/$defs/resource_bindings"
    },
    "execution_contract": {
      "$ref": "#/$defs/execution_contract"
    },
    "context_snapshot": {
      "type": "object",
      "required": [
        "id",
        "sha256",
        "freshness_at_creation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "freshness_at_creation": {
          "enum": [
            "fresh",
            "fresh_with_updates",
            "stale",
            "broken"
          ]
        }
      },
      "additionalProperties": true
    },
    "project_classification": {
      "type": "object",
      "additionalProperties": true
    },
    "resolved_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "resolved_parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "parameter_resolution_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "effective_specializations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "project_override_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "active_resource_profile": {
      "type": "object",
      "additionalProperties": true
    },
    "execution_route_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "capability_resolution_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "effective_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "required_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context_artifact"
          }
        },
        "selected_specializations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applied_project_overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_read_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "non_overlap": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "properties": {
        "required_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/required_output"
          }
        },
        "expected_report": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "required_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/required_output"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "optional_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "selected_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": true
    },
    "event_correlation_id": {
      "type": "string"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "execution_contract": {
      "description": "Complete versioned immutable assignment intent and worker permission block. The context capsule schema leaves this block optional for legacy capsules.",
      "type": "object",
      "required": [
        "contract_version",
        "identity",
        "assignment_intent",
        "assignment_intent_checksum",
        "snapshot",
        "process",
        "resources",
        "scope",
        "required_sources",
        "outputs",
        "capabilities",
        "workspace_access",
        "parameters",
        "coordination",
        "source_limits",
        "readiness",
        "worker_may_rebuild_context",
        "contract_checksum"
      ],
      "properties": {
        "contract_version": {
          "enum": [
            1,
            2
          ]
        },
        "identity": {
          "type": "object",
          "required": [
            "kind",
            "project_id",
            "run_id",
            "assignment_id",
            "context_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "work",
                "assignment"
              ]
            },
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "run_id": {
              "type": "string"
            },
            "assignment_id": {
              "type": "string",
              "minLength": 1
            },
            "context_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "assignment_intent": {
          "$ref": "#/$defs/execution_contract/$defs/assignment_intent"
        },
        "assignment_intent_checksum": {
          "$ref": "#/$defs/execution_contract/$defs/digest"
        },
        "snapshot": {
          "type": "object",
          "required": [
            "id",
            "checksum"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "checksum": {
              "$ref": "#/$defs/execution_contract/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "required": [
            "id",
            "version",
            "fingerprint"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^(?:sha256:[a-f0-9]{64})?$"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "required": [
            "selected_ids",
            "bindings_checksum"
          ],
          "properties": {
            "selected_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bindings_checksum": {
              "$ref": "#/$defs/execution_contract/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        "scope": {
          "$ref": "#/$defs/execution_contract/$defs/scope"
        },
        "required_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/execution_contract/$defs/required_source"
          }
        },
        "outputs": {
          "$ref": "#/$defs/execution_contract/$defs/outputs"
        },
        "capabilities": {
          "type": "object",
          "required": [
            "required",
            "optional"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/execution_contract/$defs/capability"
              }
            },
            "optional": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/execution_contract/$defs/capability"
              }
            }
          },
          "additionalProperties": false
        },
        "workspace_access": {
          "type": "object",
          "additionalProperties": {
            "type": "array"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "coordination": {
          "type": "object",
          "additionalProperties": true
        },
        "worker_may_rebuild_context": {
          "const": false
        },
        "source_limits": {
          "type": "object",
          "required": [
            "files",
            "file_bytes",
            "total_bytes"
          ],
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 1
            },
            "file_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "total_bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "required": [
            "status",
            "blockers"
          ],
          "properties": {
            "status": {
              "enum": [
                "ready",
                "blocked"
              ]
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": false
        },
        "contract_checksum": {
          "$ref": "#/$defs/execution_contract/$defs/digest"
        },
        "egress": {
          "type": "object",
          "required": [
            "policy_id",
            "recipient",
            "purpose",
            "policy_checksum",
            "detector_checksum",
            "minimum_enforcement",
            "limits"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "recipient": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "purpose": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "policy_checksum": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "detector_checksum": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minimum_enforcement": {
              "const": "mediated_session"
            },
            "limits": {
              "type": "object",
              "required": [
                "unit_bytes",
                "envelope_bytes",
                "attempt_bytes",
                "disclosures",
                "json_depth",
                "classification_ms",
                "token_seconds"
              ],
              "properties": {
                "unit_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                "envelope_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4194304
                },
                "attempt_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 33554432
                },
                "disclosures": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 128
                },
                "json_depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "classification_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "token_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "$defs": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "ownership": {
          "type": "object",
