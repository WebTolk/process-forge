{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/platform-contract.schema.json",
  "title": "Platform Contract",
  "type": "object",
  "required": ["schema_version", "id", "type", "version"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "platform_contract" },
    "version": { "type": "string", "minLength": 1 },
    "extends": {
      "type": "array",
      "items": { "$ref": "#/$defs/platformRef" }
    },
    "applies_to": { "type": "object", "additionalProperties": true },
    "requires": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platformRef" }
        }
      },
      "additionalProperties": true
    },
    "includes": { "type": "object", "additionalProperties": true },
    "parameters": { "type": "object", "additionalProperties": true },
    "update_sites": { "type": "array", "items": { "$ref": "#/$defs/updateSite" } },
    "policies": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "envRef": { "type": "string", "pattern": "^([A-Z_][A-Z0-9_]*|\\$\\{[A-Z_][A-Z0-9_]*\\}|(auth_ref|secret_ref):[A-Za-z0-9][A-Za-z0-9_.-]*)$" },
    "remoteUrl": { "type": "string", "pattern": "^https?://[^\\s/?#]+[^\\s]*$" },
    "updateSite": {
      "type": "object",
      "required": ["manifest_url", "changelog_url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "manifest_url": { "type": "string", "minLength": 1 },
        "changelog_url": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "api_base_url": { "$ref": "#/$defs/remoteUrl" },
        "channels": { "type": "array", "items": { "type": "string" } },
        "include_prereleases": { "type": "boolean" },
        "asset_patterns": { "type": "object", "additionalProperties": true },
        "auth_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "query_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "custom_headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "trust": { "type": "object", "additionalProperties": true },
        "policy": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "platformRef": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "required": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
