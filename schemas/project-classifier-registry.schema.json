{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/project-classifier-registry.schema.json",
  "title": "ProcessForge Project Classifier Registry",
  "type": "object",
  "required": ["schema_version", "project_classifiers"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project_classifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "disabled"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
