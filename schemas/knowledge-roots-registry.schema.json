{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/knowledge-roots-registry.schema.json",
  "title": "Knowledge Roots Registry",
  "type": "object",
  "required": ["schema_version", "knowledge_roots"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "knowledge_roots": {
      "type": "array",
      "items": { "$ref": "#/$defs/rootItem" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$" },
    "rootItem": {
      "type": "object",
      "required": ["id", "label", "path", "scope", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "scope": { "type": "string" },
        "visibility": { "enum": ["public", "private"] },
        "indexing_policy": { "enum": ["allowed", "blocked", "manual"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
