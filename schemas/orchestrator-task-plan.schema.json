{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/orchestrator-task-plan.schema.json",
  "title": "Orchestrator Task Plan",
  "type": "object",
  "required": ["schema_version", "run", "orchestrator", "workers", "integration"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "run": {
      "type": "object",
      "required": ["id", "title", "process"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "process": { "const": "multi-agent-task-orchestration" },
        "objective": { "type": "string" }
      },
      "additionalProperties": true
    },
    "orchestrator": { "type": "object", "additionalProperties": true },
    "workers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/worker" } },
    "integration": { "type": "object", "required": ["required", "role", "expected_output"], "additionalProperties": true },
    "allow_write_scope_overlap": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$" },
    "required_output": {
      "type": "object",
      "required": ["id", "path", "type", "required"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "worker": {
      "type": "object",
      "required": ["id", "title", "role", "execution_mode", "writer", "allowed_files", "allowed_read_files", "forbidden_files", "required_outputs", "expected_report_artifact"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "process": { "type": "string" },
        "execution_mode": { "type": "string" },
        "writer": { "type": "boolean" },
        "allowed_files": { "type": "array", "items": { "type": "string" } },
        "allowed_read_files": { "type": "array", "items": { "type": "string" } },
        "forbidden_files": { "type": "array", "items": { "type": "string" } },
        "required_sources": { "type": "array", "items": { "type": "string" } },
        "context_artifacts": { "type": "array", "items": { "type": ["string", "object"] } },
        "required_outputs": { "type": "array", "items": { "$ref": "#/$defs/required_output" } },
        "expected_report_artifact": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "worker_may_rebuild_context": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
