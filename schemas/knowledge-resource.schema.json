{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/knowledge-resource.schema.json",
  "title": "Knowledge Resource",
  "type": "object",
  "required": ["id", "kind", "title", "load_policy"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "source_tree",
        "documentation",
        "article",
        "article_collection",
        "note",
        "note_collection",
        "snippet",
        "snippet_collection",
        "example",
        "example_collection",
        "reference",
        "dataset"
        ,"media_reference"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "path_ref": { "type": "object", "additionalProperties": true },
    "path_status": { "type": "string" },
    "version": { "type": "string" },
    "load_policy": {
      "enum": ["always_index", "project_init", "session_start", "when_relevant", "on_demand", "never_auto_load"]
    },
    "index_policy": { "type": "string" },
    "description": { "type": "string" },
    "license": { "type": "object", "additionalProperties": true },
    "source": { "type": "object", "additionalProperties": true },
    "update_policy": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
