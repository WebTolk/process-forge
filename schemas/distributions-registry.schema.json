{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/distributions-registry.schema.json",
  "title": "ProcessForge Distributions Registry",
  "type": "object",
  "required": ["schema_version", "distributions"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "distributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "version", "channel", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "missing", "disabled"] },
          "provides": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
