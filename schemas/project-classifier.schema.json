{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/project-classifier.schema.json",
  "title": "ProcessForge Project Classifier",
  "type": "object",
  "required": ["schema_version", "kind", "id", "name", "status", "rules"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "kind": { "const": "processforge.project_classifier" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "disabled"] },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "condition": {
      "type": "object",
      "required": ["exists"],
      "properties": {
        "exists": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "when": {
      "type": "object",
      "oneOf": [
        {
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "classification": {
      "type": "object",
      "properties": {
        "project_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "when", "classify_as", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "when": { "$ref": "#/$defs/when" },
        "classify_as": { "$ref": "#/$defs/classification" },
        "confidence": { "enum": ["low", "medium", "high"] }
      },
      "additionalProperties": false
    }
  }
}
