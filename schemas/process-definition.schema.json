{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/process-definition.schema.json",
  "title": "Process Definition",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "description",
    "stages",
    "roles",
    "artifact_definitions",
    "gates",
    "evolution_policy"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "deprecated", "archived"] },
    "description": { "type": "string" },
    "required_capabilities": { "type": "array", "items": { "type": "string" } },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "responsibility": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "artifact_definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactType" }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "type": "string" },
          "blocking": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "required_packages": { "type": "array", "items": { "type": "string" } },
    "required_templates": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "evolution_policy": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "stage": {
      "type": "object",
      "required": ["id", "title", "required_role", "produced_artifacts", "exit_gates"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "required_inputs": { "type": "array", "items": { "type": "string" } },
        "produced_artifacts": { "type": "array", "items": { "type": "string" } },
        "required_role": { "$ref": "#/$defs/id" },
        "required_capabilities": { "type": "array", "items": { "type": "string" } },
        "allowed_tools": { "type": "array", "items": { "type": "string" } },
        "entry_gates": { "type": "array", "items": { "type": "string" } },
        "exit_gates": { "type": "array", "items": { "type": "string" } },
        "handoff_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "artifactType": {
      "type": "object",
      "required": ["id", "title", "owner_role", "lifecycle"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "owner_role": { "$ref": "#/$defs/id" },
        "template": { "type": "string" },
        "lifecycle": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
