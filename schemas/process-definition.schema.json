{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/process-definition.schema.json",
  "title": "Process Definition",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "status",
    "description",
    "stages",
    "roles",
    "artifact_definitions",
    "gates",
    "evolution_policy"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "experimental", "internal", "deprecated", "archived"] },
    "kind": { "type": "string" },
    "scope": { "type": "string" },
    "purpose": { "type": "string" },
    "public_surface": { "type": "boolean" },
    "catalog": {
      "type": "object",
      "properties": {
        "classification": { "enum": ["PUBLIC_STABLE", "PUBLIC_EXPERIMENTAL", "INTERNAL_MAINTENANCE", "EXAMPLE_ONLY", "DEPRECATED"] },
        "public_surface": { "type": "boolean" },
        "strict_contract": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "process_pack": {
      "type": "object",
      "properties": {
        "package": { "type": "string" },
        "example_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "agent_prompt": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "execution_mode": { "enum": ["single_agent", "single_agent_with_subagents", "orchestrated_agents", "process_factory"] },
    "execution_mode_questions": { "type": "object", "additionalProperties": true },
    "coordination_requirements": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["simple_allowed", "organized_required", "organized_optional"] },
        "director_inbox": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "optional": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "error_workflow": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["none", "director_inbox", "route_to_process", "needs_operator"] }
          },
          "additionalProperties": true
        },
        "simple_mode_behavior": { "enum": ["disable_director_features", "optional", "fail_validation", "allow_no_director"] }
      },
      "additionalProperties": true
    },
    "error_handling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["none", "director_inbox", "route_to_process", "needs_operator"] },
        "fallback_if_no_director": { "enum": ["needs_operator", "fail_validation"] }
      },
      "additionalProperties": true
    },
    "responsibility_boundaries": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "run_model": { "type": "object", "additionalProperties": true },
    "expected_artifacts": { "type": "array", "items": { "anyOf": [{ "type": "string" }, { "type": "object", "additionalProperties": true }] } },
    "process_transitions": { "type": ["array", "object"], "additionalProperties": true },
    "agent_requirements": { "type": "object", "additionalProperties": true },
    "subagent_policy": { "type": "object", "additionalProperties": true },
    "runtime_requirements": { "type": "object", "additionalProperties": true },
    "runtime_execution_boundary": { "type": "object", "additionalProperties": true },
    "stage_completion": { "type": "object", "additionalProperties": true },
    "run_completion": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true },
    "input_definitions": { "type": "object", "additionalProperties": true },
    "external_artifacts": { "type": "object", "additionalProperties": true },
    "virtual_artifacts": { "type": "object", "additionalProperties": true },
    "generated_files": { "type": "object", "additionalProperties": true },
    "description": { "type": "string" },
    "required_capabilities": { "type": "array", "items": { "type": "string" } },
    "hooks": { "$ref": "#/$defs/processHooks" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
          "required": ["id", "title"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "title": { "type": "string" },
            "kind": { "enum": ["human", "primary_agent", "worker_agent", "director_agent", "inspector", "cli_check"] },
            "responsibility": { "type": "string" },
            "responsibilities": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "artifact_definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactType" }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "type": "string" },
          "blocking": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "required_packages": { "type": "array", "items": { "type": "string" } },
    "required_templates": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "update_sites": { "type": "array", "items": { "$ref": "#/$defs/updateSite" } },
    "evolution_policy": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "envRef": { "type": "string", "pattern": "^([A-Z_][A-Z0-9_]*|\\$\\{[A-Z_][A-Z0-9_]*\\}|(auth_ref|secret_ref):[A-Za-z0-9][A-Za-z0-9_.-]*)$" },
    "remoteUrl": { "type": "string", "pattern": "^https?://[^\\s/?#]+[^\\s]*$" },
    "updateSite": {
      "type": "object",
      "required": ["id", "enabled", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "url": { "$ref": "#/$defs/remoteUrl" },
        "path": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "api_base_url": { "$ref": "#/$defs/remoteUrl" },
        "channels": { "type": "array", "items": { "type": "string" } },
        "include_prereleases": { "type": "boolean" },
        "asset_patterns": { "type": "object", "additionalProperties": true },
        "auth_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "query_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "custom_headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "trust": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "stage": {
      "type": "object",
      "required": ["id", "title", "required_role", "produced_artifacts", "exit_gates"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "goal": { "type": "string" },
        "description": { "type": "string" },
        "actor": { "enum": ["primary_agent", "director_agent", "worker_agent", "cli_tool", "operator"] },
        "required_inputs": { "type": "array", "items": { "type": "string" } },
        "produced_artifacts": { "type": "array", "items": { "type": "string" } },
        "required_role": { "$ref": "#/$defs/id" },
        "required_capabilities": { "type": "array", "items": { "type": "string" } },
        "allowed_tools": { "type": "array", "items": { "type": "string" } },
        "entry_gates": { "type": "array", "items": { "type": "string" } },
        "exit_gates": { "type": "array", "items": { "type": "string" } },
        "hooks": { "$ref": "#/$defs/stageHooks" },
        "gates": { "type": "array", "items": { "type": "string" } },
        "handoff_required": { "type": "boolean", "deprecated": true }
      },
      "additionalProperties": true
    },
    "artifactType": {
      "type": "object",
      "required": ["id", "title", "owner_role", "lifecycle"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "owner_role": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "template": { "type": "string" },
        "path_hint": { "type": "string" },
        "lifecycle": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "processHooks": {
      "type": "object",
      "properties": {
        "emit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event"],
            "properties": {
              "event": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event", "actions"],
            "properties": {
              "event": { "type": "string", "minLength": 1 },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": { "type": { "type": "string", "minLength": 1 } },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "tracking": {
          "type": "object",
          "properties": { "include": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "stageHooks": {
      "type": "object",
      "properties": {
        "emit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "stop_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": { "type": "string", "minLength": 1 },
              "require": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "patternProperties": {
    "^x_": true
  },
  "additionalProperties": false
}
