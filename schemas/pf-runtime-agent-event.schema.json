{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/pf-runtime-agent-event.schema.json",
  "title": "ProcessForge Runtime Agent Event Input",
  "type": "object",
  "required": ["schema_version", "event_type"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "adapter": { "type": "string" },
    "project_root": { "type": "string" },
    "cwd": { "type": "string" },
    "agent_id": { "type": "string" },
    "session_id": { "type": "string" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "role": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": { "type": "string" },
        "agent": { "type": "string" },
        "session_id": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
