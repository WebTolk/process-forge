{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/assignment.schema.json",
  "title": "Assignment",
  "type": "object",
  "required": ["schema_version", "id", "title", "run_id", "process", "status", "iterations", "result"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string" },
    "role": { "type": "string" },
    "process": {
      "type": ["object", "string"],
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string" }
      }
    },
    "platform": { "type": "string" },
    "selected_specializations": { "type": "array", "items": { "type": "string" } },
    "required_specializations": { "type": "array", "items": { "type": "string" } },
    "run_id": { "$ref": "#/$defs/id" },
    "stage": { "$ref": "#/$defs/id" },
    "goal": { "type": "string" },
    "objective": { "type": "string" },
    "order": { "type": "integer", "minimum": 1 },
    "dependencies": { "type": "object", "additionalProperties": true },
    "iterations": { "type": "array", "items": { "$ref": "#/$defs/iteration" } },
    "result": { "$ref": "#/$defs/result" },
    "input_artifacts": { "type": "array", "items": { "type": "string" } },
    "execution_mode": { "$ref": "#/$defs/execution_mode" },
    "context_artifacts": { "type": "array", "items": { "$ref": "#/$defs/context_artifact" } },
    "required_sources": { "type": "array", "items": { "type": "string" } },
    "parameters": { "type": "object", "additionalProperties": true },
    "allowed_files": { "type": "array", "items": { "type": "string" } },
    "allowed_read_files": { "type": "array", "items": { "type": "string" } },
    "forbidden_files": { "type": "array", "items": { "type": "string" } },
    "ownership": { "$ref": "#/$defs/ownership" },
    "non_overlap": { "$ref": "#/$defs/non_overlap" },
    "required_outputs": { "type": "array", "items": { "$ref": "#/$defs/required_output" } },
    "expected_report": { "$ref": "#/$defs/expected_report" },
    "subagent_policy": { "$ref": "#/$defs/subagent_policy" },
    "required_artifacts": { "type": "array", "items": { "type": "string" } },
    "required_reviews": { "type": "array", "items": { "type": "string" } },
    "allowed_templates": { "type": "array", "items": { "type": "string" } },
    "allowed_tools": { "type": "array", "items": { "type": "string" } },
    "quality_checklist": { "type": "array", "items": { "type": "string" } },
    "completion_criteria": { "type": "array", "items": { "type": "string" } },
    "log_file": { "type": "string" },
    "handoff_requirements": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["open", "in_progress", "blocked", "debugging", "review", "done", "cancelled", "failed"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$|^[0-9]{4}-[0-9]{2}-[0-9]{2}[a-z0-9-]*$" },
    "context_artifact": {
      "type": ["object", "string"],
      "properties": {
        "path": { "type": "string" },
        "role": { "type": "string" },
        "required": { "type": "boolean" },
        "mutable_by_worker": { "type": "boolean" },
        "checksum": { "type": "string" }
      },
      "additionalProperties": true
    },
    "execution_mode": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["read_only", "planning_only", "docs_only", "implementation", "assurance", "release_delivery"] },
        "code_changes_allowed": { "type": "boolean" },
        "artifact_changes_allowed": { "type": "boolean" },
        "requires_review": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "ownership": {
      "type": "object",
      "properties": {
        "owner_id": { "type": "string" },
        "owner_label": { "type": "string" },
        "role": { "type": "string" },
        "writer": { "type": "boolean" },
        "owned_files": { "type": "array", "items": { "type": "string" } },
        "owned_globs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "non_overlap": {
      "type": "object",
      "properties": {
        "policy": { "type": "string" },
        "active_parallel_task": { "type": "string" },
        "active_parallel_owner": { "type": "string" },
        "active_parallel_scope": { "type": "array", "items": { "type": "string" } },
        "active_parallel_tasks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "completed_parallel_task": { "type": "object", "additionalProperties": true },
        "current_write_scope": { "type": "array", "items": { "type": "string" } },
        "rule": { "type": "string" },
        "overlap_check": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "required_output": {
      "type": ["object", "string"],
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "expected_report": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "format": { "type": "string" },
        "include": { "type": "array", "items": { "type": "string" } },
        "artifact": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.).+" }
      },
      "additionalProperties": true
    },
    "subagent_policy": {
      "type": "object",
      "properties": {
        "allow": { "type": "boolean" },
        "max_subagents": { "type": "integer", "minimum": 0 },
        "allowed_roles": { "type": "array", "items": { "type": "string" } },
        "require_reports": { "type": "boolean" },
        "reports_dir": { "type": "string" }
      },
      "additionalProperties": true
    },
    "iteration": {
      "type": "object",
      "required": ["id", "kind", "status", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^iter-[0-9]{3}$|^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
        "kind": { "enum": ["work", "debug", "fix", "review", "test", "research", "handoff", "note"] },
        "status": { "enum": ["planned", "in_progress", "completed", "passed", "failed", "cancelled"] },
        "started_at": { "type": "string" },
        "completed_at": { "type": "string" },
        "summary": { "type": "string" },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pending", "done", "failed", "cancelled"] },
        "summary": { "type": "string" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "waivers": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
