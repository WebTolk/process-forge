{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/entity-update-sites.schema.json",
  "title": "ProcessForge Entity Update Sites",
  "type": "object",
  "required": ["update_sites"],
  "properties": {
    "update_sites": {
      "type": "array",
      "items": { "$ref": "#/$defs/updateSite" }
    }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "provider": {
      "enum": [
        "processforge_json",
        "processforge_json_file",
        "github_releases",
        "gitverse_releases",
        "gitlab_releases",
        "generic_http_directory",
        "tuf_repository"
      ]
    },
    "assetPatterns": {
      "type": "object",
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "trust": {
      "type": "object",
      "properties": {
        "require_https": { "type": "boolean" },
        "require_sha256_for_install": { "type": "boolean" },
        "require_signature_for_install": { "type": "boolean" },
        "trusted_signers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "updateSite": {
      "type": "object",
      "required": ["id", "enabled", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "type": { "$ref": "#/$defs/provider" },
        "priority": { "type": "integer" },
        "url": { "type": "string" },
        "path": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "api_base_url": { "type": "string" },
        "channels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "include_prereleases": { "type": "boolean" },
        "asset_patterns": { "$ref": "#/$defs/assetPatterns" },
        "auth_ref": { "type": "string" },
        "auth": { "type": "object", "additionalProperties": true },
        "headers_env": { "type": "object", "additionalProperties": { "type": "string" } },
        "trust": { "$ref": "#/$defs/trust" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
