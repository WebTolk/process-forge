{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/update-notifications.schema.json",
  "title": "ProcessForge Update Notifications",
  "type": "object",
  "required": ["schema_version", "notifications"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "notifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/notification" }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["type", "id", "scope"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "notification": {
      "type": "object",
      "required": ["subject", "channel", "version", "source_id", "first_seen_at", "status"],
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "channel": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "first_seen_at": { "type": "string", "minLength": 1 },
        "last_notified_at": { "type": ["string", "null"] },
        "status": { "enum": ["new", "notified", "acknowledged", "snoozed", "superseded", "withdrawn"] },
        "acknowledged_at": { "type": ["string", "null"] },
        "snoozed_until": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
