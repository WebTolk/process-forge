{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "required": ["id", "type", "title", "process", "status", "owner_role", "source_assignment", "content_reference"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "type": { "$ref": "#/$defs/id" },
    "title": { "type": "string" },
    "stable_id": { "$ref": "#/$defs/id" },
    "process": { "type": "object" },
    "status": { "enum": ["missing", "draft", "ready_for_review", "approved", "rejected", "stale", "superseded", "archived"] },
    "owner_role": { "type": "string" },
    "source_assignment": { "$ref": "#/$defs/id" },
    "content_reference": { "type": "string" },
    "checksum": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "review_status": { "type": "string" },
    "protection_policy": { "type": "string" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
  },
  "additionalProperties": true
}
