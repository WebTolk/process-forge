{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/normalized-update-manifest.schema.json",
  "title": "ProcessForge Normalized Update Manifest",
  "type": "object",
  "required": ["schema_version", "product", "generated_at", "subjects"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "product": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "channels": { "type": "object", "additionalProperties": true },
    "subjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/subject" }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["type", "id", "versions"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "versions": {
          "type": "array",
          "items": { "$ref": "#/$defs/version" }
        }
      },
      "additionalProperties": true
    },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "artifactUrl": { "type": "string", "pattern": "^(?:https?://[^\\s/?#]+[^\\s]*|file://[^\\s]+)$" },
    "version": {
      "type": "object",
      "required": ["version", "channels", "stability", "prerelease", "yanked", "source", "artifacts"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "channels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "stability": { "type": "string", "minLength": 1 },
        "prerelease": { "type": "boolean" },
        "released_at": { "type": "string" },
        "yanked": { "type": "boolean" },
        "source": { "type": "object", "additionalProperties": true },
        "release": { "type": "object", "additionalProperties": true },
        "compatibility": { "type": "object", "additionalProperties": true },
        "dependencies": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "changes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "migration": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["type", "format", "url", "sha256"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/artifactUrl" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "object", "additionalProperties": true },
        "provenance_url": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
