{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/mcp-definition.schema.json",
  "title": "MCP Definition",
  "type": "object",
  "required": ["id", "capability", "transport", "command", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "capability": { "type": "string", "minLength": 1 },
    "transport": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "auth_ref": { "type": ["string", "null"] },
    "update_sites": { "type": "array", "items": { "$ref": "#/$defs/updateSite" } },
    "status": { "enum": ["configured", "optional", "missing", "disabled"] }
  },
  "$defs": {
    "envRef": { "type": "string", "pattern": "^([A-Z_][A-Z0-9_]*|\\$\\{[A-Z_][A-Z0-9_]*\\}|(auth_ref|secret_ref):[A-Za-z0-9][A-Za-z0-9_.-]*)$" },
    "remoteUrl": { "type": "string", "pattern": "^https?://[^\\s/?#]+[^\\s]*$" },
    "updateSite": {
      "type": "object",
      "required": ["manifest_url", "changelog_url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "manifest_url": { "type": "string", "minLength": 1 },
        "changelog_url": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "api_base_url": { "$ref": "#/$defs/remoteUrl" },
        "channels": { "type": "array", "items": { "type": "string" } },
        "include_prereleases": { "type": "boolean" },
        "asset_patterns": { "type": "object", "additionalProperties": true },
        "auth_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "query_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "custom_headers_env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/envRef" } },
        "trust": { "type": "object", "additionalProperties": true },
        "policy": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
