{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/execution-contract.schema.json",
  "title": "Complete Work Execution Contract",
  "description": "Complete versioned immutable assignment intent and worker permission block. The context capsule schema leaves this block optional for legacy capsules.",
  "type": "object",
  "required": [
    "contract_version",
    "identity",
    "assignment_intent",
    "assignment_intent_checksum",
    "snapshot",
    "process",
    "resources",
    "scope",
    "required_sources",
    "outputs",
    "capabilities",
    "workspace_access",
    "parameters",
    "coordination",
    "source_limits",
    "readiness",
    "worker_may_rebuild_context",
    "contract_checksum"
  ],
  "properties": {
    "contract_version": {
      "enum": [
        1,
        2
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "kind",
        "project_id",
        "run_id",
        "assignment_id",
        "context_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "work",
            "assignment"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string"
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "assignment_intent": {
      "$ref": "#/$defs/assignment_intent"
    },
    "assignment_intent_checksum": {
      "$ref": "#/$defs/digest"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "checksum"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "required": [
        "id",
        "version",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^(?:sha256:[a-f0-9]{64})?$"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "selected_ids",
        "bindings_checksum"
      ],
      "properties": {
        "selected_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindings_checksum": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "required_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/required_source"
      }
    },
    "outputs": {
      "$ref": "#/$defs/outputs"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      },
      "additionalProperties": false
    },
    "workspace_access": {
      "type": "object",
      "additionalProperties": {
        "type": "array"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "coordination": {
      "type": "object",
      "additionalProperties": true
    },
    "worker_may_rebuild_context": {
      "const": false
    },
    "source_limits": {
      "type": "object",
      "required": [
        "files",
        "file_bytes",
        "total_bytes"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "status",
        "blockers"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "contract_checksum": {
      "$ref": "#/$defs/digest"
    },
    "egress": {
      "type": "object",
      "required": [
        "policy_id",
        "recipient",
        "purpose",
        "policy_checksum",
        "detector_checksum",
        "minimum_enforcement",
        "limits"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "recipient": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "purpose": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "policy_checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "detector_checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "minimum_enforcement": {
          "const": "mediated_session"
        },
        "limits": {
          "type": "object",
          "required": [
            "unit_bytes",
            "envelope_bytes",
            "attempt_bytes",
            "disclosures",
            "json_depth",
            "classification_ms",
            "token_seconds"
          ],
          "properties": {
            "unit_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "envelope_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "attempt_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            },
            "disclosures": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "json_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "classification_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "token_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
