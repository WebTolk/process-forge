{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/workplace.schema.json",
  "title": "Workplace Manifest",
  "type": "object",
  "required": ["schema_version", "workplace", "paths", "policies"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "workplace": {
      "type": "object",
      "required": ["id", "name", "type", "os"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["workstation", "server", "ci_host", "runner_machine", "agent_environment"] },
        "os": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "paths": { "type": "object", "additionalProperties": { "type": "string" } },
    "path_constants": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "registries": {
      "type": "object",
      "properties": {
        "distributions": { "type": "string" },
        "platforms": { "type": "string" },
        "knowledge_roots": { "type": "string" },
        "package_roots": { "type": "string" },
        "templates": { "type": "string" },
        "tools": { "type": "string" },
        "mcp": { "type": "string" },
        "update_sources": { "type": "string" },
        "installed_subjects": { "type": "string" },
        "update_site_overrides": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/capabilityProvider" } },
    "mcp_servers": { "type": "array", "items": { "$ref": "#/$defs/capabilityProvider" } },
    "policies": { "type": "object" },
    "coordination": {
      "type": "object",
      "properties": {
        "director_enabled": { "type": "boolean" },
        "director_office_enabled": { "type": "boolean" },
        "default_project_mode": { "enum": ["simple", "organized"] },
        "error_workflow_support": { "type": "boolean" },
        "director": {
          "type": "object",
          "properties": {
            "process_id": { "type": "string", "minLength": 1 },
            "scope": { "enum": ["workplace", "workspace"] },
            "office_path": { "type": "string", "minLength": 1 },
            "inbox_path": { "type": "string", "minLength": 1 },
            "outbox_path": { "type": "string", "minLength": 1 },
            "cases_path": { "type": "string", "minLength": 1 },
            "history_path": { "type": "string", "minLength": 1 },
            "runtime_path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "locked_policies": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "capabilityProvider": {
      "type": "object",
      "required": ["id", "capability"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "capability": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
