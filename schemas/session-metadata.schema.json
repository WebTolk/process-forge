{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/session-metadata.schema.json",
  "title": "Session Metadata",
  "type": "object",
  "required": ["schema_version", "session", "context", "telemetry"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "session": {
      "type": "object",
      "required": ["id", "mode", "actor_type", "role", "started_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "actor_type": { "type": "string" },
        "role": { "type": "string" },
        "started_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "required": ["project_flow_root", "snapshot", "snapshot_status"],
      "additionalProperties": true
    },
    "telemetry": {
      "type": "object",
      "required": ["events"],
      "properties": { "events": { "type": "string" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
