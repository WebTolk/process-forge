{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processforge.local/schemas/process-event.schema.json",
  "title": "Process Event",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "source", "subject", "time", "correlation_id", "project", "data"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^evt_[a-z0-9]+$" },
    "event_type": {
      "type": "string",
      "enum": [
        "session.started",
        "session.ended",
        "session.message.recorded",
        "chat.message.recorded",
        "process.started",
        "process.completed",
        "stage.started",
        "stage.completed",
        "assignment.created",
        "assignment.started",
        "assignment.completed",
        "artifact.created",
        "artifact.updated",
        "review.requested",
        "review.completed",
        "gate.passed",
        "gate.failed",
        "tool.invoked",
        "tool.failed",
        "mcp.invoked",
        "mcp.failed",
        "hook.dispatched",
        "hook.failed",
        "context.snapshot.refreshed",
        "context.snapshot.stale",
        "capability.missing",
        "run.created",
        "run.started",
        "run.updated",
        "run.summary.created",
        "run.completed",
        "run.failed",
        "run.cancelled",
        "run.doctor.passed",
        "run.doctor.failed",
        "task.created",
        "task.started",
        "task.updated",
        "task.completed",
        "task.failed",
        "task.cancelled",
        "task.doctor.passed",
        "task.doctor.failed",
        "iteration.added",
        "iteration.started",
        "iteration.completed",
        "iteration.failed",
        "process_authoring.started",
        "process_authoring.answers.created",
        "process_authoring.draft.created",
        "process_authoring.logic_review.created",
        "process_authoring.applied",
        "process_authoring.completed",
        "process_authoring.failed",
        "process.created",
        "process.doctor.passed",
        "process.doctor.failed",
        "authoring_parity.started",
        "authoring_parity.process.checked",
        "authoring_parity.resource.checked",
        "authoring_parity.warning",
        "authoring_parity.failed",
        "authoring_parity.completed"
      ]
    },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "project": { "type": "object", "required": ["flow_root", "project_id"], "additionalProperties": true },
    "process": { "type": "object", "additionalProperties": true },
    "assignment": { "type": "object", "additionalProperties": true },
    "actor": { "type": "object", "additionalProperties": true },
    "session": { "type": "object", "additionalProperties": true },
    "data": { "type": "object", "additionalProperties": true },
    "severity": { "type": "string", "enum": ["info", "warn", "error"] },
    "privacy": { "type": "string", "enum": ["public", "private", "sanitized"] }
  },
  "additionalProperties": true
}
